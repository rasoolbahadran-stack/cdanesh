{
  auto_https off
  admin off
}
:{$PORT:8080} {
  root * /app/public
  encode gzip zstd
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  php_server
  file_server
}
