generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── کاربران و احراز هویت ───────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  name          String
  passwordHash  String
  role          Role      @default(AUTHOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  articles      Article[] @relation("ArticleAuthor")
  revisions     ArticleRevision[]
  media         Media[]
  activityLogs  ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  username  String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// ─── محتوا: دسته‌بندی، برچسب، مقاله ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles    Article[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles  ArticleTag[]
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  content         String // Markdown
  status          String        @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId        String
  author          User          @relation("ArticleAuthor", fields: [authorId], references: [id])
  coverImage      String?
  coverAlt        String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  noindex         Boolean  @default(false)
  relatedSlugs    String   @default("[]") // JSON: اسلاگ مقالات مرتبط منتخب
  focusKeyword    String?
  readTime        Int           @default(5)
  views           Int           @default(0)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tags            ArticleTag[]
  revisions       ArticleRevision[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleRevision {
  id              String   @id @default(cuid())
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  editedById      String
  editedBy        User     @relation(fields: [editedById], references: [id])
  createdAt       DateTime @default(now())

  @@index([articleId, createdAt])
}

// ─── رسانه‌ها ────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

// ─── نمونه‌کارها ─────────────────────────────────────────────────

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  category     String
  description  String
  imageUrl     String
  imageHeight  Int      @default(2000)
  chips        String   @default("[]") // JSON: برچسب‌های ویژگی
  sections     String   @default("{}") // JSON: بخش‌های صفحه جزئیات (کسب‌وکار/هدف/چالش/راه‌حل/ساختار/UX/سئو)
  link         String?
  isConceptual Boolean  @default(true)
  isPublished  Boolean  @default(true)
  showOnHome   Boolean  @default(false)
  sortOrder    Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── درخواست‌های مشتریان ────────────────────────────────────────

enum RequestStatus {
  NEW
  IN_REVIEW
  WAITING_REPLY
  ACCEPTED
  CLOSED
}

model ServiceRequest {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  serviceType String
  budget      String?
  subject     String?
  message     String
  status      RequestStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

// ─── سؤالات متداول صفحات ───────────────────────────────────────

model Faq {
  id        String  @id @default(cuid())
  pageKey   String // web-design | seo | ai-solutions | content-production | speed-optimization | uiux | e-commerce | support | request | contact | home
  question  String
  answer    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([pageKey, sortOrder])
}

// ─── پکیج‌ها و تعرفه‌ها (تا تأیید کاربر فقط پیش‌نویس) ───────────

model Package {
  id          String   @id @default(cuid())
  serviceType String // web-design | e-commerce | seo | content | ai-solutions
  name        String
  slug        String?  @unique // برای لینک درخواست ?pkg=…
  audience    String?
  features    String   @default("[]") // JSON: امکانات لحاظ‌شده
  excluded    String   @default("[]") // JSON: موارد خارج از قیمت
  duration    String?
  support     String?
  priceToman  String? // تا تأیید تعرفه خالی می‌ماند
  priceNote   String? // زیرنویس قیمت در حالت «برآوردی»
  note        String? // یادداشت عمومی پای کارت
  marketBasis String? // مبنای مقایسه با بازار (فقط داخلی)
  featured    Boolean  @default(false) // برچسب «پیشنهاد ما»
  isPublished Boolean  @default(false) // پیش‌نویس تا تأیید تعرفه
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── زیرساخت پرداخت (فعال‌سازی پس از اتصال درگاه واقعی) ────────

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  amount           Int // تومان
  description      String
  serviceType      String?
  packageId        String?
  requestId        String?
  status           OrderStatus @default(PENDING)
  gateway          String? // zarinpal | idpay | ...
  gatewayRef       String?
  callbackVerified Boolean     @default(false) // فقط تأیید سمت سرور معتبر است
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
}

// ─── مدیریت ریدایرکت‌ها ────────────────────────────────────────

model Redirect {
  id         String  @id @default(cuid())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  isActive   Boolean @default(true)
}

// ─── تنظیمات سایت و صفحات ───────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PageContent {
  id              String   @id @default(cuid())
  key             String   @unique // about | privacy | services-web-design ...
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

// ─── لاگ فعالیت‌ها ──────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
