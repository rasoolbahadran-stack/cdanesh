# کافه‌دانش — نمونهٔ تنظیمات محیطی
# این فایل فقط نمونه است؛ مقادیر واقعی را نصب‌کنندهٔ cPanel در .env می‌نویسد.
SITE_URL=https://cdanesh.ir

# اتصال دیتابیس داخلی هاست (MySQL/MariaDB) — معماری تولید cPanel
DATABASE_URL=mysql://DBUSER:DBPASS@localhost:3306/DBNAME

# ورود امن پنل مدیریت
# حساب مدیر اولیه توسط نصب‌کننده در دیتابیس ساخته می‌شود (username: azarakhsh،
# رمز موقت admin1234 — پس از اولین ورود ملزم به تغییر هستید).
# این متغیرها فقط به‌عنوان مرجع اضطراری راه‌اندازی کار می‌کنند و اختیاری‌اند.
# ADMIN_USERNAME=azarakhsh
# ADMIN_PASSWORD_HASH=replace-with-sha256-hash
# کلید تصادفی و محرمانه برای امضای نشست‌ها؛ حداقل ۳۲ کاراکتر (نصب‌کننده می‌سازد)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# رسانه‌ها روی دیسک هاست ذخیره می‌شوند (پیش‌فرض: data/uploads)
MEDIA_DIR=data/uploads
# فقط اگر صریحاً بخواهید Vercel Blob فعال شود (استقرار cPanel هرگز لازمش ندارد):
# MEDIA_DRIVER=blob

# دستیار هوشمند اختیاری است؛ بدون این کلید هم سایت و پنل کامل کار می‌کنند.
# کلید در پنل (تنظیمات دستیار) وارد و به‌صورت رمزنگاری‌شده در دیتابیس نگه‌داری می‌شود.
