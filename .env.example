# ─── کافه دانش — متغیرهای محیطی ───
# این فایل را به .env کپی کنید (cp .env.example .env) و مقادیر را تکمیل کنید.

# دامنه canonical (برای sitemap و SEO)
SITE_URL=https://cdanesh.ir

# ─── دیتابیس Neon ───
# رشته اتصال Postgres از پنل Neon — در نبود آن سایت با داده‌های محلی کار می‌کند
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/cdanesh?sslmode=require

# ─── احراز هویت پنل مدیریت ───
ADMIN_EMAIL=admin@cdanesh.ir
ADMIN_PASSWORD=change-me-strong-password
ADMIN_JWT_SECRET=generate-a-long-random-secret
# توکن ادمین برای فراخوانی API های مدیریتی از خارج (اختیاری)
ADMIN_API_TOKEN=optional-random-token

# ─── هوک استقرار مجدد پس از انتشار محتوا (اختیاری) ───
# از Vercel → Settings → Deploy Hooks یک هوک بسازید
VERCEL_DEPLOY_HOOK_URL=
