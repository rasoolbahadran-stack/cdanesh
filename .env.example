# همهٔ مقادیر فقط در داشبورد Vercel تنظیم شوند (Settings → Environment Variables)
# این فایل فقط نام متغیرهاست؛ مقدار واقعی هرگز در گیت قرار نمی‌گیرد.

# دیتابیس (تولید): اگر URL پستگرسی باشد از Postgres استفاده می‌شود، وگرنه پیش‌نمایش با PGlite
DATABASE_URL=

# ادمین پنل API
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=        # sha256 هگز رمز ادمین — node -e "console.log(require('crypto').createHash('sha256').update('YOUR- PASSWORD').digest('hex'))"
ADMIN_SESSION_SECRET=       # یک رشتهٔ تصادفی بلند

# ذخیره‌سازی تصاویر روی Vercel (با اتصال Blob خودکار در دسترس است)
BLOB_READ_WRITE_TOKEN=
