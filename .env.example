# کافه دانش — نمونه تنظیمات محیطی
# این فایل فقط نمونه است؛ رمزها و URL واقعی را در Vercel Environment Variables ذخیره کنید.
SITE_URL=https://cdanesh.ir

# اتصال Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ورود امن پنل مدیریت
ADMIN_USERNAME=admin
# هش SHA-256 رمز مدیر (ترجیحی). مقدار واقعی را در Vercel تنظیم کنید.
ADMIN_PASSWORD_HASH=replace-with-sha256-hash
# کلید تصادفی و محرمانه برای امضای نشست‌ها؛ حداقل 32 کاراکتر
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# فقط برای سازگاری با تنظیم قدیمی؛ در صورت تنظیم ADMIN_PASSWORD_HASH لازم نیست.
# ADMIN_PASSWORD=use-only-if-legacy-hash-is-not-configured

# اتصال فقط‌خواندنی به فهرست پروژه‌های Astro در Vercel (توکن فقط در سمت سرور نگهداری می‌شود)
VERCEL_ACCESS_TOKEN=replace-with-vercel-read-token
VERCEL_TEAM_ID=team_2HhADsN06h0DCSCbvkNwLxNj

# اختیاری: هوک انتشار مجدد پس از تغییر محتوای پویا
VERCEL_DEPLOY_HOOK_URL=
