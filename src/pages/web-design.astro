---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "طراحی سایت حرفه‌ای و اختصاصی | کافه‌دانش";
const description = "طراحی سایت اختصاصی، شرکتی، خدماتی و فروشگاهی با UI/UX مهندسی‌شده، کد تمیز و سئو از روز اول — استودیو دیجیتال کافه‌دانش.";
const canonical = "https://cdanesh.ir/web-design";
---

<SiteLayout title={title} description={description} canonical={canonical}>
<!-- ═══ هیرو صفحه خدمت ═══ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="index.html">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="services.html">خدمات</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>طراحی سایت</span>
    </nav>
    <span class="eyebrow">خدمت طراحی و توسعه وب</span>
    <h1 class="h1">سایتی که از صفر <span class="gold">مال شماست</span></h1>
    <p class="lead">قالب آماده نمی‌فروشیم؛ سایت شما را متناسب با برند، مخاطب و اهداف تجاری‌تان طراحی و کدنویسی می‌کنیم — از سایت معرفی تا فروشگاه و سامانه سفارشی.</p>
    <div class="page-hero-pills">
      <span class="chip">طراحی اختصاصی</span>
      <span class="chip">کد تمیز و استاندارد</span>
      <span class="chip">واکنش‌گرا در همه اندازه‌ها</span>
      <span class="chip">آماده سئو</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="split">
      <div class="prose">
        <h2 id="custom">طراحی سایت حرفه‌ای و اختصاصی</h2>
        <p>سایت اختصاصی یعنی طراحی و کد از صفر بر اساس هویت برند شما، رفتار مخاطب شما و اهداف تجاری شما. هیچ طرح آماده‌ای این تطابق را ندارد؛ به همین دلیل در پروژه‌های اختصاصی، قبل از هر کدنویسی، معماری اطلاعات و رابط کاربری با شما بازبینی می‌شود تا مطمئن شویم مسیر درست را می‌سازیم.</p>
        <p>خروجی این خدمت یک وب‌سایت کامل است: طراحی ریسپانسیو، پنل مدیریت محتوا، ساختار آماده سئو و مستندات کوتاه برای مدیریت سایت. در تمام مراحل، پیشرفت پروژه مرحله‌به‌مرحله قابل مشاهده است.</p>
        <h2 id="corporate">سایت شرکتی، خدماتی و فروشگاهی</h2>
        <p>هر کسب‌وکار نیاز متفاوتی دارد؛ شرکت‌ها به معرفی حرفه‌ای خدمات و پروژه‌ها نیاز دارند، کسب‌وکارهای خدماتی به صفحات فرود نتیجه‌محور و فروشگاه‌ها به تجربه خرید روان با فرایند پرداخت امن. ما این سه مسیر را با الگوهای آزموده اما شخصی‌سازی‌شده می‌سازیم.</p>
        <div class="feat-grid">
          <div class="feat-card">
            <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h18l-1.5 9h-15Z"/><path d="M3 3H1m4 17h2m8 0h2"/><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/></svg></div>
            <b>فروشگاه اینترنتی</b>
            <p>سبد خرید، درگاه پرداخت، مدیریت موجودی و صفحه محصول بهینه‌شده برای تبدیل.</p>
          </div>
          <div class="feat-card">
            <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg></div>
            <b>سایت شرکتی و سازمانی</b>
            <p>معرفی خدمات، نمونه‌کارها، تیم و اخبار؛ با ساختار حرفه‌ای و مگامنوی دسته‌بندی‌شده.</p>
          </div>
          <div class="feat-card">
            <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M5 8c0 4 3 7 7 7s7-3 7-7"/></svg></div>
            <b>سایت خدماتی و صفحات فرود</b>
            <p>صفحات نتیجه‌محور با دکمه‌های اقدام واضح و فرم‌های تمیز برای گرفتن سرنخ.</p>
          </div>
          <div class="feat-card">
            <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M16 18 22 12 16 6M8 6 2 12l6 6"/></svg></div>
            <b>وب‌اپلیکیشن و سامانه</b>
            <p>سامانه‌های سفارشی: داشبورد، رزرو، عضویت و هر منطق تجاری خاص شما.</p>
          </div>
        </div>
        <h2 id="development">برنامه‌نویسی و توسعه وب‌سایت</h2>
        <p>گاهی نیاز شما فقط «یک سایت» نیست: یک ماژول سفارشی، اتصال به سیستم داخلی، یا توسعه قابلیت جدید روی سایت فعلی. در این حالت کد موجود بررسی می‌شود و توسعه به‌صورت تمیز و مستند انجام می‌گیرد — بدون خراب‌کردن بقیه سیستم.</p>
        <h2 id="uiux">طراحی UI/UX</h2>
        <p>طراحی رابط کاربری فقط «زیبایی» نیست؛ مسیر کاربر تا هدفش را مهندسی می‌کند. در پروژه‌های ما، طراحی UI/UX شامل نقشه‌راه صفحات، سلسله‌مراتب بصری، دسترس‌پذیری و تست رفتار واقعی کاربر است. اگر سایت فعلی بازدید دارد اما تبدیل نمی‌کند، معمولاً مشکل همین‌جاست.</p>
        <blockquote>قبل از شروع هر پروژه، جلسه کشف رایگان برگزار می‌شود تا دقیقاً روشن شود چه می‌سازیم، برای چه کسی و با چه معیار موفقیتی.</blockquote>
      </div>
      <aside>
        <div class="aside-card">
          <b>در این صفحه</b>
          <nav class="toc" aria-label="فهرست مطالب">
            <a href="#custom">طراحی سایت اختصاصی</a>
            <a href="#corporate">شرکتی، خدماتی و فروشگاهی</a>
            <a href="#development">برنامه‌نویسی و توسعه</a>
            <a href="#uiux">طراحی UI/UX</a>
          </nav>
        </div>
        <div class="aside-card">
          <b>سایر خدمات</b>
          <div class="plan-list">
            <a class="plan-row" href="seo.html">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <span><b>سئو تکنیکال و محتوایی</b><span>زیرساخت و رشد جست‌وجو</span></span>
              <span class="plan-link">مشاهده ←</span>
            </a>
            <a class="plan-row" href="content-production.html">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              <span><b>تولید محتوای تخصصی</b><span>مقالات سئوشده و تقویم محتوا</span></span>
              <span class="plan-link">مشاهده ←</span>
            </a>
            <a class="plan-row" href="ai-solutions.html">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M2 14h2m16 0h2M15 13v2m-6-2v2"/></svg>
              <span><b>هوش مصنوعی و اتوماسیون</b><span>دستیارها و ابزارهای هوشمند</span></span>
              <span class="plan-link">مشاهده ←</span>
            </a>
          </div>
        </div>
        <div class="aside-card" style="background:linear-gradient(150deg,rgba(227,185,83,.14),rgba(227,185,83,.04)); border-color:rgba(227,185,83,.35)">
          <b>پروژه‌تان را شروع کنیم؟</b>
          <p class="muted" style="font-size:13.5px; margin-bottom:14px">جلسه اول مشاوره رایگان است؛ نیاز شما را می‌شنویم و پیشنهاد شفاف می‌دهیم.</p>
          <a class="btn btn-gold btn-block" href="request.html">درخواست مشاوره</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- ═══ سؤالات مرتبط ═══ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">سؤالات متداول</span>
      <h2 class="h2">درباره طراحی سایت</h2>
    </div>
    <div class="faq-list" data-page-faq="web-design"></div>
  </div>
</section>
<section class="section-tight" style="padding-top:30px">
  <div class="wrap">
    <div class="section-head side" style="margin-bottom:30px">
      <h2 class="h3">مقالات مرتبط با این خدمت</h2>
    </div>
    <div class="posts-grid" data-related-articles="web-design"></div>
  </div>
</section>
</SiteLayout>
