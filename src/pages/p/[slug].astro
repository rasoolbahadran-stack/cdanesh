---
// ═══ صفحهٔ ابری — /p/<slug> ═══
// صفحات ساخته‌شده و ویرایش‌شده از بخش «صفحات» پنل مدیریت؛
// prerender=false → در هر درخواست سمت سرور از دادهٔ ابری رندر می‌شود
// (متن کامل در HTML واقعی — قابل خزش برای گوگل).
export const prerender = false;

import ProsePage from '../../components/ProsePage.astro';
import { getPublicPages, pageBySlug, getAllPages, RESERVED_SLUGS } from '../../lib/ssr-pages.mjs';
import { isAuthedAsync } from '../../../server/lib/admin-auth.mjs';

const { slug } = Astro.params;
const key = (slug || '').toLowerCase();

if (!key || RESERVED_SLUGS.has(key)) {
  return Astro.redirect('/404');
}

const pages = await getPublicPages();
let page = pageBySlug(pages, key);
let isDraftPreview = false;

if (!page) {
  /* پیش‌نویس یا ناموجود؟ فقط مدیرِ واردشده می‌تواند پیش‌نمایش پیش‌نویس را ببیند
     (noindex — برای گوگل همان رفتار قبلی: 404/ریدایرکت). */
  try {
    const authed = await isAuthedAsync({ headers: { cookie: Astro.request.headers.get('cookie') || '' } });
    if (authed) {
      const all = await getAllPages();
      const draft = pageBySlug(all, key);
      if (draft) { page = draft; isDraftPreview = true; }
    }
  } catch (e) { /* بدون نشست معتبر → مثل قبل 404 */ }
}

if (!page) {
  // صفحهٔ عمومی نیست (پیش‌نویس) یا وجود ندارد → صفحهٔ ۴۰۴
  return Astro.redirect('/404');
}
---

<ProsePage page={page} canonical={'https://cdanesh.ir/p/' + page.slug} draftPreview={isDraftPreview} />
