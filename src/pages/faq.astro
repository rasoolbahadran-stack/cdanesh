---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { q } from '../lib/db';

const faqs = await q(`SELECT question, answer FROM faqs WHERE status='published' ORDER BY sort_order`);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: String(f.question),
    acceptedAnswer: { '@type': 'Answer', text: String(f.answer) },
  })),
};
---
<BaseLayout
  title="سؤالات متداول | کافه‌دانش"
  description="پاسخ سؤالات رایج درباره طراحی سایت، هزینه، زمان تحویل، سئو، هوش مصنوعی و مالکیت کد در کافه‌دانش."
  activePath="/faq"
  schema={[faqSchema]}
>
  <PageHero
    title="سؤالات متداول"
    sub="هرچیزی که قبل از شروع پروژه بهتر است بدانید — شفاف و بدون ابهام."
    crumbs={[{ label: 'سؤالات متداول', href: '' }]}
  />
  <section class="sec">
    <div class="container">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" data-reveal style={`--rd:${(i % 4) * 40}ms`}>
            <summary><span class="fq-ico">+</span> {f.question}</summary>
            <div class="fq-body">{f.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="sec sec-dark" style="padding-block:64px">
    <div class="container">
      <div class="cta-band" data-reveal="zoom">
        <div class="cta-inner">
          <div>
            <h2>سؤال دیگری دارید؟</h2>
            <p>از طریق فرم مشاوره بپرسید؛ در ساعات کاری همان روز پاسخ می‌دهیم.</p>
          </div>
          <div class="cta-actions">
            <a href="/consult" class="btn btn-gold btn-lg">درخواست مشاوره رایگان</a>
            <a href="/contact" class="btn btn-ghost-light">تماس با ما</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
