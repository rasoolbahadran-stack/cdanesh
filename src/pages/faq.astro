---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "سؤالات متداول | کافه‌دانش";
const description = "پاسخ سؤالات رایج درباره طراحی سایت، هزینه و زمان اجرا، سئو و تولید محتوا، هوش مصنوعی و تحویل و پشتیبانی کافه‌دانش.";
const canonical = "https://cdanesh.ir/faq";
const HEAD_EXTRA_0 = "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    { \"@type\": \"Question\", \"name\": \"برای شروع طراحی سایت چه اطلاعاتی لازم است؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"در جلسه اول فقط چند چیز پایه می‌پرسیم: کسب‌وکار شما چه می‌فروشد، مخاطبش کیست، الان سایت دارید یا نه و انتظارتان از پروژه چیست. اگر لوگو یا محتوای آماده دارید عالی است؛ اگر ندارید، بخشی از پروژه است و خودمان آماده می‌کنیم.\" } },\n    { \"@type\": \"Question\", \"name\": \"طراحی سایت اختصاصی چه تفاوتی با قالب آماده دارد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"قالب آماده سریع‌تر و ارزان‌تر است اما محدودیت دارد: امکانات ثابت، ظاهر تکراری و توسعه گران. طراحی اختصاصی بر اساس کسب‌وکار، مخاطب و هدف شما ساخته می‌شود؛ هر صفحه برای هدف خودش طراحی شده و قابلیت‌های جدید بدون بازسازی اضافه می‌شوند.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا سایت در موبایل و تبلت به‌درستی نمایش داده می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. بخش عمده بازدیدها از موبایل است؛ همه صفحات در موبایل، تبلت و دسکتاپ جداگانه تست می‌شوند تا چیدمان، سرعت و تعامل در هر دستگاه درست کار کند — نه اینکه فقط کوچک‌شده باشد.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا امکان توسعه امکانات سایت در آینده وجود دارد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. زیرساخت و کد از ابتدا توسعه‌پذیر طراحی می‌شود؛ افزودن فروشگاه، بلاگ، پنل اختصاصی یا قابلیت‌های جدید بدون بازسازی کامل امکان‌پذیر است.\" } },\n    { \"@type\": \"Question\", \"name\": \"هزینه طراحی سایت چگونه مشخص می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"هزینه تابع دامنه کار است: تعداد صفحات، قابلیت‌های سفارشی، حجم محتوا و سئو. به همین دلیل قیمت ثابت عمومی اعلام نمی‌شود؛ پس از جلسه نیازسنجی رایگان، برآورد دقیق و شفاف ارائه می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"مدت اجرای پروژه به چه عواملی بستگی دارد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"سه عامل اصلی: پیچیدگی قابلیت‌ها (سایت معرفی در برابر فروشگاه یا سامانه)، آماده‌بودن محتوا و سرعت بازخورد شما در مراحل تأیید. زمان‌بندی واقعی در جلسه اول اعلام می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"در صورت نامشخص بودن نیازها، چگونه برآورد اولیه دریافت کنم؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"فرم درخواست را با توضیح کلی کسب‌وکارتان پر کنید؛ در جلسه مشاوره رایگان، نیازها را مشخص می‌کنیم و برآورد اولیه شفاف دریافت می‌کنید. اگر نیاز شما خارج از خدمات ما باشد، صادقانه می‌گوییم و مسیر مناسب را پیشنهاد می‌دهیم.\" } },\n    { \"@type\": \"Question\", \"name\": \"سئو از چه مرحله‌ای باید آغاز شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بهترین زمان، قبل یا حین طراحی سایت است تا معماری اطلاعات، ساختار آدرس‌ها و سرعت از ابتدا درست باشد. برای سایت‌های موجود، کار با آدیت فنی شروع می‌شود و بعد محتوایی ادامه می‌یابد.\" } },\n    { \"@type\": \"Question\", \"name\": \"چه عواملی بر زمان مشاهده نتایج سئو تأثیر می‌گذارند؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"رقابت حوزه، سن و اعتبار دامنه، کیفیت و تداوم محتوا و وضعیت فنی سایت. نتایج سئو معمولاً چندماهه است؛ به همین دلیل هیچ تضمین رتبه‌ای داده نمی‌شود و گزارش شفاف کار انجام‌شده ارائه می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"تولید مقاله سئومحور چه مراحلی دارد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"تحقیق کلمه کلیدی و تحلیل نیت جست‌وجو، تدوین ساختار و سرفصل‌ها، نگارش با تحقیق واقعی، بهینه‌سازی عنوان و ساختار، بازبینی ویرایشی و در نهایت انتشار با تصاویر بهینه و لینک‌سازی داخلی.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا ساختار محتوایی و لینک‌سازی داخلی هم بررسی می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. معماری محتوا و لینک‌سازی داخلی بخشی از خدمات سئو و محتواست: صفحه‌های کلیدی باید قدرت بگیرند و مسیر کاربر از مطلب به خدمت کوتاه باشد؛ این ساختار از ابتدا طراحی و به‌مرور پایش می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"چه فرایندهایی را می‌توان با هوش مصنوعی خودکار کرد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"رایج‌ترین‌ها: پاسخ‌گویی به سؤالات تکراری مشتریان، پیش‌نویس محتوا، جمع‌آوری و ثبت اطلاعات مشتری و گردش‌کارهای تکراری تیم. هر فرایند پیش از پیاده‌سازی از نظر منطق و ارزش واقعی بررسی می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا می‌توان چت‌بات را به اطلاعات سایت متصل کرد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. چت‌بات با محتوای صفحات سایت شما آموزش دیده و پاسخ‌ها را از همان اطلاعات واقعی می‌دهد، نه حدس. با به‌روزرسانی محتوا می‌توان دانش دستیار را هم به‌روز نگه داشت.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا استفاده از هوش مصنوعی به سرویس یا کلید API خارجی نیاز دارد؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. اجرای مدل‌های هوش مصنوعی به سرویس API خارجی نیاز دارد که هزینه مصرف آن بر اساس استفاده محاسبه می‌شود و با تأیید شما تهیه می‌گردد. اتصال کاملاً سمت سرور و امن است و کلیدها هرگز در مرورگر قرار نمی‌گیرند.\" } },\n    { \"@type\": \"Question\", \"name\": \"پس از تحویل سایت چه مواردی ارائه می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"کد کامل، دسترسی کامل هاست و پنل، محتوای سایت، مستندات کوتاه و آموزش مدیریت محتوا. دوره پشتیبانی اولیه برای رفع اشکال آغاز می‌شود و در صورت نیاز قرارداد نگهداری مداوم تنظیم می‌گردد.\" } },\n    { \"@type\": \"Question\", \"name\": \"پشتیبانی شامل چه خدماتی خواهد بود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بسته به توافق: رفع اشکالات، به‌روزرسانی امنیتی، پشتیبان‌گیری، تغییرات جزئی محتوا و مشاوره توسعه. محدوده دقیق پشتیبانی و موارد خارج از آن در قرارداد شفاف مشخص می‌شود.\" } },\n    { \"@type\": \"Question\", \"name\": \"آیا آموزش مدیریت محتوا ارائه می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"بله. آموزش کار با پنل مدیریت بخشی از تحویل است: انتشار مقاله، مدیریت رسانه‌ها، نمونه‌کارها و درخواست‌های مشتریان — به‌صورت جلسه آموزشی و راهنمای مکتوب.\" } },\n    { \"@type\": \"Question\", \"name\": \"مالکیت کد، محتوا و دسترسی‌های پروژه چگونه مشخص می‌شود؟\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"همه‌چیز متعلق به شماست: کد، محتوا، دامنه و دسترسی‌ها پس از تسویه کامل تحویل داده می‌شوند و هیچ وابستگی قفل‌شده‌ای به ما وجود ندارد؛ در صورت تمایل می‌توانید با هر تیم دیگری ادامه دهید.\" } }\n  ]\n}";
const TAIL_SCRIPT_0 = "/* فیلتر دسته‌بندی سؤالات متداول صفحه اختصاصی */\n(function () {\n  const btns = document.querySelectorAll('.faq-cats button');\n  const groups = document.querySelectorAll('.faq-group[data-group]');\n  btns.forEach(btn => btn.addEventListener('click', () => {\n    btns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });\n    btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');\n    const cat = btn.dataset.cat;\n    groups.forEach(g => g.classList.toggle('is-hidden', cat !== 'all' && g.dataset.group !== cat));\n  }));\n})();";
---

<SiteLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={HEAD_EXTRA_0}></script>
  </Fragment>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="index.html">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>سؤالات متداول</span>
    </nav>
    <span class="eyebrow">سؤالات متداول</span>
    <h1 class="h1">پاسخ صادقانه به <span class="gold">سؤالات رایج</span></h1>
    <p class="lead">پرسش‌هایی که مشتریان پیش از شروع همکاری می‌پرسند — دسته‌بندی‌شده و بدون اغراق. اگر پاسخ سؤال شما اینجا نبود، از صفحه تماس بپرسید؛ در اولین فرصت پاسخ می‌دهیم.</p>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="faq-cats" role="group" aria-label="فیلتر سؤالات بر اساس موضوع">
      <button type="button" class="active" data-cat="all">همه موضوع‌ها</button>
      <button type="button" data-cat="design">طراحی سایت</button>
      <button type="button" data-cat="price">قیمت و زمان</button>
      <button type="button" data-cat="seo">سئو و محتوا</button>
      <button type="button" data-cat="ai">هوش مصنوعی</button>
      <button type="button" data-cat="support">تحویل و پشتیبانی</button>
    </div>

    <div class="faq-group" data-group="design">
      <b>طراحی سایت</b>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">برای شروع طراحی سایت چه اطلاعاتی لازم است؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>در جلسه اول فقط چند چیز پایه می‌پرسیم: کسب‌وکار شما چه می‌فروشد، مخاطبش کیست، الان سایت دارید یا نه و انتظارتان از پروژه چیست. اگر لوگو یا محتوای آماده دارید عالی است؛ اگر ندارید، بخشی از پروژه است و خودمان آماده می‌کنیم.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">طراحی سایت اختصاصی چه تفاوتی با قالب آماده دارد؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>قالب آماده سریع‌تر و ارزان‌تر است اما محدودیت دارد: امکانات ثابت، ظاهر تکراری و توسعه گران. طراحی اختصاصی بر اساس کسب‌وکار، مخاطب و هدف شما ساخته می‌شود؛ هر صفحه برای هدف خودش طراحی شده و قابلیت‌های جدید بدون بازسازی اضافه می‌شوند.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">آیا سایت در موبایل و تبلت به‌درستی نمایش داده می‌شود؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>بله. بخش عمده بازدیدها از موبایل است؛ همه صفحات در موبایل، تبلت و دسکتاپ جداگانه تست می‌شوند تا چیدمان، سرعت و تعامل در هر دستگاه درست کار کند — نه اینکه فقط کوچک‌شده باشد.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">آیا امکان توسعه امکانات سایت در آینده وجود دارد؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>بله. زیرساخت و کد از ابتدا توسعه‌پذیر طراحی می‌شود؛ افزودن فروشگاه، بلاگ، پنل اختصاصی یا قابلیت‌های جدید بدون بازسازی کامل امکان‌پذیر است.</div></div>
        </div>
      </div>
    </div>

    <div class="faq-group" data-group="price">
      <b>قیمت و زمان اجرا</b>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هزینه طراحی سایت چگونه مشخص می‌شود؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>هزینه تابع دامنه کار است: تعداد صفحات، قابلیت‌های سفارشی، حجم محتوا و سئو. به همین دلیل قیمت ثابت عمومی اعلام نمی‌شود؛ پس از جلسه نیازسنجی رایگان، برآورد دقیق و شفاف ارائه می‌شود.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">مدت اجرای پروژه به چه عواملی بستگی دارد؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>سه عامل اصلی: پیچیدگی قابلیت‌ها (سایت معرفی در برابر فروشگاه یا سامانه)، آماده‌بودن محتوا و سرعت بازخورد شما در مراحل تأیید. زمان‌بندی واقعی در جلسه اول اعلام می‌شود.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">آیا امکان سفارش امکانات اختصاصی وجود دارد؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>بله؛ همین بخش اصلی کار ماست. قابلیت اختصاصی (سامانه، پنل، اتصال به نرم‌افزار داخلی و…) را در جلسه نیازسنجی بررسی می‌کنیم، امکان‌سنجی فنی می‌شود و در صورت توجیه‌پذیری، در پروپوزال پیشنهاد می‌دهیم.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">در صورت نامشخص بودن نیازها، چگونه برآورد اولیه دریافت کنم؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>فرم درخواست را با توضیح کلی کسب‌وکارتان پر کنید؛ در جلسه مشاوره رایگان، نیازها را مشخص می‌کنیم و برآورد اولیه شفاف دریافت می‌کنید. اگر نیاز شما خارج از خدمات ما باشد، صادقانه می‌گوییم و مسیر مناسب را پیشنهاد می‌دهیم.</div></div>
        </div>
      </div>
    </div>

    <div class="faq-group" data-group="seo">
      <b>سئو و تولید محتوا</b>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">سئو از چه مرحله‌ای باید آغاز شود؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
          <div class="faq-a"><div>بهترین زمان، قبل یا حین طراحی سایت است تا معماری اطلاعات، ساختار آدرس‌ها و سرعت از ابتدا درست باشد. برای سایت‌های موجود، کار با آدیت فنی شروع می‌شود و بعد محتوایی ادامه می‌یابد.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">چه عواملی بر زمان مشاهده نتایج سئو تأثیر می‌گذارند؟<span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
