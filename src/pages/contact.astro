---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { q } from '../lib/db';
import { getSiteSettings } from '../lib/seed';

const page = await q(`SELECT * FROM pages WHERE system_key='contact' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
const settings = await getSiteSettings();
const c = settings.contact;
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/contact"
>
  <PageHero title={String(page.title)} sub={String(page.excerpt)} crumbs={[{ label: 'تماس با ما', href: '' }]} />
  <section class="sec">
    <div class="container" style="display:grid;grid-template-columns:1fr 1.25fr;gap:36px;align-items:start" class="contact-grid">
      <div data-reveal="right">
        <div class="form-panel" style="margin-bottom:18px">
          <h3 style="font-size:16.5px">راه‌های ارتباطی</h3>
          <ul style="list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:14px">
            <li style="display:flex;gap:12px;align-items:center"><span style="width:44px;height:44px;border-radius:13px;background:var(--gold-soft);display:grid;place-items:center;font-size:18px">📞</span><div><b style="font-size:14px">تلفن</b><a href={`tel:+98${c.phone.slice(1)}`} style="display:block;direction:ltr;text-align:right;color:var(--gold-3);font-weight:700">{c.phoneDisplay}</a></div></li>
            <li style="display:flex;gap:12px;align-items:center"><span style="width:44px;height:44px;border-radius:13px;background:var(--gold-soft);display:grid;place-items:center;font-size:18px">✉️</span><div><b style="font-size:14px">ایمیل</b><a href={`mailto:${c.email}`} style="display:block;color:var(--gold-3);font-weight:700">{c.email}</a></div></li>
            <li style="display:flex;gap:12px;align-items:center"><span style="width:44px;height:44px;border-radius:13px;background:var(--gold-soft);display:grid;place-items:center;font-size:18px">📍</span><div><b style="font-size:14px">نشانی</b><span style="display:block;color:var(--mut-light);font-size:13.5px">{c.address}</span></div></li>
            <li style="display:flex;gap:12px;align-items:center"><span style="width:44px;height:44px;border-radius:13px;background:var(--gold-soft);display:grid;place-items:center;font-size:18px">🕘</span><div><b style="font-size:14px">ساعات کاری</b><span style="display:block;color:var(--mut-light);font-size:13.5px">{c.hours}</span></div></li>
          </ul>
        </div>
        <div class="pf-note">💡 برای درخواست پروژه و نیازسنجی، فرم <a href="/consult" style="color:var(--gold-3);font-weight:700">درخواست مشاوره</a> گزینه دقیق‌تری است.</div>
      </div>
      <div>
        <div class="prose-fa" style="margin-bottom:22px" set:html={String(page.content)} />
        <ContactForm type="contact" />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr !important; } }
</style>
