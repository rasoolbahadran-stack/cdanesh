---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "تماس با ما | کافه‌دانش";
const description = "راه‌های ارتباط با استودیو دیجیتال کافه‌دانش — ایمیل، تلفن و فرم پیام.";
const canonical = "https://cdanesh.ir/contact";
---

<SiteLayout title={title} description={description} canonical={canonical}>
<!-- ═══ هیرو تماس ═══ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="index.html">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>تماس با ما</span>
    </nav>
    <span class="eyebrow">تماس با ما</span>
    <h1 class="h1">خوشحال می‌شویم <span class="gold">شنیدیم</span></h1>
    <p class="lead">برای سؤال، پیشنهاد همکاری یا سفارش پروژه — از هر مسیری که راحت‌ترید پیام بدهید. پاسخ‌گویی در ساعات کاری معمولاً حداکثر یک روز کاری است.</p>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-item">
          <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg></div>
          <div><b>ایمیل</b><a href="mailto:info@cdanesh.ir" dir="ltr">info@cdanesh.ir</a><p class="small muted">برای مکاتبات رسمی و درخواست‌ها</p></div>
        </div>
        <div class="contact-item">
          <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg></div>
          <div><b>تلفن</b><a href="tel:+982100000000" dir="ltr">۰۲۱ — ۰۰ ۰۰ ۰۰ ۰۰</a><p class="small muted">شنبه تا چهارشنبه، ۹ تا ۱۷</p></div>
        </div>
        <div class="contact-item">
          <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <div><b>ارتباط آنلاین</b><p>ترجیح می‌دهید همه‌چیز کتبی باشد؟ <a href="request.html" style="color:var(--gold)">فرم درخواست خدمات</a> دقیق‌ترین راه است؛ همه جزئیات را یک‌جا می‌گیرد.</p></div>
        </div>
        <div class="contact-item">
          <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
          <div><b>زمان پاسخ</b><p class="muted" style="font-size:13px">ایمیل و فرم‌ها: حداکثر ۱ روز کاری — پیام‌های عاجل را در موضوع مشخص کنید.</p></div>
        </div>
      </div>
      <div>
        <div class="form-card">
          <h2 class="h3" style="margin-bottom:6px">پیام مستقیم</h2>
          <p class="muted small" style="margin-bottom:26px">پیام شما ثبت می‌شود و در ساعات کاری حداکثر یک روز کاری پاسخ می‌گیرید.</p>
          <div class="form-ok" role="status">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span><b>پیام شما ثبت شد!</b> کد پیگیری: <b data-ref></b> — در ساعات کاری حداکثر یک روز کاری پاسخ می‌دهیم.</span>
          </div>
          <div class="form-ok form-err-global" role="alert" style="background:rgba(229,118,106,.1); border-color:rgba(229,118,106,.4); color:var(--err); display:none" data-err-global></div>
          <form data-cd-form="contact" novalidate>
            <div class="form-grid">
              <div class="field"><label for="cname">نام و نام خانوادگی <i>*</i></label><input class="control" id="cname" name="name" required placeholder="مثلاً سارا محمدی"><span class="field-err">این فیلد الزامی است.</span></div>
              <div class="field"><label for="cmail">ایمیل <i>*</i></label><input class="control" id="cmail" name="email" type="email" required placeholder="name@example.com" dir="ltr" style="text-align:right"><span class="field-err">ایمیل معتبر نیست.</span></div>
              <div class="field"><label for="cphone">شماره موبایل (اختیاری)</label><input class="control" id="cphone" name="phone" type="tel" data-kind="phone-optional" placeholder="09123456789" dir="ltr" style="text-align:right"><span class="field-err">شماره موبایل معتبر نیست؛ نمونه درست: 09123456789</span></div>
              <div class="field"><label for="csubj">موضوع</label><input class="control" id="csubj" name="subject" placeholder="مثلاً درخواست طراحی سایت شرکتی"></div>
              <div class="field field-full"><label for="cmsg">پیام <i>*</i></label><textarea class="control" id="cmsg" name="message" required placeholder="پیام‌تان را بنویسید…"></textarea><span class="field-err">این فیلد الزامی است.</span></div>
              <div class="field field-full" style="position:absolute; right:-9999px" aria-hidden="true"><label for="cweb">وب‌سایت</label><input id="cweb" name="website" type="text" tabindex="-1" autocomplete="off"></div>
            </div>
            <button class="btn btn-gold btn-block btn-lg" type="submit" style="margin-top:22px">ارسال پیام</button>
            <p class="form-note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              <span>اطلاعات شما فقط برای پاسخ به همین پیام استفاده می‌شود و مطابق <a href="privacy.html" style="color:var(--gold)">سیاست حریم خصوصی</a> نگهداری می‌شود. فیلدهای ستاره‌دار الزامی‌اند.</span>
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
