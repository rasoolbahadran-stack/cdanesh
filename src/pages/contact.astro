---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { q } from '../lib/db';
import { getSiteSettings } from '../lib/seed';

const page = await q(`SELECT * FROM pages WHERE system_key='contact' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
const settings = await getSiteSettings();
const c = settings.contact;
const phoneDigits = String(c.phone).replace(/\D/g, '');
const phoneHref = phoneDigits.startsWith('0') ? `+98${phoneDigits.slice(1)}` : phoneDigits;

const contactMethods = [
  { label: 'تماس تلفنی', value: c.phoneDisplay, href: `tel:${phoneHref}`, icon: '☎', direction: 'ltr' },
  { label: 'ایمیل', value: c.email, href: `mailto:${c.email}`, icon: '✉', direction: 'ltr' },
  { label: 'نشانی دفتر', value: c.address, href: '', icon: '⌖', direction: 'rtl' },
  { label: 'ساعات پاسخ‌گویی', value: c.hours, href: '', icon: '◷', direction: 'rtl' },
];
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/contact"
>
  <PageHero
    title={String(page.title)}
    sub={String(page.excerpt)}
    crumbs={[{ label: 'تماس با ما', href: '' }]}
  />
  <section class="sec contact-section">
    <div class="container contact-layout">
      <aside class="contact-aside" data-reveal="right">
        <div class="contact-aside-intro">
          <span class="section-label pink">در ارتباط باشیم</span>
          <h2>برای شروع گفتگو، از راه مناسب خودتان استفاده کنید.</h2>
          <p>برای پرسش درباره خدمات، پیگیری درخواست یا هماهنگی جلسه، راه‌های ارتباطی زیر در دسترس هستند.</p>
        </div>
        <div class="contact-methods">
          {contactMethods.map((item) => (
            <div class="contact-method">
              <span class="contact-method-icon" aria-hidden="true">{item.icon}</span>
              <div class="contact-method-copy">
                <span class="contact-method-label">{item.label}</span>
                {item.href
                  ? <a href={item.href} dir={item.direction}>{item.value}</a>
                  : <p dir={item.direction}>{item.value}</p>}
              </div>
            </div>
          ))}
        </div>
        <div class="contact-consult-note">
          <strong>برای برآورد هزینه و زمان پروژه</strong>
          <p>فرم درخواست مشاوره اطلاعات لازم برای بررسی اولیه پروژه را دریافت می‌کند.</p>
          <a href="/consult">رفتن به فرم مشاوره <span aria-hidden="true">←</span></a>
        </div>
      </aside>

      <div class="contact-form-column" data-reveal="left">
        <div class="contact-form-heading">
          <span class="section-label">ارسال پیام</span>
          <h2>پیام خود را برای ما بنویسید</h2>
          <p>پیام شما پس از ثبت در سایت بررسی می‌شود و برای پاسخ‌گویی با شما تماس می‌گیریم.</p>
        </div>
        {page.content ? <div class="prose-fa contact-page-copy" set:html={String(page.content)} /> : null}
        <div class="contact-form-shell">
          <ContactForm type="contact" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
