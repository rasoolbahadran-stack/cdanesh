---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FormBlock from '../components/FormBlock.astro';
import { SITE, PRICING } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const selectedPackageKey = Astro.url.searchParams.get('package');
const selectedPackage = PRICING.find((item) => item.key === selectedPackageKey);
const initialSubject = selectedPackage
  ? `پرسش درباره پکیج ${selectedPackage.name} — ${selectedPackage.price}`
  : '';

const meta = {
  title: 'تماس با کافه دانش | سفارش پروژه طراحی سایت',
  description: 'راه‌های ارتباط با استودیو طراحی و توسعه وب‌سایت کافه‌دانش در بوشهر: تلفن، ایمیل و فرم پیام با پاسخ‌گویی حداکثر تا یک روز کاری — برای درخواست پروژه یا پرسش دربارهٔ خدمات.',
  path: '/contact',
};
---
<BaseLayout meta={meta} current="/contact" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'تماس با ما', url: '/contact' }])]}>
  <PageHero
    title="تماس با ما"
    sub="پرسش دربارهٔ خدمات، دریافت برآورد یا شروع پروژه — راه‌های ارتباطی و زمان پاسخ‌گویی ما از ابتدا شفاف است."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="card" style="padding:clamp(22px,4vw,36px)">
        <h2 style="font-size:1.3rem">پیام خود را ثبت کنید</h2>
        <p style="color:var(--mut);font-size:.94rem">فیلدهای ستاره‌دار را تکمیل کنید؛ پیام شما مستقیم به تیم فنی می‌رسد و حداکثر تا <b>یک روز کاری</b> پاسخ می‌گیرید.</p>
        <FormBlock kind="contact" initialSubject={initialSubject} />
      </div>

      <aside class="contact-aside">
        <div class="card" style="padding:24px">
          <h3 style="font-size:1.05rem">راه‌های ارتباطی</h3>
          <ul style="list-style:none;padding:0;margin:14px 0 0;display:grid;gap:14px;font-size:.95rem">
            <li style="display:flex;gap:11px;align-items:flex-start">
              <span class="hero__chip-ico" style="flex:none"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg></span>
              <span><b>تلفن:</b> <a href={`tel:${SITE.phoneIntl}`} dir="ltr">{SITE.phoneFa}</a><br /><small style="color:var(--mut)">شنبه تا پنجشنبه، ۹ تا ۱۸</small></span>
            </li>
            <li style="display:flex;gap:11px;align-items:flex-start">
              <span class="hero__chip-ico" style="flex:none"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg></span>
              <span><b>ایمیل:</b> <a href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a></span>
            </li>
            <li style="display:flex;gap:11px;align-items:flex-start">
              <span class="hero__chip-ico" style="flex:none"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z" /><circle cx="12" cy="10" r="2.6" /></svg></span>
              <span><b>آدرس:</b> {SITE.address}</span>
            </li>
          </ul>
        </div>

        <div class="card" style="padding:24px">
          <h3 style="font-size:1.05rem">پس از ارسال پیام، چه اتفاقی می‌افتد؟</h3>
          <ol class="contact-steps">
            <li><b>پاسخ اولیه</b> — حداکثر تا یک روز کاری، با شما تماس می‌گیریم یا ایمیل می‌زنیم.</li>
            <li><b>جلسهٔ نیازسنجی رایگان</b> — کسب‌وکار، مخاطب و هدف پروژه را مرور می‌کنیم (آنلاین یا حضوری).</li>
            <li><b>پروپوزال مکتوب</b> — دامنهٔ کار، زمان‌بندی و برآورد شفاف؛ تصمیم با شماست، بدون تعهد.</li>
          </ol>
        </div>

        <div class="card" style="padding:24px">
          <h3 style="font-size:1.05rem">برای پاسخ دقیق‌تر، این‌ها را بنویسید</h3>
          <p style="font-size:.92rem;color:var(--mut);margin:0 0 8px">کسب‌وکارتان چه می‌فروشد، الان سایت دارید یا نه، و از سایت جدید چه نتیجه‌ای می‌خواهید؛ همین سه خط، جلسهٔ اول را هدفمند می‌کند.</p>
          <p style="font-size:.92rem;margin:0">اگر <b>درخواست پروژه</b> دارید، <a href="/consult">فرم درخواست مشاوره</a> برای نیازسنجی دقیق‌تر طراحی شده است. برآورد قیمت پکیج‌ها را هم می‌توانید در <a href="/pricing">صفحهٔ تعرفه‌ها</a> ببینید.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 30px; }
  .contact-steps {
    margin: 14px 0 0; padding: 0; list-style: none;
    display: grid; gap: 12px; counter-reset: step;
  }
  .contact-steps li {
    position: relative; padding-inline-start: 40px;
    font-size: .92rem; line-height: 1.9; color: var(--body);
  }
  .contact-steps li::before {
    counter-increment: step; content: counter(step, persian);
    position: absolute; inset-inline-start: 0; top: 2px;
    width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--lavender); color: var(--purple);
    font-weight: 800; font-size: .88rem;
  }
  .contact-steps b { color: var(--navy); }
  @media (min-width: 1000px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
    .contact-aside { position: sticky; top: 92px; display: grid; gap: 20px; }
  }
</style>
