---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { q } from '../lib/db';

const page = await q(`SELECT * FROM pages WHERE system_key='consult' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
const plan = Astro.url.searchParams.get('plan') || '';
const service = Astro.url.searchParams.get('service') || '';
const defaultPlan = plan || service;
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/consult"
>
  <PageHero title={String(page.title)} sub={String(page.excerpt)} crumbs={[{ label: 'درخواست مشاوره', href: '' }]} />
  <section class="sec">
    <div class="container consult-layout">
      <div class="consult-form-column" data-reveal="right">
        <ContactForm type="consult" defaultPlan={defaultPlan} compact={false} />
        {page.content ? <div class="prose-fa consult-copy" set:html={String(page.content)} /> : null}
      </div>
      <aside class="consult-info-column" data-reveal="left">
        <div class="form-panel consult-info-panel" style="background:var(--ink);color:var(--txt-dark);border:none">
          <h3 style="font-size:17px;color:var(--gold-2)">در جلسه مشاوره چه اتفاقی می‌افتد؟</h3>
          <ul style="list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:12px">
            <li style="display:flex;gap:10px"><span style="color:var(--gold);font-weight:800">✓</span><span style="font-size:13.5px;color:var(--mut-dark)">گوش می‌دهیم: کسب‌وکار، مخاطب و وضعیت فعلی شما.</span></li>
            <li style="display:flex;gap:10px"><span style="color:var(--gold);font-weight:800">✓</span><span style="font-size:13.5px;color:var(--mut-dark)">سؤال می‌پرسیم: انتظار واقعی‌تان از سایت و محتوا چیست.</span></li>
            <li style="display:flex;gap:10px"><span style="color:var(--gold);font-weight:800">✓</span><span style="font-size:13.5px;color:var(--mut-dark)">گزینه‌ها را می‌گوییم: چه راه‌حلی به درد شما می‌خورد و چه چیزی نمی‌خورد.</span></li>
            <li style="display:flex;gap:10px"><span style="color:var(--gold);font-weight:800">✓</span><span style="font-size:13.5px;color:var(--mut-dark)">برآورد اولیه می‌دهیم: دامنهٔ زمانی و هزینه، بدون پنهان‌کاری.</span></li>
          </ul>
          <blockquote style="background:rgba(227,185,83,.1);border:none;border-inline-start:3px solid var(--gold);border-radius:12px;padding:14px 18px;margin-top:18px;font-size:13px;color:var(--gold-2)">مشاوره یعنی شنیدن و پیشنهاد؛ نه فروش فوری پکیج.</blockquote>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
