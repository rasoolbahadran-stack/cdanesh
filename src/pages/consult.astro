---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { q } from '../lib/db';

const page = await q(`SELECT * FROM pages WHERE system_key='consult' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
const plan = Astro.url.searchParams.get('plan') || '';
const service = Astro.url.searchParams.get('service') || '';
const defaultPlan = plan || service;
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/consult"
>
  <PageHero title="درخواست مشاوره" sub={String(page.excerpt)} crumbs={[{ label: 'درخواست مشاوره', href: '' }]} />

  <section class="section">
    <div class="container contact-grid">
      <div data-reveal="right">
        <ContactForm type="consult" defaultPlan={defaultPlan} />
        {page.content ? <div class="prose-fa mt-3" data-reveal="up" set:html={String(page.content)} /> : null}
      </div>

      <aside class="contact-side" data-reveal="left">
        <h2>در جلسه مشاوره چه اتفاقی می‌افتد؟</h2>
        <p>مشاوره یعنی شنیدن و پیشنهاد؛ نه فروش فوری پکیج.</p>
        <ul class="contact-side__list">
          <li>
            <Icon name="check" size={19} stroke={2.2} />
            <span>گوش می‌دهیم: کسب‌وکار، مخاطب و وضعیت فعلی شما.</span>
          </li>
          <li>
            <Icon name="check" size={19} stroke={2.2} />
            <span>سؤال می‌پرسیم: انتظار واقعی‌تان از سایت و محتوا چیست.</span>
          </li>
          <li>
            <Icon name="check" size={19} stroke={2.2} />
            <span>گزینه‌ها را می‌گوییم: چه راه‌حلی به درد شما می‌خورد و چه چیزی نمی‌خورد.</span>
          </li>
          <li>
            <Icon name="check" size={19} stroke={2.2} />
            <span>برآورد اولیه می‌دهیم: دامنهٔ زمانی و هزینه، بدون پنهان‌کاری.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
