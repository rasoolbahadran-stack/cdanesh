---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "وب‌سایت کلینیک مهر | نمونه‌کار کافه‌دانش";
const description = "نمونه مفهومی وب‌سایت کلینیک تخصصی مهر با نوبت‌دهی آنلاین سه‌گامی و پروفایل پزشکان.";
---

<SiteLayout title={title} description={description} schemas={false}>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="index.html">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="portfolio.html">نمونه‌کارها</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>کلینیک مهر</span>
    </nav>
    <span class="eyebrow">نمونه‌کار خدماتی</span>
    <h1 class="h1">نوبت‌دهی آنلاین که <span class="gold">بیمار را خسته نمی‌کند</span></h1>
    <p class="lead">نمونه‌ای از سایت خدماتی درمانی: معرفی تخصص‌ها و پزشکان، نوبت‌دهی سه‌گامی و پاسخ به پرسش‌های رایج بیماران.</p>
    <div class="page-hero-pills">
      <span class="chip chip-gold">خدماتی</span>
      <span class="badge-demo">نمونه مفهومی — پروژه نمایشی</span>
      <span class="chip">نوبت‌دهی آنلاین</span>
      <span class="chip">پروفایل پزشکان</span>
      <span class="chip">سؤالات متداول</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="pf-card">
      <div class="pf-head">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pf-url">cdanesh.ir/demo/portfolio-mehr</span>
        <span class="pf-url" style="flex:0">با ماوس بکشید یا اسکرول کنید</span>
      </div>
      <div class="pf-window custom-scrollbar" role="region" aria-label="پیش‌نمایش کامل کلینیک مهر — اسکرول داخل قاب">
        <img src="assets/img/pf-clinic.webp" alt="نمای کامل صفحه کلینیک مهر — نمونه مفهومی" width="1280" height="2739" loading="lazy">
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin-top:18px">این تصویر، نمای کاملِ صفحه‌ی اصلی نمونه است. داخل قاب اسکرول کنید تا همه بخش‌ها را ببینید.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">درباره پروژه</span>
      <h2 class="h2">هدف و روند <span class="gold">اجرای پروژه</span></h2>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">بیمارِ دردمند باید در کمترین زمان به دو چیز برسد: «پزشک مناسب» و «نوبت». این نمونه این دو مسیر را کوتاه کرده است؛ تخصص‌ها در صفحه اصلی دیده می‌شوند و فرم نوبت‌دهی در سه گام ساده بدون تماس تلفنی تکمیل می‌شود.</p>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">پروفایل هر پزشک شامل تخصص، سابقه و ساعات حضور است تا بیمار با اطمینان انتخاب کند. بخش سؤالات متداول هم به نگرانی‌های واقعی بیماران (پذیرش بیمه، مدارک لازم، لغو نوبت) پاسخ می‌دهد و تماس‌های تکراری منشی را کم می‌کند.</p>
      <div class="duo-points" style="margin-top:24px">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>نوبت‌دهی سه‌گامی بدون تماس</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>پروفایل شفاف پزشکان</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>پاسخ به نگرانی‌های رایج بیماران</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>طراحی آرام و خوانا برای همه سنین</span></li>
      </div>
    </div>
    <aside class="aside-card reveal" data-delay="1">
      <b style="font-size:16px">مشخصات پروژه</b>
      <ul style="margin-top:16px; display:grid; gap:12px; font-size:13.5px; color:var(--mut)">
        <li style="display:flex; justify-content:space-between; gap:12px"><span>نوع پروژه</span><b style="color:var(--txt)">خدماتی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>وضعیت</span><b style="color:var(--warn)">نمونه مفهومی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>خدمات اجراشده</span><b style="color:var(--txt)">طراحی سایت + UI/UX + سئوی محلی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>زمان اجرای مشابه</span><b style="color:var(--txt)">طبق برآورد پروژه</b></li>
      </ul>
      <p class="pkg-note">این نمونه برای نمایش سبک کار و کیفیت اجرای ما ساخته شده است؛ هیچ کسب‌وکار واقعی به آن اشاره ندارد.</p>
      <a class="btn btn-gold btn-block" href="request.html" style="margin-top:18px">پروژه مشابه می‌خواهم</a>
    </aside>
  </div>
</section>

<section class="section-tight" style="padding-bottom:20px">
  <div class="wrap">
    <span class="eyebrow">امکانات کلیدی</span>
    <h2 class="h2" style="margin-top:10px">چه چیزهایی در این نمونه <span class="gold">پیاده شده است</span>؟</h2>
    <div class="feat-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px">
      <div class="feat-card"><b>نوبت‌دهی ساختارمند</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">انتخاب تخصص، پزشک و زمان در سه گام؛ با کد پیگیری برای بیمار.</p></div>
      <div class="feat-card"><b>پروفایل پزشکان</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">تخصص، سابقه و ساعات حضور هر پزشک در صفحه مستقل و قابل جست‌وجو.</p></div>
      <div class="feat-card"><b>سؤالات متداول درمانی</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">پاسخ به پرسش‌های پرتکرار پذیرش برای کاهش تماس‌های تکراری.</p></div>
      <div class="feat-card"><b>طراحی با تضاد بالا</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">خوانایی مناسب برای کاربران مسن‌تر؛ فونت درشت و مسیرهای واضح.</p></div>
      <div class="feat-card"><b>سئوی محلی</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">ساختار مناسب برای جست‌وجوی «کلینیک + شهر» و نمایش در نتایج محلی.</p></div>
      <div class="feat-card"><b>اتصال به سامانه مطب</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">قابل اتصال به نرم‌افزارهای مدیریت مطب و کلینیک برای همگام‌سازی نوبت‌ها.</p></div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>پروژه‌ای شبیه این نمونه در سر دارید؟</h2>
        <p>در جلسه مشاوره، دقیقاً می‌گوییم چه ساختار و چه امکاناتی برای هدف شما لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="request.html">شروع پروژه</a>
        <a class="btn btn-ghost btn-lg" href="portfolio.html">نمونه‌کارهای دیگر</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
