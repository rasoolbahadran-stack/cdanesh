---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Blocks from '../components/Blocks.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const page = getPage('about')!;
const bodyBlocks = page.blocks.filter((b) => !(b.t === 'h1'
  || (b.t === 'img' && b.src.includes('about-studio'))
  || (b.t === 'p' && b.x.startsWith('استودیو دیجیتال کافه'))
  || (b.t === 'p' && b.x.startsWith('کافه‌دانش؛ استودیو تخصصی طراحی و توسعه وب‌سایت در بوشهر.'))));

const meta = {
  title: 'درباره کافه دانش | استودیو طراحی و توسعه وب‌سایت در بوشهر',
  description: page.meta,
  path: '/about',
  image: '/img/about-studio.webp',
};
---
<BaseLayout meta={meta} current="/about" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'درباره ما', url: '/about' }])]}>
  <PageHero title="درباره کافه دانش" sub="کافه‌دانش؛ استودیو تخصصی طراحی و توسعه وب‌سایت در بوشهر — شرکتی، فروشگاهی و اختصاصی." crumbs={[{ label: 'خانه', href: '/' }, { label: 'درباره ما' }]} />

  <section class="section--tight">
    <div class="container">
      <figure style="margin:0 0 10px;border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-float);max-width:920px;margin-inline:auto">
        <img src="/img/ai/about-team.webp" alt="فضای استودیو کافه دانش" width="800" height="450" loading="lazy" decoding="async" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block" />
      </figure>
      <Blocks blocks={bodyBlocks} />
    </div>
  </section>

  <section class="section--tight">
    <div class="container" style="max-width:920px">
      <figure style="margin:0;border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-card)">
        <img src="/img/ai/hero-team.webp" alt="تیم کافه دانش در حال برنامه‌ریزی و طراحی وب‌سایت" width="672" height="384" loading="lazy" decoding="async" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block" />
      </figure>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
