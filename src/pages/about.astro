---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { q } from '../lib/db';

const page = await q(`SELECT * FROM pages WHERE system_key='about' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/about"
>
  <PageHero title={String(page.title)} sub={String(page.excerpt)} crumbs={[{ label: 'درباره ما', href: '' }]} />
  <section class="sec">
    <div class="container" style="max-width:980px">
      <img src="/img/about-studio.webp" alt="استودیو دیجیتال کافه‌دانش" width="1152" height="864" style="border-radius:26px;box-shadow:var(--shadow-card);margin-bottom:36px" data-reveal="zoom" fetchpriority="high" />
      <div class="prose-fa" data-reveal set:html={String(page.content)} />
    </div>
  </section>
</BaseLayout>
