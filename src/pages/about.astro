---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Blocks from '../components/Blocks.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

type AboutBlock = { t: string; x?: string; items?: string[] };
const page = getPage('about')!;
const blocks = page.blocks as unknown as AboutBlock[];
const locIdx = blocks.findIndex((b) => b.t === 'h2' && (b.x || '').startsWith('کجا هستیم'));
const reasonsIdx = blocks.findIndex((b) => b.t === 'h2' && (b.x || '').startsWith('پنج دلیل'));
const stepsIdx = blocks.findIndex((b) => b.t === 'h2' && (b.x || '').startsWith('شش مرحله'));
const ctaIdx = blocks.findIndex((b, i) => i > stepsIdx && b.t === 'h2');
const coreBlocks = blocks.slice(3, locIdx);
const locationBlocks = blocks.slice(locIdx, reasonsIdx);
const introPrinciples = [
  'معماری اطلاعات و طراحی UI/UX پیش از طراحی بصری',
  'بررسی سرعت، ریسپانسیو و ساختار سئو پیش از انتشار',
  'تحویل دسترسی‌ها، آموزش پنل و مستندات موردتوافق',
];
const collectItems = (start: number, end: number) => {
  const items: Array<{ title: string; description: string }> = [];
  for (let i = start; i < end; i++) {
    if (blocks[i].t !== 'h3') continue;
    items.push({ title: blocks[i].x || '', description: blocks[i + 1]?.t === 'p' ? blocks[i + 1].x || '' : '' });
  }
  return items;
};
const reasons = collectItems(reasonsIdx + 1, stepsIdx);
const steps = collectItems(stepsIdx + 1, ctaIdx > stepsIdx ? ctaIdx : blocks.length);
const ctaTitle = ctaIdx >= 0 ? blocks[ctaIdx].x : 'برای طراحی سایت کسب‌وکارتان آماده‌اید؟';
const ctaSub = ctaIdx >= 0 && blocks[ctaIdx + 1]?.t === 'p' ? blocks[ctaIdx + 1].x : 'نیازهای پروژه را بررسی می‌کنیم و مسیر مناسب اجرا را پیشنهاد می‌دهیم.';

const meta = {
  title: 'درباره کافه دانش | استودیو طراحی و توسعه وب‌سایت در بوشهر',
  description: 'آشنایی با استودیوی کافه دانش؛ طراحی سایت شرکتی، فروشگاهی و اختصاصی با تحلیل نیاز، معماری اطلاعات، طراحی تجربه کاربری و توسعه فنی.',
  path: '/about',
  image: '/img/about-studio.webp',
};
---
<BaseLayout meta={meta} current="/about" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'درباره ما', url: '/about' }])]}>
  <PageHero title="درباره کافه دانش" sub="رویکرد، فرایند و استانداردهای اجرای پروژه در استودیوی کافه دانش." />

  <section class="section">
    <div class="container about-intro-wrap">
      <figure class="about-cover">
        <img src="/img/ai/about-team.webp" alt="فضای کاری تیم کافه دانش در حال بررسی طراحی و توسعه وب‌سایت" width="1200" height="680" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
      <div class="about-intro">
        <span class="about-eyebrow">استودیوی طراحی و توسعه وب‌سایت</span>
        <h2>از تحلیل نیاز تا تحویل یک وب‌سایت قابل توسعه</h2>
        <p>کافه‌دانش استودیوی طراحی و توسعه وب‌سایت است. هر پروژه با تحلیل نیاز و معماری اطلاعات آغاز می‌شود و با طراحی رابط کاربری، کدنویسی استاندارد و توجه به سرعت و سئو به مرحله تحویل می‌رسد. تمرکز اصلی ما طراحی سایت شرکتی، فروشگاه اینترنتی و وب‌سایت اختصاصی است؛ سئو و تولید محتوا نیز خدمات مکمل‌اند.</p>
        <ul class="about-intro__points">
          {introPrinciples.map((item) => (
            <li>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container about-core">
      <Blocks blocks={coreBlocks} />
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container about-location">
      <figure class="about-location__media">
        <img src="/img/ai/hero-team.webp" alt="تیم کافه دانش در حال بررسی و برنامه‌ریزی پروژه‌های طراحی وب‌سایت" width="960" height="640" loading="lazy" decoding="async" />
      </figure>
      <div class="about-location__copy">
        <Blocks blocks={locationBlocks} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-duo">
      <section class="about-duo__panel" aria-labelledby="about-reasons-title">
        <div class="about-duo__head">
          <h2 id="about-reasons-title">{blocks[reasonsIdx]?.x || 'پنج دلیل که نتیجه کار را متمایز می‌کند'}</h2>
        </div>
        <div class="about-duo__list">
          {reasons.map((item, i) => (
            <article class="about-point">
              <span class="about-point__num">{new Intl.NumberFormat('fa-IR').format(i + 1)}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </section>
      <section class="about-duo__panel" aria-labelledby="about-steps-title">
        <div class="about-duo__head">
          <h2 id="about-steps-title">{blocks[stepsIdx]?.x || 'شش مرحله شفاف، از درخواست تا تحویل'}</h2>
        </div>
        <div class="about-duo__list">
          {steps.map((item, i) => (
            <article class="about-point about-point--step">
              <span class="about-point__num">{new Intl.NumberFormat('fa-IR').format(i + 1)}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <CtaBand title={ctaTitle || undefined} sub={ctaSub || undefined} />
</BaseLayout>

<style>
  .about-intro-wrap { display: grid; gap: clamp(22px, 3vw, 34px); }
  .about-cover { width: 100%; height: clamp(260px, 39vw, 500px); margin: 0; overflow: hidden; border-radius: 24px; box-shadow: var(--shadow-card); background: var(--lavender); }
  .about-cover img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 44%; }
  .about-intro { max-width: 1080px; width: 100%; margin-inline: auto; }
  .about-eyebrow { display: inline-flex; color: var(--pink-dark); font-size: .86rem; font-weight: 800; margin-bottom: 6px; }
  .about-intro h2 { color: var(--navy); font-size: clamp(1.35rem, 2.5vw, 1.8rem); margin: 0 0 10px; }
  .about-intro p { color: var(--body); font-size: 1.04rem; line-height: 2.1; margin: 0; }
  .about-intro__points { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; list-style: none; padding: 0; margin: 22px 0 0; }
  .about-intro__points li { display: flex; align-items: flex-start; gap: 9px; padding: 14px; background: #fff; border: 1px solid var(--line); border-radius: 13px; color: var(--navy); font-size: .9rem; font-weight: 700; line-height: 1.9; }
  .about-intro__points svg { flex: none; color: var(--mint-ink); margin-top: 3px; }
  .about-core { width: 100%; }
  .about-core .prose,.about-location .prose { max-width: 100%; width: 100%; margin-inline: 0; }
  .about-location {
    width: 100%; display: grid;
    grid-template-columns: minmax(0,.78fr) minmax(0,1.22fr);
    align-items: center; gap: clamp(28px,3vw,44px); direction: ltr;
  }
  .about-location__media {
    min-width: 0; width: 100%; height: clamp(280px,25vw,360px);
    margin: 0; overflow: hidden; border-radius: 22px;
    background: var(--lavender); box-shadow: var(--shadow-card);
  }
  .about-location__media img {
    display: block; width: 100%; height: 100%; min-height: 0;
    object-fit: cover; object-position: center 44%;
  }
  .about-location__copy { min-width: 0; direction: rtl; }
  .about-location .prose h2 { margin-top: 0; }
  .about-duo { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 26px; align-items: stretch; }
  .about-duo__panel { min-width: 0; padding: clamp(24px,2.8vw,36px); border-radius: 22px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-soft); }
  .about-duo__head { margin-bottom: 22px; }
  .about-duo__head > span { color: var(--pink-dark); font-size: .82rem; font-weight: 800; }
  .about-duo__head h2 { color: var(--navy); font-size: clamp(1.18rem,1.8vw,1.52rem); line-height: 1.75; margin: 5px 0 0; }
  .about-duo__list { display: grid; gap: 17px; }
  .about-point { display: grid; grid-template-columns: 38px minmax(0,1fr); gap: 13px; align-items: start; }
  .about-point__num { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--lavender); color: var(--purple); font-weight: 900; font-size: .9rem; }
  .about-point h3 { color: var(--navy); font-size: .98rem; line-height: 1.7; margin: 0 0 4px; }
  .about-point p { color: var(--mut); font-size: .88rem; line-height: 1.95; margin: 0; }
  .about-point--step .about-point__num { background: var(--peach); color: var(--pink-dark); }
  @media (max-width: 920px) {
    .about-duo, .about-location { grid-template-columns: minmax(0,1fr); }
    .about-intro__points { grid-template-columns: minmax(0,1fr); }
    .about-location__media { height: clamp(220px,56vw,280px); }
    .about-location__media img { min-height: 0; }
  }
</style>