---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "کافه‌دانش | طراحی سایت، سئو و هوش مصنوعی برای رشد واقعی کسب‌وکار";
const description = "استودیو دیجیتال کافه‌دانش: طراحی سایت اختصاصی، سئو تکنیکال و محتوایی، تولید مقالات تخصصی و راهکارهای هوش مصنوعی — همه در یک تیم.";
const canonical = "https://cdanesh.ir/";
---

<SiteLayout title={title} description={description} canonical={canonical}>
<!-- ═══ هیرو ═══ -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow reveal in">استودیو دیجیتال کافه‌دانش</span>
        <h1 class="h1 reveal in">سایت، محتوا و هوش مصنوعی؛<br>سه موتور <span class="gold">رشد کسب‌وکار</span> شما</h1>
        <p class="lead reveal in" data-delay="1">سایتی که برند شما را معرفی می‌کند، محتوایی که مخاطب را می‌آورد و ابزارهایی که کارهای تکراری را حذف می‌کنند — همه را یک تیم، با یک نقشه راه و تحویل مرحله‌به‌مرحله انجام می‌دهد.</p>
        <div class="hero-ctas reveal in" data-delay="2">
          <a class="btn btn-gold btn-lg" href="request.html">درخواست مشاوره رایگان
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="portfolio.html">مشاهده نمونه‌کارها</a>
        </div>
        <div class="hero-pills reveal in" data-delay="3">
          <span class="chip">طراحی اختصاصی، نه قالب آماده</span>
          <span class="chip">سئوی اصولی و قابل توضیح</span>
          <span class="chip">پشتیبانی واقعی پس از تحویل</span>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-orbit"></div>
        <span class="orbit-tag" style="top:2%; inset-inline-start:38%">طراحی <b>UI/UX</b></span>
        <span class="orbit-tag" style="top:26%; inset-inline-start:-2%">سئو <b>تکنیکال</b></span>
        <span class="orbit-tag" style="top:26%; inset-inline-end:0%">محتوای <b>تخصصی</b></span>
        <span class="orbit-tag" style="bottom:4%; inset-inline-start:30%">هوش مصنوعی <b>کاربردی</b></span>
        <div class="hero-frame">
          <div class="frame-bar"><i></i><i></i><i></i><span class="frame-url">cdanesh.ir — نمونه طراحی</span></div>
          <div class="mock">
            <div class="mock-nav"><span class="mock-logo"></span><i></i><i></i><i></i><span class="mock-btn"></span></div>
            <div class="mock-hero"><b></b><b></b><i></i><i></i><i style="width:60%"></i><span class="mock-cta"></span></div>
            <div class="mock-cards"><i></i><i></i><i></i></div>
          </div>
        </div>
        <div class="float-chip fc-1">
          <span class="fc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4 20 9.5 9.5 20 4 20 4 14.5Z"/></svg></span>
          <span><b>تحویل مرحله‌ای</b><span>پیشرفت پروژه شفاف و قابل پیگیری</span></span>
        </div>
        <div class="float-chip fc-2">
          <span class="fc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10L5.6 18.4"/><circle cx="12" cy="12" r="3.5"/></svg></span>
          <span><b>ابزارهای هوشمند</b><span>اتوماسیون و دستیارهای اختصاصی</span></span>
        </div>
      </div>
    </div>

    <!-- نوار اعتماد -->
    <div class="trustbar reveal">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <div><b>طراحی اختصاصی</b><span>سایت شما کپی هیچ قالبی نیست</span></div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v6c0 5 3.8 8.4 9 10 5.2-1.6 9-5 9-10V7l-9-5Z"/><path d="m9 12 2 2 4-4"/></svg>
        <div><b>شفافیت کامل</b><span>محدوده کار و زمان‌بندی از روز اول مشخص است</span></div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <div><b>تحویل مرحله‌ای</b><span>هر مرحله با تأیید شما جلو می‌رود</span></div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4 20 9.5 9.5 20 4 20 4 14.5Z"/></svg>
        <div><b>مالکیت کامل</b><span>کد، محتوا و دسترسی‌ها متعلق به شماست</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ توانمندی‌ها (بنتو) ═══ -->
<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">توانمندی‌ها</span>
      <h2 class="h2">تمام حلقه‌های حضور دیجیتال، در یک تیم</h2>
      <p class="lead">به‌جای هماهنگ‌کردن چند پیمانکار جدا، کل زنجیره از طراحی تا محتوا و اتوماسیون را یک تیم و با یک زبان مشترک پیش می‌برد.</p>
    </div>
    <div class="bento">
      <article class="bento-card b-wide b-gold reveal">
        <span class="bento-num">۰۱</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M8 21V9"/></svg></div>
        <h3>طراحی سایت اختصاصی</h3>
        <p>سایت شما از صفر برای برند و اهداف خودتان طراحی می‌شود؛ نه یک قالب آماده با اسم شما. نتیجه: تمایز واقعی در بازار.</p>
        <div class="mini-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </article>
      <article class="bento-card b-slim b-deep reveal" data-delay="1">
        <span class="bento-num">۰۲</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></div>
        <h3>سئو تکنیکال و محتوایی</h3>
        <p>از سرعت و ساختار فنی تا انتخاب کلمه کلیدی و معماری محتوا.</p>
        <div class="mini-type" aria-hidden="true"><b>Aa</b><span class="dots"><i></i><i></i><i></i><i></i></span></div>
      </article>
      <article class="bento-card b-third reveal">
        <span class="bento-num">۰۳</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></div>
        <h3>تولید محتوای تخصصی</h3>
        <p>مقالات ساختاریافته با تحقیق واقعی؛ محتوایی که هم کاربر را پاسخ می‌دهد و هم موتور جست‌وجو را.</p>
      </article>
      <article class="bento-card b-third reveal" data-delay="1">
        <span class="bento-num">۰۴</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4m8-4v4M3 10h18M8 15h3"/></svg></div>
        <h3>استراتژی و تقویم محتوایی</h3>
        <p>نقشه راه انتشار منظم؛ تا وبلاگ شما از «نوشته‌های پراکنده» به یک دارایی تبدیل شود.</p>
      </article>
      <article class="bento-card b-third reveal" data-delay="2">
        <span class="bento-num">۰۵</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"/></svg></div>
        <h3>عملکرد و تجربه کاربری</h3>
        <p>سرعت، دسترس‌پذیری و روانی تعامل؛ سنجه‌هایی که هم کاربر حس می‌کند و هم گوگل اندازه می‌گیرد.</p>
      </article>
      <article class="bento-card b-half b-deep reveal">
        <span class="bento-num">۰۶</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M2 14h2m16 0h2M15 13v2m-6-2v2"/></svg></div>
        <h3>هوش مصنوعی و اتوماسیون</h3>
        <p>دستیارهای هوشمند، ابزارهای تولید محتوا و خودکارسازی کارهای تکراری؛ با اتصال امن سمت سرور و بازبینی انسانی.</p>
        <div class="mini-orbit" aria-hidden="true"></div>
      </article>
      <article class="bento-card b-half reveal" data-delay="1">
        <span class="bento-num">۰۷</span>
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/><path d="M12 7v5l3 3"/></svg></div>
        <h3>پشتیبانی و توسعه مداوم</h3>
        <p>سایت پس از انتشار «تمام‌شده» نیست؛ نگهداری امنیتی، به‌روزرسانی و توسعه قابلیت‌های جدید ادامه مسیر است.</p>
      </article>
    </div>
  </div>
</section>

<!-- ═══ مزیت‌ها (چرا کافه‌دانش) ═══ -->
<section class="section" id="why" style="padding-top:30px">
  <div class="wrap">
    <div class="why-grid">
      <div class="reveal">
        <span class="eyebrow">مزیت‌های همکاری با ما</span>
        <h2 class="h2" style="margin-bottom:26px">پنج دلیل که نتیجه کار را <span class="gold">متمایز می‌کند</span></h2>
        <div class="why-rows">
          <div class="why-row">
            <span class="why-num">۰۱</span>
            <div><b>طراحی متناسب با نیاز کسب‌وکار شما</b><p>قبل از هر خط کد، کسب‌وکار، مخاطب و هدف شما تحلیل می‌شود؛ نتیجه سایتی است که برای «شما» ساخته شده، نه برای همه.</p></div>
          </div>
          <div class="why-row">
            <span class="why-num">۰۲</span>
            <div><b>تجربه کاربری و نمایش درست در موبایل</b><p>بیشتر بازدیدها از گوشی است؛ هر صفحه برای موبایل، تبلت و دسکتاپ جداگانه تست می‌شود، نه فقط «کوچک‌شده» است.</p></div>
          </div>
          <div class="why-row">
            <span class="why-num">۰۳</span>
            <div><b>زیرساخت فنی و سئوی اصولی از روز اول</b><p>سرعت، ساختار استاندارد و آماده‌بودن برای موتور جست‌وجو جزو تحویل اولیه است؛ بعداً هزینه اضافه برای «اصلاح زیرساخت» نمی‌پردازید.</p></div>
          </div>
          <div class="why-row">
            <span class="why-num">۰۴</span>
            <div><b>قابلیت توسعه و مدیریت محتوا</b><p>پنل مدیریتی کامل با آموزش؛ محتوای جدید خودتان منتشر کنید و قابلیت‌های جدید بدون بازسازی اضافه شوند.</p></div>
          </div>
          <div class="why-row">
            <span class="why-num">۰۵</span>
            <div><b>استفاده هدفمند از هوش مصنوعی</b><p>جایی که واقعاً ارزش دارد: پاسخ‌گویی، تولید پیش‌نویس و خودکارسازی کار تکراری — با بازبینی انسانی، نه جایگزینی کیفیت.</p></div>
          </div>
        </div>
      </div>
      <div class="why-visual reveal" data-delay="1">
        <div class="why-ring" aria-hidden="true"></div>
        <div class="why-stat-card">
          <div class="num" data-count="12" data-suffix="">۰</div>
          <div class="lbl">خدمت تخصصی در یک تیم واحد</div>
          <div class="row"><span>صفحه تخصصی خدمات</span><b>۴</b></div>
          <div class="row"><span>ابزار هوشمند محتوا</span><b>۸</b></div>
          <div class="row"><span>مرحله فرایند همکاری</span><b>۶</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ خدمات اصلی: ۸ دسته ═══ -->
<section class="section" id="services" style="padding-top:30px">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">خدمات ما</span>
      <h2 class="h2">هشت خدمت تخصصی، هشت صفحه اختصاصی</h2>
      <p class="lead">هر خدمت صفحه اختصاصی و محتوای کامل خودش را دارد؛ می‌توانید هر کدام را مستقل سفارش دهید یا ترکیبی سفارش بدهید.</p>
    </div>
    <div class="svc-grid8">
      <a class="svc-mini reveal" href="web-design.html#corporate">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M4 21h16M8 7h2m4 0h2M8 11h2m4 0h2M8 15h2m4 0h2"/></svg></div>
        <h3>طراحی سایت شرکتی</h3>
        <p>حضور حرفه‌ای برای معرفی خدمات، پروژه‌ها و تیم شرکت شما.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="e-commerce.html" data-delay="1">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.6"/><circle cx="17" cy="20" r="1.6"/><path d="M3 3h2l2.6 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6"/></svg></div>
        <h3>طراحی فروشگاه اینترنتی</h3>
        <p>تجربه خرید روان، درگاه پرداخت و صفحه محصول تبدیل‌محور.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="speed-optimization.html" data-delay="2">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
        <h3>بهینه‌سازی سرعت و عملکرد</h3>
        <p>Core Web Vitals، تصاویر و زیرساخت؛ سایتی که سریع جواب می‌دهد.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="uiux.html" data-delay="3">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg></div>
        <h3>طراحی رابط و تجربه کاربری</h3>
        <p>مسیر کاربر مهندسی می‌شود تا هر صفحه به هدف خودش برسد.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="seo.html">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg></div>
        <h3>سئو تکنیکال و محتوایی</h3>
        <p>زیرساخت فنی استاندارد و انتخاب هوشمندانه کلمات کلیدی.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="content-production.html" data-delay="1">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></div>
        <h3>تولید مقالات سئومحور</h3>
        <p>مقالات تخصصی با تحقیق واقعی و ساختار استاندارد انتشار.</p>
        <span class="link-more">جزئیات خدمت <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M19 12H5m7-7-7 7 7 7"/></svg></span>
      </a>
      <a class="svc-mini reveal" href="support.html" data-delay="2">
        <div class="bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4m8-4v4M3 10h18M8 15h3"/></svg></div>
        <h3>پشتیبانی و نگهداری سایت</h3>
