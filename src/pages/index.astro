---
// صفحه اصلی کافه دانش — Hero با خط منحنی، عکس انسان و داشبورد + تمام بخش‌های سایت فعلی
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPosts, getPortfolio, CAPS, PROS, SERVICE_CARDS, STEPS, PRICING, HOME_FOUR, MARQUEE_ITEMS, SITE, svcImg } from '../lib/content';
import { jsonLdFaq, jsonLdBreadcrumb } from '../lib/seo';
import { getFaq } from '../lib/content';

const posts = await getPosts();
const portfolio = await getPortfolio();
const faq = getFaq();
const latestPosts = posts.slice(0, 3);
const showPf = portfolio.filter((p) => p.status === 'published').slice(0, 6);

const marqueeItems = [...MARQUEE_ITEMS, ...MARQUEE_ITEMS];

const meta = {
  title: 'طراحی سایت و تولید محتوا در بوشهر | کافه دانش',
  description: 'کافه دانش (Cafe Danesh) با تمرکز بر طراحی سایت اختصاصی و تولید محتوای تخصصی فعالیت می‌کند؛ خدمات سئو نیز برای بهبود دیده‌شدن سایت ارائه می‌شود.',
  path: '/',
};
---
<BaseLayout meta={meta} current="/" extraJsonLd={[jsonLdFaq(faq), jsonLdBreadcrumb([{ name: 'خانه', url: '/' }])]}>
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero" id="top" aria-label="معرفی کافه دانش">
    <!-- خط منحنی عبوری از وسط Hero — به سبک ساسمیکس -->
    <svg class="hero__ribbon" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M-90 470 C 260 200, 640 640, 950 430 S 1400 260, 1560 400" stroke="rgba(11,18,51,0.20)" stroke-width="170" fill="none" stroke-linecap="round" />
      <path d="M-70 640 C 320 420, 760 720, 1120 560 S 1460 470, 1560 590" stroke="rgba(255,255,255,0.10)" stroke-width="88" fill="none" stroke-linecap="round" />
      <path d="M-60 160 C 420 380, 900 90, 1520 300" stroke="rgba(255,255,255,0.08)" stroke-width="62" fill="none" stroke-linecap="round" />
    </svg>
    <span class="hero__glow hero__glow--1" aria-hidden="true"></span>
    <span class="hero__glow hero__glow--2" aria-hidden="true"></span>
    <svg class="hero__sparkle" style="top:14%;left:6%" width="30" height="30" viewBox="0 0 24 24" fill="#FFD7E8" aria-hidden="true"><path d="M12 0c.9 6.7 4.4 10.2 12 12-7.6 1.8-11.1 5.3-12 12-.9-6.7-4.4-10.2-12-12C7.6 10.2 11.1 6.7 12 0Z"/></svg>
    <svg class="hero__sparkle hero__sparkle--b" style="top:60%;right:4%" width="22" height="22" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M12 0c.9 6.7 4.4 10.2 12 12-7.6 1.8-11.1 5.3-12 12-.9-6.7-4.4-10.2-12-12C7.6 10.2 11.1 6.7 12 0Z"/></svg>

    <div class="container hero__grid">
      <div class="hero__content">
        <h1 class="hero__title" data-reveal="up">
          سایت، محتوا و هوش مصنوعی؛<br />
          <span class="hero__mark">سه موتور رشد</span> کسب‌وکار شما
        </h1>
        <p class="hero__text" data-reveal="up" data-delay="120">
          سایتی که برند شما را معرفی می‌کند، محتوایی که مخاطب را می‌آورد و ابزارهایی که کارهای تکراری را حذف می‌کنند — همه را یک تیم، با یک نقشه راه و تحویل مرحله‌به‌مرحله انجام می‌دهد.
        </p>
        <div class="hero__btns" data-reveal="up" data-delay="240">
          <a href="/consult" class="btn btn--lg">درخواست مشاوره رایگان</a>
          <a href="/portfolio" class="btn btn--ghost btn--lg">
            مشاهده نمونه‌کارها
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6" /></svg>
          </a>
        </div>
        <ul class="hero__points" data-reveal="up" data-delay="340">
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg> طراحی اختصاصی، نه قالب آماده</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg> سئوی اصولی و قابل توضیح</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg> پشتیبانی واقعی پس از تحویل</li>
        </ul>
      </div>

      <div class="hero__media" data-reveal="zoom" data-delay="200">
        <!-- داشبورد ماکاپ — مانند سایت فعلی -->
        <div class="hero__dash" role="img" aria-label="پیش‌نمایش نمایشی داشبورد مدیریت سایت کافه دانش">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#f6f7fd;border-bottom:1px solid var(--line)">
            <span style="display:inline-flex;gap:6px" aria-hidden="true">
              <i style="width:10px;height:10px;border-radius:50%;background:#ff5f57"></i>
              <i style="width:10px;height:10px;border-radius:50%;background:#febc2e"></i>
              <i style="width:10px;height:10px;border-radius:50%;background:#28c840"></i>
            </span>
            <span dir="ltr" style="font-size:.72rem;color:var(--mut);background:#fff;border:1px solid var(--line);border-radius:99px;padding:2px 12px">panel.cdanesh.ir</span>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:14px 16px 4px">
            <div style="border-radius:10px;background:var(--peach);padding:10px 12px">
              <small style="color:var(--mut);font-size:.68rem">بازدید امروز</small>
              <b style="display:block;color:var(--navy);font-size:1.05rem">۱,۲۴۸</b>
            </div>
            <div style="border-radius:10px;background:var(--lavender);padding:10px 12px">
              <small style="color:var(--mut);font-size:.68rem">درخواست جدید</small>
              <b style="display:block;color:var(--purple);font-size:1.05rem">۱۸</b>
            </div>
            <div style="border-radius:10px;background:var(--mint);padding:10px 12px">
              <small style="color:var(--mut);font-size:.68rem">پروژه فعال</small>
              <b style="display:block;color:var(--mint-ink);font-size:1.05rem">۷</b>
            </div>
          </div>
          <div style="padding:10px 16px 16px">
            <p style="font-size:.74rem;color:var(--navy);font-weight:700;margin:0 0 8px">روند بازدید هفته گذشته <span style="color:var(--mut);font-weight:500">(۷ روز)</span></p>
            <div style="display:flex;align-items:flex-end;gap:7px;height:88px" aria-hidden="true">
              {[38, 62, 46, 74, 52, 88, 66].map((h, i) => (
                <span style={`flex:1;height:${h}%;border-radius:6px 6px 3px 3px;background:${i % 2 ? 'var(--grad-btn-hover)' : 'linear-gradient(to top,#ece2fd,var(--purple-light))'}`}></span>
              ))}
            </div>
            <div style="margin-top:12px;display:grid;gap:7px">
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:.72rem;color:var(--navy);background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px">
                <span>مقاله جدید منتشر شد</span><span class="badge badge--ok">انجام شد</span>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:.72rem;color:var(--navy);background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px">
                <span>درخواست مشاوره جدید</span><span class="badge badge--soon">در انتظار</span>
              </div>
            </div>
          </div>
        </div>

        <!-- عکس انسانی: تیم کافه دانش در محیط کار -->
        <figure class="hero__photo-ring" style="margin:0">
          <img
            src="/img/ai/hero-team.webp"
            alt="تیم کافه دانش در حال بررسی طراحی سایت با لپ‌تاپ در استودیو"
            width="480" height="571"
            fetchpriority="high" decoding="async"
          />
        </figure>

        <!-- کارت‌های شناور -->
        <div class="hero__chip hero__chip--a" aria-hidden="true">
          <span class="hero__chip-ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z" /><path d="m2 17 10 5 10-5M2 12l10 5 10-5" /></svg>
          </span>
          <span>طراحی <b>UI/UX</b>، سئو <b>تکنیکال</b>، محتوای <b>تخصصی</b><small>سه تخصص، یک تیم واحد</small></span>
        </div>
        <div class="hero__chip hero__chip--b" aria-hidden="true">
          <span class="hero__chip-ico" style="background:var(--mint);color:var(--mint-ink)">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
          </span>
          <span>{SITE.url.replace('https://', '')} — نمونه طراحی<small>تحویل مرحله‌ای و شفاف</small></span>
        </div>
      </div>
    </div>

    <div class="hero__trust">
      <div class="container hero__trust-inner" data-reveal="up" data-delay="420">
        <span>✳ <b>تحویل مرحله‌ای</b> — پیشرفت پروژه شفاف و قابل پیگیری</span>
        <span>✳ <b>ابزارهای هوشمند</b> — اتوماسیون و دستیارهای اختصاصی</span>
        <span>✳ <b>مالکیت کامل</b> — کد، محتوا و دسترسی‌ها متعلق به شماست</span>
      </div>
    </div>
  </section>

  <!-- نوار متحرک پروژه‌ها -->
  <div class="marquee marquee--hero" style="background:var(--grad-hero);padding-bottom:22px;margin-top:-2px" aria-hidden="true">
    <div class="marquee__track">
      {marqueeItems.map((m) => (
        <span class="marquee__item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.9 6.7 4.4 10.2 12 12-7.6 1.8-11.1 5.3-12 12-.9-6.7-4.4-10.2-12-12C7.6 10.2 11.1 6.7 12 0Z" /></svg>
          {m}
        </span>
      ))}
    </div>
  </div>

  <!-- ═══════════ نوار آمار ═══════════ -->
  <section class="section--tight" aria-label="آمار کافه دانش در یک نگاه">
    <div class="container">
      <div class="stats">
        <div class="stat" data-reveal="up">
          <span class="stat__ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z" /><path d="m2 17 10 5 10-5M2 12l10 5 10-5" /></svg></span>
          <p class="stat__num"><span data-count="8">۰</span></p>
          <p class="stat__label">خدمت تخصصی در یک تیم واحد</p>
        </div>
        <div class="stat" data-reveal="up" data-delay="120">
          <span class="stat__ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" /></svg></span>
          <p class="stat__num"><span data-count="7">۰</span></p>
          <p class="stat__label">توانمندی اصلی تیم</p>
        </div>
        <div class="stat" data-reveal="up" data-delay="240">
          <span class="stat__ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" /></svg></span>
          <p class="stat__num"><span data-count="6">۰</span></p>
          <p class="stat__label">مرحلهٔ شروع همکاری</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ توانمندی‌ها ═══════════ -->
  <section class="section bg-soft" aria-labelledby="caps-title">
    <div class="container">
      <SectionHead tag="توانمندی‌ها" title="تمام حلقه‌های حضور دیجیتال، در یک تیم" sub="به‌جای هماهنگ‌کردن چند پیمانکار جدا، کل زنجیره از طراحی تا محتوا و اتوماسیون را یک تیم و با یک زبان مشترک پیش می‌برد." />
      <div class="cap-grid">
        {CAPS.map((c, i) => (
          <div class="cap" data-reveal="up" data-delay={String(i * 70)}>
            <span class="cap__num" aria-hidden="true">{new Intl.NumberFormat('fa-IR').format(i + 1).padStart(2, '۰')}</span>
            <div>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ مزیت‌ها ═══════════ -->
  <section class="section" aria-labelledby="pros-title">
    <div class="container" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:clamp(28px,5vw,60px);align-items:start">
      <div>
        <SectionHead tag="مزیت‌های همکاری با ما" title="پنج دلیل که نتیجه کار را متمایز می‌کند" />
        <img src="/img/ai/about-team.webp" alt="تیم کافه دانش در استودیو هنگام جلسه طراحی" width="672" height="384" loading="lazy" decoding="async" style="border-radius:var(--r-lg);box-shadow:var(--shadow-card)" />
      </div>
      <ul class="pro-list" style="margin-top:8px">
        {PROS.map((p, i) => (
          <li class="pro" data-reveal="left" data-delay={String(i * 80)}>
            <span class="pro__num" aria-hidden="true"></span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════ خدمات ═══════════ -->
  <section class="section bg-lavender" aria-labelledby="svc-title">
    <div class="container">
      <SectionHead tag="خدمات ما" title="هشت خدمت تخصصی، هشت صفحه اختصاصی" sub="هر خدمت صفحه اختصاصی و محتوای کامل خودش را دارد؛ می‌توانید هر کدام را مستقل سفارش دهید یا ترکیبی سفارش بدهید." center />
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px" class="svc-grid">
        {SERVICE_CARDS.map((s, i) => (
          <a href={`/services/${s.slug}`} class="svc-card" data-reveal="up" data-delay={String((i % 4) * 80)} style="color:inherit">
            <div class="svc-card__media">
              <img src={svcImg(s.slug)} alt={`${s.t} — خدمت کافه دانش`} width="480" height="300" loading="lazy" decoding="async" />
              <span class="svc-card__cat">{s.cat}</span>
            </div>
            <div class="svc-card__body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <span class="svc-card__more">
                جزئیات خدمت
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ خدمات از نزدیک ═══════════ -->
  <section class="section" aria-labelledby="svc4-title">
    <div class="container">
      <SectionHead tag="خدمات، از نزدیک" title="هر خدمت دقیقاً چه تغییری در کسب‌وکار شما می‌سازد؟" sub="چهار حوزه اصلی کار ما — با نگاه کاربردی به «قبل و بعد» آن برای کسب‌وکار شما." />
      <div style="display:grid;gap:clamp(22px,3vw,34px)">
        {HOME_FOUR.map((h, i) => (
          <div style={`display:grid;grid-template-columns:${i % 2 ? '1.1fr 0.9fr' : '0.9fr 1.1fr'};gap:clamp(20px,4vw,48px);align-items:center`} class="home-four-row" data-reveal="up">
            <div style={`order:${i % 2 ? 2 : 1}`}>
              <span class="section-head__tag" style="font-size:.85rem">{h.chip}</span>
              <h2 style="font-size:clamp(1.2rem,2.4vw,1.7rem)">{h.h}</h2>
              <p style="color:var(--mut)">{h.d}</p>
              <ul style="list-style:none;padding:0;margin:14px 0 20px;display:grid;gap:8px">
                {h.items.map((it) => (
                  <li style="display:flex;gap:9px;align-items:flex-start;font-size:.94rem">
                    <svg style="flex:none;margin-top:6px" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--mint-ink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                    {it}
                  </li>
                ))}
              </ul>
              <a href={h.href} class="btn">{h.cta}</a>
            </div>
            <img src={h.cover} alt={`${h.chip} در کافه دانش — تصویر تیم در حال کار`} width="576" height="432" loading="lazy" decoding="async" style={`border-radius:var(--r-lg);box-shadow:var(--shadow-float);order:${i % 2 ? 1 : 2};aspect-ratio:4/3;object-fit:cover;width:100%`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ پکیج‌ها ═══════════ -->
  <section class="section bg-soft" aria-labelledby="pricing-title">
    <div class="container">
      <SectionHead tag="پکیج‌های طراحی سایت" title="قیمت شفاف و ثابت؛ بدون هزینه پنهان" sub="دامنهٔ کار هر پکیج دقیقاً مشخص است: تعداد صفحات، زمان تحویل و مدت پشتیبانی رایگان. برای پروژه‌های بزرگ‌تر، پکیج اختصاصی با برآورد شفاف پیشنهاد می‌شود." center />
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px" class="price-grid">
        {PRICING.map((p, i) => (
          <article class="card" style={`padding:26px 22px;display:flex;flex-direction:column;gap:10px;${p.featured ? 'border:2px solid var(--pink);position:relative' : ''}`} data-reveal="up" data-delay={String(i * 90)}>
            {p.featured && <span class="badge" style="position:absolute;top:-13px;right:20px;background:var(--pink);color:#fff">پیشنهاد ما</span>}
            <span class="section-head__tag" style="font-size:.8rem">{p.badge}</span>
            <h3 style="font-size:1.25rem;margin:0">{p.name}</h3>
            <p style="color:var(--mut);font-size:.88rem;margin:0">{p.desc}</p>
            <p style="margin:8px 0 0"><b style="font-size:1.15rem;color:var(--navy)">{p.price}</b><br /><small style="color:var(--mut)">{p.note}</small></p>
            <ul style="list-style:none;padding:0;margin:6px 0;display:grid;gap:7px;font-size:.88rem">
              {p.features.map((f) => (
                <li style="display:flex;gap:8px;align-items:flex-start">
                  <svg style="flex:none;margin-top:5px" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--mint-ink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href={`/consult?package=${p.key}`} class="btn" style="margin-top:auto;justify-content:center">درخواست این پکیج</a>
            <small style="color:var(--mut);text-align:center">{p.foot}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ نمونه‌کارها ═══════════ -->
  <section class="section" aria-labelledby="pf-title">
    <div class="container">
      <SectionHead tag="نمونه‌کارها" title="موس را روی کارت نگه دارید؛ کل صفحه مرور می‌شود" sub="در این بخش فقط پروژه‌هایی را می‌بینید که نسخه آنلاین و منتشرشده دارند؛ برای مشاهده جزئیات و نمونه کامل، هر کارت را باز کنید." />
      <div class="pf-grid">
        {showPf.map((p, i) => (
          <PortfolioCard item={p} delay={String((i % 3) * 90)} />
        ))}
      </div>
      <div style="text-align:center;margin-top:36px" data-reveal="up">
        <a href="/portfolio" class="btn btn--outline btn--lg">مشاهده همه نمونه‌کارها (با فیلتر دسته‌بندی)</a>
      </div>
    </div>
  </section>

  <!-- ═══════════ مراحل همکاری ═══════════ -->
  <section class="section bg-lavender" aria-labelledby="steps-title">
    <div class="container">
      <SectionHead tag="مسیر شروع همکاری" title="شش مرحله شفاف، از درخواست تا تحویل" sub="در هر گام می‌دانید کجا هستید، چه چیزی تحویل می‌گیرید و گام بعدی چیست." center />
      <div class="steps">
        {STEPS.map((s, i) => (
          <div class="step" data-reveal="up" data-delay={String((i % 3) * 90)}>
            <span class="step__line" aria-hidden="true"></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ مجله ═══════════ -->
  <section class="section" aria-labelledby="blog-title">
    <div class="container">
      <SectionHead tag="مجله کافه‌دانش" title="خواندنی‌های تخصصی دیجیتال" sub="هر هفته یک مطلب کاربردی درباره طراحی سایت، سئو، محتوا و هوش مصنوعی — به زبان ساده." />
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px" class="blog-grid">
        {latestPosts.map((p, i) => (
          <PostCard post={p} delay={String(i * 90)} />
        ))}
      </div>
      <div style="text-align:center;margin-top:34px" data-reveal="up">
        <a href="/blog" class="btn btn--outline btn--lg">مشاهده همه مقالات</a>
      </div>
    </div>
  </section>

  <!-- ═══════════ FAQ ═══════════ -->
  <section class="section bg-soft" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead tag="سؤالات متداول" title="قبل از شروع پروژه بهتر است بدانید" center />
      <div class="faq-wrap">
        {faq.map((f, i) => (
          <div class:list={['faq-item', { 'is-open': i === 0 }]} data-accordion-item data-reveal="up" data-delay={String(i * 60)}>
            <button class="faq-item__btn" type="button" data-accordion-btn aria-expanded={i === 0 ? 'true' : 'false'}>
              {f.q}
              <span class="faq-item__sign" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="faq-item__panel" data-accordion-panel aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="faq-item__panel-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:30px" data-reveal="up">
        <a href="/faq" class="btn btn--outline">مشاهده همه سؤالات متداول</a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style is:global>
  .svc-grid, .price-grid, .blog-grid, .home-four-row { grid-template-columns: 1fr; }
  @media (min-width: 700px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .price-grid { grid-template-columns: repeat(2, 1fr); }
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
    .home-four-row { grid-template-columns: 1fr !important; }
    .home-four-row img, .home-four-row > div { order: initial !important; }
  }
  @media (min-width: 1020px) {
    .svc-grid { grid-template-columns: repeat(4, 1fr); }
    .price-grid { grid-template-columns: repeat(4, 1fr); }
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
    .home-four-row { grid-template-columns: inherit !important; }
  }
</style>
