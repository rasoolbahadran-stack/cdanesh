---
/* صفحهٔ اصلی کافه‌دانش — ۱۳ بخش به سبک Porto SEO 2 با هویت اختصاصی */
import BaseLayout from '../layouts/BaseLayout.astro';
import { q } from '../lib/db';
import { getSiteSettings } from '../lib/seed';
import { faNum, enNum } from '../lib/persian';

interface Row {
  id: number;
  [k: string]: unknown;
}

const settings = await getSiteSettings();
const hp = settings.homepage;

const services = await q<Row>(`SELECT slug, title, short_desc, image FROM services WHERE status='published' ORDER BY sort_order`);
const projects = await q<Row>(`SELECT slug, title, summary, cover_image, tags, category FROM projects WHERE status='published' ORDER BY sort_order LIMIT 3`);
const plans = await q<Row>(`SELECT * FROM plans WHERE status='published' ORDER BY sort_order`);
const posts = await q<Row>(
  `SELECT p.slug, p.title, p.excerpt, p.cover_image, p.reading_time, p.published_at, c.name AS category
   FROM posts p LEFT JOIN categories c ON c.id = p.category_id
   WHERE p.status='published' ORDER BY p.published_at DESC LIMIT 3`,
);
const faqs = await q<Row>(`SELECT question, answer FROM faqs WHERE status='published' ORDER BY sort_order LIMIT 6`);
const testimonials = await q<Row>(`SELECT * FROM testimonials WHERE status='published' ORDER BY sort_order`);

/* اسکیما FAQ برای صفحهٔ اصلی */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: String(f.question),
    acceptedAnswer: { '@type': 'Answer', text: String(f.answer) },
  })),
};

const faNums = (s: string) => faNum(s);
---
<BaseLayout
  title={settings.seo.defaultTitle}
  description={settings.seo.defaultDescription}
  activePath="/"
  schema={[faqSchema]}
>
  {/* ─── ۱. هیرو ─── */}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="hero-badge anim-up"><i></i> استودیو دیجیتال کافه‌دانش — بوشهر</span>
        <h1 class="anim-up d-1">{hp.introTitle.split('؛')[0]}؛<br /><span class="grad-text">{hp.introTitle.split('؛')[1]}</span></h1>
        <p class="hero-sub anim-up d-2">{hp.introText}</p>
        <div class="hero-actions anim-up d-3">
          <a href="/consult" class="btn btn-gold btn-lg">درخواست مشاوره رایگان <i>←</i></a>
          <a href="/portfolio" class="btn btn-ghost-light btn-lg">مشاهده نمونه‌کارها</a>
        </div>
        <div class="hero-points anim-up d-4">
          <span><i>✓</i> طراحی اختصاصی، نه قالب آماده</span>
          <span><i>✓</i> سئوی اصولی و قابل توضیح</span>
          <span><i>✓</i> پشتیبانی واقعی پس از تحویل</span>
        </div>
      </div>
      <div class="hero-visual anim-up d-2">
        <img src="/img/hero-main.webp" alt="نمای سه‌بعدی استودیو دیجیتال کافه‌دانش؛ طراحی سایت، رشد کسب‌وکار و هوش مصنوعی" width="1440" height="720" fetchpriority="high" />
        <div class="hero-float hf-1" data-parallax="0.06">
          <i class="hf-ico">📈</i>
          <span>رشد ارگانیک<small>سئو و محتوای هدفمند</small></span>
        </div>
        <div class="hero-float hf-2" data-parallax="-0.05">
          <i class="hf-ico">🤖</i>
          <span>ابزارهای هوشمند<small>اتوماسیون کارهای تکراری</small></span>
        </div>
      </div>
    </div>
  </section>

  {/* ─── نوار ویژگی‌ها ─── */}
  <div class="strip">
    <div class="container strip-grid">
      <div class="strip-item"><i>🎯</i><div><b>تحویل مرحله‌ای</b><span>پیشرفت پروژه شفاف و قابل پیگیری</span></div></div>
      <div class="strip-item"><i>🧠</i><div><b>ابزارهای هوشمند</b><span>اتوماسیون و دستیارهای اختصاصی</span></div></div>
      <div class="strip-item"><i>✍️</i><div><b>طراحی اختصاصی</b><span>سایت شما کپی هیچ قالبی نیست</span></div></div>
      <div class="strip-item"><i>🤝</i><div><b>شفافیت کامل</b><span>محدوده کار و زمان‌بندی مشخص</span></div></div>
    </div>
  </div>

  {/* ─── ۲. معرفی کوتاه ─── */}
  <section class="sec sec-cream">
    <div class="container about-split">
      <div class="img-side" data-reveal="right">
        <img src="/img/about-studio.webp" alt="استودیو دیجیتال کافه‌دانش؛ محیط طراحی و توسعه" width="1152" height="864" loading="lazy" />
      </div>
      <div data-reveal="left">
        <span class="section-label">درباره کافه‌دانش</span>
        <h2 style="font-size:clamp(24px,3vw,34px)">تمام حلقه‌های حضور دیجیتال، در یک تیم</h2>
        <p style="color:var(--mut-light);font-size:16px">
          به‌جای هماهنگ‌کردن چند پیمانکار جدا، کل زنجیره از طراحی تا محتوا و اتوماسیون را یک تیم و با یک زبان مشترک پیش می‌برد.
          کافه‌دانش یک استودیو دیجیتال در بوشهر است که برای کسب‌وکارهای ایرانی سایت می‌سازد، محتوا تولید می‌کند و ابزارهای هوشمند می‌دهد — با نقشه راه شفاف و تحویل مرحله‌ای.
        </p>
        <div class="about-pts">
          <div class="about-pt"><i>✅</i><div><b>مالکیت کامل</b><span>کد، محتوا و دسترسی‌ها متعلق به شماست</span></div></div>
          <div class="about-pt"><i>✅</i><div><b>گزارش شفاف</b><span>می‌بینید چه کاری انجام شده و چه تغییری کرده</span></div></div>
          <div class="about-pt"><i>✅</i><div><b>مدیریت محتوا</b><span>پنل مدیریتی کامل با آموزش کاربری</span></div></div>
          <div class="about-pt"><i>✅</i><div><b>پشتیبانی واقعی</b><span>پاسخ‌گویی مشخص، بدون بلاتکلیفی</span></div></div>
        </div>
        <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
          <a href="/about" class="btn btn-ghost">بیشتر درباره ما</a>
          <a href="/consult" class="btn btn-gold">شروع پروژه</a>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ۳. خدمات اصلی ─── */}
  <section class="sec sec-paper">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">خدمات ما</span>
        <h2>هشت خدمت تخصصی، هشت صفحه اختصاصی</h2>
        <p>هر خدمت صفحه اختصاصی و محتوای کامل خودش را دارد؛ می‌توانید هر کدام را مستقل سفارش دهید یا ترکیبی سفارش بدهید.</p>
      </div>
      <div class="grid-4">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}`} class="svc-card" data-reveal style={`--rd:${(i % 4) * 70}ms`}>
            <div class="svc-thumb">
              <img src={String(s.image)} alt={`خدمت ${s.title} — کافه‌دانش`} width="1152" height="864" loading="lazy" />
            </div>
            <div class="svc-body">
              <h3>{s.title}</h3>
              <p>{s.short_desc}</p>
              <span class="svc-link">جزئیات خدمت <i>←</i></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ─── ۴. مزیت‌های همکاری ─── */}
  <section class="sec sec-dark">
    <div class="container">
      <div class="sec-head" data-reveal>
        <span class="section-label on-dark">مزیت‌های همکاری با ما</span>
        <h2>{hp.advantagesTitle}</h2>
      </div>
      <div class="grid-3">
        {hp.advantages.map((a, i) => (
          <div class="cap-card" data-reveal style={`--rd:${(i % 3) * 80}ms`}>
            <div class="cap-no">{faNum(String(i + 1).padStart(2, '0'))}</div>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>

      {/* آمار واقعی تیم */}
      <div class="stats-band" style="margin-top:52px;--stats-n:3" data-reveal>
        {hp.stats.map((s) => (
          <div class="stat-item">
            <div class="stat-num" data-count={parseInt(enNum(s.value), 10) || 0}>{faNums(s.value)}</div>
            <p>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── ۵. خدمات از نزدیک ─── */}
  <section class="sec sec-cream">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">خدمات، از نزدیک</span>
        <h2>هر خدمت دقیقاً چه تغییری در کسب‌وکار شما می‌سازد؟</h2>
        <p>چهار حوزه اصلی کار ما — با نگاه کاربردی به «قبل و بعد» آن برای کسب‌وکار شما.</p>
      </div>

      <div class="svc-feature" data-reveal>
        <div class="img-side"><img src="/img/svc-company.webp" alt="طراحی سایت شرکتی اختصاصی" width="1152" height="864" loading="lazy" /></div>
        <div class="txt-side">
          <span class="tag">طراحی سایت</span>
          <h3>سایتی که هویت برند شما را می‌فروشد، نه قالبی که همه دارند</h3>
          <p>قالب آماده هزینه اولیه کمتری دارد، اما مخاطب حس «تکراری‌بودن» را حس می‌کند و توسعه بعدی گران تمام می‌شود. طراحی اختصاصی یعنی هر صفحه برای هدف مشخص آن ساخته شده باشد.</p>
          <ul>
            <li><i>✓</i> طراحی بر اساس پرسونای واقعی مخاطب — نه سلیقه لحظه‌ای</li>
            <li><i>✓</i> ساختار صفحه‌ها بر مبنای مسیر خرید یا تماس مشتری</li>
            <li><i>✓</i> کد تمیز و توسعه‌پذیر — قابلیت جدید بعداً بدون بازسازی اضافه می‌شود</li>
          </ul>
          <a href="/services/company-website" class="btn btn-gold btn-sm">صفحه خدمت طراحی سایت</a>
        </div>
      </div>

      <div class="svc-feature flip" data-reveal>
        <div class="img-side"><img src="/img/svc-seo.webp" alt="سئو تکنیکال و محتوایی" width="1152" height="864" loading="lazy" /></div>
        <div class="txt-side">
          <span class="tag">سئو</span>
          <h3>سئو یعنی ساختار درست؛ نه ترفند موقت</h3>
          <p>هیچ‌کس نمی‌تواند رتبه اول را تضمین کند — اما می‌توان زیرساختی ساخت که گوگل آن را دوست داشته باشد و محتوایی منتشر کرد که واقعاً سؤال مخاطب را پاسخ می‌دهد. نتیجه‌اش در طول زمان خودش را نشان می‌دهد.</p>
          <ul>
            <li><i>✓</i> سئوی تکنیکال: سرعت، ساختار آدرس‌ها، داده ساختاریافته</li>
            <li><i>✓</i> تحقیق کلمه کلیدی بر اساس نیت جست‌وجوی مخاطب شما</li>
            <li><i>✓</i> گزارش شفاف: می‌بینید چه کاری انجام شده و چه تغییری کرده</li>
          </ul>
          <a href="/services/seo" class="btn btn-gold btn-sm">صفحه خدمت سئو</a>
        </div>
      </div>

      <div class="svc-feature" data-reveal>
        <div class="img-side"><img src="/img/svc-content.webp" alt="تولید محتوای تخصصی سئومحور" width="1152" height="864" loading="lazy" /></div>
        <div class="txt-side">
          <span class="tag">تولید محتوا</span>
          <h3>محتوایی که سؤال مشتری را پاسخ می‌دهد، فروش را می‌آورد</h3>
          <p>مقاله‌ای که فقط «کلمه کلیدی» داشته باشد خوانده نمی‌شود. محتوای خوب نیاز واقعی مخاطب را پیدا می‌کند، کامل پاسخ می‌دهد و خواننده را یک قدم به خرید نزدیک می‌کند — و همین محتواست که سئو را می‌سازد.</p>
          <ul>
            <li><i>✓</i> مقالات سئومحور با تحقیق واقعی — نه بازنویسی رقبا</li>
            <li><i>✓</i> لحن برند شما حفظ می‌شود؛ محتوا با شما یکدست است</li>
            <li><i>✓</i> تقویم انتشار منظم — وبلاگ از سردرگمی به دارایی تبدیل می‌شود</li>
          </ul>
          <a href="/services/content" class="btn btn-gold btn-sm">صفحه خدمت تولید محتوا</a>
        </div>
      </div>

      <div class="svc-feature flip" data-reveal>
        <div class="img-side"><img src="/img/svc-ai.webp" alt="هوش مصنوعی و اتوماسیون کسب‌وکار" width="1152" height="864" loading="lazy" /></div>
        <div class="txt-side">
          <span class="tag">هوش مصنوعی</span>
          <h3>کارهای تکراری تیم‌تان را به ابزار بسپارید</h3>
          <p>پاسخ‌دادن به سؤالات تکراری، پیش‌نویس محتوا و جمع‌آوری اطلاعات مشتری، ساعت‌ها از وقت تیم شما را می‌گیرد. دستیارهای هوشمند این کارها را خودکار می‌کنند تا انسان‌ها روی کارهای مهم تمرکز کنند.</p>
          <ul>
            <li><i>✓</i> چت‌بات آموزش‌دیده با محتوای سایت شما — پاسخ درست، نه حدس</li>
            <li><i>✓</i> اتصال امن سمت سرور — کلیدها هرگز در مرورگر قرار نمی‌گیرند</li>
            <li><i>✓</i> بازبینی انسانی روی خروجی‌ها — سرعت هوش مصنوعی، کیفیت انسانی</li>
          </ul>
          <a href="/services/ai-automation" class="btn btn-gold btn-sm">صفحه راهکارهای هوش مصنوعی</a>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ۶. نمونه‌کارهای منتخب ─── */}
  <section class="sec sec-paper">
    <div class="container">
      <div class="sec-head" data-reveal>
        <span class="section-label">نمونه‌کارها</span>
        <h2>کیفیت اجرا را همین‌جا ببینید</h2>
        <p>نمونه‌های زیر مفهومی و ساخته خود ما هستند؛ پروژه‌های واقعی به‌محض آماده‌شدن و با اجازه صاحبان‌شان منتشر می‌شوند.</p>
      </div>
      <div class="grid-3">
        {projects.map((p, i) => {
          const tags = Array.isArray(p.tags) ? (p.tags as string[]) : [];
          return (
            <a href={`/portfolio/${p.slug}`} class="pf-card" data-reveal style={`--rd:${i * 80}ms`}>
              <img src={String(p.cover_image)} alt={`نمونه‌کار ${p.title}`} width="1344" height="768" loading="lazy" />
              <div class="pf-overlay">
                <div class="pf-tags">{tags.map((t) => <span>{t}</span>)}</div>
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
              </div>
            </a>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:34px" data-reveal>
        <a href="/portfolio" class="btn btn-ghost">مشاهده همه نمونه‌کارها</a>
      </div>
    </div>
  </section>

  {/* ─── ۷. مراحل اجرای پروژه ─── */}
  <section class="sec sec-cream">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">مسیر شروع همکاری</span>
        <h2>{hp.stepsTitle}</h2>
        <p>در هر گام می‌دانید کجا هستید، چه چیزی تحویل می‌گیرید و گام بعدی چیست.</p>
      </div>
      <div class="steps-grid">
        {hp.steps.map((s, i) => (
          <div class="step-card" data-reveal style={`--rd:${(i % 3) * 70}ms`}>
            <div class="step-num">{faNum(String(i + 1))}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── ۸. تعرفه‌ها ─── */}
  <section class="sec sec-paper" id="pricing">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">پکیج‌های طراحی سایت</span>
        <h2>قیمت شفاف و ثابت؛ بدون هزینه پنهان</h2>
        <p>دامنهٔ کار هر پکیج دقیقاً مشخص است: تعداد صفحات، زمان تحویل و مدت پشتیبانی رایگان. برای پروژه‌های بزرگ‌تر، پکیج اختصاصی با برآورد شفاف پیشنهاد می‌شود.</p>
      </div>
      <div class="plan-grid">
        {plans.map((p, i) => {
          const feats = Array.isArray(p.features) ? (p.features as string[]) : [];
          return (
            <div class={`plan-card ${p.highlighted ? 'highlight' : ''}`} data-reveal style={`--rd:${i * 70}ms`}>
              {p.highlighted ? <span class="plan-badge">پیشنهاد ما</span> : p.badge ? <span class="plan-badge" style="background:var(--ink);color:var(--gold-2)">{p.badge}</span> : null}
              <h3>{p.title}</h3>
              <div class="plan-desc">{p.description}</div>
              <div class="plan-price">{p.price}</div>
              <div class="plan-note">{p.price_note}</div>
              <ul class="plan-feats">
                {feats.map((f) => <li><i>✓</i> {f}</li>)}
              </ul>
              <div class="plan-footnote">{faNum(String(i + 1)) === '۱' ? 'هر صفحه با ساختار استاندارد سئو و ریسپانسیو کامل تحویل می‌شود.' : faNum(String(i + 1)) === '۲' ? 'برجسته‌شدن این پکیج به‌معنای ادعای برتری نیست؛ تجربه نشان داده بیشترین نیازها را پوشش می‌دهد.' : faNum(String(i + 1)) === '۳' ? 'پنل مدیریت فروشگاه همراه با آموزش کامل تحویل داده می‌شود.' : 'پس از تحلیل نیازها، پروپوزال مکتوب و شفاف ارائه می‌شود.'}</div>
              <a href={`/consult?plan=${encodeURIComponent(String(p.title))}`} class={`btn btn-block ${p.highlighted ? 'btn-gold' : 'btn-ghost'}`}>{p.cta_text}</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ─── ۹. مقالات جدید ─── */}
  {posts.length ? (
    <section class="sec sec-cream">
      <div class="container">
        <div class="sec-head" data-reveal>
          <span class="section-label">مجله کافه‌دانش</span>
          <h2>خواندنی‌های تخصصی دیجیتال</h2>
          <p>هر هفته یک مطلب کاربردی درباره طراحی سایت، سئو، محتوا و هوش مصنوعی — به زبان ساده.</p>
        </div>
        <div class="grid-3">
          {posts.map((p, i) => (
            <a href={`/blog/${p.slug}`} class="post-card" data-reveal style={`--rd:${i * 70}ms`}>
              <div class="post-thumb"><img src={String(p.cover_image)} alt={String(p.title)} width="1344" height="768" loading="lazy" /></div>
              <div class="post-body">
                <div class="post-meta">
                  <span class="cat">{p.category || 'مقالات'}</span>
                  <span>{faNum(String(p.reading_time))} دقیقه مطالعه</span>
                </div>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
        <div style="text-align:center;margin-top:34px" data-reveal>
          <a href="/blog" class="btn btn-ghost">مشاهده همه مقالات</a>
        </div>
      </div>
    </section>
  ) : null}

  {/* ─── ۱۰. نظرات مشتریان (فقط با دادهٔ واقعی) ─── */}
  {testimonials.length ? (
    <section class="sec sec-paper">
      <div class="container">
        <div class="sec-head center" data-reveal>
          <span class="section-label">نظرات مشتریان</span>
          <h2>تجربهٔ همکاری، از زبان همکارانمان</h2>
        </div>
        <div class="grid-3">
          {testimonials.map((t, i) => (
            <div class="svc-card" data-reveal style={`--rd:${i * 70}ms`}>
              <div class="svc-body">
                <div style="color:var(--gold-3);font-size:15px">{'★'.repeat(Number(t.rating))}</div>
                <h3 style="font-size:15px">{t.name} <span style="font-weight:400;color:var(--mut-light);font-size:12.5px">— {t.role} {t.company ? `در ${t.company}` : ''}</span></h3>
                <p style="font-size:13.5px">«{t.content}»</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  {/* ─── ۱۱. سؤالات متداول ─── */}
  <section class="sec sec-cream">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">سؤالات متداول</span>
        <h2>قبل از شروع پروژه بهتر است بدانید</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" data-reveal>
            <summary><span class="fq-ico">+</span> {f.question}</summary>
            <div class="fq-body">{f.answer}</div>
          </details>
        ))}
      </div>
      <div style="text-align:center;margin-top:28px" data-reveal>
        <a href="/faq" class="btn btn-ghost">مشاهده همه سؤالات متداول</a>
      </div>
    </div>
  </section>

  {/* ─── ۱۲. دعوت به مشاوره ─── */}
  <section class="sec sec-dark" style="padding-block:64px">
    <div class="container">
      <div class="cta-band" data-reveal="zoom">
        <div class="cta-inner">
          <div>
            <h2>{hp.ctaTitle}</h2>
            <p>{hp.ctaText}</p>
          </div>
          <div class="cta-actions">
            <a href="/consult" class="btn btn-gold btn-lg">درخواست مشاوره رایگان</a>
            <a href="/portfolio" class="btn btn-ghost-light">مشاهده نمونه‌کارها</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  {/* ─── ۱۳. فوتر در چیدمان پایه ─── */}
</BaseLayout>
