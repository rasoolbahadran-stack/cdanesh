---
/* صفحهٔ اصلی کافه‌دانش — کپی وفادار از ساختار دموی Porto SEO 2
   ترتیب بخش‌ها: هیرو → ۳ کارت ویژگی → معرفی + تصویر → نوار مشتریان → خدمات
   → CTA سرمه‌ای → مهارت‌ها و آمار → نظرات → تعرفه‌ها → بلاگ → سؤالات متداول */
import BaseLayout from '../layouts/BaseLayout.astro';
import { q } from '../lib/db';
import { getSiteSettings } from '../lib/seed';
import { faNum } from '../lib/persian';
import { ASTRO_PROJECTS } from '../lib/portfolio-projects';

interface Row {
  id: number;
  [k: string]: unknown;
}

const settings = await getSiteSettings();

const services = await q<Row>(`SELECT slug, title, short_desc FROM services WHERE status='published' ORDER BY sort_order LIMIT 6`);
const plans = await q<Row>(`SELECT * FROM plans WHERE status='published' ORDER BY sort_order`);
const posts = await q<Row>(
  `SELECT p.slug, p.title, p.excerpt, p.cover_image, p.reading_time, p.published_at, c.name AS category
   FROM posts p LEFT JOIN categories c ON c.id = p.category_id
   WHERE p.status='published' ORDER BY p.published_at DESC LIMIT 3`,
);
const faqs = await q<Row>(`SELECT question, answer FROM faqs WHERE status='published' ORDER BY sort_order LIMIT 6`);
const testimonials = await q<Row>(`SELECT * FROM testimonials WHERE status='published' ORDER BY sort_order`);

/* اسکیما FAQ برای صفحهٔ اصلی */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: String(f.question),
    acceptedAnswer: { '@type': 'Answer', text: String(f.answer) },
  })),
};

/* آیکون‌های دموی Porto برای جعبه‌های خدمات */
const svcIcons = ['/img/porto/icons/icon-1.png', '/img/porto/icons/icon-2.png', '/img/porto/icons/icon-3.png', '/img/porto/icons/icon-4.png', '/img/porto/icons/icon-5.png', '/img/porto/icons/icon-6.png'];
const projectHighlights = ASTRO_PROJECTS.slice(0, 4);
---
<BaseLayout
  title={settings.seo.defaultTitle}
  description={settings.seo.defaultDescription}
  activePath="/"
  schema={[faqSchema]}
>
  {/* ─── ۱. هیرو — دقیقاً سبک دموی Porto SEO 2 ─── */}
  <section class="hero sec-rel">
    <span class="hero-circle c-indigo" aria-hidden="true"></span>
    <span class="hero-circle c-pink" aria-hidden="true"></span>
    <span class="hero-circle c-dot-1" aria-hidden="true"></span>
    <span class="hero-circle c-dot-2" aria-hidden="true"></span>
    <span class="hero-circle c-dot-3" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="hero-txt">
        <h1 class="anim-up">طراحی سایت و سئو؛ موتور رشد کسب‌وکار شما</h1>
        <p class="hero-sub anim-up d-2">حضور آنلاین حرفه‌ای با طراحی اختصاصی، سئوی اصولی و محتوای هدفمند — دقیقاً همان لحظه‌ای که مشتری در گوگل به دنبال خدمات شماست، شما را می‌بیند.</p>
        <div class="hero-actions anim-up d-3">
          <a href="/consult" class="btn btn-gold btn-lg">شروع کنید</a>
        </div>
      </div>
      <div class="hero-visual anim-up d-1">
        <img src="/img/svc-seo.webp" alt="تصویرسازی باکیفیت بهینه‌سازی موتور جستجو و رشد وب‌سایت" width="1152" height="768" fetchpriority="high" decoding="async" />
      </div>
    </div>
    {/* موج سفید — انتقال هیرو به بخش بعد */}
    <div class="sec-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 76" preserveAspectRatio="none"><path fill="#ffffff" d="M0,76 L1440,76 L1440,34 C1300,12 1190,14 1060,34 C900,60 820,52 720,38 C560,14 470,18 320,38 C180,58 90,42 0,28 Z" /></svg>
    </div>
  </section>

  {/* ─── ۲. سه کارت ویژگی — هم‌پوشان با هیرو (سبک دمو) ─── */}
  <section class="sec sec-paper" style="padding-top:0">
    <div class="container hero-cards" style="margin-top:-58px">
      <div class="hero-cards-grid">
        <div class="fbox-card" data-reveal>
          <div class="fbox-ico"><img src="/img/porto/icons/target.svg" alt="" width="74" height="74" loading="lazy" /></div>
          <h3>بهینه‌سازی موتور جستجو</h3>
          <p>با سئوی تکنیکال و محتوایی، سایت شما دقیقاً زمانی دیده می‌شود که مشتری به دنبال خدمات شماست؛ رشد پایدار، نه ترفند موقت.</p>
          <a href="/services/seo" class="fbox-more">بیشتر بخوانید +</a>
        </div>
        <div class="fbox-card" data-reveal style="--rd:90ms">
          <div class="fbox-ico"><img src="/img/porto/icons/search.svg" alt="" width="74" height="74" loading="lazy" /></div>
          <h3>طراحی سایت اختصاصی</h3>
          <p>سایتی متناسب با هویت برند شما؛ سریع، ریسپانسیو و مهندسی‌شده برای تبدیل بازدیدکننده به مشتری واقعی.</p>
          <a href="/services/company-website" class="fbox-more">بیشتر بخوانید +</a>
        </div>
        <div class="fbox-card" data-reveal style="--rd:180ms">
          <div class="fbox-ico"><img src="/img/porto/icons/teaching.svg" alt="" width="74" height="74" loading="lazy" /></div>
          <h3>محتوا و هوش مصنوعی</h3>
          <p>محتوای سئومحور که سؤال مشتری را پاسخ می‌دهد و ابزارهای هوشمندی که کارهای تکراری تیم شما را خودکار می‌کنند.</p>
          <a href="/services/content" class="fbox-more">بیشتر بخوانید +</a>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ۳. معرفی + تصویرسازی دوم (سبک دمو) ─── */}
  <section class="sec sec-paper" style="padding-top:40px">
    <div class="container intro-split">
      <div class="txt-side" data-reveal>
        <span class="section-label pink">راحت‌ترین راه حضور آنلاین</span>
        <h2>پیشرو باشید؛ مشتریان بیشتری جذب کنید و برند قوی‌تری بسازید</h2>
        <p>به‌جای هماهنگ‌کردن چند پیمانکار جدا، کل زنجیرهٔ دیجیتال شما — از طراحی و سئو تا محتوا و اتوماسیون — توسط یک تیم و با یک زبان مشترک پیش برده می‌شود؛ بدون گلوگاه، بدون سرزنش متقابل و با نقشهٔ راه شفاف.</p>
        <p>CDANESH STUDIO (کافه‌دانش) یک استودیو دیجیتال در بوشهر است که برای کسب‌وکارهای ایرانی سایت می‌سازد، محتوا تولید می‌کند و ابزارهای هوشمند ارائه می‌دهد. هر پروژه با تحلیل نیازها شروع می‌شود، با تحویل مرحله‌ای جلو می‌رود و پس از تحویل هم تنها نیستید.</p>
        <div style="margin-top:22px">
          <a href="/services" class="btn btn-gold">خدمات ما</a>
        </div>
      </div>
      <div class="img-side" data-reveal="left">
        <img src="/img/about-studio.webp" alt="تصویرسازی تیم طراحی و توسعه وب در استودیوی دیجیتال" width="1152" height="768" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ─── ۴. نوار اعتماد مشتریان (سبک دمو) ─── */}
  <section class="clients-band sec-rel">
    <div class="container">
      <p class="clients-label">پروژه‌های اجراشده با فریم‌ورک Astro</p>
      <div class="clients-row" data-reveal>
        {projectHighlights.map((project) => (
          <a class="cl-logo" href={`/portfolio/${project.slug}`}>{project.title}<small>BUILT WITH ASTRO</small></a>
        ))}
      </div>
    </div>
    <div class="sec-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 76" preserveAspectRatio="none"><path fill="#ffffff" d="M0,76 L1440,76 L1440,34 C1300,12 1190,14 1060,34 C900,60 820,52 720,38 C560,14 470,18 320,38 C180,58 90,42 0,28 Z" /></svg>
    </div>
  </section>

  {/* ─── ۵. خدمات ما — جعبه‌های آیکون‌دار دموی Porto ─── */}
  <section class="sec sec-paper" style="padding-top:48px">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">خدمات ما</span>
        <h2>هر خدمت، یک متخصص رشد کنار شما</h2>
        <p>از طراحی اختصاصی تا سئو، محتوا و هوش مصنوعی — هر خدمت صفحهٔ اختصاصی و محتوای کامل خودش را دارد و می‌تواند مستقل سفارش داده شود.</p>
      </div>
      <div class="grid-3 svc-stagger">
        {services.map((s, i) => (
          <div class="svc-box" data-reveal style={`--rd:${(i % 3) * 80}ms`}>
            <div class="svc-ico"><img src={svcIcons[i % svcIcons.length]} alt="" width="78" height="78" loading="lazy" /></div>
            <h3>{s.title}</h3>
            <p>{s.short_desc}</p>
            <a href={`/services/${s.slug}`} class="fbox-more">بیشتر بخوانید +</a>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:44px" data-reveal>
        <a href="/contact" class="btn btn-ghost btn-lg">ارتباط با ما</a>
      </div>
    </div>
  </section>

  {/* ─── ۶. CTA سرمه‌ای — سبک دمو ─── */}
  <section class="cta-full sec-rel">
    <div class="container">
      <div class="cta-center" data-reveal>
        <h2>مشاورهٔ رایگان سئو و طراحی سایت خود را همین حالا دریافت کنید</h2>
        <p>وضعیت فعلی سایت‌تان را بررسی می‌کنیم و نقشهٔ راه شفافی برای رشد در گوگل پیشنهاد می‌دهیم — بدون تعهد.</p>
        <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
          <a href={`tel:+989165806207`} class="btn btn-tertiary btn-lg">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#fff" style="flex:none" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
            <span dir="ltr">۰۹۱۶ ۵۸۰ ۶۲۰۷</span>
          </a>
          <a href="/consult" class="btn btn-ghost-light btn-lg">درخواست مشاوره</a>
        </div>
      </div>
    </div>
    <div class="sec-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 76" preserveAspectRatio="none"><path fill="#ffffff" d="M0,76 L1440,76 L1440,34 C1300,12 1190,14 1060,34 C900,60 820,52 720,38 C560,14 470,18 320,38 C180,58 90,42 0,28 Z" /></svg>
    </div>
  </section>

  {/* ─── ۷. مهارت‌ها و آمار — نوارهای پیشرفت + دایره‌های رنگی دمو ─── */}
  <section class="sec sec-paper" style="padding-top:48px">
    <div class="container">
      <div class="intro-split">
        <div class="txt-side" data-reveal>
          <span class="section-label pink">راه سادهٔ رشد آنلاین</span>
          <h2>تجربه‌ای که در نتیجه دیده می‌شود</h2>
          <p>ما فقط کد نمی‌زنیم؛ زیرساخت رشد می‌سازیم. هر پروژه با استانداردهای فنی گوگل، معماری محتوایی درست و تجربهٔ کاربری مهندسی‌شده تحویل داده می‌شود تا نتیجه در سرچ‌کنسول و فروش قابل اندازه‌گیری باشد.</p>
          <div style="margin-top:26px">
            <div class="progress">
              <div class="pb-label"><span>سئوی تکنیکال و محتوایی</span><b>۹۵٪</b></div>
              <div class="pb-bar" style="--w:95%"></div>
            </div>
            <div class="progress">
              <div class="pb-label"><span>سرعت و تجربهٔ کاربری</span><b>۹۲٪</b></div>
              <div class="pb-bar" style="--w:92%"></div>
            </div>
            <div class="progress">
              <div class="pb-label"><span>رضایت مشتریان</span><b>۹۸٪</b></div>
              <div class="pb-bar" style="--w:98%"></div>
            </div>
          </div>
        </div>
        <div class="circles-wrap" data-reveal="left">
          <div class="circles-group">
            <div class="cc cc-magenta"><b>۲۲</b><span>مقالهٔ تخصصی</span></div>
            <div class="cc cc-indigo"><b>۸</b><span>خدمت تخصصی</span></div>
            <div class="cc cc-navy"><b>۶</b><span>گام شفاف همکاری</span></div>
            <span class="cc cc-small-pink" aria-hidden="true"></span>
            <span class="cc cc-dot" aria-hidden="true"></span>
            <span class="cc cc-dot-2" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ۸. نظرات مشتریان (سبک دمو) ─── */}
  {testimonials.length ? (
    <section class="sec sec-paper" style="padding-top:20px">
      <div class="container">
        <div class="sec-head center" data-reveal>
          <span class="section-label">نظرات مشتریان</span>
          <h2>آنچه مشتریان ما می‌گویند را بررسی کنید</h2>
        </div>
        <div class="grid-3">
          {testimonials.map((t, i) => (
            <div class="tst-card" data-reveal style={`--rd:${i * 80}ms`}>
              <blockquote>
                <p>«{t.content}»</p>
              </blockquote>
              <div class="tst-stars" aria-label={`امتیاز ${t.rating} از ۵`}>{'★'.repeat(Number(t.rating))}</div>
              <div class="tst-author">
                <span class="tst-ava">{String(t.name).trim().charAt(0)}</span>
                <p><b>{t.name}</b><span>{t.role} {t.company ? `در ${t.company}` : ''}</span></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  {/* ─── ۹. تعرفه‌ها — کارت‌های Porto با هدیهٔ هاستینگ ─── */}
  <section class="sec sec-cream sec-rel" id="pricing">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">جدول تعرفه‌ها</span>
        <h2>قیمت شفاف و ثابت؛ بدون هزینهٔ پنهان</h2>
        <p>دامنهٔ کار هر پکیج دقیقاً مشخص است: تعداد صفحات، زمان تحویل و مدت پشتیبانی رایگان. دو پلن اول با ۶ ماه هاست هدیه و دو پلن بعدی با یک سال هاست هدیه ارائه می‌شوند.</p>
      </div>
      <div class="plan-grid">
        {plans.map((p, i) => {
          const rawFeats = Array.isArray(p.features) ? (p.features as string[]) : [];
const hostingDuration = i < 2 ? '۶ ماه' : '۱ سال';
const hostingGift = `${hostingDuration} هاست هدیه`;
const feats = rawFeats.map((feature) => String(feature).replace(/(?:۶|٦|6)\s*ماه|(?:۱۲|١٢|12)\s*ماه|(?:۱|١|1)\s*سال|یک\s*سال/g, hostingDuration).replace(/هاستینگ/g, 'هاست'));
const displayFeats = feats.some((feature) => /هاست\s*هدیه/.test(feature)) ? feats : [hostingGift, ...feats];
          return (
            <div class={`plan-card ${p.highlighted ? 'highlight' : ''}`} data-reveal style={`--rd:${i * 70}ms`}>
              <span class="hosting-badge">🎁 {hostingGift}</span>
              {p.highlighted ? <span class="plan-ribbon">محبوب</span> : null}
              <h3>{p.title}</h3>
              <div class="plan-desc">{p.description}</div>
              <div class="plan-price">{p.price}</div>
              <div class="plan-note">{p.price_note}</div>
              <ul class="plan-feats">
                {displayFeats.map((f) => <li><i>✓</i> {f}</li>)}
              </ul>
              <a href={`/consult?plan=${encodeURIComponent(String(p.title))}`} class={`btn btn-block ${p.highlighted ? 'btn-ghost-light' : 'btn-ghost'}`}>اکنون بخرید</a>
            </div>
          );
        })}
      </div>
    </div>
    <div class="sec-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 76" preserveAspectRatio="none"><path fill="#ffffff" d="M0,76 L1440,76 L1440,34 C1300,12 1190,14 1060,34 C900,60 820,52 720,38 C560,14 470,18 320,38 C180,58 90,42 0,28 Z" /></svg>
    </div>
  </section>

  {/* ─── ۱۰. مطالب اخیر بلاگ (سبک دمو) ─── */}
  {posts.length ? (
    <section class="sec sec-paper">
      <div class="container">
        <div class="sec-head center" data-reveal>
          <span class="section-label">مجلهٔ کافه‌دانش</span>
          <h2>مطالب اخیر بلاگ</h2>
          <p>هر هفته یک مطلب کاربردی دربارهٔ طراحی سایت، سئو، محتوا و هوش مصنوعی — به زبان ساده و قابل اجرا.</p>
        </div>
        <div class="grid-3">
          {posts.map((p, i) => (
            <a href={`/blog/${p.slug}`} class="post-card" data-reveal style={`--rd:${i * 70}ms`}>
              <div class="post-thumb"><img src={String(p.cover_image)} alt={String(p.title)} width="1344" height="768" loading="lazy" /></div>
              <div class="post-body">
                <div class="post-meta">
                  <span class="cat">{p.category || 'مقالات'}</span>
                  <span class="pm-sep"></span>
                  <span>{faNum(String(p.reading_time))} دقیقه مطالعه</span>
                </div>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
                <span class="fbox-more">بیشتر بخوانید +</span>
              </div>
            </a>
          ))}
        </div>
        <div style="text-align:center;margin-top:40px" data-reveal>
          <a href="/blog" class="btn btn-gold">مشاهدهٔ بلاگ</a>
        </div>
      </div>
    </section>
  ) : null}

  {/* ─── ۱۱. سؤالات متداول ─── */}
  <section class="sec sec-cream">
    <div class="container">
      <div class="sec-head center" data-reveal>
        <span class="section-label">سؤالات متداول</span>
        <h2>قبل از شروع پروژه بهتر است بدانید</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" data-reveal>
            <summary><span class="fq-ico">+</span> {f.question}</summary>
            <div class="fq-body">{f.answer}</div>
          </details>
        ))}
      </div>
      <div style="text-align:center;margin-top:28px" data-reveal>
        <a href="/faq" class="btn btn-ghost">مشاهدهٔ همهٔ سؤالات متداول</a>
      </div>
    </div>
  </section>
</BaseLayout>
