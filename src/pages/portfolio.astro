---
// نمونه‌کارها — فیلتر دسته‌بندی + کارت‌های اسکرول هنگام Hover
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPortfolio } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const items = (await getPortfolio()).filter((item) => item.status === 'published');
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=900');
// ترتیب دسته‌ها با اولویت تخصص اصلی برند
const preferredPf = ['سایت شرکتی', 'فروشگاه اینترنتی', 'پورتال و سامانه'];
const foundPf = [...new Set(items.map((i) => i.category))];
const categories = ['همه', ...preferredPf.filter((c) => foundPf.includes(c)), ...foundPf.filter((c) => !preferredPf.includes(c))];

const meta = {
  title: 'نمونه‌کارهای طراحی سایت و فروشگاه اینترنتی | کافه دانش',
  description: 'نمونه‌کارهای طراحی سایت شرکتی، فروشگاه اینترنتی و سامانه‌های تحت وب کافه دانش؛ با پیش‌نمایش زنده و جزئیات هر پروژه.',
  path: '/portfolio',
};
---
<BaseLayout meta={meta} current="/portfolio" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'نمونه‌کارها', url: '/portfolio' }])]}>
  <h1 class="sr-only">نمونه‌کارها</h1>

  <section class="section">
    <div class="container">
      <div class="pf-filters" role="group" aria-label="فیلتر دسته‌بندی نمونه‌کارها">
        {categories.map((c, i) => (
          <button type="button" class:list={[{ 'is-active': i === 0 }]} data-pf-filter={c}>{c}</button>
        ))}
      </div>
      <div class="pf-grid">
        {items.map((p, i) => (
          <PortfolioCard item={p} delay={String((i % 3) * 80)} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="پروژه شما هم می‌تواند اینجا باشد" sub="اگر سایتی مثل همین نمونه‌ها می‌خواهید، از جلسه مشاوره رایگان شروع کنیم." />
</BaseLayout>
