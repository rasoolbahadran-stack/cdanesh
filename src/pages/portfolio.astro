---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "نمونه‌کارها | کافه‌دانش";
const description = "نمونه‌کارهای کافه‌دانش: موس را روی هر کارت نگه دارید تا کل صفحه پروژه از بالا تا پایین به‌صورت خودکار مرور شود — بدون ترک این صفحه.";
const canonical = "https://cdanesh.ir/portfolio";
---

<SiteLayout title={title} description={description} canonical={canonical} schemas={false}>
<!-- ═══ هیرو نمونه‌کارها ═══ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>نمونه‌کارها</span>
    </nav>
    <span class="eyebrow">نمونه‌کارها</span>
    <h1 class="h1">هر پروژه را <span class="gold">تا آخرین صفحه</span> ببینید</h1>
    <p class="lead">موس را روی هر کارت نگه دارید؛ تصویر کاملِ سایت به‌آرامی از بالا به پایین مرور می‌شود تا کل ساختار صفحه را در همین‌جا ببینید. با برداشتن موس، تصویر به ابتدا برمی‌گردد. کلیک روی کارت، صفحه جزئیات همان پروژه را باز می‌کند.</p>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <!-- فیلتر دسته‌بندی (واقعی و فعال) -->
    <div class="pf-filters" role="group" aria-label="فیلتر نمونه‌کارها بر اساس دسته‌بندی">
      <button type="button" class="active" data-filter="all">همه</button>
      <button type="button" data-filter="shop">فروشگاهی</button>
      <button type="button" data-filter="corporate">شرکتی</button>
      <button type="button" data-filter="service">خدماتی</button>
      <button type="button" data-filter="content">محتوایی</button>
      <button type="button" data-filter="ai">هوش مصنوعی</button>
    </div>
    <p class="pf-count" aria-live="polite">۶ نمونه مفهومی در همه دسته‌ها</p>

    <div class="pf-grid2" id="pf-grid2">
      <!-- پروژه‌ها از بانک نمونه‌کارها رندر می‌شود (ترتیب/نمایش از پنل مدیریت) -->
      <!-- ۱) فروشگاهی -->
      <article class="pf-card2 reveal" data-cat="shop">
        <a class="pf-frame" href="/portfolio-rosa" aria-label="نمونه فروشگاه اینترنتی رُزا — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-shop.webp" alt="نمای کامل صفحه اصلی فروشگاه اینترنتی رُزا — نمونه مفهومی" width="1280" height="3051" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">فروشگاهی</span><span class="chip">طراحی اختصاصی</span><span class="chip">درگاه پرداخت</span></div>
          <h3>فروشگاه اینترنتی رُزا</h3>
          <p>فروش محصولات تازه با تجربه خرید روان، فیلتر دسته‌بندی و صفحه محصول بهینه‌شده برای تبدیل.</p>
          <a class="link-more" href="/portfolio-rosa">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- ۲) شرکتی -->
      <article class="pf-card2 reveal" data-cat="corporate" data-delay="1">
        <a class="pf-frame" href="/portfolio-arman" aria-label="نمونه وب‌سایت هلدینگ آرمان — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-corporate.webp" alt="نمای کامل صفحه اصلی هلدینگ صنعتی آرمان — نمونه مفهومی" width="1280" height="2541" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">شرکتی</span><span class="chip">معرفی خدمات</span><span class="chip">چندزبانه</span></div>
          <h3>وب‌سایت هلدینگ آرمان</h3>
          <p>معرفی سه شرکت تابعه، پروژه‌های اجراشده و روند همکاری؛ ساختار منظم برای مخاطب B2B.</p>
          <a class="link-more" href="/portfolio-arman">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- ۳) خدماتی -->
      <article class="pf-card2 reveal" data-cat="service" data-delay="2">
        <a class="pf-frame" href="/portfolio-mehr" aria-label="نمونه وب‌سایت کلینیک مهر — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-clinic.webp" alt="نمای کامل صفحه اصلی کلینیک تخصصی مهر — نمونه مفهومی" width="1280" height="2739" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">خدماتی</span><span class="chip">نوبت‌دهی آنلاین</span><span class="chip">معرفی پزشکان</span></div>
          <h3>وب‌سایت کلینیک مهر</h3>
          <p>نوبت‌دهی سه‌مرحله‌ای، پروفایل پزشکان و پاسخ به پرسش‌های رایج بیماران؛ ساده و قابل اعتماد.</p>
          <a class="link-more" href="/portfolio-mehr">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- ۴) محتوایی -->
      <article class="pf-card2 reveal" data-cat="content">
        <a class="pf-frame" href="/portfolio-goldast" aria-label="نمونه مجله آشپزی گلدست — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-mag.webp" alt="نمای کامل صفحه اصلی مجله آشپزی گلدست — نمونه مفهومی" width="1280" height="2889" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">محتوایی</span><span class="chip">سئو محور</span><span class="chip">خبرنامه</span></div>
          <h3>مجله آشپزی گلدست</h3>
          <p>ساختار مجله‌ای با دستورهای ساختاریافته، دسته‌بندی موضوعی و عضویت خبرنامه؛ طراحی‌شده برای رشد ارگانیک.</p>
          <a class="link-more" href="/portfolio-goldast">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- ۵) هوش مصنوعی -->
      <article class="pf-card2 reveal" data-cat="ai" data-delay="1">
        <a class="pf-frame" href="/portfolio-negar" aria-label="نمونه محصول دستیار هوشمند نِگار — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-ai.webp" alt="نمای کامل صفحه اصلی دستیار هوشمند نِگار — نمونه مفهومی" width="1280" height="2438" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">هوش مصنوعی</span><span class="chip">چت‌بات فروش</span><span class="chip">صفحه فرود SaaS</span></div>
          <h3>دستیار هوشمند نِگار</h3>
          <p>صفحه فرود محصول با نمایش زنده گفتگو، پلن‌های قیمت‌گذاری و ثبت‌نام آزمایشی؛ برای محصول SaaS.</p>
          <a class="link-more" href="/portfolio-negar">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- ۶) خدماتی (سامانه آموزشی) -->
      <article class="pf-card2 reveal" data-cat="service" data-delay="2">
        <a class="pf-frame" href="/portfolio-daneshvar" aria-label="نمونه پلتفرم آموزش آنلاین دانش‌ور — مشاهده جزئیات پروژه">
          <div class="pf-scroll"><img src="/assets/img/pf-lms.webp" alt="نمای کامل صفحه اصلی پلتفرم آموزش آنلاین دانش‌ور — نمونه مفهومی" width="1280" height="2513" loading="lazy"></div>
          <span class="pf-hint" aria-hidden="true">
            <span class="hint-motion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="8" y="3" width="8" height="18" rx="4"/><path d="M12 7v3"/></svg> برای مرور خودکار، موس را نگه دارید</span>
            <span class="hint-touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m0-14-4 4m4-4 4 4"/></svg> برای دیدن کل صفحه، انگشت را بکشید</span>
          </span>
          <span class="badge-demo">نمونه مفهومی</span>
        </a>
        <div class="pf-meta">
          <div class="pf-tags"><span class="chip chip-gold">خدماتی</span><span class="chip">فروش دوره</span><span class="chip">پنل دانشجو</span></div>
          <h3>پلتفرم آموزش آنلاین دانش‌ور</h3>
          <p>کاتالوگ دوره‌ها، مسیرهای شغلی ساختارمند و ثبت‌نام آنلاین؛ تجربه‌ای منظم برای یادگیری.</p>
          <a class="link-more" href="/portfolio-daneshvar">جزئیات پروژه
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
          </a>
        </div>
      </article>
    </div>
    <p class="muted small" style="text-align:center; margin-top:36px; max-width:640px; margin-inline:auto">صادقانه: همه نمونه‌های بالا مفهومی و ساخته خود ما هستند و به کسب‌وکار واقعی اشاره‌ای ندارند. به‌محض اتمام پروژه‌های واقعی و با اجازه صاحبان‌شان، اینجا منتشر می‌شوند.</p>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>کیفیت را در نمونه‌ها ببینید؛ در پروژه شما تجربه کنید</h2>
        <p>جلسه مشاوره رایگان برگزار می‌کنیم و دقیقاً می‌گوییم چه چیزی برای اهدافتان لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="/request">شروع پروژه</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
