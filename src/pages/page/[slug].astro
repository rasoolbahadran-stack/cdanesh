---
/* نمایش صفحات عمومی ساخته‌شده در پنل — /page/[slug] */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { q } from '../../lib/db';
import { siteUrl } from '../../lib/seo';

interface PageRow {
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  featured_image: string;
  seo_title: string;
  seo_description: string;
}

const { slug } = Astro.params;

/* بیلد استاتیک: prerender صفحات منتشرشده | بیلد سرور: SSR */
export const prerender = !!process.env.STATIC_BUILD;
export async function getStaticPaths() {
  const rows = await q<{ slug: string }>(`SELECT slug FROM pages WHERE status='published'`);
  return rows.map((r) => ({ params: { slug: String(r.slug) } }));
}

const page = await q<PageRow>('SELECT title, slug, excerpt, content, featured_image, seo_title, seo_description FROM pages WHERE slug = $1 AND status = $2', [String(slug), 'published']).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: '/' },
    { '@type': 'ListItem', position: 2, name: page.title, item: siteUrl(`/page/${page.slug}`) },
  ],
}];
---
<BaseLayout
  title={page.seo_title || page.title}
  description={page.seo_description || page.excerpt}
  activePath={`/page/${page.slug}`}
  schema={schema}
>
  <PageHero title={page.title} sub={page.excerpt} />
  <section class="sec">
    <div class="container">
      <div class="prose-fa" style="max-width:880px;margin-inline:auto" data-reveal set:html={page.content} />
    </div>
  </section>
</BaseLayout>
