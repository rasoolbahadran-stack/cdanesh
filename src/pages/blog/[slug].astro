---
// صفحه مقاله — محتوای کامل + JSON-LD مقاله + مقالات مرتبط
import BaseLayout from '../../layouts/BaseLayout.astro';
import Blocks from '../../components/Blocks.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPost, getRelatedPosts } from '../../lib/content';
import type { Post } from '../../lib/types';
import { jsonLdArticle, jsonLdBreadcrumb } from '../../lib/seo';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const post = await getPost(slug) as Post | undefined;
if (!post) return Astro.redirect('/404');

const related = getRelatedPosts(slug, 3);
const toc = post.blocks.map((block, index) => ({ block, index })).filter(({ block }) => block.t === 'h2' || block.t === 'h3');
const fa = (n: number | string) => new Intl.NumberFormat('fa-IR').format(Number(n));

const meta = {
  title: `${post.title} | مجله کافه دانش`,
  description: post.excerpt,
  path: `/blog/${post.slug}`,
  type: 'article' as const,
  image: post.cover,
  publishedTime: post.date || undefined,
};
---
<BaseLayout
  meta={meta}
  current="/blog"
  extraJsonLd={[
    jsonLdArticle({
      title: post.title, description: post.excerpt, path: meta.path, image: post.cover,
      datePublished: post.date, dateFa: post.dateFa, readMinutes: post.readMinutes, category: post.category,
    }),
    jsonLdBreadcrumb([
      { name: 'خانه', url: '/' }, { name: 'مجله', url: '/blog' }, { name: post.title, url: meta.path },
    ]),
  ]}
>
  <section class="page-hero">
    <svg class="hero__ribbon" viewBox="0 0 1440 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M-40 120 C 260 320, 620 60, 900 200 S 1380 330, 1520 210" stroke="rgba(11,18,51,0.16)" stroke-width="130" fill="none" stroke-linecap="round" />
      <path d="M-60 330 C 300 130, 700 380, 1080 240 S 1420 120, 1540 260" stroke="rgba(255,255,255,0.10)" stroke-width="72" fill="none" stroke-linecap="round" />
    </svg>
    <div class="container">
      <nav class="page-hero__crumbs" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span aria-hidden="true">/</span><a href="/blog">مجله</a><span aria-hidden="true">/</span><span aria-current="page">{post.category}</span>
      </nav>
      <h1 data-reveal="up" style="max-width:24ch;margin-inline:auto">{post.title}</h1>
      <div class="post-hero-meta" data-reveal="up" data-delay="120">
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4m8-4v4M3 10h18" /></svg>
          {post.dateFa || '—'}
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
          {fa(post.readMinutes)} دقیقه مطالعه
        </span>
        <span class="badge" style="background:rgba(255,255,255,.18);color:#fff">{post.category}</span>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      {post.cover && (
        <figure style="max-width:900px;margin:0 auto 34px;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-card)">
          <img src={post.cover} alt={`تصویر شاخص مقاله: ${post.title}`} width="800" height="450" decoding="async" style="width:100%;display:block;aspect-ratio:16/9;object-fit:cover" fetchpriority="high" />
        </figure>
      )}
      {toc.length > 2 && (
        <nav class="article-toc" aria-label="فهرست مطالب">
          <strong>در این مقاله می‌خوانید</strong>
          <ul>{toc.map(({ block, index }) => <li class:list={[block.t === 'h3' ? 'is-sub' : '']}><a href={`#content-heading-${index + 1}`}>{block.x}</a></li>)}</ul>
        </nav>
      )}
      <Blocks blocks={post.blocks} />

      <div class="article-actions">
        <span style="font-weight:700;color:var(--navy)">نوشتهٔ تیم کافه دانش</span>
        <div>
          <button type="button" class="btn btn--outline btn--sm" id="article-share">اشتراک‌گذاری مقاله</button>
          <a href="/consult" class="btn btn--sm">مشاوره رایگان برای پروژه شما</a>
        </div>
        <p id="article-share-status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="section bg-soft" aria-labelledby="related-title">
    <div class="container">
      <div class="section-head">
        <span class="section-head__tag">ادامهٔ خواندن</span>
        <h2 class="section-head__title" style="font-size:1.5rem">مقالات مرتبط</h2>
      </div>
      <div class="pf-grid">
        {related.map((p, i) => <PostCard post={p} delay={String(i * 80)} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  const shareButton = document.getElementById('article-share') as HTMLButtonElement | null;
  const shareStatus = document.getElementById('article-share-status');
  shareButton?.addEventListener('click', async () => {
    const shareData = { title: document.title, text: document.querySelector('meta[name="description"]')?.getAttribute('content') || document.title, url: window.location.href };
    try {
      if (navigator.share) await navigator.share(shareData);
      else {
        await navigator.clipboard.writeText(shareData.url);
        if (shareStatus) shareStatus.textContent = 'پیوند مقاله کپی شد.';
      }
    } catch (error) {
      if (error instanceof Error && error.name === 'AbortError') return;
      if (shareStatus) shareStatus.textContent = 'اشتراک‌گذاری انجام نشد؛ نشانی صفحه را از نوار مرورگر کپی کنید.';
    }
  });
</script>
<style>
  .article-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;margin-top:44px;padding-top:22px;border-top:1px solid var(--line)}
  .article-actions>div{display:flex;flex-wrap:wrap;gap:10px}
  .article-actions p{width:100%;margin:0;color:var(--mut);font-size:.84rem}
</style>

<style>
  .article-toc{max-width:900px;margin:0 auto 28px;padding:20px 24px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--bg-soft,#faf9fd)}
  .article-toc strong{display:block;color:var(--navy);margin-bottom:10px}
  .article-toc ul{margin:0;padding-right:20px;display:grid;gap:8px;line-height:1.9}
  .article-toc li{color:var(--purple)}
  .article-toc li.is-sub{padding-right:16px;font-size:.92rem}
  .article-toc a{color:var(--navy);text-decoration:none}
  .article-toc a:hover{color:var(--purple)}
</style>
