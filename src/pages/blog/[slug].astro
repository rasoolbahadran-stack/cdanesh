---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { q } from '../../lib/db';
import { siteUrl } from '../../lib/seo';
import { faNum, faDate } from '../../lib/persian';

interface PostRow {
  id: number;
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  cover_image: string;
  reading_time: number;
  author: string;
  published_at: string;
  seo_title: string;
  seo_description: string;
  category_id: number | null;
}

const { slug } = Astro.params;
const post = await q<PostRow>('SELECT * FROM posts WHERE slug = $1 AND status = $2', [String(slug), 'published']).then((r) => r[0] ?? null);
if (!post) return Astro.redirect('/404', 302);

const category = post.category_id
  ? await q<{ name: string; slug: string }>('SELECT name, slug FROM categories WHERE id = $1', [post.category_id]).then((r) => r[0] ?? null)
  : null;

const related = await q(
  `SELECT slug, title, cover_image, reading_time, published_at FROM posts
   WHERE status='published' AND slug != $1 ${post.category_id ? 'AND category_id = $2' : ''}
   ORDER BY published_at DESC LIMIT 3`,
  post.category_id ? [post.slug, post.category_id] : [post.slug],
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.excerpt,
    image: siteUrl(post.cover_image),
    datePublished: post.published_at,
    dateModified: post.published_at,
    author: { '@type': 'Organization', name: 'کافه‌دانش', url: siteUrl('/') },
    publisher: { '@type': 'Organization', name: 'کافه‌دانش', logo: { '@type': 'ImageObject', url: siteUrl('/img/logo.svg') } },
    mainEntityOfPage: siteUrl(`/blog/${post.slug}`),
    inLanguage: 'fa-IR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'مجله', item: '/blog' },
      { '@type': 'ListItem', position: 3, name: post.title, item: siteUrl(`/blog/${post.slug}`) },
    ],
  },
];
---
<BaseLayout
  title={post.seo_title || post.title}
  description={post.seo_description || post.excerpt}
  ogImage={post.cover_image}
  activePath="/blog"
  schema={schema}
>
  <PageHero
    title={post.title}
    sub={post.excerpt}
    crumbs={[{ label: 'مجله', href: '/blog' }, ...(category ? [{ label: category.name, href: `/blog?cat=${category.slug}` }] : []), { label: '', href: '' }]}
    meta={[`${category ? category.name : 'مقالات'}`, `🗓 ${faDate(post.published_at)}`, `⏱ ${faNum(String(post.reading_time))} دقیقه مطالعه`, `✍️ ${post.author}`]}
  />
  <section class="sec">
    <div class="wrap-narrow">
      <img src={post.cover_image} alt={post.title} width="1344" height="768" style="border-radius:26px;box-shadow:var(--shadow-card);margin-bottom:30px" data-reveal="zoom" fetchpriority="high" />
      <article class="prose-fa" data-reveal set:html={post.content} />
      <div style="margin-top:44px;padding-top:26px;border-top:1px dashed var(--line-light);display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap" data-reveal>
        <a href="/blog" class="btn btn-ghost btn-sm">← همه مقالات مجله</a>
        <a href="/consult" class="btn btn-gold btn-sm">درخواست مشاوره رایگان</a>
      </div>
    </div>
  </section>
  {related.length ? (
    <section class="sec sec-cream" style="padding-top:56px">
      <div class="container">
        <div class="sec-head" data-reveal>
          <span class="section-label">ادامهٔ مسیر</span>
          <h2>مطالب مرتبط</h2>
        </div>
        <div class="grid-3">
          {related.map((p, i) => (
            <a href={`/blog/${p.slug}`} class="post-card" data-reveal style={`--rd:${i * 60}ms`}>
              <div class="post-thumb"><img src={String(p.cover_image)} alt={String(p.title)} width="1344" height="768" loading="lazy" /></div>
              <div class="post-body">
                <div class="post-meta"><span>{faNum(String(p.reading_time))} دقیقه مطالعه</span></div>
                <h3>{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : null}
</BaseLayout>
