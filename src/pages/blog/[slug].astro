---
// ═══ صفحهٔ اختصاصی هر مقاله — /blog/<slug> ═══
// prerender=false → در هر درخواست سمت سرور رندر می‌شود؛
// متن کامل مقاله در HTML واقعی است (قابل خزش)، با متای یکتا، تصویر شاخص،
// نویسنده، تاریخ، دادهٔ ساختاریافته Article و مقالات مرتبط.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicArticles, bySlugFrom, relatedFrom, renderBlocks, postCardHtml, esc, fa, tocFrom } from '../../lib/ssr-articles.mjs';

const { slug } = Astro.params;
const posts = await getPublicArticles();
const a = bySlugFrom(posts, slug || '');

if (!a) {
  return Astro.redirect('/blog');
}

const title = a.seoTitle || (a.title + ' | کافه‌دانش');
const description = a.seoDesc || a.excerpt;
const canonical = 'https://cdanesh.ir/blog/' + a.slug;
const url = canonical;

const toc = tocFrom(a.blocks);
const related = relatedFrom(posts, a, 3);
const shareUrl = url, shareTxt = a.title;

/* نویسندهٔ واقعی — نام قدیمی تیمی به رسول بهادران نگاشت می‌شود */
const AUTHOR_ROLE = 'طراح و توسعه‌دهندهٔ وب و متخصص سئو';
const authorName = (!a.author || a.author === 'تیم محتوای کافه‌دانش') ? 'رسول بهادران' : a.author;
const isPerson = authorName === 'رسول بهادران';

/* تاریخ میلادی برای دادهٔ ساختاریافته (از sort: YYYYMMDD) */
const s = String(a.sort || '');
const isoDate = s.length === 8 ? `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}T08:00:00+03:30` : undefined;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description,
  image: 'https://cdanesh.ir' + a.cover,
  inLanguage: 'fa-IR',
  ...(isoDate ? { datePublished: isoDate, dateModified: isoDate } : {}),
  author: isPerson
    ? { '@type': 'Person', name: authorName, jobTitle: AUTHOR_ROLE, url: 'https://cdanesh.ir/about' }
    : { '@type': 'Organization', name: authorName },
  publisher: { '@type': 'Organization', name: 'کافه‌دانش', url: 'https://cdanesh.ir' },
  mainEntityOfPage: url,
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://cdanesh.ir/' },
    { '@type': 'ListItem', position: 2, name: 'مجله', item: 'https://cdanesh.ir/blog' },
    { '@type': 'ListItem', position: 3, name: a.title, item: url },
  ],
};
---

<SiteLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} slot="head" />

<section class="article-hero">
  <div class="wrap"><div class="article-hero-grid">
    <div class="article-head">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <a href="/blog">مجله</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span>{a.catLabel}</span>
      </nav>
      <div class="article-cats"><span class="chip chip-gold">{a.catLabel}</span></div>
      <h1>{a.title}</h1>
      <div class="article-meta">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4m8-4v4M3 10h18"/></svg> {a.date}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> {fa(a.read)} دقیقه مطالعه</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7h-9m9 5h-9m9 5h-9M4 7l2 2-2 2m2 6 2 2-2 2"/></svg> {authorName}{isPerson && <span class="author-role"> — {AUTHOR_ROLE}</span>}</span>
      </div>
    </div>
    <div class="article-hero-cover">
      <img src={a.cover} alt={a.coverAlt || a.title} width="640" height="400" fetchpriority="high" />
    </div>
  </div></div>
</section>

<section class="section-tight" style="padding-top:10px">
  <div class="wrap"><div class="split">
    <article class="prose article-body-card">
      <Fragment set:html={renderBlocks(a.blocks)} />
      <div class="author-box">
        <img src="/assets/img/founder-rasool.webp" alt="رسول بهادران — بنیان‌گذار کافه‌دانش" width="56" height="56" loading="lazy" />
        <div>
          <b>{authorName}</b>
          <span>{AUTHOR_ROLE} — بنیان‌گذار استودیوی دیجیتال کافه‌دانش در بوشهر</span>
          <a href="/about">بیشتر دربارهٔ نویسنده ←</a>
        </div>
      </div>
      <div class="share-row"><b>اشتراک‌گذاری:</b>
        <a id="share-tg" href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTxt)}`} target="_blank" rel="noopener" aria-label="اشتراک‌گذاری در تلگرام"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></a>
        <a id="share-li" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener" aria-label="اشتراک‌گذاری در لینکدین"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        <button type="button" id="share-copy" aria-label="کپی لینک مقاله"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></button>
        <span class="copy-ok" id="copy-ok" hidden>لینک کپی شد</span>
      </div>
    </article>
    <aside class="article-aside">
      {toc.length > 1 && (
        <div class="aside-card toc-card"><b>فهرست مطالب</b>
          <nav class="toc" aria-label="فهرست مطالب مقاله" id="article-toc">
            {toc.map(sh => <a href={'#' + sh.id} class={sh.level === 3 ? 'toc-l3' : ''}>{sh.t}</a>)}
          </nav>
        </div>
      )}
      <div class="aside-card" style="background:linear-gradient(150deg,rgba(227,185,83,.14),rgba(227,185,83,.04)); border-color:rgba(227,185,83,.35)">
        <b>پروژه مشابهی در ذهن دارید؟</b>
        <p class="muted" style="font-size:14px; margin-bottom:14px">در جلسه کوتاه مشاوره، نیاز شما بررسی و مسیر پیشنهادی ارائه می‌شود.</p>
        <a class="btn btn-gold btn-block" href="/request">درخواست مشاوره رایگان</a>
      </div>
    </aside>
  </div>

  {a.faq && a.faq.length > 0 && (
    <div style="margin-top:64px">
      <div class="section-head side" style="margin-bottom:26px"><h2 class="h3">پرسش‌های متداول این مقاله</h2></div>
      <div class="faq-list" data-article-faq>
        {a.faq.map(it => (
          <div class="faq-item">
            <button class="faq-q" aria-expanded="false">{it.q}
              <span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span>
            </button>
            <div class="faq-a"><div>{it.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  )}

  <div style="margin-top:70px">
    <div class="section-head side" style="margin-bottom:30px"><h2 class="h3">مقالات مرتبط</h2></div>
    <div class="posts-grid" id="article-related">
      {related.map((x, i) => <Fragment set:html={postCardHtml(x, i)} />)}
    </div>
  </div>
  </div>
</section>

<script is:inline>
  (function () {
    var cp = document.getElementById('share-copy');
    if (cp) cp.addEventListener('click', function () {
      (navigator.clipboard ? navigator.clipboard.writeText(location.href) : Promise.reject())
        .then(function () { var ok = document.getElementById('copy-ok'); if (ok) { ok.hidden = false; setTimeout(function () { ok.hidden = true; }, 2200); } })
        .catch(function () {});
    });
    /* اسکرول‌اسپای فهرست مطالب — هایلایت بخش فعلی هنگام خواندن */
    var tocNav = document.getElementById('article-toc');
    if (tocNav && 'IntersectionObserver' in window) {
      var links = Array.prototype.slice.call(tocNav.querySelectorAll('a'));
      var targets = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); }).filter(Boolean);
      var current = null;
      var setActive = function (id) {
        if (id === current) return;
        current = id;
        links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + id); });
      };
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) setActive(en.target.id);
        });
      }, { rootMargin: '-25% 0px -65% 0px', threshold: 0 });
      targets.forEach(function (t) { io.observe(t); });
      window.addEventListener('scroll', function () {
        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
          if (targets.length) setActive(targets[targets.length - 1].id);
        }
      }, { passive: true });
    }
  })();
</script>
</SiteLayout>
