---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { q } from '../../lib/db';
import { siteUrl } from '../../lib/seo';
import { faNum, faDate } from '../../lib/persian';

/* در بیلد استاتیک این مسیر prerender می‌شود؛ در بیلد سرور SSR می‌ماند */
export const prerender = !!process.env.STATIC_BUILD;

export async function getStaticPaths() {
  const rows = await q<{ slug: string }>(`SELECT slug FROM posts WHERE status='published'`);
  return rows.map((r) => ({ params: { slug: String(r.slug) } }));
}

interface PostRow {
  id: number;
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  cover_image: string;
  reading_time: number;
  author: string;
  published_at: string;
  seo_title: string;
  seo_description: string;
  category_id: number | null;
  tags: unknown;
}

const { slug } = Astro.params;
const post = await q<PostRow>('SELECT * FROM posts WHERE slug = $1 AND status = $2', [String(slug), 'published']).then((r) => r[0] ?? null);
if (!post) return Astro.redirect('/404', 302);

const category = post.category_id
  ? await q<{ name: string; slug: string }>('SELECT name, slug FROM categories WHERE id = $1', [post.category_id]).then((r) => r[0] ?? null)
  : null;

const related = await q(
  `SELECT slug, title, cover_image, reading_time, published_at, excerpt FROM posts
   WHERE status='published' AND slug != $1 ${post.category_id ? 'AND category_id = $2' : ''}
   ORDER BY published_at DESC LIMIT 3`,
  post.category_id ? [post.slug, post.category_id] : [post.slug],
);

const articleTags = Array.isArray(post.tags) ? post.tags.map(String).filter(Boolean) : [];
const articleText = String(post.content || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const articleWordCount = articleText ? articleText.split(' ').filter(Boolean).length : 0;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.excerpt,
    image: siteUrl(post.cover_image),
    articleSection: category?.name || 'مقالات تخصصی',
    keywords: articleTags.join('، '),
    wordCount: articleWordCount,
    isAccessibleForFree: true,
    datePublished: post.published_at,
    dateModified: post.published_at,
    author: { '@type': 'Organization', name: 'کافه دانش', url: siteUrl('/') },
    publisher: { '@type': 'Organization', name: 'کافه دانش', logo: { '@type': 'ImageObject', url: siteUrl('/img/logo.svg') } },
    mainEntityOfPage: siteUrl(`/blog/${post.slug}`),
    inLanguage: 'fa-IR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'مجله', item: '/blog' },
      { '@type': 'ListItem', position: 3, name: post.title, item: siteUrl(`/blog/${post.slug}`) },
    ],
  },
];
---
<BaseLayout
  title={post.seo_title || post.title}
  description={post.seo_description || post.excerpt}
  ogImage={post.cover_image}
  ogType="article"
  ogPublishedTime={String(post.published_at)}
  activePath="/blog"
  schema={schema}
>
  <PageHero
    title={post.title}
    sub={post.excerpt}
    crumbs={[{ label: 'مجله', href: '/blog' }, ...(category ? [{ label: category.name, href: `/blog?cat=${category.slug}` }] : []), { label: post.title, href: '' }]}
    meta={[String(category?.name || 'مقالات'), faDate(String(post.published_at)), `${faNum(Number(post.reading_time))} دقیقه مطالعه`, String(post.author)]}
  />

  <section class="section pad-half">
    <div class="container">
      <div class="article-cover" data-reveal="zoom">
        <img src={String(post.cover_image)} alt={String(post.title)} width="1344" height="768" fetchpriority="high" decoding="async" />
      </div>

      <div class="article-body mt-2">
        <article class="prose-fa" data-reveal="up" set:html={String(post.content)} />

        <div class="author-box" data-reveal="up">
          {
            String(post.author || '').includes('رسول') ? (
              <img class="author-box__ava" src="/assets/img/founder-rasool.webp" alt={String(post.author)} width="64" height="64" loading="lazy" style="object-fit:cover" />
            ) : (
              <span class="author-box__ava">{String(post.author || 'ک').trim().charAt(0)}</span>
            )
          }
          <div>
            <b>{String(post.author)}</b>
            <p>
              {String(post.author || '').includes('رسول')
                ? 'طراح و توسعه‌دهندهٔ وب‌سایت — نویسندهٔ این مطلب در کافه دانش؛ با تمرکز بر طراحی سایت، تولید محتوا و سئو.'
                : 'این مطلب توسط تیم کافه دانش با تمرکز بر طراحی سایت، تولید محتوا و سئو نوشته و بازبینی شده است.'}
            </p>
          </div>
        </div>

        <div class="mt-2" style="display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap" data-reveal="up">
          <a href="/blog" class="btn btn--ghost btn--sm">
            <Icon name="arrow-right" size={16} stroke={2.2} />
            همهٔ مقالات مجله
          </a>
          <a href="/consult" class="btn btn--sm">
            <Icon name="send" size={16} stroke={2} />
            درخواست مشاوره رایگان
          </a>
        </div>
      </div>
    </div>
  </section>

  {
    related.length ? (
      <section class="section pad-half bg-lavender">
        <div class="container">
          <div class="section-head section-head--center" data-reveal="up">
            <span class="sub-title">
              <Icon name="doc" size={20} stroke={2} class="sub-ico" />
              ادامهٔ مسیر
            </span>
            <h2 class="sec-title" style="font-size:clamp(22px,3vw,32px)">مطالب مرتبط</h2>
          </div>
          <div class="grid-3">
            {related.map((p, i) => (
              <article class="post-card" data-reveal="up" data-delay={String(i * 70)}>
                <div class="post-card__thumb">
                  <img src={String(p.cover_image)} alt={String(p.title)} width="672" height="384" loading="lazy" decoding="async" />
                </div>
                <div class="post-card__body">
                  <div class="post-card__meta">
                    <Icon name="clock" size={13} stroke={2} />
                    <span>{faNum(Number(p.reading_time))} دقیقه مطالعه</span>
                  </div>
                  <h3><a href={`/blog/${p.slug}`}>{String(p.title)}</a></h3>
                  <p>{String(p.excerpt || '').slice(0, 110)}</p>
                  <a href={`/blog/${p.slug}`} class="post-card__more">
                    ادامهٔ مطلب
                    <Icon name="arrow-left" size={15} stroke={2.2} />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }
</BaseLayout>
