---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { getSiteSettings } from '../lib/seed';

const settings = await getSiteSettings();
const c = settings.contact;
const plan = Astro.url.searchParams.get('plan') || '';
const service = Astro.url.searchParams.get('service') || '';
const defaultPlan = plan || service;
---
<BaseLayout
  title="ثبت درخواست خدمات | کافه دانش"
  description="فرم درخواست مشاوره و سفارش خدمات طراحی سایت، تولید محتوا و سئو — کافه دانش."
  activePath="/consult"
>
  <PageHero
    title="ثبت درخواست خدمات"
    sub="پروژه‌تان را دقیق بگویید تا دقیق جواب بگیرید؛ جلسه اول مشاوره رایگان است."
    crumbs={[{ label: 'ثبت درخواست', href: '' }]}
  />

  <section class="section">
    <div class="container contact-grid">
      <div data-reveal="right">
        <ContactForm type="consult" defaultPlan={defaultPlan} />
      </div>

      <aside class="contact-side" data-reveal="left">
        <h2>به‌جای فرم، ترجیح می‌دهید مستقیم صحبت کنیم؟</h2>
        <p>در ساعات کاری در دسترس هستیم؛ تماس بگیرید یا ایمیل بزنید.</p>
        <ul class="contact-side__list">
          <li>
            <Icon name="phone" size={20} stroke={1.9} />
            <a href={`tel:+98${c.phone.slice(1)}`} dir="ltr">{c.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={20} stroke={1.9} />
            <a href={`mailto:${c.email}`} dir="ltr">{c.email}</a>
          </li>
          <li>
            <Icon name="clock" size={20} stroke={1.9} />
            <span>{c.hours}</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
