---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "مجله آشپزی گلدست | نمونه‌کار کافه‌دانش";
const description = "نمونه مفهومی مجله آشپزی گلدست با ساختار محتوایی سئومحور، دسته‌بندی موضوعی و خبرنامه هفتگی.";
---

<SiteLayout title={title} description={description} schemas={false}>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="./">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="portfolio.html">نمونه‌کارها</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>مجله گلدست</span>
    </nav>
    <span class="eyebrow">نمونه‌کار محتوایی</span>
    <h1 class="h1">مجلکه‌ای که <span class="gold">برای رشد ارگانیک</span> ساخته شده</h1>
    <p class="lead">نمونه‌ای از سایت محتوایی سئومحور: دستور پخت‌های ساختاریافته، دسته‌بندی موضوعی و عضویت خبرنامه — طراحی برای بازدید برگشتی.</p>
    <div class="page-hero-pills">
      <span class="chip chip-gold">محتوایی</span>
      <span class="badge-demo">نمونه مفهومی — پروژه نمایشی</span>
      <span class="chip">سئو محور</span>
      <span class="chip">خبرنامه</span>
      <span class="chip">ساختار مجله‌ای</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="pf-card">
      <div class="pf-head">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pf-url">cdanesh.ir/demo/portfolio-goldast</span>
        <span class="pf-url" style="flex:0">با ماوس بکشید یا اسکرول کنید</span>
      </div>
      <div class="pf-window custom-scrollbar" role="region" aria-label="پیش‌نمایش کامل مجله گلدست — اسکرول داخل قاب">
        <img src="assets/img/pf-mag.webp" alt="نمای کامل صفحه مجله گلدست — نمونه مفهومی" width="1280" height="2889" loading="lazy">
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin-top:18px">این تصویر، نمای کاملِ صفحه‌ی اصلی نمونه است. داخل قاب اسکرول کنید تا همه بخش‌ها را ببینید.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">درباره پروژه</span>
      <h2 class="h2">هدف و روند <span class="gold">اجرای پروژه</span></h2>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">سایت‌های محتوایی با تعداد زیاد صفحه زندگی می‌کنند؛ پس موتور جست‌وجو و خوانایی مهم‌ترین مخاطبان‌اند. در این نمونه، ساختار دستور پخت‌ها طبق داده ساختاریافته چیده شده: زمان آماده‌سازی، میزان مواد و مراحل شماره‌دار تا هم کاربر راضی باشد و هم گوگل صفحه را درست بفهمد.</p>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">خبرنامه هفتگی نقش بازگشت کاربر را دارد؛ عضویت در جای طبیعی صفحه (پایان هر دستور) قرار گرفته نه به‌صورت پاپ‌آپ آزاردهنده. دسته‌بندی موضوعی هم مسیر «از یک دستور به ده دستور مشابه» را کوتاه می‌کند تا کاربر در سایت بماند.</p>
      <div class="duo-points" style="margin-top:24px">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>ساختار دستور پخت با داده ساختاریافته</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>دسته‌بندی موضوعی منظم</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>خبرنامه در مسیر طبیعی خواندن</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>طراحی سبک برای بارگذاری سریع تصاویر</span></li>
      </div>
    </div>
    <aside class="aside-card reveal" data-delay="1">
      <b style="font-size:16px">مشخصات پروژه</b>
      <ul style="margin-top:16px; display:grid; gap:12px; font-size:13.5px; color:var(--mut)">
        <li style="display:flex; justify-content:space-between; gap:12px"><span>نوع پروژه</span><b style="color:var(--txt)">محتوایی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>وضعیت</span><b style="color:var(--warn)">نمونه مفهومی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>خدمات اجراشده</span><b style="color:var(--txt)">طراحی سایت + سئوی محتوا + استراتژی محتوا</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>زمان اجرای مشابه</span><b style="color:var(--txt)">طبق برآورد پروژه</b></li>
      </ul>
      <p class="pkg-note">این نمونه برای نمایش سبک کار و کیفیت اجرای ما ساخته شده است؛ هیچ کسب‌وکار واقعی به آن اشاره ندارد.</p>
      <a class="btn btn-gold btn-block" href="request.html" style="margin-top:18px">پروژه مشابه می‌خواهم</a>
    </aside>
  </div>
</section>

<section class="section-tight" style="padding-bottom:20px">
  <div class="wrap">
    <span class="eyebrow">امکانات کلیدی</span>
    <h2 class="h2" style="margin-top:10px">چه چیزهایی در این نمونه <span class="gold">پیاده شده است</span>؟</h2>
    <div class="feat-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px">
      <div class="feat-card"><b>قالب دستور پخت استاندارد</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">مواد، زمان و مراحل شماره‌دار با امکان چاپ و ذخیره؛ سازگار با اسکیمای Recipe.</p></div>
      <div class="feat-card"><b>دسته‌بندی و برچسب‌گذاری</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">ساختار دو سطحی موضوعی برای مسیرهای کشف محتوای مرتبط.</p></div>
      <div class="feat-card"><b>خبرنامه درون‌محتوایی</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">فرم عضویت در پایان هر مطلب؛ بدون پاپ‌آپ مزاحم.</p></div>
      <div class="feat-card"><b>جست‌وجوی سریع</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">جست‌وجوی زنده دستورها بر اساس نام و مواد اولیه.</p></div>
      <div class="feat-card"><b>سرعت بالا</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">بارگذاری تنبل تصاویر و ساختار سبک برای امتیاز بهتر Core Web Vitals.</p></div>
      <div class="feat-card"><b>طراحی تصویرمحور</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">نمایش درست عکس غذا با نسبت ابعاد منظم و بدون شکستن چیدمان.</p></div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>پروژه‌ای شبیه این نمونه در سر دارید؟</h2>
        <p>در جلسه مشاوره، دقیقاً می‌گوییم چه ساختار و چه امکاناتی برای هدف شما لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="request.html">شروع پروژه</a>
        <a class="btn btn-ghost btn-lg" href="portfolio.html">نمونه‌کارهای دیگر</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
