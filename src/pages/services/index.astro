---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES_SEED } from '../../lib/seed/services-data';

/* سه محور اصلی + خدمات مکمل، از دادهٔ واقعی خدمات */
const mainServices = SERVICES_SEED.filter((s) => ['company-website', 'content', 'seo'].includes(s.slug)).map((s, i) => ({
  ...s,
  ico: ['layout', 'pen', 'search'][i],
  tone: ['purple', 'pink', 'sky'][i],
}));

const extraServices = SERVICES_SEED.filter((s) =>
  ['ecommerce', 'ui-ux', 'speed-optimization', 'support', 'ai-automation'].includes(s.slug),
).map((s, i) => ({
  slug: s.slug,
  title: s.title,
  short_desc: s.short_desc,
  ico: ['cart', 'target', 'gauge', 'shield', 'sparkle'][i],
  tone: ['pink', 'sky', 'mint', 'purple', 'pink'][i],
}));
---
<BaseLayout
  title="خدمات کافه دانش | طراحی سایت، تولید محتوا و سئو"
  description="کافه دانش با تمرکز بر طراحی سایت اختصاصی و تولید محتوای تخصصی فعالیت می‌کند؛ خدمات سئو نیز به‌عنوان گزینه‌ای مکمل برای رشد و دیده‌شدن بهتر سایت ارائه می‌شود."
  activePath="/services"
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'خدمات', item: '/services' },
    ],
  }]}
>
  <PageHero
    title="خدمات کافه دانش"
    sub="تمرکز اصلی ما طراحی سایت و تولید محتواست؛ سئو نیز در صورت نیاز، به‌عنوان مسیر مکمل به پروژه اضافه می‌شود."
    crumbs={[{ label: 'خدمات', href: '' }]}
  />

  {/* سه محور اصلی */}
  <section class="section pad-half">
    <div class="container">
      <div class="grid-3">
        {
          mainServices.map((s, i) => (
            <a href={`/services/${s.slug}`} class="svc-card" data-reveal="up" data-delay={String(i * 100)}>
              <div class={`svc-card__ico svc-card__ico--${s.tone}`}>
                <Icon name={s.ico} size={32} stroke={1.8} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.short_desc}</p>
              <span class="svc-card__more">
                جزئیات خدمت
                <Icon name="arrow-left" size={17} stroke={2.2} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* خدمات مکمل */}
  <section class="section pad-half bg-lavender">
    <div class="container">
      <div class="section-head section-head--center" data-reveal="up">
        <span class="sub-title">
          <Icon name="layers" size={20} stroke={2} class="sub-ico" />
          خدمات تکمیلی
        </span>
        <h2 class="sec-title">هر آنچه یک سایت حرفه‌ای لازم دارد</h2>
        <p class="sec-text">از فروشگاه اینترنتی و تجربه کاربری تا سرعت، پشتیبانی و ابزارهای هوشمند؛ همه زیر یک سقف.</p>
      </div>
      <div class="grid-3">
        {
          extraServices.map((s, i) => (
            <article class="svc-mini" data-reveal="up" data-delay={String((i % 3) * 90)}>
              <div class={`svc-mini__ico svc-card__ico--${s.tone}`}>
                <Icon name={s.ico} size={24} stroke={1.9} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.short_desc}</p>
              <a href={`/services/${s.slug}`} class="svc-mini__link">مشاهده جزئیات ›</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="section pad-half">
    <div class="container">
      <div class="cta-band" data-reveal="zoom">
        <span class="cta-band__deco cta-band__deco--1" aria-hidden="true"></span>
        <span class="cta-band__deco cta-band__deco--2" aria-hidden="true"></span>
        <h2>برای طراحی سایت یا تولید محتوا برنامه دارید؟</h2>
        <p>نیاز و بودجهٔ پروژه را بررسی می‌کنیم؛ در صورت نیاز، خدمات سئو را هم به‌عنوان گزینهٔ مکمل پیشنهاد می‌دهیم.</p>
        <div class="cta-band__btns">
          <a href="/consult" class="btn btn--white btn--lg">درخواست مشاوره</a>
          <a href="/pricing" class="btn btn--ghost-light">دیدن تعرفه‌ها</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
