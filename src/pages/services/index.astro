---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { q } from '../../lib/db';

const services = await q(`SELECT slug, title, short_desc, icon, features, image
  FROM services
  WHERE status = 'published'
    AND slug IN ('company-website', 'content', 'seo')
  ORDER BY CASE slug
    WHEN 'company-website' THEN 1
    WHEN 'content' THEN 2
    WHEN 'seo' THEN 3
    ELSE 4
  END`);
---
<BaseLayout
  title="خدمات کافه دانش | طراحی سایت، تولید محتوا و سئو"
  description="کافه دانش با تمرکز بر طراحی سایت اختصاصی و تولید محتوای تخصصی فعالیت می‌کند؛ خدمات سئو نیز به‌عنوان گزینه‌ای مکمل برای رشد و دیده‌شدن بهتر سایت ارائه می‌شود."
  activePath="/services"
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: '/' },
      { '@type': 'ListItem', position: 2, name: 'خدمات', item: '/services' },
    ],
  }]}
>
  <PageHero
    title="سه حوزهٔ اصلی خدمات کافه دانش"
    sub="تمرکز اصلی ما طراحی سایت و تولید محتواست؛ سئو نیز در صورت نیاز، به‌عنوان مسیر مکمل به پروژه اضافه می‌شود."
    crumbs={[{ label: 'خدمات', href: '' }]}
  />
  <section class="sec">
    <div class="container">
      <div class="grid-3">
        {services.map((s, i) => {
          const feats = Array.isArray(s.features) ? (s.features as string[]) : [];
          return (
            <a href={`/services/${s.slug}`} class="svc-card" data-reveal style={`--rd:${i * 90}ms`}>
              <div class="svc-thumb">
                <img src={String(s.image)} alt={`خدمت ${s.title}`} width="1152" height="864" loading="lazy" />
              </div>
              <div class="svc-body">
                <h3>{s.title}</h3>
                <p>{s.short_desc}</p>
                <div style="font-size:12.5px;color:var(--mut-light);display:flex;flex-direction:column;gap:4px">
                  {feats.slice(0, 3).map((f) => <span>✓ {f}</span>)}
                </div>
                <span class="svc-link">جزئیات خدمت <i>←</i></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
  <section class="sec sec-dark" style="padding-block:64px">
    <div class="container">
      <div class="cta-band" data-reveal="zoom">
        <div class="cta-inner">
          <div>
            <h2>برای طراحی سایت یا تولید محتوا برنامه دارید؟</h2>
            <p>نیاز و بودجهٔ پروژه را بررسی می‌کنیم؛ در صورت نیاز، خدمات سئو را هم به‌عنوان گزینهٔ مکمل پیشنهاد می‌دهیم.</p>
          </div>
          <div class="cta-actions">
            <a href="/consult" class="btn btn-gold btn-lg">درخواست مشاوره</a>
            <a href="/pricing" class="btn btn-ghost-light">دیدن تعرفه‌ها</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>