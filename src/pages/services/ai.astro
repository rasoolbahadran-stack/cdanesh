---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { jsonLdBreadcrumb, jsonLdService } from '../../lib/seo';

const title = 'راهکارهای هوش مصنوعی برای کسب‌وکار';
const description = 'طراحی مسیرهای کاربردی هوش مصنوعی برای کمک به تولید محتوا، پاسخ‌گویی و خودکارسازی فرایندهای تکراری؛ با بررسی نیاز و نظارت انسانی.';
const meta = { title: title + ' | خدمات کافه دانش', description, path: '/services/ai', image: '/img/ai/svc-ai.webp' };
const capabilities = [
  { n: '۰۱', title: 'دستیارهای محتوایی', text: 'آماده‌سازی پیش‌نویس، ایده، ساختار مقاله و پیشنهاد عنوان؛ با بازبینی و تأیید نهایی انسان.' },
  { n: '۰۲', title: 'اتوماسیون فرایندها', text: 'شناسایی کارهای تکراری و طراحی گردش‌کارهای مشخص برای کاهش ورود دستی اطلاعات.' },
  { n: '۰۳', title: 'دستیار پاسخ‌گویی', text: 'طراحی تجربه پاسخ‌گویی بر پایه اطلاعات تأییدشده کسب‌وکار و ارجاع موارد مبهم به اپراتور.' },
];
const steps = ['شناخت فرایند و مسئله واقعی کسب‌وکار', 'انتخاب مدل و ابزار متناسب با سطح محرمانگی و هزینه', 'طراحی نمونه اولیه و تعریف معیار ارزیابی', 'آزمایش، اصلاح و تحویل مستندات استفاده'];
---
<BaseLayout meta={meta} current="/services" extraJsonLd={[jsonLdService(title, description, meta.path), jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'خدمات', url: '/services' }, { name: title, url: meta.path }])]}>
  <PageHero title={title} sub="هوش مصنوعی زمانی ارزشمند است که یک مسئله واقعی را حل کند؛ نه اینکه فقط به سایت یک عنوان پرزرق‌وبرق اضافه شود." crumbs={[{ label: 'خانه', href: '/' }, { label: 'خدمات', href: '/services' }, { label: 'هوش مصنوعی' }]} />
  <section class="section"><div class="container">
    <div class="ai-service-hero">
      <div><span class="service-tag">AI & AUTOMATION</span><h2>ابزار هوشمند، با هدف مشخص و کنترل انسانی</h2><p>از تولید پیش‌نویس محتوا تا سامان‌دهی پاسخ‌ها و اتصال ابزارها، ابتدا فرایند فعلی را بررسی می‌کنیم. سپس راهکاری پیشنهاد می‌دهیم که قابل سنجش، قابل نگهداری و متناسب با داده‌های کسب‌وکار باشد.</p><a class="btn" href="/consult?service=ai">درخواست بررسی نیاز</a></div>
      <img src="/img/ai/svc-ai.webp" alt="تصویر مفهومی راهکارهای هوش مصنوعی کافه دانش" width="640" height="480" loading="lazy" decoding="async" />
    </div>
  </div></section>
  <section class="section bg-soft"><div class="container"><div class="section-head"><span class="section-head__tag">کاربردها</span><h2>چه چیزی می‌توان طراحی کرد؟</h2></div><div class="ai-service-grid">{capabilities.map((item)=><article class="card"><span>{item.n}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><span class="section-head__tag">فرایند همکاری</span><h2>از مسئله تا راهکار قابل ارزیابی</h2></div><ol class="ai-service-steps">{steps.map((step)=><li>{step}</li>)}</ol><p class="ai-disclaimer">نوع مدل، هزینه استفاده و امکان اتصال به سرویس‌های بیرونی پس از نیازسنجی مشخص می‌شود. تا پیش از راه‌اندازی و آزمون اتصال واقعی، هیچ قابلیت هوش مصنوعی به‌عنوان سرویس فعال معرفی نخواهد شد.</p></div></section>
  <CtaBand title="آیا بخشی از کارهای کسب‌وکارتان تکراری است؟" sub="فرایند را توضیح دهید تا امکان‌سنجی کنیم که هوش مصنوعی واقعاً چه کمکی می‌تواند بکند." />
</BaseLayout>
<style>
.ai-service-hero{display:grid;gap:24px;align-items:center}.ai-service-hero h2{font-size:clamp(1.45rem,3vw,2rem);color:var(--navy);line-height:1.6}.ai-service-hero p,.ai-service-grid p{color:var(--mut);line-height:2}.ai-service-hero img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:var(--r-xl);box-shadow:var(--shadow-card)}.service-tag{color:var(--purple);font-size:.78rem;font-weight:800;letter-spacing:.08em}.ai-service-grid{display:grid;gap:16px}.ai-service-grid .card{padding:22px}.ai-service-grid .card>span{color:var(--purple);font-weight:900}.ai-service-grid h3{color:var(--navy)}.ai-service-steps{display:grid;gap:12px;padding-right:22px;line-height:2}.ai-disclaimer{padding:16px 20px;border-right:3px solid var(--purple);background:var(--bg-soft,#f8f7fc);border-radius:var(--r-md);color:var(--mut);line-height:2}@media(min-width:850px){.ai-service-hero{grid-template-columns:1.1fr .9fr;gap:50px}.ai-service-grid{grid-template-columns:repeat(3,1fr)}.ai-service-steps{grid-template-columns:repeat(2,1fr);padding-right:24px}}
</style>
