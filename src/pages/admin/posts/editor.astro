---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="ویرایشگر مقاله">
  <div class="admin-page-head" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px">
    <div><h1 id="editor-heading" style="margin:0">مقاله جدید</h1><p style="color:var(--mut);margin:4px 0">ویرایش دیداری یا کد HTML؛ تصویرها از کتابخانه رسانه</p></div>
    <a href="/admin/posts" class="btn btn--outline btn--sm">← بازگشت به فهرست</a>
  </div>
  <form id="post-editor-form" class="panel" style="padding:20px;display:grid;gap:16px">
    <input type="hidden" name="id" />
    <div class="form-grid">
      <div class="form-field full"><label for="post-title">عنوان مقاله</label><input id="post-title" name="title" required maxlength="200" placeholder="عنوان فارسی مقاله را بنویسید" /></div>
      <div class="form-field"><label for="post-slug">نشانی انگلیسی (Slug)</label><input id="post-slug" name="slug" required dir="ltr" style="text-align:left" placeholder="ecommerce-design-principles" /><small class="hint">پس از واردکردن عنوان، پیشنهاد خودکار ساخته می‌شود؛ امکان ویرایش دستی دارید.</small></div>
      <div class="form-field"><label for="post-category">دسته‌بندی</label><input id="post-category" name="category" value="وب و سئو" /></div>
      <div class="form-field full"><label for="post-excerpt">خلاصه مقاله</label><textarea id="post-excerpt" name="excerpt" rows="2" maxlength="600" placeholder="خلاصه‌ای کوتاه برای معرفی مقاله"></textarea></div>
      <div class="form-field full"><label>تصویر شاخص</label><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><input id="post-cover" name="cover" dir="ltr" style="direction:ltr;text-align:left;flex:1;min-width:220px" placeholder="/uploads/..." /><button type="button" id="pick-cover" class="btn btn--outline btn--sm">انتخاب از رسانه‌ها</button></div><img id="cover-preview" alt="پیش‌نمایش تصویر شاخص" style="display:none;max-width:260px;border-radius:12px;margin-top:8px" /></div>
      <div class="form-field"><label for="post-read">زمان مطالعه (دقیقه)</label><input id="post-read" name="read_minutes" type="number" min="1" max="120" value="6" /></div>
    </div>
    <div class="form-field full"><label>محتوای مقاله</label><div id="post-content-editor"></div><small class="hint">برای درج عکس داخل متن از آیکون تصویر در نوار ابزار استفاده کن. دکمه «&lt;/&gt;» حالت ویرایش مستقیم HTML را باز می‌کند.</small></div>
    <div class="editor-actions" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--a-line);padding-top:16px">
      <button type="button" id="save-draft" class="btn btn--outline">ذخیره پیش‌نویس</button>
      <button type="button" id="publish-post" class="btn btn--sm">انتشار مقاله</button>
      <button type="button" id="preview-post" class="btn btn--outline" disabled>پیش‌نمایش</button>
      <span id="save-status" role="status" style="color:var(--mut);font-size:.9rem"></span>
    </div>
  </form>
  <style>
    #post-editor-form{background:#fff;border:1px solid var(--a-line);border-radius:16px}
    #post-editor-form input,#post-editor-form textarea,#post-editor-form select{width:100%;border:1px solid var(--a-line);border-radius:9px;padding:10px 12px;font-family:inherit}
    #post-content-editor .editor-area{min-height:360px;padding:18px;border:1px solid var(--a-line);border-radius:0 0 10px 10px;direction:rtl;text-align:right;line-height:2;outline:none}
    #post-content-editor .editor-toolbar{display:flex;gap:5px;flex-wrap:wrap;padding:8px;background:#f6f4fb;border:1px solid var(--a-line);border-radius:10px 10px 0 0}
    #post-content-editor .ed-btn{min-width:34px;height:34px;border:1px solid #e5e0ef;border-radius:7px;background:#fff;color:#39304e}
    #post-content-editor .ed-btn:hover{background:#eee8fb}
    #post-content-editor .editor-footer{display:flex;justify-content:space-between;color:var(--mut);font-size:12px;padding:7px 2px}
    @media(max-width:720px){#post-editor-form{padding:12px}.editor-actions>*{flex:1}}
  </style>
  <script>
    import { initEditor, openMediaPicker, toast } from '../../../scripts/admin';
    const form=document.querySelector('#post-editor-form') as HTMLFormElement;
    const editor=initEditor('post-content-editor','');
    const status=document.querySelector('#save-status') as HTMLElement;
    const heading=document.querySelector('#editor-heading') as HTMLElement;
    const idInput=form.querySelector('[name=id]') as HTMLInputElement;
    const titleInput=form.querySelector('[name=title]') as HTMLInputElement;
    const slugInput=form.querySelector('[name=slug]') as HTMLInputElement;
    const coverInput=form.querySelector('[name=cover]') as HTMLInputElement;
    const preview=document.querySelector('#cover-preview') as HTMLImageElement;
    const previewBtn=document.querySelector('#preview-post') as HTMLButtonElement;
    let manualSlug=false;
    const words:Record<string,string>={'اصول':'principles','طراحی':'design','فروشگاه':'store','اینترنتی':'ecommerce','فروشگاهی':'ecommerce','حرفه':'professional','حرفه‌ای':'professional','راهنمای':'guide','سایت':'website','وب':'web','سئو':'seo','محتوا':'content','دیجیتال':'digital','کسب':'business','و':'and','کار':'business','امنیت':'security','بازاریابی':'marketing','تجربه':'experience','کاربری':'user','قیمت':'pricing','آموزش':'tutorial'};
    const fallbackSlug=(v:string)=>v.toLowerCase().trim().replace(/[،؛؟!,:]/g,' ').split(/\s+/).map(x=>words[x]||x.replace(/[^a-z0-9-]/g,'')).filter(Boolean).join('-').replace(/-+/g,'-').replace(/^-|-$/g,'')||'new-article';
    titleInput.addEventListener('input',()=>{if(!manualSlug)slugInput.value=fallbackSlug(titleInput.value);});
    slugInput.addEventListener('input',()=>{manualSlug=true;});
    titleInput.addEventListener('blur',async()=>{
      if(!titleInput.value.trim())return;
      try{
        const r=await fetch('/api/admin/assistant',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({task:'slug',title:titleInput.value})});
        if(r.ok&&!manualSlug){const j=await r.json();if(j.text)slugInput.value=j.text.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');}
      }catch{}
    });
    coverInput.addEventListener('input',()=>{preview.src=coverInput.value;preview.style.display=coverInput.value?'block':'none';});
    document.querySelector('#pick-cover')?.addEventListener('click',()=>openMediaPicker((url)=>{coverInput.value=url;preview.src=url;preview.style.display='block';}));
    const queryId=new URLSearchParams(location.search).get('id');
    async function load(){
      if(!queryId)return;
      const r=await fetch('/api/admin/posts');const j=await r.json();
      const row=(j.rows||[]).find((x:any)=>String(x.id)===queryId);
      if(!row){status.textContent='مقاله موردنظر پیدا نشد';return;}
      idInput.value=String(row.id);titleInput.value=row.title||'';slugInput.value=row.slug||'';manualSlug=true;
      (form.querySelector('[name=category]') as HTMLInputElement).value=row.category||'عمومی';
      (form.querySelector('[name=excerpt]') as HTMLTextAreaElement).value=row.excerpt||'';
      (form.querySelector('[name=read_minutes]') as HTMLInputElement).value=String(row.read_minutes||6);
      coverInput.value=row.cover||'';if(row.cover){preview.src=row.cover;preview.style.display='block';}
      editor.setHtml(row.content||'');heading.textContent='ویرایش مقاله';previewBtn.disabled=false;
      document.querySelector('#publish-post')!.textContent=row.published?'ذخیره و به‌روزرسانی':'انتشار مقاله';
    }
    async function save(published:boolean){
      const title=titleInput.value.trim(),slug=slugInput.value.trim();
      if(!title||!slug){status.textContent='عنوان و نشانی مقاله الزامی است';return;}
      status.textContent='در حال ذخیره…';
      const body={id:Number(idInput.value)||undefined,title,slug,category:(form.querySelector('[name=category]') as HTMLInputElement).value,excerpt:(form.querySelector('[name=excerpt]') as HTMLTextAreaElement).value,read_minutes:Number((form.querySelector('[name=read_minutes]') as HTMLInputElement).value)||6,cover:coverInput.value,content:editor.getHtml(),published};
      try{
        const r=await fetch('/api/admin/posts',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(body)});
        const j=await r.json();
        if(!r.ok||!j.ok){status.textContent=j.error||'ذخیره ناموفق بود';return;}
        if(j.id){idInput.value=String(j.id);previewBtn.disabled=false;if(!history.state?.postId)history.replaceState({postId:j.id},'', '/admin/posts/editor?id='+j.id);}
        status.textContent=published?'مقاله منتشر و ذخیره شد ✓':'پیش‌نویس ذخیره شد ✓';
        toast(status.textContent);heading.textContent=published?'مقاله منتشرشده':'پیش‌نویس مقاله';
        document.querySelector('#publish-post')!.textContent=published?'ذخیره و به‌روزرسانی':'انتشار مقاله';
      }catch{status.textContent='ارتباط با سرور برقرار نشد';}
    }
    document.querySelector('#save-draft')?.addEventListener('click',()=>save(false));
    document.querySelector('#publish-post')?.addEventListener('click',()=>save(true));
    previewBtn.addEventListener('click',()=>{if(idInput.value)window.open('/admin/preview?type=posts&id='+idInput.value,'_blank','noopener');});
    load();
  </script>
</AdminLayout>
