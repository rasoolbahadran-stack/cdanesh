---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import EntityAdmin from '../../components/admin/EntityAdmin.astro';
const config = {
 entity:'projects', title:'نمونه‌کارها',
 help:'مدیریت کامل نمونه‌کارها: معرفی پروژه، تصویر اصلی، گالری، لینک نسخه زنده، وضعیت انتشار و تنظیمات مستقل سئو. ویرایشگر، کتابخانه رسانه و پیش‌نمایش از ابزارهای Astro استفاده می‌کنند.',
 columns:[
  {key:'cover_image',label:'تصویر',type:'thumb'},{key:'title',label:'عنوان'},{key:'category',label:'دسته'},
  {key:'status',label:'انتشار',type:'badge'},{key:'display_status',label:'وضعیت نمایش'},{key:'sort_order',label:'ترتیب',type:'num'}
 ],
 fields:[
  {key:'title',label:'عنوان پروژه',type:'text',required:true},
  {key:'slug',label:'نشانی انگلیسی (Slug)',type:'text',required:true},
  {key:'category',label:'دسته‌بندی',type:'text'},
  {key:'summary',label:'خلاصه پروژه',type:'textarea',full:true},
  {key:'content',label:'شرح کامل پروژه',type:'editor',full:true},
  {key:'cover_image',label:'تصویر اصلی',type:'image'},
  {key:'preview_webp',label:'تصویر پیش‌نمایش WebP',type:'image'},
  {key:'gallery',label:'گالری تصاویر',type:'gallery',full:true},
  {key:'tags',label:'برچسب‌ها',type:'lines',hint:'هر برچسب در یک خط'},
  {key:'url',label:'لینک نسخه زنده',type:'text'},
  {key:'note',label:'یادداشت داخلی',type:'textarea',full:true},
  {key:'sort_order',label:'ترتیب نمایش',type:'number'},
  {key:'status',label:'وضعیت انتشار',type:'select',options:['published','draft'],labels:['منتشرشده','پیش‌نویس']},
  {key:'display_status',label:'وضعیت نمایشی کارت',type:'select',options:['published','conceptual','soon'],labels:['نسخه زنده','نمونه مفهومی','به‌زودی']},
  {key:'seo_title',label:'عنوان سئو',type:'text'},
  {key:'seo_description',label:'توضیحات سئو',type:'textarea',full:true},
  {key:'canonical_url',label:'Canonical URL',type:'text'},
  {key:'og_title',label:'عنوان اشتراک‌گذاری',type:'text'},
  {key:'og_description',label:'توضیح اشتراک‌گذاری',type:'textarea',full:true},
  {key:'og_image',label:'تصویر اشتراک‌گذاری',type:'image'},
  {key:'noindex',label:'عدم ایندکس در موتورهای جست‌وجو',type:'checkbox'}
 ]
};
---
<AdminLayout title="مدیریت نمونه‌کارها" crumb="محتوای سایت › نمونه‌کارها"><EntityAdmin config={config}/></AdminLayout>
