---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { q } from '../../lib/db';
const entity = String(Astro.url.searchParams.get('entity') || 'posts');
const id = Number(Astro.url.searchParams.get('id') || 0);
const valid = ['posts', 'pages'].includes(entity) && id > 0;
let revisions: Array<Record<string, unknown>> = [];
if (valid) {
  try { revisions = await q('SELECT id, created_at, snapshot FROM content_revisions WHERE entity=$1 AND entity_id=$2 ORDER BY created_at DESC LIMIT 30', [entity, id]); } catch {}
}
const dateFa = (v: unknown) => new Intl.DateTimeFormat('fa-IR-u-ca-persian', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(String(v)));
const views = revisions.map((r) => {
  const snap = (r.snapshot || {}) as Record<string, unknown>;
  return { id: String(r.id), title: String(snap.title || 'بدون عنوان'), status: String(snap.status || '—'), excerpt: String(snap.excerpt || '').slice(0, 220), date: dateFa(r.created_at) };
});
---
<AdminLayout title="تاریخچه نسخه‌های محتوا">
  <div style="max-width:1100px;margin:auto;padding:26px">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap">
      <div><h1 style="margin:0">تاریخچه و بازیابی نسخه‌ها</h1><p style="color:var(--a-muted);margin:4px 0">نسخه قبلی محتوا پیش از ویرایش نگهداری می‌شود.</p></div>
      <a href={entity === 'posts' ? '/admin/posts' : '/admin/pages'} class="btn btn-ghost">بازگشت</a>
    </div>
    {!valid ? <div class="admin-card" style="margin-top:18px">درخواست تاریخچه معتبر نیست.</div> : views.length ? (
      <div style="display:grid;gap:12px;margin-top:18px">
        {views.map((r) => <article class="admin-card">
          <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center">
            <div><b>{r.title}</b><p style="font-size:12px;color:var(--a-muted);margin:4px 0">ذخیره‌شده در {r.date} · وضعیت: {r.status}</p><p style="font-size:12px;color:var(--a-muted);margin:0">{r.excerpt}</p></div>
            <button type="button" class="btn btn-ghost" data-restore={r.id}>بازیابی این نسخه</button>
          </div>
        </article>)}
      </div>
    ) : <div class="admin-card" style="margin-top:18px">هنوز نسخه قبلی ذخیره نشده است. پس از ویرایش بعدی، نسخه قبلی در این بخش نگهداری می‌شود.</div>}
  </div>
  <script>
    document.querySelectorAll('[data-restore]').forEach((btn) => btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      if (!confirm('نسخه قبلی جایگزین محتوای فعلی شود؟ نسخه فعلی نیز پیش از بازیابی ذخیره خواهد شد.')) return;
      el.setAttribute('disabled', 'true');
      try {
        const r = await fetch('/api/admin/revisions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ entity: new URLSearchParams(location.search).get('entity'), revisionId: Number(el.dataset.restore) }) });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.message || 'بازیابی انجام نشد');
        alert(j.message); location.reload();
      } catch (e) { alert((e as Error).message); el.removeAttribute('disabled'); }
    }));
  </script>
</AdminLayout>
