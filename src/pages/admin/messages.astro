---
export const prerender=false;import AdminLayout from '../../layouts/AdminLayout.astro';import {dbAvailable} from '../../lib/cms-db';const useDb=dbAvailable();
---
<AdminLayout title="درخواست‌ها و پیام‌ها" crumb="ارتباط با مشتریان › صندوق پیام‌ها">
<section class="messages-page"><div class="messages-intro"><div><h2>صندوق پیام‌ها</h2><p>برای مشاهده جزئیات، یک پیام را از فهرست انتخاب کنید.</p></div><button type="button" class="btn btn-ghost btn-sm" id="messages-refresh">↻ تازه‌سازی</button></div>
{!useDb&&<div class="info-strip">اتصال دیتابیس فعال نیست؛ پیام‌ها در دسترس نیستند.</div>}
<div class="message-filters" role="tablist"><button type="button" class="active" data-view="active">همه پیام‌های فعال</button><button type="button" data-view="new">خوانده‌نشده</button><button type="button" data-view="read">خوانده‌شده</button><button type="button" data-view="replied">پاسخ‌داده‌شده</button><button type="button" data-view="archived">بایگانی</button><button type="button" data-view="all">همه</button></div>
<div class="messages-layout"><section class="panel message-list-panel"><div class="panel-head"><h2 id="message-list-title">پیام‌های فعال</h2><span id="message-count" class="badge badge-gold">۰ پیام</span></div><div id="message-list" class="message-list"><div class="empty-state">در حال بارگذاری…</div></div></section><section class="panel message-detail-panel" id="message-detail"><div class="empty-state"><div class="big">✉</div>برای مشاهده جزئیات، یک پیام را انتخاب کنید.</div></section></div></section>
<script>
document.addEventListener('DOMContentLoaded',()=>{
type M={id:number;name:string;email:string;phone:string;company:string;service:string;kind:string;message:string;status:string;admin_note:string;starred:boolean;created_at:string;is_read:boolean};
const list=document.getElementById('message-list') as HTMLElement,detail=document.getElementById('message-detail') as HTMLElement,count=document.getElementById('message-count') as HTMLElement,title=document.getElementById('message-list-title') as HTMLElement,tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));let rows:M[]=[],view='active',selected:number|null=null;
const fa=(n:number)=>new Intl.NumberFormat('fa-IR').format(n),date=(v:string)=>new Intl.DateTimeFormat('fa-IR-u-ca-persian',{dateStyle:'medium',timeStyle:'short'}).format(new Date(v)),labels:Record<string,string>={new:'خوانده‌نشده',read:'خوانده‌شده',replied:'پاسخ‌داده‌شده',archived:'بایگانی‌شده'},titles:Record<string,string>={active:'پیام‌های فعال',new:'خوانده‌نشده',read:'خوانده‌شده',replied:'پاسخ‌داده‌شده',archived:'پیام‌های بایگانی‌شده',all:'تمام پیام‌ها'};
async function patch(id:number,data:Record<string,unknown>){const r=await fetch('/api/admin/messages',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,...data})}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.message||'عملیات ناموفق بود');}
function btn(t:string,fn:()=>void,kind='btn-ghost'){const b=document.createElement('button');b.type='button';b.className='btn btn-sm '+kind;b.textContent=t;b.addEventListener('click',fn);return b;}
function renderList(){list.innerHTML='';count.textContent=fa(rows.length)+' پیام';title.textContent=titles[view]||'پیام‌ها';if(!rows.length){const e=document.createElement('div');e.className='empty-state';e.textContent=view==='archived'?'پیامی در بایگانی وجود ندارد.':'پیامی برای نمایش وجود ندارد.';list.append(e);return;}rows.forEach(m=>{const b=document.createElement('button');b.type='button';b.className='message-row'+(m.id===selected?' selected':'')+(m.status==='new'?' unread':'');const top=document.createElement('span');top.className='message-row-top';const n=document.createElement('b');n.textContent=m.name||'بدون نام';const st=document.createElement('small');st.className='message-status';st.textContent=labels[m.status]||m.status;top.append(n,st);const preview=document.createElement('span');preview.className='message-preview';preview.textContent=(m.message||'بدون متن').replace(/\s+/g,' ').slice(0,110);const foot=document.createElement('span');foot.className='message-row-foot';foot.textContent=date(m.created_at)+(m.starred?' · ⭐ مهم':'');b.append(top,preview,foot);b.addEventListener('click',()=>open(m.id));list.append(b);});}
function renderDetail(m:M){detail.innerHTML='';const head=document.createElement('div');head.className='message-detail-head';const h=document.createElement('h2');h.textContent=m.name||'بدون نام';const sub=document.createElement('p');sub.textContent=(m.kind||'پیام')+' · '+date(m.created_at);head.append(h,sub);const body=document.createElement('div');body.className='message-detail-body';const meta=document.createElement('div');meta.className='message-meta';[['تلفن',m.phone],['ایمیل',m.email],['شرکت',m.company],['خدمت',m.service]].forEach(([k,v])=>{if(!v)return;const x=document.createElement('div');x.className='message-meta-item';const l=document.createElement('small');l.textContent=k;const val=document.createElement('b');val.textContent=v;x.append(l,val);if(k==='تلفن'){const a=document.createElement('a');a.href='tel:'+v;a.textContent='تماس';x.append(a);}if(k==='ایمیل'){const a=document.createElement('a');a.href='mailto:'+v;a.textContent='ارسال ایمیل';x.append(a);}meta.append(x);});const msg=document.createElement('p');msg.className='message-full-text';msg.textContent=m.message||'متنی ثبت نشده است.';const label=document.createElement('label');label.textContent='یادداشت داخلی مدیر';const note=document.createElement('textarea');note.className='message-note';note.rows=3;note.value=m.admin_note||'';const actions=document.createElement('div');actions.className='message-actions';
actions.append(btn('ذخیره یادداشت',async()=>{try{await patch(m.id,{admin_note:note.value});await load(view);open(m.id);}catch(e){alert((e as Error).message);}},'btn-gold'),btn(m.starred?'حذف نشان مهم':'⭐ علامت‌گذاری مهم',async()=>{try{await patch(m.id,{starred:!m.starred});await load(view);open(m.id);}catch(e){alert((e as Error).message);}}));
if(m.status==='archived')actions.append(btn('بازگردانی به پیام‌های فعال',async()=>{try{await patch(m.id,{status:'read'});selected=m.id;await load('active');open(m.id);}catch(e){alert((e as Error).message);}},'btn-gold'));else{if(m.status==='new')actions.append(btn('علامت‌گذاری خوانده‌شده',async()=>{try{await patch(m.id,{status:'read'});await load(view);open(m.id);}catch(e){alert((e as Error).message);}}));if(m.status!=='replied')actions.append(btn('علامت‌گذاری پاسخ‌داده‌شده',async()=>{try{await patch(m.id,{status:'replied'});await load(view);open(m.id);}catch(e){alert((e as Error).message);}}));actions.append(btn('بایگانی پیام',async()=>{if(!confirm('پیام به بایگانی منتقل شود؟ حذف نمی‌شود و قابل بازیابی است.'))return;try{await patch(m.id,{status:'archived'});selected=null;await load(view);detail.innerHTML='<div class="empty-state">پیام بایگانی شد و در فیلتر بایگانی قابل بازیابی است.</div>';}catch(e){alert((e as Error).message);}}));}
body.append(meta,msg,label,note,actions);detail.append(head,body);}
async function open(id:number){const m=rows.find(x=>x.id===id);if(!m)return;selected=id;if(m.status==='new'){try{await patch(id,{status:'read'});m.status='read';m.is_read=true;}catch(e){alert((e as Error).message);}}renderList();renderDetail(m);}
async function load(v=view){view=v;tabs.forEach(t=>t.classList.toggle('active',t.dataset.view===view));list.innerHTML='<div class="empty-state">در حال بارگذاری…</div>';try{const r=await fetch('/api/admin/messages?view='+encodeURIComponent(view),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.message||'دریافت پیام‌ها ناموفق بود');rows=Array.isArray(j.rows)?j.rows:[];renderList();if(selected!==null&&rows.some(x=>x.id===selected))renderDetail(rows.find(x=>x.id===selected)!);else detail.innerHTML='<div class="empty-state"><div class="big">✉</div>برای مشاهده جزئیات، یک پیام را انتخاب کنید.</div>';}catch(e){list.textContent='خطا در دریافت پیام‌ها: '+(e as Error).message;}}
tabs.forEach(t=>t.addEventListener('click',()=>{selected=null;load(t.dataset.view||'active');}));document.getElementById('messages-refresh')?.addEventListener('click',()=>load(view));load('active');
});
</script></AdminLayout>