---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="گزارش خطاهای سایت">
<style>.err-wrap{max-width:1400px;padding:26px;margin:auto}.err-table{width:100%;border-collapse:collapse}.err-table th,.err-table td{padding:11px;border-bottom:1px solid var(--a-line);text-align:right;font-size:12px;vertical-align:top}.err-table th{color:var(--a-muted);background:#f8f8fc}.err-msg{max-width:430px;overflow-wrap:anywhere}.err-status{border:1px solid var(--a-line);border-radius:8px;padding:6px;font:inherit;background:#fff}.err-source{border-radius:20px;padding:2px 8px;background:#f0edff;color:#6040a5;font-size:11px}</style>
<div class="err-wrap"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><h1 style="margin:0">گزارش خطاهای سایت</h1><p style="color:var(--a-muted);margin:4px 0">خطاهای ثبت‌شده از مرورگر و سرور</p></div><a href="/admin" class="btn btn-ghost">بازگشت به داشبورد</a></div>
<div class="panel" style="margin-top:18px"><div class="panel-head"><h2>آخرین گزارش‌ها</h2><button id="refresh-errors" class="btn btn-ghost btn-sm">تازه‌سازی</button></div><div class="table-scroll"><table class="err-table"><thead><tr><th>زمان</th><th>منبع</th><th>صفحه</th><th>شرح خطا</th><th>شناسه پیگیری</th><th>وضعیت</th></tr></thead><tbody id="error-rows"><tr><td colspan="6">در حال بارگذاری…</td></tr></tbody></table></div></div></div>
<script>
document.addEventListener('DOMContentLoaded',()=>{const body=document.getElementById('error-rows')!;const labels:Record<string,string>={open:'جدید',investigating:'در حال بررسی',resolved:'رفع‌شده'};
async function load(){body.innerHTML='<tr><td colspan="6">در حال بارگذاری…</td></tr>';try{const r=await fetch('/api/admin/errors');const j=await r.json();if(!r.ok||!j.ok)throw new Error();body.innerHTML='';if(!j.rows.length){body.innerHTML='<tr><td colspan="6">هنوز خطایی ثبت نشده است.</td></tr>';return;}j.rows.forEach((x:any)=>{const tr=document.createElement('tr');const cells=[new Intl.DateTimeFormat('fa-IR-u-ca-persian',{dateStyle:'medium',timeStyle:'short'}).format(new Date(x.created_at)),x.source==='server'?'سرور':'مرورگر',x.path,x.message,x.trace_id];cells.forEach((v,i)=>{const td=document.createElement('td');td.textContent=String(v||'—');if(i===3)td.className='err-msg';if(i===1)td.innerHTML='<span class="err-source">'+td.textContent+'</span>';tr.appendChild(td);});const td=document.createElement('td'),sel=document.createElement('select');sel.className='err-status';Object.keys(labels).forEach(k=>{const o=document.createElement('option');o.value=k;o.textContent=labels[k];o.selected=x.status===k;sel.appendChild(o);});sel.addEventListener('change',async()=>{const rr=await fetch('/api/admin/errors',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:x.id,status:sel.value})});if(!rr.ok)alert('ذخیره وضعیت ناموفق بود');});td.appendChild(sel);tr.appendChild(td);body.appendChild(tr);});}catch{body.innerHTML='<tr><td colspan="6">دریافت گزارش‌ها ناموفق بود؛ دوباره تلاش کنید.</td></tr>';}}
document.getElementById('refresh-errors')?.addEventListener('click',load);load();});
</script>
</AdminLayout>
