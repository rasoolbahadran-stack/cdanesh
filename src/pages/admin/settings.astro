---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="تنظیمات سایت" crumb="ارتباط و تنظیمات › تنظیمات عمومی">
  <div class="info-strip">
    <span>ℹ️</span>
    <span>تنظیمات در دیتابیس ذخیره می‌شوند و همهٔ صفحات سایت بلافاصله از آن‌ها استفاده می‌کنند.</span>
  </div>
  <div class="settings-tabs" id="st-tabs">
    <button data-tab="identity" class="active">برند و هویت</button>
    <button data-tab="contact">اطلاعات تماس</button>
    <button data-tab="seo">سئوی پیش‌فرض</button>
    <button data-tab="menu">منوها</button>
    <button data-tab="footer">فوتر</button>
    <button data-tab="homepage">محتوای صفحهٔ اصلی</button>
    <button data-tab="security">🔒 امنیت</button>
  </div>

  <form id="st-form">
    {/* ─── برند ─── */}
    <div class="panel settings-pane active" data-pane="identity">
      <div class="panel-head"><h2>برند و هویت</h2></div>
      <div class="panel-body"><div class="form-grid">
        <div class="form-field"><label>نام فارسی برند</label><input name="identity.brandFa" /></div>
        <div class="form-field"><label>نام لاتین برند</label><input name="identity.brandEn" /></div>
        <div class="form-field full"><label>شعار (tagline)</label><input name="identity.tagline" /></div>
        <div class="form-field"><label>نام طراح / مجری</label><input name="identity.designer" /></div>
        <div class="form-field"><label>مسیر لوگو</label><input name="identity.logoImage" style="direction:ltr;text-align:left" /></div>
        <div class="form-field"><label>مسیر فاوآیکون</label><input name="identity.favicon" style="direction:ltr;text-align:left" placeholder="/img/logo-180.png" /></div>
      </div></div>
    </div>

    {/* ─── تماس ─── */}
    <div class="panel settings-pane" data-pane="contact">
      <div class="panel-head"><h2>اطلاعات تماس</h2></div>
      <div class="panel-body"><div class="form-grid">
        <div class="form-field"><label>ایمیل</label><input name="contact.email" style="direction:ltr;text-align:left" /></div>
        <div class="form-field"><label>تلفن (شماره واقعی)</label><input name="contact.phone" style="direction:ltr;text-align:left" /></div>
        <div class="form-field"><label>نمایش تلفن (فارسی)</label><input name="contact.phoneDisplay" /></div>
        <div class="form-field"><label>ساعات کاری</label><input name="contact.hours" /></div>
        <div class="form-field full"><label>نشانی</label><input name="contact.address" /></div>
        <div class="form-field"><label>لینک گیت‌هاب (اختیاری)</label><input name="contact.github" style="direction:ltr;text-align:left" /></div>
        <div class="form-field"><label>کد امبد نقشه (اختیاری)</label><input name="contact.mapEmbed" style="direction:ltr;text-align:left" /></div>
      </div></div>
    </div>

    {/* ─── سئو ─── */}
    <div class="panel settings-pane" data-pane="seo">
      <div class="panel-head"><h2>سئوی پیش‌فرض</h2></div>
      <div class="panel-body"><div class="form-grid">
        <div class="form-field full"><label>عنوان پیش‌فرض سایت (صفحهٔ اصلی)</label><input name="seo.defaultTitle" /></div>
        <div class="form-field"><label>الگوی عنوان صفحات (%s = عنوان)</label><input name="seo.titlePattern" /></div>
        <div class="form-field"><label>تصویر پیش‌فرض OG</label><input name="seo.ogImage" style="direction:ltr;text-align:left" /></div>
        <div class="form-field full"><label>توضیح پیش‌فرض (Meta Description)</label><textarea name="seo.defaultDescription"></textarea></div>
        <div class="form-field full"><label>کلمات کلیدی (هر کدام در یک خط)</label><textarea name="seo.keywords" data-lines></textarea></div>
      </div></div>
    </div>

    {/* ─── منو ─── */}
    <div class="panel settings-pane" data-pane="menu">
      <div class="panel-head"><h2>منوی اصلی و مگامنو</h2></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:14px">
        <div class="form-field"><label>لینک‌های منوی اصلی — هر خط: «عنوان | آدرس»</label><textarea data-lines name="menu.main"></textarea></div>
        <div class="form-field"><label>دکمهٔ فراخوان منو — «عنوان | آدرس»</label><input data-pair name="menu.cta" /></div>
        <div class="form-field"><label>گروه‌های مگامنو — هر خط: «عنوان | آدرس | توضیح» (گروه‌ها با «###» جدا می‌شوند)</label><textarea data-mega name="menu.megaGroups"></textarea><span class="hint">مثال: طراحی و توسعه وب ### طراحی سایت اختصاصی | /services/company-website | توضیح …</span></div>
      </div>
    </div>

    {/* ─── فوتر ─── */}
    <div class="panel settings-pane" data-pane="footer">
      <div class="panel-head"><h2>فوتر سایت</h2></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:14px">
        <div class="form-field"><label>متن معرفی کوتاه</label><textarea data-lines name="footer.aboutText"></textarea></div>
        <div class="form-field"><label>ستون خدمات — هر خط: «عنوان | آدرس»</label><textarea data-lines name="footer.colServices"></textarea></div>
        <div class="form-field"><label>ستون دسترسی سریع — هر خط: «عنوان | آدرس»</label><textarea data-lines name="footer.colQuick"></textarea></div>
        <div class="form-field"><label>ستون راه‌های ارتباطی — هر خط: «عنوان | آدرس»</label><textarea data-lines name="footer.colContact"></textarea></div>
        <div class="form-field"><label>متن کپی‌رایت</label><input name="footer.copyright" /></div>
      </div>
    </div>

    {/* ─── صفحه اصلی ─── */}
    <div class="panel settings-pane" data-pane="homepage">
      <div class="panel-head"><h2>محتوای صفحهٔ اصلی</h2></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:14px">
        <div class="form-field"><label>عنوان اصلی هیرو (بعد از «؛» با گرادیان طلایی نمایش داده می‌شود)</label><input name="homepage.introTitle" /></div>
        <div class="form-field"><label>متن هیرو</label><textarea data-lines name="homepage.introText"></textarea></div>
        <div class="form-field"><label>عنوان بخش مزیت‌ها</label><input name="homepage.advantagesTitle" /></div>
        <div class="form-field"><label>مزیت‌های همکاری — هر خط: «عنوان | متن»</label><textarea data-pair-lines name="homepage.advantages"></textarea></div>
        <div class="form-field"><label>توانمندی‌ها — هر خط: «عنوان | متن»</label><textarea data-pair-lines name="homepage.capabilities"></textarea></div>
        <div class="form-field"><label>عنوان بخش مراحل</label><input name="homepage.stepsTitle" /></div>
        <div class="form-field"><label>مراحل اجرای پروژه — هر خط: «عنوان | متن»</label><textarea data-pair-lines name="homepage.steps"></textarea></div>
        <div class="form-field"><label>آمار واقعی — هر خط: «عدد | برچسب»</label><textarea data-pair-lines name="homepage.stats"></textarea></div>
        <div class="form-field"><label>عنوان دعوت به مشاوره</label><input name="homepage.ctaTitle" /></div>
        <div class="form-field"><label>متن دعوت به مشاوره</label><textarea data-lines name="homepage.ctaText"></textarea></div>
      </div>
    </div>

    <div class="form-msg" style="display:none"></div>
    <div class="form-actions">
      <button type="submit" class="btn btn-gold">💾 ذخیره تنظیمات</button>
      <span id="st-status" style="font-size:12px;color:var(--a-muted)"></span>
    </div>
  </form>

  {/* ─── امنیت: تغییر رمز مدیر (خارج از فرم تنظیمات) ─── */}
  <div class="panel settings-pane" data-pane="security">
    <div class="panel-head"><h2>🔒 امنیت و دسترسی</h2></div>
    <div class="panel-body" style="display:grid;gap:16px">
      <div class="info-strip" style="margin:0">
        <span>🛡</span>
        <span>ورود با کوکی امن HttpOnly + محدودسازی تلاش ناموفق فعال است. رمز فعلی با متغیر محیطی <code>ADMIN_PASSWORD_HASH</code> یا رمز تغییر‌یافتهٔ دیتابیس کنترل می‌شود. پس از تغییر رمز، همهٔ مسیرهای مدیریتی و API همچنان در سمت سرور کنترل می‌شوند.</span>
      </div>
      <form id="pw-form" style="display:grid;gap:14px;max-width:460px">
        <div class="form-field"><label>رمز فعلی</label><input type="password" name="current" autocomplete="current-password" /></div>
        <div class="form-field"><label>رمز جدید (حداقل ۸ کاراکتر)</label><input type="password" name="next" autocomplete="new-password" /></div>
        <div class="form-field"><label>تکرار رمز جدید</label><input type="password" name="next2" autocomplete="new-password" /></div>
        <div style="display:flex;gap:10px;align-items:center">
          <button type="submit" class="btn btn-gold">تغییر رمز مدیر</button>
          <span id="pw-status" style="font-size:12px;color:var(--a-muted)"></span>
        </div>
      </form>
      <div style="font-size:12.5px;color:var(--a-muted);line-height:2">
        <b>وضعیت سیستم:</b> اتصال دیتابیس و ذخیره‌سازی تصاویر در داشبورد قابل بررسی است. هیچ رمز یا توکنی در این صفحه نمایش داده نمی‌شود.
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const { api, toast } = window.CDA;
      type Rec = Record<string, any>;
      let data: Rec | null = null;

      /* تب‌ها */
      document.querySelectorAll<HTMLButtonElement>('#st-tabs button').forEach((b) => {
        b.addEventListener('click', () => {
          document.querySelectorAll<HTMLButtonElement>('#st-tabs button').forEach((x) => x.classList.remove('active'));
          b.classList.add('active');
          document.querySelectorAll<HTMLElement>('.settings-pane').forEach((p) => p.classList.toggle('active', p.dataset.pane === b.dataset.tab));
        });
      });

      /* helpers */
      const pairsToLines = (arr: any[] | null | undefined) => (arr || []).map((p: any) => `${p.title || p.value || p.label || ''} | ${p.text || p.href || p.desc || ''}`).join('\n');
      const pairsToMega = (groups: any[] | null | undefined) => (groups || []).map((g: any) => {
        const items = (g.items || []).map((it: any) => `${it.label} | ${it.href} | ${it.desc}`).join('\n');
        return `${g.title}\n${items}`;
      }).join('\n###\n');

      function fill() {
        const form = document.getElementById('st-form') as HTMLFormElement;
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) => {
          const path = el.name.split('.');
          let v: any = data;
          for (const p of path) v = v?.[p];
          if (el.dataset.lines !== undefined && Array.isArray(v)) el.value = v.map((x: any) => (typeof x === 'string' ? x : `${x.title || ''} | ${x.text || x.href || ''}`)).join('\n');
          else if (el.name === 'footer.aboutText') el.value = v || '';
          else if (el.name === 'seo.keywords' && Array.isArray(v)) el.value = v.join('\n');
          else if (el.name === 'menu.main' && Array.isArray(v)) el.value = v.map((x: any) => `${x.label} | ${x.href}`).join('\n');
          else if (el.name === 'menu.cta') el.value = `${v?.label || ''} | ${v?.href || ''}`;
          else if (el.name === 'menu.megaGroups') el.value = pairsToMega(v);
          else if (el.dataset.pair !== undefined && v && !Array.isArray(v)) el.value = `${v.label || ''} | ${v.href || ''}`;
          else if (el.dataset.pairLines !== undefined && Array.isArray(v)) el.value = pairsToLines(v);
          else el.value = v ?? '';
        });
      }

      function collect(): Rec {
        const out: Rec = JSON.parse(JSON.stringify(data || {}));
        const form = document.getElementById('st-form') as HTMLFormElement;
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) => {
          const path = el.name.split('.');
          const val = el.value.trim();
          const lines = val.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
          let v: any;
          if (el.name === 'seo.keywords') v = lines;
          else if (el.name === 'menu.main') v = lines.map((l) => { const [label, href] = l.split('|').map((s) => s.trim()); return { label, href: href || '#' }; });
          else if (el.name === 'menu.cta') { const [label, href] = val.split('|').map((s) => s.trim()); v = { label, href: href || '/consult' }; }
          else if (el.name === 'menu.megaGroups') {
            v = val.split('###').map((chunk) => {
              const rows = chunk.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
              const title = rows.shift() || '';
              const items = rows.map((l) => { const [label, href, desc] = l.split('|').map((s) => s.trim()); return { label, href: href || '#', desc: desc || '' }; });
              return { title, items };
            }).filter((g) => g.title);
          } else if (el.dataset.pairLines !== undefined) {
            v = lines.map((l) => { const [title, ...rest] = l.split('|'); return { title: title.trim(), text: rest.join('|').trim() }; });
          } else if (el.name === 'footer.colServices' || el.name === 'footer.colQuick' || el.name === 'footer.colContact') {
            v = lines.map((l) => { const [label, href] = l.split('|').map((s) => s.trim()); return { label, href: href || '#' }; });
          } else {
            v = val;
          }
          let target = out;
          for (let i = 0; i < path.length - 1; i++) {
            if (typeof target[path[i]] !== 'object' || target[path[i]] === null) target[path[i]] = {};
            target = target[path[i]];
          }
          target[path[path.length - 1]] = v;
        });
        return out;
      }

      (async () => {
        const j = await api('/api/admin/settings');
        if (!j.ok) { toast(j.message || 'بارگذاری تنظیمات ناموفق بود', 'err'); return; }
        data = (j.data as Rec) || {};
        fill();
      })();

      document.getElementById('st-form')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = document.getElementById('st-status')!;
        status.textContent = '⏳ در حال ذخیره…';
        const r = await api('/api/admin/settings', 'PUT', collect());
        if (r.ok) { data = (r.data as Rec) || data; status.textContent = '✓ ذخیره شد در دیتابیس'; status.style.color = 'var(--a-green)'; toast(r.message || 'تنظیمات ذخیره شد'); }
        else { status.textContent = '✕ ذخیره نشد'; status.style.color = 'var(--a-red)'; toast(r.message || 'ذخیره ناموفق بود', 'err'); }
      });

      /* تغییر رمز مدیر */
      document.getElementById('pw-form')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const status = document.getElementById('pw-status')!;
        const body = {
          current: (f.querySelector('[name=current]') as HTMLInputElement).value,
          next: (f.querySelector('[name=next]') as HTMLInputElement).value,
          next2: (f.querySelector('[name=next2]') as HTMLInputElement).value,
        };
        if (body.next.length < 8) { toast('رمز جدید باید حداقل ۸ کاراکتر باشد', 'err'); return; }
        if (body.next !== body.next2) { toast('تکرار رمز جدید مطابقت ندارد', 'err'); return; }
        status.textContent = '⏳ در حال تغییر…';
        const r = await api('/api/admin/password', 'POST', body);
        if (r.ok) {
          status.textContent = '✓ رمز تغییر کرد';
          status.style.color = 'var(--a-green)';
          toast(r.message || 'رمز مدیر تغییر کرد');
          f.reset();
        } else {
          status.textContent = '✕ ' + (r.message || 'تغییر ناموفق بود');
          status.style.color = 'var(--a-red)';
          toast(r.message || 'تغییر رمز ناموفق بود', 'err');
        }
      });
    });
  </script>
</AdminLayout>
