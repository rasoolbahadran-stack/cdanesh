---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readAiConfig } from '../../lib/ai';
const config = await readAiConfig().catch(()=>({configured:false,provider:'OpenRouter',model:'openrouter/free',permissions:{draft:true,seo:true,edit:false,publish:false}}));
---
<AdminLayout title="دستیار هوشمند کافه دانش">
<style>
.ai-wrap{max-width:1100px;margin:auto;padding:26px}.ai-grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:16px}.ai-panel{background:#fff;border:1px solid var(--a-line);border-radius:16px;padding:18px;min-width:0}.ai-panel h2{font-size:15px;margin:0 0 12px}.ai-field{display:grid;gap:6px;margin-bottom:12px}.ai-field label{font-size:12px;font-weight:700}.ai-field input,.ai-field select{width:100%;border:1px solid var(--a-line);border-radius:10px;padding:9px 11px;font:inherit}.chat-box{height:480px;overflow:auto;background:#f7f7fb;border-radius:13px;padding:14px;display:flex;flex-direction:column;gap:10px}.bubble{max-width:90%;padding:11px 13px;border-radius:13px;white-space:pre-wrap;line-height:1.9;font-size:13px}.bubble.user{align-self:flex-start;background:#e9e5ff;color:#3f3377}.bubble.assistant{align-self:flex-end;background:white;border:1px solid #e4e4ed;color:#3c4058}.chat-form{display:flex;gap:8px;margin-top:10px}.chat-form textarea{flex:1;min-height:60px;border:1px solid var(--a-line);border-radius:11px;padding:10px;font:inherit}.perm{display:flex;gap:8px;align-items:center;font-size:12px;margin:8px 0}.notice{background:#f5f3ff;border:1px solid #e5defe;color:#50417e;padding:12px;border-radius:12px;font-size:12px;line-height:1.9;margin-bottom:14px}@media(max-width:850px){.ai-grid{grid-template-columns:1fr}.ai-wrap{padding:14px}}
</style>
<div class="ai-wrap">
 <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:16px"><div><h1 style="margin:0">دستیار هوشمند کافه دانش ✨</h1><p style="color:var(--a-muted);margin:4px 0 0">کمک برای تولید محتوا، ویرایش متن و سئو</p></div><a href="/admin" class="btn btn-ghost">بازگشت به داشبورد</a></div>
 <div class="notice">این دستیار از طریق API به سرویس هوش مصنوعی متصل می‌شود و همان نشست ChatGPT فعلی نیست. اشتراک ChatGPT به‌تنهایی کلید API نمی‌دهد. برای شروع می‌توانید OpenRouter را با مدل رایگان <b>openrouter/free</b> تنظیم کنید. سهمیه مدل‌های رایگان ممکن است تغییر کند. کلید در سرور رمزگذاری می‌شود و به مرورگر برگردانده نمی‌شود. در این نسخه دستیار متن و پیشنهاد تولید می‌کند؛ ذخیره یا انتشار محتوا همچنان با اقدام و تأیید مدیر است.</div>
 <div class="ai-grid">
  <section class="ai-panel">
   <h2>تنظیمات اتصال</h2>
   <form id="ai-settings">
    <div class="ai-field"><label>ارائه‌دهنده</label><input value="OpenRouter" disabled /></div>
    <div class="ai-field"><label for="ai-model">مدل</label><select id="ai-model"><option value="openrouter/free" selected={config.model==='openrouter/free'}>انتخاب خودکار مدل رایگان</option><option value={config.model} selected>{config.model}</option></select></div>
    <div class="ai-field"><label for="ai-key">کلید API</label><input id="ai-key" type="password" autocomplete="new-password" placeholder={config.configured?'کلید ثبت شده؛ برای جایگزینی کلید جدید وارد کنید':'کلید OpenRouter را وارد کنید'} /></div>
    <label class="perm"><input type="checkbox" id="perm-draft" checked={config.permissions.draft} /> اجازه پیشنهاد و آماده‌سازی پیش‌نویس</label>
    <label class="perm"><input type="checkbox" id="perm-seo" checked={config.permissions.seo} /> اجازه پیشنهادهای سئو</label>
    <label class="perm"><input type="checkbox" id="perm-edit" checked={config.permissions.edit} /> مجوز ویرایش محتوای موجود (در این نسخه غیرفعال)</label>
    <label class="perm"><input type="checkbox" id="perm-publish" checked={config.permissions.publish} /> مجوز انتشار (همیشه نیازمند تأیید مدیر)</label>
    <button class="btn btn-gold" type="submit" style="width:100%;margin-top:12px">ذخیره اتصال</button>
    <p id="ai-config-status" style="font-size:11px;color:var(--a-muted)">{config.configured?'کلید API ثبت شده است.':'هنوز کلید API ثبت نشده است.'}</p>
   </form>
   <a href="https://openrouter.ai/keys" target="_blank" rel="noopener" style="font-size:12px;color:var(--purple)">دریافت کلید از OpenRouter ↗</a>
  </section>
  <section class="ai-panel">
   <h2>گفت‌وگو با دستیار</h2>
   <div class="chat-box" id="chat-box"><div class="bubble assistant">سلام! درباره تولید مقاله، ساختار محتوا، ویرایش متن یا سئوی کافه دانش چه کمکی لازم داری؟</div></div>
   <form class="chat-form" id="chat-form"><textarea id="chat-input" placeholder="مثلاً برای مقاله طراحی فروشگاه اینترنتی یک ساختار کامل پیشنهاد بده…" required></textarea><button class="btn btn-gold" type="submit">ارسال</button></form>
  </section>
 </div>
</div>
<script>
document.addEventListener('DOMContentLoaded',()=>{
 const settings=document.getElementById('ai-settings') as HTMLFormElement;
 const cfgStatus=document.getElementById('ai-config-status') as HTMLElement;
 settings.addEventListener('submit',async(e)=>{
  e.preventDefault();cfgStatus.textContent='در حال ذخیره…';
  const body={model:(document.getElementById('ai-model') as HTMLSelectElement).value,apiKey:(document.getElementById('ai-key') as HTMLInputElement).value,
   permissions:{draft:(document.getElementById('perm-draft') as HTMLInputElement).checked,seo:(document.getElementById('perm-seo') as HTMLInputElement).checked,edit:(document.getElementById('perm-edit') as HTMLInputElement).checked,publish:(document.getElementById('perm-publish') as HTMLInputElement).checked}};
  try{const r=await fetch('/api/admin/ai-config',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json();cfgStatus.textContent=r.ok&&j.ok?'تنظیمات ذخیره شد.':(j.message||'ذخیره ناموفق بود.');if(r.ok)(document.getElementById('ai-key') as HTMLInputElement).value='';}
  catch{cfgStatus.textContent='ارتباط با سرور برقرار نشد.';}
 });
 const box=document.getElementById('chat-box')!;const form=document.getElementById('chat-form') as HTMLFormElement;const input=document.getElementById('chat-input') as HTMLTextAreaElement;
 const messages:{role:'user'|'assistant';content:string}[]=[];
 function bubble(role:string,content:string){const el=document.createElement('div');el.className='bubble '+role;el.textContent=content;box.appendChild(el);box.scrollTop=box.scrollHeight;}
 form.addEventListener('submit',async(e)=>{e.preventDefault();const content=input.value.trim();if(!content)return;input.value='';messages.push({role:'user',content});bubble('user',content);const btn=form.querySelector('button')!;btn.setAttribute('disabled','true');
  try{const r=await fetch('/api/admin/assistant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages})});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.message||'پاسخ دریافت نشد');messages.push({role:'assistant',content:j.reply});bubble('assistant',j.reply);}
  catch(err){bubble('assistant','خطا: '+(err as Error).message);}finally{btn.removeAttribute('disabled');}
 });
});
</script>
