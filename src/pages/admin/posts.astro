---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAdminPosts, dbAvailable } from '../../lib/cms-db';
const useDb = dbAvailable();
let rows: Array<Record<string, unknown>> = [];
if (useDb) {
  try { rows = (await listAdminPosts()) as unknown as Array<Record<string, unknown>>; } catch { rows = []; }
}
const fa = (n: number | string) => new Intl.NumberFormat('fa-IR').format(Number(n));
---
<AdminLayout title="مدیریت مقاله‌ها">
  
        <div style="padding:28px;max-width:1400px;margin:auto;width:100%">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">
            <div><h1 style="margin:0 0 4px">مدیریت مقاله‌ها</h1><p style="margin:0;color:var(--mut)">ساخت، ویرایش و مدیریت وضعیت انتشار مقاله‌ها</p></div>
            <a href="/admin/posts/new" class="btn btn-gold">＋ مقاله جدید</a>
          </div>
          {!useDb && <div class="form-status is-err" style="display:flex;margin-top:18px">اتصال دیتابیس فعال نیست؛ برای مدیریت مقاله‌ها باید DATABASE_URL تنظیم شده باشد.</div>}
          <div class="panel" style="margin-top:20px">
            <div class="panel-head"><h2>فهرست مقاله‌ها ({fa(rows.length)})</h2><input id="post-search" type="search" placeholder="جست‌وجوی عنوان یا اسلاگ…" style="max-width:280px;border:1px solid var(--a-line);border-radius:10px;padding:8px 12px;font-family:inherit" /></div>
            <div class="table-scroll">
              <table class="admin-table" id="posts-table">
                <thead><tr><th>عنوان مقاله</th><th>دسته‌بندی</th><th>آدرس</th><th>وضعیت</th><th>تاریخ</th><th>عملیات</th></tr></thead>
                <tbody>
                {rows.map((r) => <tr data-post-row data-search={(String(r.title || '') + ' ' + String(r.slug || '')).toLowerCase()}>
                  <td><b>{String(r.title ?? '')}</b></td><td>{String(r.category ?? 'عمومی')}</td>
                  <td dir="ltr" style="text-align:left;font-size:12px">/{String(r.slug ?? '')}</td>
                  <td><span class="badge" class:list={{'badge--ok': r.published, 'badge--soon': !r.published}}>{r.published ? 'منتشرشده' : 'پیش‌نویس'}</span></td>
                  <td>{String(r.dateFa ?? '—')}</td>
                  <td><div class="admin-actions"><a href={'/admin/posts/' + encodeURIComponent(String(r.slug))}>ویرایش</a>{r.published ? <a href={'/blog/' + encodeURIComponent(String(r.slug))} target="_blank" rel="noopener">مشاهده</a> : <a href={'/admin/preview?type=posts&id=' + String(r.id)} target="_blank">پیش‌نمایش</a>}</div></td>
                </tr>)}
                </tbody>
              </table>
            </div>
            {!rows.length && <div class="empty-state" style="padding:34px">هنوز مقاله‌ای ثبت نشده است. با دکمهٔ «مقاله جدید» اولین مقاله را بسازید.</div>}
          </div>
        </div>
      
  <script>
    const search = document.getElementById('post-search');
    search?.addEventListener('input', () => {
      const q = (search as HTMLInputElement).value.trim().toLowerCase();
      document.querySelectorAll('[data-post-row]').forEach((row) => {
        const el = row as HTMLElement;
        el.style.display = !q || (el.dataset.search || '').includes(q) ? '' : 'none';
      });
    });
  </script>
</AdminLayout>
