---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAdminPosts, dbAvailable } from '../../lib/cms-db';
const useDb=dbAvailable();let rows:Array<Record<string,any>>=[];
if(useDb){try{rows=(await listAdminPosts()) as unknown as Array<Record<string,any>>;}catch{rows=[];}}
const fa=(n:number|string)=>new Intl.NumberFormat('fa-IR').format(Number(n));
const totals={all:rows.length,published:rows.filter(r=>r.status==='published').length,draft:rows.filter(r=>r.status==='draft').length,scheduled:rows.filter(r=>r.status==='scheduled').length};
---
<AdminLayout title="مدیریت مقاله‌ها" crumb="مدیریت محتوا › مقاله‌ها">
<style>
.posts-admin{max-width:1500px;margin:auto;width:100%}.posts-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:17px}
.posts-head h2{margin:0 0 3px;font-size:20px}.posts-head p{margin:0;color:var(--a-muted);font-size:12px}
.posts-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin-bottom:16px}.posts-stat{border:1px solid var(--a-line);border-radius:12px;background:var(--a-surface);padding:12px 15px}.posts-stat small{display:block;color:var(--a-muted)}.posts-stat b{font-size:22px;color:#fff}
.posts-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.posts-tools input,.posts-tools select{border:1px solid var(--a-line);background:#0d162b;color:#edf2ff;border-radius:9px;padding:8px 10px;font:inherit;min-width:145px}.posts-tools input{min-width:230px}
.posts-bulk{display:none;gap:8px;align-items:center;padding:10px 14px;background:#202b4b;border-bottom:1px solid var(--a-line);flex-wrap:wrap}.posts-bulk.show{display:flex}
.posts-table{width:100%;min-width:880px;border-collapse:collapse}.posts-table th,.posts-table td{padding:12px 10px;border-bottom:1px solid var(--a-line);text-align:right;vertical-align:middle;font-size:12px}.posts-table th{background:#192542;color:#aebbd7;white-space:nowrap}
.posts-title b{display:block;color:#f0f4ff}.posts-title small{display:block;color:#8798ba;direction:ltr;text-align:right}.posts-actions{display:flex;gap:5px;flex-wrap:wrap}
.posts-actions a,.posts-actions button{border:1px solid #3a4b70;background:#243451;color:#dce5fa;border-radius:8px;padding:6px 9px;font:inherit;font-size:11px;white-space:nowrap;cursor:pointer}.posts-actions .danger{color:#ff9eb2;border-color:#674050;background:#3a263c}
@media(max-width:750px){.posts-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.posts-tools{width:100%}.posts-tools input{flex:1;min-width:0}}
</style>
<div class="posts-admin">
<header class="posts-head"><div><h2>مقالات سایت</h2><p>مدیریت، نگارش حرفه‌ای، سئو، زمان‌بندی و انتشار مقاله‌ها در یک بخش</p></div><a href="/admin/posts/new" class="btn btn-gold">＋ مقاله جدید</a></header>
{!useDb&&<div class="form-status is-err" style="display:flex;margin-bottom:16px">اتصال دیتابیس فعال نیست؛ DATABASE_URL را بررسی کنید.</div>}
<section class="posts-stats"><div class="posts-stat"><small>همه مقاله‌ها</small><b>{fa(totals.all)}</b></div><div class="posts-stat"><small>منتشرشده</small><b>{fa(totals.published)}</b></div><div class="posts-stat"><small>پیش‌نویس</small><b>{fa(totals.draft)}</b></div><div class="posts-stat"><small>زمان‌بندی‌شده</small><b>{fa(totals.scheduled)}</b></div></section>
<section class="panel"><div class="panel-head"><h2>فهرست مقاله‌ها ({fa(rows.length)})</h2><div class="posts-tools"><input id="post-search" type="search" placeholder="جست‌وجوی عنوان، نویسنده یا اسلاگ…"/><select id="post-status"><option value="">همه وضعیت‌ها</option><option value="published">منتشرشده</option><option value="draft">پیش‌نویس</option><option value="scheduled">زمان‌بندی‌شده</option></select></div></div>
<div class="posts-bulk" id="posts-bulk"><b id="posts-selected-count">۰ مقاله انتخاب‌شده</b><button class="btn btn-ghost btn-sm" type="button" data-bulk="published">انتشار انتخاب‌شده</button><button class="btn btn-ghost btn-sm" type="button" data-bulk="draft">تبدیل به پیش‌نویس</button><button class="btn btn-danger btn-sm" type="button" data-bulk="delete">انتقال به سطل زباله</button><button class="btn btn-ghost btn-sm" type="button" id="posts-clear">لغو انتخاب</button></div>
<div class="table-scroll"><table class="posts-table"><thead><tr><th><input type="checkbox" id="posts-all" aria-label="انتخاب همه"/></th><th>عنوان مقاله</th><th>دسته‌بندی</th><th>نویسنده</th><th>وضعیت</th><th>مطالعه</th><th>تاریخ</th><th>عملیات</th></tr></thead><tbody>
{rows.map(r=><tr data-post-row data-id={String(r.id)} data-status={String(r.status||'draft')} data-search={(String(r.title||'')+' '+String(r.slug||'')+' '+String(r.author||'')).toLowerCase()}>
<td><input type="checkbox" data-post-check aria-label="انتخاب مقاله"/></td><td class="posts-title"><b>{String(r.title??'')}</b><small>/{String(r.slug??'')}</small></td><td>{String(r.category??'عمومی')}</td><td>{String(r.author||'مدیر کافه‌دانش')}</td>
<td><span class:list={['badge',r.status==='published'?'badge-pub':r.status==='scheduled'?'badge-gold':'badge-draft']}>{r.status==='published'?'منتشرشده':r.status==='scheduled'?'زمان‌بندی‌شده':'پیش‌نویس'}</span></td>
<td>{fa(Number(r.read_minutes||6))} دقیقه</td><td>{String(r.dateFa??'—')}</td><td><div class="posts-actions"><a href={'/admin/posts/'+encodeURIComponent(String(r.slug))}>ویرایش</a>{r.status==='published'?<a href={'/blog/'+encodeURIComponent(String(r.slug))} target="_blank" rel="noopener">مشاهده</a>:<a href={'/admin/preview?type=posts&id='+String(r.id)} target="_blank" rel="noopener">پیش‌نمایش</a>}<button type="button" data-copy={String(r.id)}>کپی</button><button type="button" class="danger" data-delete={String(r.id)}>حذف</button></div></td></tr>)}
</tbody></table></div>{!rows.length&&<div class="empty-state" style="padding:34px">هنوز مقاله‌ای ثبت نشده است؛ اولین مقاله را ایجاد کنید.</div>}</section></div>
<script>
document.addEventListener('DOMContentLoaded',()=>{
const search=document.getElementById('post-search') as HTMLInputElement,status=document.getElementById('post-status') as HTMLSelectElement,bulk=document.getElementById('posts-bulk') as HTMLElement;
const selected=()=>Array.from(document.querySelectorAll<HTMLInputElement>('[data-post-check]:checked'));
const update=()=>{const boxes=selected();bulk.classList.toggle('show',boxes.length>0);const c=document.getElementById('posts-selected-count');if(c)c.textContent=boxes.length.toLocaleString('fa-IR')+' مقاله انتخاب‌شده';};
const filter=()=>{const q=search.value.trim().toLowerCase();document.querySelectorAll<HTMLTableRowElement>('[data-post-row]').forEach(r=>{r.hidden=!!((q&&!(r.dataset.search||'').includes(q))||(status.value&&r.dataset.status!==status.value));});};
search.addEventListener('input',filter);status.addEventListener('change',filter);
document.getElementById('posts-all')?.addEventListener('change',e=>{const on=(e.currentTarget as HTMLInputElement).checked;document.querySelectorAll<HTMLInputElement>('[data-post-row]:not([hidden]) [data-post-check]').forEach(x=>x.checked=on);update();});
document.querySelectorAll<HTMLInputElement>('[data-post-check]').forEach(x=>x.addEventListener('change',update));
document.getElementById('posts-clear')?.addEventListener('click',()=>{document.querySelectorAll<HTMLInputElement>('[data-post-check]').forEach(x=>x.checked=false);(document.getElementById('posts-all') as HTMLInputElement).checked=false;update();});
document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{b.disabled=true;try{const r=await fetch('/api/admin/posts/duplicate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(b.dataset.copy)})}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.message||'کپی ناموفق بود');location.reload();}catch(e){alert((e as Error).message);b.disabled=false;}}));
document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('این مقاله به سطل زباله منتقل شود؟ امکان بازیابی وجود دارد.'))return;b.disabled=true;try{const r=await fetch('/api/admin/posts/'+b.dataset.delete,{method:'DELETE'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.message||'حذف ناموفق بود');location.reload();}catch(e){alert((e as Error).message);b.disabled=false;}}));
document.querySelectorAll<HTMLButtonElement>('[data-bulk]').forEach(b=>b.addEventListener('click',async()=>{const ids=selected().map(x=>Number((x.closest('[data-post-row]') as HTMLElement).dataset.id)),action=b.dataset.bulk;if(!ids.length)return;if(action==='delete'&&!confirm(ids.length.toLocaleString('fa-IR')+' مقاله به سطل زباله منتقل شود؟'))return;b.disabled=true;try{const body=action==='delete'?{action:'delete',ids}:{action:'status',ids,value:action};const r=await fetch('/api/admin/posts/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.message||'عملیات گروهی ناموفق بود');location.reload();}catch(e){alert((e as Error).message);b.disabled=false;}}));
filter();const p=new URLSearchParams(location.search);if(p.get('status')){status.value=p.get('status')||'';filter();}
});
</script></AdminLayout>