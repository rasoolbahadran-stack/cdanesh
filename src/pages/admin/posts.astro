---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAdminPosts } from '../../lib/cms-db';
const rows = await listAdminPosts();
const fa = (n: unknown) => new Intl.NumberFormat('fa-IR').format(Number(n)||0);
---
<AdminLayout title="مدیریت مقالات">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px">
    <div><h1 style="margin:0">مدیریت مقالات</h1><p style="color:var(--mut);margin:4px 0 0">ساخت، ویرایش و انتشار محتوای وبلاگ</p></div>
    <a href="/admin/posts/editor" class="btn btn--sm">＋ مقاله جدید</a>
  </div>
  <div class="panel">
    <div class="panel-head"><h2>فهرست مقاله‌ها ({fa(rows.length)})</h2><input id="post-search" type="search" placeholder="جست‌وجوی عنوان یا نشانی…" style="max-width:280px;border:1px solid var(--a-line);border-radius:10px;padding:8px 12px;font-family:inherit" /></div>
    <div class="table-scroll"><table class="admin-table" id="posts-table"><thead><tr><th>عنوان</th><th>دسته</th><th>تاریخ</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
      {rows.map((r) => <tr data-search={String(r.title) + ' ' + String(r.slug) + ' ' + String(r.category)}>
        <td><b>{r.title}</b><br/><small dir="ltr" style="color:var(--mut)">/blog/{r.slug}</small></td>
        <td>{r.category || 'عمومی'}</td><td>{r.dateFa || '—'}</td>
        <td><span class="badge" class:list={{'badge--ok':r.published,'badge--soon':!r.published}}>{r.published?'منتشرشده':r.status==='scheduled'?'زمان‌بندی‌شده':'پیش‌نویس'}</span></td>
        <td><div class="admin-actions"><a href={'/admin/posts/editor?id=' + r.id}>ویرایش</a>{r.published && <a href={'/blog/' + r.slug} target="_blank" rel="noreferrer">مشاهده</a>}</div></td>
      </tr>)}
    </tbody></table></div>
    {rows.length===0 && <div class="empty-state"><div class="big">📝</div>هنوز مقاله‌ای ثبت نشده است.</div>}
  </div>
  <script>
    const search=document.querySelector('#post-search');
    search?.addEventListener('input',()=>{const q=(search.value||'').trim().toLocaleLowerCase();document.querySelectorAll('#posts-table tbody tr').forEach((tr)=>{tr.hidden=!((tr as HTMLElement).dataset.search||'').toLocaleLowerCase().includes(q);});});
  </script>
</AdminLayout>
