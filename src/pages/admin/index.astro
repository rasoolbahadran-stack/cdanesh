---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminStats } from '../../lib/cms-db';

const session = Astro.locals.admin;
let stats = { posts: 0, portfolio: 0, messages: 0, unread: 0 };
let dbOk = true;
try {
  stats = await adminStats();
} catch {
  dbOk = false;
}
---
<AdminLayout title="پنل مدیریت کافه دانش">
  <div class="admin-body">
    <div class="admin-shell">
      <aside class="admin-side">
        <div style="display:flex;align-items:center;gap:10px">
          <img src="/img/logo.svg" alt="" width="38" height="38" style="border-radius:10px" />
          <div>
            <b style="color:#fff;display:block">کافه دانش</b>
            <small style="opacity:.7">پنل مدیریت</small>
          </div>
        </div>
        <nav class="admin-side__nav" aria-label="منوی مدیریت">
          <a href="/admin" class="is-active">🏠 داشبورد</a>
          <a href="/admin/posts">📝 مقالات</a>
          <a href="/admin/portfolio">🎨 نمونه‌کارها</a>
          <a href="/admin/messages">💬 پیام‌ها</a>
          <a href="/" target="_blank">🌍 مشاهده سایت</a>
        </nav>
        <form id="logout-form" style="margin-top:26px">
          <button type="submit" class="btn btn--sm btn--outline" style="width:100%;justify-content:center">خروج</button>
        </form>
      </aside>

      <main class="admin-main">
        <h1>سلام {session?.u ?? 'مدیر'} 👋</h1>
        <p style="color:var(--mut)">وضعیت کلی محتوای سایت در یک نگاه</p>

        {!dbOk && (
          <div class="form-status is-err" style="display:flex;margin-bottom:16px">
            اتصال به دیتابیس برقرار نیست (DATABASE_URL). سایت با داده‌های محلی کار می‌کند؛ پس از تنظیم متغیر محیطی، امکانات مدیریت فعال می‌شود.
          </div>
        )}

        <div class="admin-cards">
          <div class="admin-card"><b>{new Intl.NumberFormat('fa-IR').format(stats.posts)}</b><span>مقاله منتشرشده</span></div>
          <div class="admin-card"><b>{new Intl.NumberFormat('fa-IR').format(stats.portfolio)}</b><span>نمونه‌کار</span></div>
          <div class="admin-card"><b>{new Intl.NumberFormat('fa-IR').format(stats.messages)}</b><span>پیام دریافتی</span></div>
          <div class="admin-card"><b>{new Intl.NumberFormat('fa-IR').format(stats.unread)}</b><span>پیام خوانده‌نشده</span></div>
        </div>

        <div class="admin-card" style="margin-top:22px">
          <h2 style="font-size:1.05rem">دسترسی سریع</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
            <a href="/admin/posts" class="btn btn--sm">مدیریت مقالات</a>
            <a href="/admin/portfolio" class="btn btn--sm btn--purple">مدیریت نمونه‌کارها</a>
            <a href="/admin/messages" class="btn btn--sm btn--outline">صندوق پیام‌ها</a>
          </div>
          <p style="color:var(--mut);font-size:.85rem;margin-top:14px">
            نکته: پس از تغییر محتوای دیتابیس، برای به‌روزرسانی صفحات عمومی می‌توانید Redeploy کنید (یا VERCEL_DEPLOY_HOOK_URL را در .env تنظیم کنید).
          </p>
        </div>
      </main>
    </div>
  </div>

  <script>
    document.getElementById('logout-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });
  </script>
</AdminLayout>
