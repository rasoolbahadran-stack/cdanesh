---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { q } from '../../lib/db';

const session = Astro.locals.admin;
const fa = (n: unknown) => new Intl.NumberFormat('fa-IR').format(Number(n) || 0);
let counts = { published: 0, draft: 0, scheduled: 0, pages: 0, messages: 0, unread: 0, portfolio: 0, services: 0, categories: 0, plans: 0, faqs: 0, testimonials: 0, media: 0 };
let activity: Array<Record<string, unknown>> = [];
let dbOk = true;
try {
  const [p, pg, m, pr, sv, ct, pl, fq, ts, md, a] = await Promise.all([
    q<{ published: number; draft: number; scheduled: number }>(`SELECT
      COUNT(*) FILTER (WHERE status='published')::int AS published,
      COUNT(*) FILTER (WHERE status='draft')::int AS draft,
      COUNT(*) FILTER (WHERE status='scheduled')::int AS scheduled FROM posts`),
    q<{ pages: number }>(`SELECT COUNT(*)::int AS pages FROM pages WHERE status='published'`),
    q<{ messages: number; unread: number }>(`SELECT
      COUNT(*) FILTER (WHERE status <> 'archived')::int AS messages,
      COUNT(*) FILTER (WHERE status = 'new')::int AS unread FROM messages`),
    q<{ portfolio: number }>(`SELECT COUNT(*)::int AS portfolio FROM projects WHERE status='published'`),
    q<{ services: number }>(`SELECT COUNT(*)::int AS services FROM services`),
    q<{ categories: number }>(`SELECT COUNT(*)::int AS categories FROM categories`),
    q<{ plans: number }>(`SELECT COUNT(*)::int AS plans FROM plans`),
    q<{ faqs: number }>(`SELECT COUNT(*)::int AS faqs FROM faqs`),
    q<{ testimonials: number }>(`SELECT COUNT(*)::int AS testimonials FROM testimonials`),
    q<{ media: number }>(`SELECT COUNT(*)::int AS media FROM media`),
    q<Record<string, unknown>>(`SELECT type, entity, title, created_at FROM activity ORDER BY created_at DESC LIMIT 7`)
  ]);
  counts = {
    published: Number(p[0]?.published || 0),
    draft: Number(p[0]?.draft || 0),
    scheduled: Number(p[0]?.scheduled || 0),
    pages: Number(pg[0]?.pages || 0),
    messages: Number(m[0]?.messages || 0),
    unread: Number(m[0]?.unread || 0),
    portfolio: Number(pr[0]?.portfolio || 0),
    services: Number(sv[0]?.services || 0), categories: Number(ct[0]?.categories || 0),
    plans: Number(pl[0]?.plans || 0), faqs: Number(fq[0]?.faqs || 0),
    testimonials: Number(ts[0]?.testimonials || 0), media: Number(md[0]?.media || 0),
  };
  activity = a;
} catch { dbOk = false; }
const totalPosts = counts.published + counts.draft + counts.scheduled;
const safeTotal = Math.max(1, totalPosts);
const pubPct = Math.round(counts.published / safeTotal * 100);
const draftPct = Math.round(counts.draft / safeTotal * 100);
const scheduledPct = Math.max(0, 100 - pubPct - draftPct);
const typeLabel: Record<string, string> = { create: 'ایجاد', update: 'ویرایش', delete: 'حذف', publish: 'انتشار' };
const entityLabel: Record<string, string> = { posts: 'مقاله', pages: 'صفحه', media: 'رسانه', messages: 'پیام', settings: 'تنظیمات' };
---
<AdminLayout title="داشبورد مدیریت کافه دانش">
  <style>
    .dash-wrap{padding:28px;max-width:1500px;margin:auto}
    .dash-head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
    .dash-head h1{font-size:clamp(21px,2.4vw,30px);margin:0;color:#202345}
    .dash-head p{margin:4px 0 0;color:#777b91}
    .dash-shortcuts{display:flex;flex-wrap:wrap;gap:8px}
    .dash-shortcuts a{padding:9px 14px;border-radius:11px;background:#fff;border:1px solid #e5e7ef;color:#454866;font-weight:700;font-size:13px}
    .dash-shortcuts a.primary{background:linear-gradient(120deg,#6a2bda,#a35eec);color:#fff;border:0}
    .dash-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:18px}
    .dash-stat{background:#fff;border:1px solid #e9eaf1;border-radius:17px;padding:18px;box-shadow:0 8px 24px rgba(34,35,80,.045)}
    .dash-stat span{color:#777b91;font-size:12px}.dash-stat b{display:block;font-size:27px;line-height:1.5;color:#272949}
    .dash-stat i{font-style:normal;font-size:22px;float:left}
    .dash-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:16px}
    .dash-panel{background:#fff;border:1px solid #e8e9f1;border-radius:18px;padding:20px;box-shadow:0 8px 24px rgba(34,35,80,.045)}
    .dash-panel h2{font-size:16px;margin:0 0 16px;color:#292b4d}
    .donut-row{display:flex;align-items:center;gap:28px;flex-wrap:wrap}
    .donut{width:190px;height:190px;border-radius:50%;display:grid;place-items:center;flex:none;position:relative}
    .donut:after{content:"";position:absolute;inset:24px;background:#fff;border-radius:50%}
    .donut-center{position:relative;z-index:1;text-align:center;color:#777b91;font-size:12px}
    .donut-center b{display:block;font-size:28px;color:#272949}
    .donut-legend{display:grid;gap:13px;min-width:180px;flex:1}
    .legend-item{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#555a73;font-size:13px}
    .legend-item span:first-child{display:flex;align-items:center;gap:9px}
    .dot{width:10px;height:10px;border-radius:50%;display:inline-block}
    .bar-list{display:grid;gap:14px}
    .bar-head{display:flex;justify-content:space-between;font-size:12.5px;color:#646980;margin-bottom:5px}
    .bar-track{height:9px;border-radius:20px;background:#f0f1f6;overflow:hidden}
    .bar-fill{height:100%;border-radius:20px}
    .activity-list{display:grid;gap:0}
    .activity-row{display:flex;align-items:flex-start;gap:10px;padding:11px 0;border-bottom:1px solid #f0f1f5}
    .activity-row:last-child{border:0}
    .activity-icon{width:32px;height:32px;border-radius:10px;background:#f0edff;display:grid;place-items:center;flex:none}
    .activity-row b{font-size:12.5px;color:#3d405e}.activity-row small{display:block;color:#888ca0;font-size:11px}
    .dash-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:16px}
    .dash-tile{padding:14px;border-radius:14px;background:#f6f5ff;border:1px solid #ebe8ff}
    .dash-tile b{display:block;font-size:21px;color:#4b3d94}.dash-tile span{font-size:11.5px;color:#77728f}
    @media(max-width:900px){.dash-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.dash-grid{grid-template-columns:1fr}}
    @media(max-width:520px){.dash-wrap{padding:16px}.dash-stats{gap:9px}.dash-stat{padding:13px}.dash-stat b{font-size:22px}.donut{width:160px;height:160px}.dash-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>
  
        <div class="dash-wrap">
          <header class="dash-head">
            <div><h1>به پنل مدیریت یکپارچه کافه دانش خوش آمدید 👋</h1><p>وضعیت محتوا، ارتباط با مشتریان و ابزارهای مدیریت سایت در یک نگاه</p></div>
            <div class="dash-shortcuts">
              <a class="primary" href="/admin/posts/new">＋ مقاله جدید</a>
              <a href="/admin/pages">مدیریت صفحات</a>
              <a href="/admin/media">افزودن تصویر</a>
            </div>
          </header>
          {!dbOk && <div class="form-status is-err" style="display:flex;margin-bottom:16px">اتصال به پایگاه داده برقرار نیست. آمار داشبورد در دسترس نیست.</div>}
          <section class="dash-stats">
<a class="dash-stat" href="/admin/posts"><i>📝</i><span>مقاله منتشرشده</span><b>{fa(counts.published)}</b></a>
<a class="dash-stat" href="/admin/pages"><i>📄</i><span>صفحه منتشرشده</span><b>{fa(counts.pages)}</b></a>
<a class="dash-stat" href="/admin/portfolio"><i>◇</i><span>نمونه‌کار منتشرشده</span><b>{fa(counts.portfolio)}</b></a>
<a class="dash-stat" href="/admin/services"><i>⌘</i><span>خدمات</span><b>{fa(counts.services)}</b></a>
<a class="dash-stat" href="/admin/messages"><i>💬</i><span>درخواست و پیام</span><b>{fa(counts.messages)}</b></a>
<a class="dash-stat" href="/admin/media"><i>▧</i><span>رسانه‌ها</span><b>{fa(counts.media)}</b></a></section>
          <section class="dash-grid">
            <div class="dash-panel">
              <h2>وضعیت مقاله‌ها</h2>
              <div class="donut-row">
                <div class="donut" style={'background:conic-gradient(#6a2bda 0 ' + pubPct + '%, #f2a541 ' + pubPct + '% ' + (pubPct + draftPct) + '%, #29a6a0 ' + (pubPct + draftPct) + '% 100%)'}>
                  <div class="donut-center"><b>{fa(totalPosts)}</b>مجموع مقاله‌ها</div>
                </div>
                <div class="donut-legend">
                  <div class="legend-item"><span><i class="dot" style="background:#6a2bda"></i>منتشرشده</span><b>{fa(counts.published)}</b></div>
                  <div class="legend-item"><span><i class="dot" style="background:#f2a541"></i>پیش‌نویس</span><b>{fa(counts.draft)}</b></div>
                  <div class="legend-item"><span><i class="dot" style="background:#29a6a0"></i>زمان‌بندی‌شده</span><b>{fa(counts.scheduled)}</b></div>
                </div>
              </div>
              <div class="dash-tiles">
<a class="dash-tile" href="/admin/posts?status=draft"><b>{fa(counts.draft)}</b><span>پیش‌نویس مقاله</span></a>
<a class="dash-tile" href="/admin/posts?status=scheduled"><b>{fa(counts.scheduled)}</b><span>انتشار زمان‌بندی‌شده</span></a>
<a class="dash-tile" href="/admin/messages"><b>{fa(counts.unread)}</b><span>پیام خوانده‌نشده</span></a>
<a class="dash-tile" href="/admin/categories"><b>{fa(counts.categories)}</b><span>دسته‌بندی</span></a>
<a class="dash-tile" href="/admin/pricing"><b>{fa(counts.plans)}</b><span>پلن تعرفه</span></a>
<a class="dash-tile" href="/admin/faq"><b>{fa(counts.faqs)}</b><span>سؤال متداول</span></a>
<a class="dash-tile" href="/admin/testimonials"><b>{fa(counts.testimonials)}</b><span>نظر مشتریان</span></a></div>
            </div>
            <div class="dash-panel">
              <h2>نمای کلی محتوا</h2>
              <div class="bar-list">
                <div><div class="bar-head"><span>مقاله‌های منتشرشده</span><b>{fa(counts.published)}</b></div><div class="bar-track"><div class="bar-fill" style={'width:' + (totalPosts ? counts.published / totalPosts * 100 : 0) + '%;background:#6a2bda'}></div></div></div>
                <div><div class="bar-head"><span>پیش‌نویس‌ها</span><b>{fa(counts.draft)}</b></div><div class="bar-track"><div class="bar-fill" style={'width:' + (totalPosts ? counts.draft / totalPosts * 100 : 0) + '%;background:#f2a541'}></div></div></div>
                <div><div class="bar-head"><span>صفحه‌های سایت</span><b>{fa(counts.pages)}</b></div><div class="bar-track"><div class="bar-fill" style={'width:' + (counts.pages ? 100 : 0) + '%;background:#29a6a0'}></div></div></div>
              </div>
              <p style="color:#888ca0;font-size:11.5px;margin:18px 0 0">آمار بازدید فقط پس از اتصال ابزار تحلیل و دریافت داده واقعی نمایش داده خواهد شد.</p>
            </div>
          </section>
          <section class="dash-panel" style="margin-top:16px">
            <h2>آخرین فعالیت‌های پنل</h2>
            {activity.length ? <div class="activity-list">{activity.map((item) => <div class="activity-row"><div class="activity-icon">📝</div><div><b>{String(item.title || (typeLabel[String(item.type)] || 'فعالیت') + ' ' + (entityLabel[String(item.entity)] || 'محتوا'))}</b><small>{new Intl.DateTimeFormat('fa-IR-u-ca-persian', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(String(item.created_at)))}</small></div></div>)}</div> : <p style="margin:0;color:#85899b;font-size:13px">هنوز فعالیتی ثبت نشده است.</p>}
          </section>
        </div>
      
</AdminLayout>
