---
import BareLayout from '../layouts/BareLayout.astro';
const title = "پنل مدیریت کافه‌دانش";
const description = "پنل مدیریت کافه‌دانش.";
const robots = "noindex, nofollow";
---

<BareLayout title={title} description={description} robots={robots} bodyClass="adm-light" schemas={false}>
<Fragment slot="head"><link rel="stylesheet" href="/assets/css/admin-theme.css"></Fragment>
<div class="admin-shell">
  <aside class="admin-side">
    <a class="brand" href="/admin" style="margin-bottom:30px">
      <span class="brand-mark" aria-hidden="true"><img src="/assets/img/logo.svg" alt=""></span>
      <span class="brand-name">کافه‌دانش<small>PANEL</small></span>
    </a>
    <nav aria-label="ناوبری پنل">
      <a href="#/dashboard" data-nav="dashboard" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>داشبورد</span></a>
      <a href="#/articles" data-nav="articles"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg><span>مقالات</span></a>
      <a href="#/pages" data-nav="pages"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M8 21V9"/></svg><span>صفحات</span></a>
      <a href="#/portfolio" data-nav="portfolio"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="3"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg><span>نمونه‌کارها</span></a>
      <a href="#/faq" data-nav="faq"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.2 9a2.8 2.8 0 0 1 5.5.7c0 1.8-2.7 2.3-2.7 3.8M12 17h.01"/></svg><span>سؤالات متداول</span></a>
      <a href="#/messages" data-nav="messages"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 20l1-4.9a8.4 8.4 0 1 1 17-3.6Z"/></svg><span>پیام‌ها</span><b class="adm-badge-count" id="nav-msg-count" hidden>۰</b></a>
      <a href="#/payments" data-nav="payments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20M6 15h4"/></svg><span>درگاه پرداخت</span></a>
      <a href="#/seo" data-nav="seo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg><span>سئو</span></a>
      <a href="#/performance" data-nav="performance"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 14 16 9"/><path d="M20.5 17.5a9 9 0 1 0-17 0"/></svg><span>عملکرد و امنیت</span></a>
      <a href="#/settings" data-nav="settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.5h.1a1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.5 1Z"/></svg><span>تنظیمات</span></a>
    </nav>
    <a class="btn btn-ghost btn-sm btn-block" href="/" style="margin-top:14px">مشاهده سایت</a>
    <div class="stor-badge" id="stor-badge" hidden><span class="dot" aria-hidden="true"></span><span>بررسی وضعیت ذخیره‌سازی…</span></div>
    <button class="btn btn-ghost btn-sm btn-block" id="adm-logout" type="button" style="margin-top:8px; border-color:rgba(229,118,106,.4); color:var(--err)">خروج از حساب</button>
  </aside>

  <div class="admin-main" id="adm-view" aria-live="polite">
    <!-- نمای فعلی با مسیریابی hash رندر می‌شود -->
  </div>
</div>

<script is:inline src="/assets/js/store.js"></script>
<script is:inline src="/assets/js/data/articles-a.js"></script>
<script is:inline src="/assets/js/data/articles-b.js"></script>
<script is:inline src="/assets/js/data/articles.js"></script>
<script is:inline src="/assets/js/data/faq.js"></script>
<script is:inline src="/assets/js/data/portfolio.js"></script>
<script is:inline src="/assets/js/data/pages-seed.js"></script>
<script is:inline src="/assets/js/admin.js"></script>
</BareLayout>
