---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { q } from '../lib/db';

const page = await q(`SELECT * FROM pages WHERE system_key='terms' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/terms"
>
  <PageHero title="شرایط استفاده" sub={String(page.excerpt)} crumbs={[{ label: 'شرایط استفاده', href: '' }]} />
  <section class="section pad-half">
    <div class="container">
      <div class="article-body">
        <div class="prose-fa" data-reveal="up" set:html={String(page.content)} />
      </div>
    </div>
  </section>
</BaseLayout>
