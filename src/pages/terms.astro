---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Blocks from '../components/Blocks.astro';
import { getPage } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const page = getPage('terms')!;
const bodyBlocks = page.blocks.filter((b) => b.t !== 'h1');

const meta = { title: 'شرایط استفاده | کافه دانش', description: page.meta, path: '/terms' };
---
<BaseLayout meta={meta} current="/terms" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'شرایط استفاده', url: '/terms' }])]}>
  <PageHero title="شرایط استفاده" sub="قواعد استفاده از خدمات و محتوای کافه دانش." />
  <section class="section--tight">
    <div class="container"><Blocks blocks={bodyBlocks} /></div>
  </section>
</BaseLayout>
