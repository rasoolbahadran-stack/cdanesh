---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "پلتفرم آموزش آنلاین دانش‌ور | نمونه‌کار کافه‌دانش";
const description = "نمونه مفهومی پلتفرم آموزش آنلاین دانش‌ور با کاتالوگ دوره، مسیر شغلی و ثبت‌نام آنلاین.";
---

<SiteLayout title={title} description={description} schemas={false}>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="/portfolio">نمونه‌کارها</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>پلتفرم دانش‌ور</span>
    </nav>
    <span class="eyebrow">نمونه‌کار خدماتی</span>
    <h1 class="h1">کاتالوگی مرتب برای <span class="gold">مسیر یادگیری</span> مشخص</h1>
    <p class="lead">نمونه‌ای از سامانه آموزش آنلاین: کاتالوگ دوره‌ها، مسیرهای شغلی ساختارمند و ثبت‌نام آنلاین — منظم و قابل توسعه.</p>
    <div class="page-hero-pills">
      <span class="chip chip-gold">خدماتی</span>
      <span class="badge-demo">نمونه مفهومی — پروژه نمایشی</span>
      <span class="chip">فروش دوره</span>
      <span class="chip">مسیر شغلی</span>
      <span class="chip">پنل دانشجو</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="pf-card">
      <div class="pf-head">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pf-url">cdanesh.ir/demo/portfolio-daneshvar</span>
        <span class="pf-url" style="flex:0">با ماوس بکشید یا اسکرول کنید</span>
      </div>
      <div class="pf-window custom-scrollbar" role="region" aria-label="پیش‌نمایش کامل پلتفرم دانش‌ور — اسکرول داخل قاب">
        <img src="/assets/img/pf-lms.webp" alt="نمای کامل صفحه پلتفرم دانش‌ور — نمونه مفهومی" width="1280" height="2513" loading="lazy">
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin-top:18px">این تصویر، نمای کاملِ صفحه‌ی اصلی نمونه است. داخل قاب اسکرول کنید تا همه بخش‌ها را ببینید.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">درباره پروژه</span>
      <h2 class="h2">هدف و روند <span class="gold">اجرای پروژه</span></h2>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">چالش اصلی سایت‌های آموزشی، هدایت کاربرِ سردرگم میان ده‌ها دوره است. این نمونه با مفهوم «مسیر شغلی» این سردرگمی را حل می‌کند: کاربر به جای انتخاب یک دوره، یک مسیر مشخص با ترتیب دوره‌ها دریافت می‌کند.</p>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">کارت هر دوره اطلاعات تصمیم‌گیری (مدت، سطح، پروژه پایانی) را یک‌جا نشان می‌دهد و ثبت‌نام بدون خروج از صفحه انجام می‌شود. بخش آمار هم با همین ساختار طراحی شده تا بر اساس داده واقعی هر پلتفرم آموزشی پر شود.</p>
      <div class="duo-points" style="margin-top:24px">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>مسیر شغلی به جای دوره پراکنده</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>کارت دوره با اطلاعات تصمیم‌گیری</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>ثبت‌نام بدون خروج از صفحه</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>ساختار آماده پنل دانشجو</span></li>
      </div>
    </div>
    <aside class="aside-card reveal" data-delay="1">
      <b style="font-size:16px">مشخصات پروژه</b>
      <ul style="margin-top:16px; display:grid; gap:12px; font-size:13.5px; color:var(--mut)">
        <li style="display:flex; justify-content:space-between; gap:12px"><span>نوع پروژه</span><b style="color:var(--txt)">خدماتی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>وضعیت</span><b style="color:var(--warn)">نمونه مفهومی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>خدمات اجراشده</span><b style="color:var(--txt)">طراحی سایت + توسعه وب + UI/UX</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>زمان اجرای مشابه</span><b style="color:var(--txt)">طبق برآورد پروژه</b></li>
      </ul>
      <p class="pkg-note">این نمونه برای نمایش سبک کار و کیفیت اجرای ما ساخته شده است؛ هیچ کسب‌وکار واقعی به آن اشاره ندارد.</p>
      <a class="btn btn-gold btn-block" href="/request" style="margin-top:18px">پروژه مشابه می‌خواهم</a>
    </aside>
  </div>
</section>

<section class="section-tight" style="padding-bottom:20px">
  <div class="wrap">
    <span class="eyebrow">امکانات کلیدی</span>
    <h2 class="h2" style="margin-top:10px">چه چیزهایی در این نمونه <span class="gold">پیاده شده است</span>؟</h2>
    <div class="feat-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px">
      <div class="feat-card"><b>کاتالوگ دوره ساختارمند</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">فیلتر بر اساس سطح، مدت و موضوع؛ با نمایش پروژه پایانی هر دوره.</p></div>
      <div class="feat-card"><b>مسیرهای شغلی</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">ترتیب پیشنهادی دوره‌ها برای هر شغل با نمودار پیشرفت.</p></div>
      <div class="feat-card"><b>صفحه دوره کامل</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">سرفصل‌ها، مدرس، پیش‌نیازها و پرسش‌های رایج در یک صفحه.</p></div>
      <div class="feat-card"><b>ثبت‌نام و پرداخت</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">جریان ثبت‌نام کوتاه با فاکتور و دسترسی فوری به کلاس.</p></div>
      <div class="feat-card"><b>پنل دانشجو</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">دسترسی به دوره‌ها، تمرین‌های بازبینی‌شده و گواهی پایان دوره.</p></div>
      <div class="feat-card"><b>زیرساخت مقیاس‌پذیر</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">طراحی برای رشد تعداد دوره‌ها بدون شکستن ساختار.</p></div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>پروژه‌ای شبیه این نمونه در سر دارید؟</h2>
        <p>در جلسه مشاوره، دقیقاً می‌گوییم چه ساختار و چه امکاناتی برای هدف شما لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="/request">شروع پروژه</a>
        <a class="btn btn-ghost btn-lg" href="/portfolio">نمونه‌کارهای دیگر</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
