---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedProjects, getProjectBySlug } from '../../lib/portfolio-unified';
import { siteUrl } from '../../lib/seo';

const { slug } = Astro.params;

/* بیلد استاتیک: prerender همهٔ پروژه‌ها | بیلد سرور: SSR */
export const prerender = !!process.env.STATIC_BUILD;
export async function getStaticPaths() {
  const all = await getPublishedProjects();
  return all.map((item) => ({ params: { slug: item.slug } }));
}

const project = await getProjectBySlug(String(slug));
if (!project) return Astro.redirect('/404', 302);

const related = (await getPublishedProjects()).filter((item) => item.slug !== project.slug).slice(0, 3);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    description: project.summary,
    image: siteUrl(project.coverImage),
    creator: { '@type': 'Organization', name: 'کافه دانش', url: siteUrl('/') },
    keywords: project.tags.join('، '),
    url: siteUrl(`/portfolio/${project.slug}`),
    sameAs: project.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: siteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'نمونه‌کارها', item: siteUrl('/portfolio') },
      { '@type': 'ListItem', position: 3, name: project.title, item: siteUrl(`/portfolio/${project.slug}`) },
    ],
  },
];
---
<BaseLayout
  title={project.seoTitle || project.title}
  description={project.seoDescription || project.summary}
  ogImage={project.coverImage}
  activePath="/portfolio"
  schema={schema}
>
  <PageHero
    title={project.title}
    sub={project.summary}
    crumbs={[{ label: 'نمونه‌کارها', href: '/portfolio' }, { label: project.title, href: '' }]}
    meta={[project.category, 'پیاده‌سازی با Astro']}
  />

  <section class="section pad-half">
    <div class="container">
      <div class="detail-head-img" data-reveal="zoom">
        <img
          src={project.coverImage}
          alt={project.coverAlt}
          width="1152"
          height="768"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section pad-half">
    <div class="container contact-grid">
      <div class="prose-fa" data-reveal="right">
        {project.html ? (
          <Fragment set:html={project.html} />
        ) : (
          <>
            <h2>درباره این پروژه</h2>
            <p>{project.description}</p>
            <h3>مشخصات فنی</h3>
            <ul>
              <li><strong>فریم‌ورک:</strong> Astro — رندر سریع و ساختار استاندارد برای سئو</li>
              <li><strong>نوع پروژه:</strong> {project.category}</li>
              <li><strong>برچسب‌ها:</strong> {project.tags.join('، ')}</li>
            </ul>
          </>
        )}
        {project.note && <blockquote>{project.note}</blockquote>}
      </div>

      <aside data-reveal="left">
        <div class="aside-card" style="position:sticky;top:110px">
          <h3>{project.url ? 'نسخهٔ آنلاین پروژه' : 'پروژه مشابه می‌خواهید؟'}</h3>
          <p class="small muted" style="margin-bottom:16px">
            {project.url
              ? 'این پیوند شما را به نسخهٔ عمومی منتشرشدهٔ پروژه هدایت می‌کند.'
              : 'برای این پروژه لینک عمومی ثبت نشده است؛ برای دریافت اطلاعات بیشتر با ما در تماس باشید.'}
          </p>
          {project.url && (
            <a class="btn btn--full" href={project.url} target="_blank" rel="noopener noreferrer">
              <Icon name="external-link" size={17} stroke={2} />
              مشاهدهٔ نسخهٔ آنلاین
            </a>
          )}
          <a href="/consult" class={`btn ${project.url ? 'btn--ghost btn--full mt-1' : 'btn--full'}`}>
            پروژه‌ای مشابه می‌خواهم
          </a>
        </div>
      </aside>
    </div>
  </section>

  {project.gallery.length > 0 && (
    <section class="section pad-half bg-lavender">
      <div class="container">
        <div class="section-head section-head--center" data-reveal="up">
          <span class="sub-title">
            <Icon name="layers" size={20} stroke={2} class="sub-ico" />
            گالری پروژه
          </span>
          <h2 class="sec-title" style="font-size:clamp(22px,3vw,32px)">تصاویر پروژه {project.title}</h2>
        </div>
        <div class="grid-3" data-reveal="up">
          {project.gallery.map((img: string, i: number) => (
            <figure style="margin:0;border-radius:16px;overflow:hidden;border:1px solid rgba(20,10,60,.08);background:#fff">
              <img src={img} alt={`${project.title} — تصویر ${i + 1}`} width="640" height="427" loading="lazy" decoding="async" style="width:100%;height:220px;object-fit:cover;display:block" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section pad-half bg-lavender">
    <div class="container">
      <div class="section-head section-head--center" data-reveal="up">
        <span class="sub-title">
          <Icon name="globe" size={20} stroke={2} class="sub-ico" />
          ادامهٔ نمونه‌کارها
        </span>
        <h2 class="sec-title" style="font-size:clamp(22px,3vw,32px)">پروژه‌های دیگر کافه دانش</h2>
      </div>
      <div class="grid-3">
        {
          related.map((item, index) => (
            <a href={`/portfolio/${item.slug}`} class="pf-card" data-reveal="up" data-delay={String(index * 80)}>
              <div class="pf-card__thumb">
                <img src={item.coverImage} alt={item.coverAlt} width="640" height="427" loading="lazy" decoding="async" />
                <span class="pf-card__cat">{item.category}</span>
              </div>
              <div class="pf-card__body">
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <div class="pf-card__foot">
                  <div class="pf-card__tags">
                    {item.tags.slice(0, 2).map((t) => <span>{t}</span>)}
                  </div>
                  <span class="pf-card__visit">
                    جزئیات پروژه
                    <Icon name="arrow-left" size={15} stroke={2.2} />
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
