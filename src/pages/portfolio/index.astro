---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedProjects } from '../../lib/portfolio-unified';

/* نمونه‌کارهای واقعی: از دیتابیس (قابل مدیریت از پنل)؛ در نبود دیتابیس، دادهٔ استاتیک واقعی */
const ASTRO_PROJECTS = await getPublishedProjects();

const categories = [...new Set(ASTRO_PROJECTS.map((project) => project.category))];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'پروژه‌های اجراشده با Astro | کافه دانش',
  description: 'فهرست پروژه‌های واقعی توسعه‌یافته با فریم‌ورک Astro در کافه دانش.',
  url: 'https://cdanesh.ir/portfolio',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: ASTRO_PROJECTS.length,
    itemListElement: ASTRO_PROJECTS.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      url: `https://cdanesh.ir/portfolio/${project.slug}`,
    })),
  },
}];
---
<BaseLayout
  title="نمونه‌کارهای واقعی Astro | پروژه‌های کافه دانش"
  description="مشاهده پروژه‌های واقعی کافه دانش با فریم‌ورک Astro؛ شامل فروشگاه‌های اینترنتی، وب‌سایت‌های شرکتی و سامانه‌های تحت وب."
  activePath="/portfolio"
  schema={schema}
>
  <PageHero
    title="نمونه‌کارها"
    sub="در این فهرست، وب‌سایت‌ها و سامانه‌هایی را می‌بینید که با فریم‌ورک Astro توسعه داده شده‌اند. هر کارت به صفحه معرفی پروژه و نسخه آنلاین آن متصل است."
    crumbs={[{ label: 'نمونه‌کارها', href: '' }]}
  />

  <section class="section pad-half">
    <div class="container">
      <div class="pf-filter" data-reveal="up" aria-label="فیلتر پروژه‌ها">
        <button class="active" type="button" data-filter="all">همهٔ پروژه‌ها</button>
        {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
      </div>

      <div class="grid-3">
        {
          ASTRO_PROJECTS.map((project, index) => (
            <a
              href={`/portfolio/${project.slug}`}
              class="pf-card"
              data-pf-item
              data-cat={project.category}
              data-reveal="up"
              data-delay={String((index % 3) * 80)}
            >
              <div class="pf-card__thumb">
                <img src={project.coverImage} alt={project.coverAlt} width="640" height="427" loading="lazy" decoding="async" />
                <span class="pf-card__cat">{project.category}</span>
              </div>
              <div class="pf-card__body">
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <div class="pf-card__foot">
                  <div class="pf-card__tags">
                    {project.tags.slice(0, 2).map((t) => <span>{t}</span>)}
                  </div>
                  <span class="pf-card__visit">
                    جزئیات پروژه
                    <Icon name="arrow-left" size={15} stroke={2.2} />
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <p class="small muted center mt-3" data-reveal="up">
        تصاویر کارت‌ها تصویرسازی مرتبط با حوزهٔ هر پروژه هستند؛ برای مشاهدهٔ ظاهر واقعی وب‌سایت، وارد صفحهٔ پروژه شوید.
      </p>
    </div>
  </section>

  <section class="section pad-half bg-lavender">
    <div class="container">
      <div class="cta-band" data-reveal="zoom">
        <span class="cta-band__deco cta-band__deco--1" aria-hidden="true"></span>
        <span class="cta-band__deco cta-band__deco--2" aria-hidden="true"></span>
        <h2>پروژه شما هم می‌تواند اینجا باشد</h2>
        <p>برای بررسی نیاز، انتخاب فناوری مناسب و دریافت برآورد شفاف، از یک گفت‌وگوی اولیه شروع کنیم.</p>
        <div class="cta-band__btns">
          <a href="/consult" class="btn btn--white btn--lg">درخواست مشاوره پروژه</a>
          <a href="/pricing" class="btn btn--ghost-light">دیدن تعرفه‌ها</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
