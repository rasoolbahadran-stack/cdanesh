---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { q } from '../../lib/db';

const projects = await q(`SELECT slug, title, category, summary, cover_image, tags, note, url FROM projects WHERE status='published'${excluded} ORDER BY sort_order`);
const cats = [...new Set(projects.map((p) => String(p.category)))];
---
<BaseLayout
  title="نمونه‌کارهای کافه‌دانش | فروشگاه، سایت شرکتی و هوش مصنوعی"
  description="نمونه‌کارهای واقعی و تأییدشده طراحی سایت و توسعه وب توسط کافه‌دانش."
  activePath="/portfolio"
>
  <PageHero
    title="نمونه‌کارها"
    sub="پروژه‌های اجراشده و تأییدشده کافه‌دانش."
    crumbs={[{ label: 'نمونه‌کارها', href: '' }]}
  />
  <section class="sec">
    <div class="container">
      {projects.length ? (
        <>
          <div class="pf-filter" data-reveal>
            <button class="active" data-filter="all">همه</button>
            {cats.map((c) => <button data-filter={c}>{c}</button>)}
          </div>
          <div class="portfolio-grid">
            {projects.map((p, i) => {
              const tags = Array.isArray(p.tags) ? (p.tags as string[]) : [];
              return (
                <a href={p.url ? String(p.url) : `/portfolio/${p.slug}`} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined} class="portfolio-card pf-filterable" data-cat={String(p.category)} data-reveal style={`--rd:${(i % 3) * 70}ms`}>
                  <div class="portfolio-card-media">
                    <img src={String(p.cover_image)} alt={`تصویر پروژه ${p.title}`} loading="lazy" />
                    <span class="portfolio-card-arrow">↗</span>
                  </div>
                  <div class="portfolio-card-body">
                    <span class="portfolio-card-category">{p.category}</span>
                    <h2>{p.title}</h2>
                    <p>{p.summary}</p>
                    <div class="pf-tags">{tags.map((t) => <span>{t}</span>)}</div>
                  </div>
                </a>
              );
            })}
          </div>
        </>
      ) : (
        <div class="portfolio-empty">
          <span class="portfolio-empty-mark">✦</span>
          <h2>نمونه‌کارهای تأییدشده</h2>
          <p>در حال حاضر پروژه‌ای برای نمایش عمومی تأیید نشده است.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
