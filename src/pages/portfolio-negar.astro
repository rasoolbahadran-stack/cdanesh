---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "دستیار هوشمند نِگار | نمونه‌کار کافه‌دانش";
const description = "نمونه مفهومی صفحه فرود دستیار هوشمند نِگار با نمایش گفتگو، امکانات و پلن‌های قیمت‌گذاری.";
---

<SiteLayout title={title} description={description} schemas={false}>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="/portfolio">نمونه‌کارها</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>دستیار نِگار</span>
    </nav>
    <span class="eyebrow">نمونه‌کار هوش مصنوعی</span>
    <h1 class="h1">صفحه فرودی که <span class="gold">محصول هوشمند</span> را باورپذیر می‌کند</h1>
    <p class="lead">نمونه‌ای از صفحه فرود SaaS: نمایش زنده گفتگو با چت‌بات، توضیح شفاف مکانیزم کار و پلن‌های قیمت‌گذاری روشن.</p>
    <div class="page-hero-pills">
      <span class="chip chip-gold">هوش مصنوعی</span>
      <span class="badge-demo">نمونه مفهومی — پروژه نمایشی</span>
      <span class="chip">چت‌بات فروش</span>
      <span class="chip">صفحه فرود SaaS</span>
      <span class="chip">ثبت‌نام آزمایشی</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="pf-card">
      <div class="pf-head">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pf-url">cdanesh.ir/demo/portfolio-negar</span>
        <span class="pf-url" style="flex:0">با ماوس بکشید یا اسکرول کنید</span>
      </div>
      <div class="pf-window custom-scrollbar" role="region" aria-label="پیش‌نمایش کامل دستیار نِگار — اسکرول داخل قاب">
        <img src="/assets/img/pf-ai.webp" alt="نمای کامل صفحه دستیار نِگار — نمونه مفهومی" width="1280" height="2438" loading="lazy">
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin-top:18px">این تصویر، نمای کاملِ صفحه‌ی اصلی نمونه است. داخل قاب اسکرول کنید تا همه بخش‌ها را ببینید.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">درباره پروژه</span>
      <h2 class="h2">هدف و روند <span class="gold">اجرای پروژه</span></h2>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">سخت‌ترین کار صفحه فرود محصول هوش مصنوعی، باورپذیر کردن قابلیت‌هاست. این نمونه به جای ادعا، خودِ محصول را نشان می‌دهد: یک پنجره گفتگوی واقعی که سؤال مشتری و پاسخ دستیار را پیش از ثبت‌نام تجربه می‌کند.</p>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">بخش «چطور کار می‌کند» در سه گام شفاف اتصال، پاسخ‌گویی و تحویل سرنخ را توضیح می‌دهد و پلن‌های قیمت‌گذاری بدون عدد جعلی، ساختار سه‌گانه پایه تا سفارشی را نمایش می‌دهند تا بازدیدکننده بداند مسیر خرید چگونه است.</p>
      <div class="duo-points" style="margin-top:24px">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>نمایش زنده محصول پیش از ثبت‌نام</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>توضیح شفاف مکانیزم کار</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>پلن‌های قیمت ساختارمند</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>دعوت به شروع آزمایشی بدون ریسک</span></li>
      </div>
    </div>
    <aside class="aside-card reveal" data-delay="1">
      <b style="font-size:16px">مشخصات پروژه</b>
      <ul style="margin-top:16px; display:grid; gap:12px; font-size:13.5px; color:var(--mut)">
        <li style="display:flex; justify-content:space-between; gap:12px"><span>نوع پروژه</span><b style="color:var(--txt)">هوش مصنوعی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>وضعیت</span><b style="color:var(--warn)">نمونه مفهومی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>خدمات اجراشده</span><b style="color:var(--txt)">طراحی سایت + UI/UX + هوش مصنوعی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>زمان اجرای مشابه</span><b style="color:var(--txt)">طبق برآورد پروژه</b></li>
      </ul>
      <p class="pkg-note">این نمونه برای نمایش سبک کار و کیفیت اجرای ما ساخته شده است؛ هیچ کسب‌وکار واقعی به آن اشاره ندارد.</p>
      <a class="btn btn-gold btn-block" href="/request" style="margin-top:18px">پروژه مشابه می‌خواهم</a>
    </aside>
  </div>
</section>

<section class="section-tight" style="padding-bottom:20px">
  <div class="wrap">
    <span class="eyebrow">امکانات کلیدی</span>
    <h2 class="h2" style="margin-top:10px">چه چیزهایی در این نمونه <span class="gold">پیاده شده است</span>؟</h2>
    <div class="feat-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px">
      <div class="feat-card"><b>دموی گفتگوی زنده</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">تجربه تعامل با دستیار پیش از ثبت‌نام؛ مهم‌ترین ابزار اعتمادسازی محصول AI.</p></div>
      <div class="feat-card"><b>توضیح سه‌گامی مکانیزم</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">اتصال، آموزش با محتوای سایت و تحویل سرنخ — هر گام با یک اسکرین‌شات.</p></div>
      <div class="feat-card"><b>پلن‌های مقایسه‌پذیر</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">سه پلن با تفکیک شفاف کانال‌ها و کاربران؛ قابل اتصال به فرم درخواست.</p></div>
      <div class="feat-card"><b>فرم شروع آزمایشی</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">ثبت‌نام کوتاه با وعده روشن («بدون کارت بانکی») و پیگیری ایمیلی.</p></div>
      <div class="feat-card"><b>پاسخ‌گویی چندکاناله</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">ساختار آماده برای سایت، واتس‌پپ و پیام‌رسان‌های داخلی.</p></div>
      <div class="feat-card"><b>گزارش‌دهی شفاف</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">نمونه داشبورد گزارش هفتگی گفتگوها و سؤالات پرتکرار.</p></div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>پروژه‌ای شبیه این نمونه در سر دارید؟</h2>
        <p>در جلسه مشاوره، دقیقاً می‌گوییم چه ساختار و چه امکاناتی برای هدف شما لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="/request">شروع پروژه</a>
        <a class="btn btn-ghost btn-lg" href="/portfolio">نمونه‌کارهای دیگر</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
