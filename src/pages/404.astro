---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'صفحه پیدا نشد | کافه دانش',
  description: 'صفحه‌ای که دنبالش بودید در کافه دانش پیدا نشد.',
  path: '/404',
  noindex: true,
};
---
<BaseLayout meta={meta} current="">
  <section class="section" style="min-height:62vh;display:grid;place-items:center;text-align:center">
    <div class="container" style="max-width:560px">
      <p style="font-size:clamp(4rem,12vw,7rem);font-weight:900;line-height:1;background:var(--grad-btn-hover);-webkit-background-clip:text;background-clip:text;color:transparent;margin:0">۴۰۴</p>
      <h1 style="font-size:1.5rem">این صفحه در استودیو پیدا نشد</h1>
      <p style="color:var(--mut)">آدرس تغییر کرده یا صفحه وجود ندارد. از مسیرهای زیر ادامه دهید:</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:22px">
        <a href="/" class="btn">صفحه اصلی</a>
        <a href="/portfolio" class="btn btn--outline">نمونه‌کارها</a>
        <a href="/blog" class="btn btn--outline">مجله</a>
      </div>
    </div>
  </section>
</BaseLayout>
