---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="صفحه پیدا نشد | کافه‌دانش" description="صفحه موردنظر شما در کافه‌دانش پیدا نشد؛ از لینک‌های زیر مسیر درست را پیدا کنید." noIndex={true}>
  <section class="sec" style="min-height:56vh;display:grid;place-items:center;text-align:center">
    <div class="container" style="max-width:600px">
      <div class="grad-text" style="font-size:clamp(64px,10vw,110px);font-weight:700;line-height:1.2">۴۰۴</div>
      <h2 style="font-size:22px;margin-bottom:12px">این صفحه در کافه‌دانش پیدانشد</h2>
      <p style="color:var(--mut);margin-bottom:26px">ممکن است آدرس را اشتباه وارد کرده باشید یا صفحه جابه‌جا شده باشد؛ از لینک‌های زیر ادامه دهید.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/" class="btn btn-gold">صفحه اصلی</a>
        <a href="/blog" class="btn btn-ghost">مجله</a>
        <a href="/services" class="btn btn-ghost">خدمات</a>
        <a href="/consult" class="btn btn-ghost">درخواست مشاوره</a>
      </div>
    </div>
  </section>
</BaseLayout>
