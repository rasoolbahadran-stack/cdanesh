---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="صفحه پیدا نشد | کافه دانش" description="صفحه موردنظر شما در کافه دانش پیدا نشد؛ از لینک‌های زیر مسیر درست را پیدا کنید." noIndex={true}>
  <section class="notfound">
    <div class="container" style="max-width:620px">
      <div class="notfound__code" data-reveal="zoom">۴۰۴</div>
      <h1 data-reveal="up">این صفحه در کافه دانش پیدا نشد</h1>
      <p data-reveal="up" data-delay="100">ممکن است آدرس را اشتباه وارد کرده باشید یا صفحه جابه‌جا شده باشد؛ از لینک‌های زیر ادامه دهید.</p>
      <div class="notfound__btns" data-reveal="up" data-delay="200">
        <a href="/" class="btn">
          <Icon name="arrow-right" size={17} stroke={2.2} />
          صفحه اصلی
        </a>
        <a href="/blog" class="btn btn--ghost">مجله</a>
        <a href="/services" class="btn btn--ghost">خدمات</a>
        <a href="/consult" class="btn btn--ghost">درخواست مشاوره</a>
      </div>
    </div>
  </section>
</BaseLayout>
