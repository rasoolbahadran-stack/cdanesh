---
import BareLayout from '../layouts/BareLayout.astro';
const title = "صفحه پیدا نشد | کافه‌دانش";
const description = "صفحه موردنظر شما در کافه‌دانش یافت نشد.";
const canonical = "https://cdanesh.ir/404";
---

<BareLayout title={title} description={description} canonical={canonical}>
<!-- این صفحه هدر/فوتر عمومی ندارد -->
<div class="nf-wrap">
  <div class="nf-code" aria-hidden="true">۴۰۴</div>
  <h1 class="h2" style="margin-bottom:10px">این صفحه پیدا نشد</h1>
  <p class="lead" style="max-width:480px; margin-bottom:32px">آدرسی که وارد کرده‌اید وجود ندارد یا جابه‌جا شده است. از این‌جا ادامه بدهید:</p>
  <div style="display:flex; gap:13px; flex-wrap:wrap; justify-content:center">
    <a class="btn btn-gold btn-lg" href="/">صفحه اصلی</a>
    <a class="btn btn-ghost btn-lg" href="/blog">مجله مقالات</a>
    <a class="btn btn-ghost btn-lg" href="/portfolio">نمونه‌کارها</a>
  </div>
  <p class="muted small" style="margin-top:40px">کافه‌دانش — استودیو دیجیتال</p>
</div>
</BareLayout>
