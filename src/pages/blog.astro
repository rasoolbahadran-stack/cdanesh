---
// مجله کافه دانش — همه مقالات با دسته‌بندی و نمایش تدریجی
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPosts } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const posts = await getPosts();
// ترتیب دسته‌ها با اولویت تخصص اصلی برند (طراحی سایت و UI/UX)
const preferredCats = ['طراحی سایت', 'طراحی UI/UX', 'سئو', 'تولید محتوا', 'هوش مصنوعی', 'کسب‌وکار و رشد آنلاین'];
const foundCats = [...new Set(posts.map((p) => p.category))];
const categories = ['همه', ...preferredCats.filter((c) => foundCats.includes(c)), ...foundCats.filter((c) => !preferredCats.includes(c))];
const fa = (n: number) => new Intl.NumberFormat('fa-IR').format(n);

const meta = {
  title: 'وبلاگ کافه دانش | مقالات طراحی سایت، سئو و تولید محتوا',
  description: 'مقالات تخصصی درباره طراحی سایت، فروشگاه اینترنتی، UI/UX، سئو و تولید محتوا — به زبان ساده و کاربردی.',
  path: '/blog',
};
---
<BaseLayout meta={meta} current="/blog" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'مجله', url: '/blog' }])]}>
  <PageHero
    title="مجله کافه دانش"
    sub={`${fa(posts.length)} مقالهٔ تخصصی درباره طراحی سایت، فروشگاه اینترنتی، سئو و تولید محتوا — هر هفته یک مطلب کاربردی تازه.`}
    crumbs={[{ label: 'خانه', href: '/' }, { label: 'مجله' }]}
  />

  <section class="section">
    <div class="container">
      <div class="pf-filters" role="group" aria-label="فیلتر دسته‌بندی مقالات">
        {categories.map((c, i) => (
          <button type="button" class:list={[{ 'is-active': i === 0 }]} data-pf-filter={c}>{c}</button>
        ))}
      </div>
      <div class="pf-grid" id="blog-grid" style="margin-top:8px">
        {posts.map((p, i) => (
          <div data-pf-item data-cat={p.category} style={i >= 9 ? 'display:none' : ''} class="blog-cell">
            <PostCard post={p} delay={String((i % 3) * 80)} />
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:36px">
        <button type="button" class="btn btn--outline btn--lg" id="blog-more">
          نمایش مقالات بیشتر
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" /></svg>
        </button>
      </div>
    </div>
  </section>

  <CtaBand title="موضوعی در ذهن دارید که نوشته نشده؟" sub="پیشنهاد موضوع مقاله بدهید؛ یا اگر محتوای تخصصی برای سایت خودتان می‌خواهید، از صفحه تولید محتوا شروع کنید." />
</BaseLayout>

<script>
  const btn = document.getElementById('blog-more');
  const cells = document.querySelectorAll<HTMLElement>('#blog-grid .blog-cell');
  const shown = 9;
  let visible = shown;
  btn?.addEventListener('click', () => {
    visible = Math.min(cells.length, visible + 9);
    cells.forEach((c, i) => { if (i < visible) c.style.display = ''; });
    // re-trigger reveal for newly shown
    cells.forEach((c, i) => { if (i < visible) c.querySelector('[data-reveal]')?.classList.add('is-in'); });
    if (visible >= cells.length) btn.style.display = 'none';
  });
  // با فیلتر دسته، همه آیتم‌های همان دسته نمایش داده شود
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-pf-filter]');
  filterBtns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.pfFilter;
    cells.forEach((c) => {
      const show = cat === 'همه' || c.dataset.cat === cat;
      c.style.display = show ? '' : 'none';
      c.querySelector('[data-reveal]')?.classList.add('is-in');
    });
    btn.style.display = cat === 'همه' && cells.length > visible ? '' : 'none';
  }));
</script>
