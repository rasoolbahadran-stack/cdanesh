---
// مجله کافه دانش — همه مقالات با دسته‌بندی و نمایش تدریجی
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPosts } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const posts = await getPosts();
// ترتیب دسته‌ها با اولویت تخصص اصلی برند (طراحی سایت و UI/UX)
const preferredCats = ['طراحی سایت', 'طراحی UI/UX', 'سئو', 'تولید محتوا', 'هوش مصنوعی', 'کسب‌وکار و رشد آنلاین'];
const foundCats = [...new Set(posts.map((p) => p.category))];
const categories = ['همه', ...preferredCats.filter((c) => foundCats.includes(c)), ...foundCats.filter((c) => !preferredCats.includes(c))];
const fa = (n: number) => new Intl.NumberFormat('fa-IR').format(n);

const meta = {
  title: 'وبلاگ کافه دانش | مقالات طراحی سایت، سئو و تولید محتوا',
  description: 'مقالات تخصصی درباره طراحی سایت، فروشگاه اینترنتی، UI/UX، سئو و تولید محتوا — به زبان ساده و کاربردی.',
  path: '/blog',
};
---
<BaseLayout meta={meta} current="/blog" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'مجله', url: '/blog' }])]}>
  <PageHero
    title="مجله کافه دانش"
    sub={`${fa(posts.length)} مقالهٔ تخصصی درباره طراحی سایت، فروشگاه اینترنتی، سئو و تولید محتوا — هر هفته یک مطلب کاربردی تازه.`}
  />

  <section class="section">
    <div class="container">
      <div class="blog-search">
        <label for="blog-search-input">جست‌وجو در مجله</label>
        <input id="blog-search-input" type="search" placeholder="عنوان، موضوع یا عبارت موردنظر..." autocomplete="off" />
      </div>
      <div class="pf-filters" role="group" aria-label="فیلتر دسته‌بندی مقالات">
        {categories.map((c, i) => (
          <button type="button" class:list={[{ 'is-active': i === 0 }]} data-pf-filter={c}>{c}</button>
        ))}
      </div>
      <div class="pf-grid" id="blog-grid" style="margin-top:8px">
        {posts.map((p, i) => (
          <div data-pf-item data-cat={p.category} data-search={p.title + ' ' + p.excerpt + ' ' + p.category} style={i >= 9 ? 'display:none' : ''} class="blog-cell">
            <PostCard post={p} delay={String((i % 3) * 80)} />
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:36px">
        <button type="button" class="btn btn--outline btn--lg" id="blog-more">
          نمایش مقالات بیشتر
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" /></svg>
        </button>
      </div>
    </div>
  </section>

  <CtaBand title="موضوعی در ذهن دارید که نوشته نشده؟" sub="پیشنهاد موضوع مقاله بدهید؛ یا اگر محتوای تخصصی برای سایت خودتان می‌خواهید، از صفحه تولید محتوا شروع کنید." />
</BaseLayout>

<script>
  const btn = document.getElementById('blog-more') as HTMLButtonElement | null;
  const cells = [...document.querySelectorAll<HTMLElement>('#blog-grid .blog-cell')];
  const search = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-pf-filter]')];
  let visible = 9;
  let activeCategory = 'همه';
  const applyFilters = () => {
    const query = (search?.value || '').trim().toLocaleLowerCase('fa');
    let matchingCount = 0;
    cells.forEach((cell) => {
      const categoryMatch = activeCategory === 'همه' || cell.dataset.cat === activeCategory;
      const searchMatch = !query || (cell.dataset.search || '').toLocaleLowerCase('fa').includes(query);
      const match = categoryMatch && searchMatch;
      const show = match && (query || activeCategory !== 'همه' || matchingCount < visible);
      cell.style.display = show ? '' : 'none';
      if (match) matchingCount++;
      if (show) cell.querySelector('[data-reveal]')?.classList.add('is-in');
    });
    if (btn) btn.style.display = !query && activeCategory === 'همه' && matchingCount > visible ? '' : 'none';
  };
  btn?.addEventListener('click', () => { visible += 9; applyFilters(); });
  filterBtns.forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.pfFilter || 'همه';
    filterBtns.forEach((item) => item.classList.toggle('is-active', item === button));
    applyFilters();
  }));
  search?.addEventListener('input', applyFilters);
  applyFilters();
</script>

<style is:global>
  .blog-search{display:grid;gap:8px;max-width:520px;margin:0 auto 22px}
  .blog-search label{font-size:.88rem;font-weight:700;color:var(--navy)}
  .blog-search input{width:100%;min-width:0;padding:13px 16px;border:1px solid var(--line);border-radius:var(--r-md);background:#fff;color:var(--navy);font:inherit;outline-offset:3px}
  .blog-search input:focus{border-color:var(--purple)}
</style>
