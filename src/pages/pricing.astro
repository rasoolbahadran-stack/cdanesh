---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRICING } from '../lib/content';
import { jsonLdBreadcrumb } from '../lib/seo';

const meta = {
  title: 'تعرفه‌ها و پکیج‌های طراحی سایت | کافه دانش',
  description: 'تعرفه و محدوده خدمات طراحی سایت کافه دانش؛ از سایت معرفی و شرکتی تا فروشگاه اینترنتی و سامانه اختصاصی.',
  path: '/pricing',
};
---
<BaseLayout meta={meta} current="/pricing" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'تعرفه‌ها', url: '/pricing' }])]}>
  <PageHero
    title="تعرفه‌ها و پکیج‌های خدمات"
    sub="قیمت پایه و محدودهٔ هر پکیج روشن است؛ امکانات، تعداد صفحات، زمان تحویل و مدت پشتیبانی پیش از شروع مشخص می‌شوند."
    crumbs={[{ label: 'خانه', href: '/' }, { label: 'تعرفه‌ها' }]}
  />

  <section class="section">
    <div class="container">
      <div class="price-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:22px">
        {PRICING.map((p, i) => (
          <article class="card" style={`padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:10px;${p.featured ? 'border:2px solid var(--pink);position:relative' : ''}`} data-reveal="up" data-delay={String((i % 2) * 90)}>
            {p.featured && <span class="badge" style="position:absolute;top:-13px;right:22px;background:var(--pink);color:#fff">پیشنهاد ما</span>}
            <span class="section-head__tag" style="font-size:.82rem">{p.badge}</span>
            <h2 style="font-size:1.35rem;margin:0">{p.name}</h2>
            <p style="color:var(--mut);font-size:.93rem;margin:0">{p.desc}</p>
            <p style="margin:8px 0 0"><b style="font-size:1.35rem;color:var(--navy)">{p.price}</b><br /><small style="color:var(--mut)">{p.note}</small></p>
            <ul style="list-style:none;padding:0;margin:8px 0;display:grid;gap:8px;font-size:.93rem">
              {p.features.map((f) => (
                <li style="display:flex;gap:8px;align-items:flex-start">
                  <svg style="flex:none;margin-top:5px" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--mint-ink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                  {f}
                </li>
              ))}
            </ul>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:auto;padding-top:8px">
              <a href={`/consult?package=${p.key}`} class="btn">درخواست این پکیج</a>
              <a href={`/contact?package=${p.key}`} class="btn btn--outline">سؤال درباره این پکیج</a>
            </div>
            <small style="color:var(--mut)">{p.foot}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="مطمئن نیستید کدام پکیج مناسب شماست؟" sub="در جلسه مشاوره رایگان، نیازتان را بررسی می‌کنیم و پکیج درست را پیشنهاد می‌دهیم — حتی اگر هیچ‌کدام دقیقاً مناسب نباشد، برآورد شفاف می‌دهیم." />
</BaseLayout>

<style is:global>
  @media (max-width: 860px) { .price-grid { grid-template-columns: 1fr !important; } }
</style>
