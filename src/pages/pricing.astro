---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRICING } from '../lib/content';
import { jsonLdBreadcrumb, jsonLdFaq } from '../lib/seo';

const meta = {
  title: 'تعرفه طراحی سایت | پکیج شرکتی، فروشگاهی و اختصاصی کافه دانش',
  description: 'تعرفه طراحی سایت شرکتی، فروشگاهی و اختصاصی در کافه دانش؛ قیمت، امکانات، زمان تحویل و پشتیبانی پکیج‌ها را مقایسه کنید و برای سفارش سایت مشاوره بگیرید.',
  path: '/pricing',
};

// سؤالات متداول اختصاصی تعرفه‌ها — هم برای کاربر، هم به‌عنوان اسکیمای FAQPage
const pricingFaq = [
  { q: 'قیمت طراحی سایت چرا در شرکت‌های مختلف متفاوت است؟', a: 'قیمت طراحی سایت به نوع طراحی، کیفیت پیاده‌سازی، امکانات فنی، پیچیدگی پروژه، پنل مدیریتی، زیرساخت میزبانی و خدمات پس از تحویل بستگی دارد. برای مقایسه دقیق، فقط مبلغ نهایی را بررسی نکنید؛ دامنه خدمات، امکانات، مالکیت و دسترسی‌ها، زمان تحویل و شرایط پشتیبانی را نیز مقایسه کنید.' },
  { q: 'پکیج شرکتی ۱۷ میلیون تومان شامل چه امکاناتی است؟', a: 'این پکیج شامل طراحی اختصاصی وب‌سایت شرکتی تا ۸ صفحه، دامنه .IR رایگان، ۶ ماه هاست هدیه، صفحات اصلی، مجله مقالات با پنل فارسی، فرم تماس و مشاوره، تنظیمات پایه سئو و نمایش ریسپانسیو است. زمان تحویل ۲ تا ۳ هفته و مدت پشتیبانی رایگان ۳ ماه است. جزئیات کامل در کارت پکیج شرکتی درج شده است.' },
  { q: 'بعد از راه‌اندازی سایت چه هزینه‌هایی خواهم داشت؟', a: 'مهم‌ترین هزینه‌های احتمالی پس از پایان دوره هدیه شامل تمدید دامنه، تمدید هاست و در صورت نیاز خدمات سئو، تولید محتوا و پشتیبانی هستند. هزینه هر سرویس بر اساس نوع نیاز و تعرفه زمان تمدید مشخص می‌شود. موارد خارج از پکیج پیش از اجرا به شما اطلاع داده خواهند شد.' },
  { q: 'آیا امکان ارتقا از پکیج شرکتی به فروشگاهی وجود دارد؟', a: 'بله، در صورت سازگاری ساختار فنی سایت با امکانات فروشگاهی موردنیاز، امکان بررسی و توسعه آن وجود دارد. ابتدا نیازهای فروشگاه، امکانات لازم و وضعیت سایت فعلی بررسی می‌شوند و سپس محدوده تغییرات، هزینه و زمان اجرای ارتقا اعلام خواهد شد.' },
  { q: 'چرا پکیج اختصاصی قیمت ثابت ندارد؟', a: 'پروژه‌های اختصاصی از نظر نوع فرایندها، تعداد کاربران، پنل‌های مدیریتی، امکانات، سطح پیچیدگی و اتصال به سرویس‌های دیگر با یکدیگر متفاوت هستند. به همین دلیل، ابتدا نیازمندی‌ها بررسی و مستند می‌شوند و سپس بر اساس محدوده اجرا، برآورد دقیق ارائه می‌شود.' },
  { q: 'پرداخت هزینه طراحی سایت چگونه انجام می‌شود؟', a: 'هزینه پکیج‌های شرکتی و فروشگاهی طبق شرایط درج‌شده در صفحه به‌صورت یک‌جا پرداخت می‌شود. در پروژه‌های اختصاصی، شرایط و مراحل پرداخت متناسب با محدوده پروژه در پروپوزال و قرارداد مشخص خواهد شد.' },
];

// استانداردهای مشترک کافه دانش در همهٔ پکیج‌ها — تفاوت پکیج‌ها در دامنهٔ کار است، نه در کیفیت
const commonFeatures = [
  { t: 'مالکیت و دسترسی پروژه', d: 'دسترسی‌های مدیریتی، دامنه و محتوای متعلق به کسب‌وکار مطابق توافق در اختیار شما قرار می‌گیرد. شرایط تحویل سورس‌کد و مجوزهای اجزای ثالث نیز از ابتدا مشخص می‌شود.' },
  { t: 'طراحی اختصاصی', d: 'طراحی متناسب با هویت برند و نیاز کسب‌وکار شما؛ بدون اتکا به قالب آماده برای بخش‌های اصلی طراحی.' },
  { t: 'پنل مدیریتی فارسی', d: 'امکانات مدیریتی متناسب با نوع وب‌سایت، برای مدیریت محتوا، محصولات یا بخش‌های قابل ویرایش پروژه.' },
  { t: 'آموزش مدیریت سایت', d: 'آموزش کار با پنل و بخش‌های مدیریتی در اختیار شما قرار می‌گیرد تا بتوانید امور روزمره سایت را مستقل انجام دهید.' },
  { t: 'نمایش ریسپانسیو', d: 'ساختار و صفحات سایت برای نمایش مناسب در موبایل، تبلت و دسکتاپ طراحی و بررسی می‌شوند.' },
  { t: 'سئوی زیرساختی', d: 'ساختار استاندارد صفحات، تنظیمات پایه سئو و ملاحظات فنی اولیه از زمان طراحی و توسعه در نظر گرفته می‌شوند.' },
  { t: 'تحویل مرحله‌ای', d: 'مراحل اصلی پروژه به‌صورت مشخص پیش می‌روند و فرصت بررسی و ارائه بازخورد در نقاط توافق‌شده وجود دارد.' },
  { t: 'شفافیت در هزینه‌ها', d: 'محدوده خدمات، هزینه‌های توافق‌شده و موارد خارج از پکیج پیش از اجرا مشخص می‌شوند. هیچ خدمت اضافه‌ای بدون اطلاع و تأیید شما به پروژه افزوده نمی‌شود.' },
];

// خدمات مکمل و پس از راه‌اندازی — برآورد پس از نیازسنجی (بدون قیمت ثابت)
const complementary = [
  {
    t: 'خدمات سئو سایت',
    d: 'بررسی و بهینه‌سازی ساختار فنی، سرعت، صفحات و محتوای وب‌سایت با هدف بهبود قابلیت دیده‌شدن در موتورهای جست‌وجو و جذب مخاطب مرتبط.',
    href: '/services/seo', cta: 'مشاهده خدمات سئو',
  },
  {
    t: 'تولید محتوای سایت',
    d: 'تهیه مقالات تخصصی، محتوای صفحات و برنامه انتشار متناسب با نیاز مخاطبان و استراتژی محتوایی وب‌سایت.',
    href: '/services/content', cta: 'مشاهده خدمات تولید محتوا',
  },
  {
    t: 'مدیریت و پشتیبانی سایت',
    d: 'نگهداری فنی، به‌روزرسانی، مدیریت محتوا و بررسی مشکلات وب‌سایت پس از انتشار؛ با محدوده خدمات و شرایط پاسخ‌گویی مشخص.',
    href: '/services/support', cta: 'مشاهده خدمات پشتیبانی',
  },
];
---
<BaseLayout meta={meta} current="/pricing" extraJsonLd={[jsonLdBreadcrumb([{ name: 'خانه', url: '/' }, { name: 'تعرفه‌ها', url: '/pricing' }]), jsonLdFaq(pricingFaq)]}>
  <PageHero
    title="تعرفه طراحی سایت؛ پکیج‌های شرکتی، فروشگاهی و اختصاصی"
    sub="سه مسیر روشن برای ساخت وب‌سایت کسب‌وکار شما؛ از سایت شرکتی و فروشگاه اینترنتی تا سامانه اختصاصی. امکانات، قیمت، زمان تحویل و مدت پشتیبانی هر پکیج را بررسی کنید و متناسب با نیازتان تصمیم بگیرید."
  />

  <!-- ═══ مقدمه: قیمت طراحی سایت چگونه تعیین می‌شود؟ ═══ -->
  <section class="section section--tight" aria-labelledby="price-intro-title">
    <div class="container">
      <div class="price-intro">
        <h2 id="price-intro-title">هزینه طراحی سایت در کافه دانش چگونه تعیین می‌شود؟</h2>
        <p>هزینه طراحی سایت به نوع پروژه، امکانات موردنیاز، حجم محتوا و میزان سفارشی‌سازی بستگی دارد. به همین دلیل، خدمات پایه کافه دانش در سه پکیج مشخص ارائه می‌شوند تا پیش از شروع همکاری، محدوده خدمات و هزینه‌ها برای شما روشن باشد.</p>
        <p>پکیج شرکتی برای معرفی حرفه‌ای کسب‌وکار و خدمات شما طراحی شده است. پکیج فروشگاهی امکانات لازم برای عرضه محصولات و مدیریت سفارش‌ها را فراهم می‌کند. پکیج اختصاصی نیز برای پروژه‌هایی در نظر گرفته شده که به سامانه، پنل مدیریتی یا فرایندهای فنی سفارشی نیاز دارند.</p>
        <p>در هر پکیج، امکانات و زمان تحویل از ابتدا مشخص است. هر قابلیت خارج از محدوده توافق‌شده نیز پیش از اجرا، با برآورد مکتوب و تأیید شما اعلام می‌شود. هدف ما این است که پیش از شروع پروژه، دقیقاً بدانید چه خدماتی دریافت می‌کنید و چه هزینه‌هایی در انتظار شماست.</p>
      </div>
    </div>
  </section>

  <!-- ═══ پکیج‌ها ═══ -->
  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="price-grid">
        {PRICING.map((p, i) => (
          <article class="card" style={`padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:10px;${p.featured ? 'border:2px solid var(--pink);position:relative' : ''}`} data-reveal="up" data-delay={String(i * 90)}>
            {p.featured && <span class="badge" style="position:absolute;top:-13px;right:22px;background:var(--pink);color:#fff">پیشنهاد کافه دانش</span>}
            <span class="section-head__tag" style="font-size:.82rem">{p.badge}</span>
            <h2 style="font-size:1.35rem;margin:0">{p.name}</h2>
            <p style="color:var(--mut);font-size:.93rem;margin:0">{p.desc}</p>
            <p style="margin:8px 0 0"><b style="font-size:1.35rem;color:var(--navy)">{p.price}</b><br /><small style="color:var(--mut)">{p.note}</small></p>
            <ul style="list-style:none;padding:0;margin:8px 0;display:grid;gap:8px;font-size:.93rem">
              {p.features.map((f) => (
                <li style="display:flex;gap:8px;align-items:flex-start">
                  <svg style="flex:none;margin-top:5px" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--mint-ink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                  {f}
                </li>
              ))}
            </ul>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:auto;padding-top:8px">
              <a href={`/consult?package=${p.key}`} class="btn">{p.btn}</a>
              <a href={`/contact?package=${p.key}`} class="btn btn--outline">سؤال درباره پکیج {p.name}</a>
            </div>
            <small style="color:var(--mut)">{p.foot}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ امکانات مشترک در همهٔ پکیج‌ها ═══ -->
  <section class="section bg-soft" aria-labelledby="common-title">
    <div class="container">
      <SectionHead tag="استانداردهای کافه دانش" title="استانداردهای کافه دانش در تمام پروژه‌ها" sub="تفاوت پکیج‌ها در نوع امکانات و دامنه اجراست؛ اما کیفیت اجرا، شفافیت همکاری و توجه به تجربه کاربری در تمام پروژه‌ها اهمیت دارد." center />
      <div class="common-grid">
        {commonFeatures.map((c, i) => (
          <div class="card common-item" data-reveal="up" data-delay={String((i % 4) * 70)}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--mint-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
            <div>
              <strong>{c.t}</strong>
              <span>{c.d}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ زمان تحویل و هزینه‌های دوره‌ای ═══ -->
  <section class="section" aria-labelledby="timeline-title">
    <div class="container">
      <SectionHead tag="زمان تحویل و هزینه‌ها" title="زمان تحویل و هزینه‌های پس از راه‌اندازی" sub="برای تصمیم‌گیری دقیق، بهتر است علاوه بر قیمت طراحی سایت، زمان اجرای پروژه و هزینه‌های احتمالی نگهداری آن را نیز از ابتدا بدانید." center />
      <div class="ops-grid">
        <article class="card" style="padding:clamp(22px,3vw,30px);display:grid;gap:14px" data-reveal="up">
          <h3 style="font-size:1.15rem;margin:0">هر پکیج چقدر زمان نیاز دارد؟</h3>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:10px;font-size:.95rem">
            <li style="display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px"><span><b>پکیج شرکتی</b></span><span style="color:var(--mut)">۲ تا ۳ هفته</span></li>
            <li style="display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px"><span><b>پکیج فروشگاهی</b></span><span style="color:var(--mut)">۴ تا ۶ هفته</span></li>
            <li style="display:flex;justify-content:space-between;gap:12px"><span><b>پکیج اختصاصی</b></span><span style="color:var(--mut)">بر اساس فازهای اجرایی و محدوده پروژه</span></li>
          </ul>
          <p style="margin:0;color:var(--mut);font-size:.9rem">زمان‌بندی پروژه پس از دریافت اطلاعات، محتوا و دسترسی‌های موردنیاز آغاز می‌شود. آماده‌بودن محتوای اولیه و ارائه بازخورد در زمان مناسب، به حفظ برنامه تحویل کمک می‌کند. زمان‌بندی نهایی در توافق پروژه مشخص خواهد شد.</p>
        </article>
        <article class="card" style="padding:clamp(22px,3vw,30px);display:grid;gap:14px" data-reveal="up" data-delay="90">
          <h3 style="font-size:1.15rem;margin:0">پس از راه‌اندازی سایت چه هزینه‌هایی وجود دارد؟</h3>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:10px;font-size:.95rem">
            <li style="display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px"><span><b>دامنه</b></span><span style="color:var(--mut)">تمدید دامنه به‌صورت سالانه و بر اساس تعرفه روز ثبت‌کننده انجام می‌شود</span></li>
            <li style="display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px"><span><b>هاست و میزبانی</b></span><span style="color:var(--mut)">پس از پایان دوره هدیه هر پکیج، بر اساس نوع سرویس و نیاز سایت</span></li>
            <li style="display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed var(--line);padding-bottom:10px"><span><b>سئو و تولید محتوا</b></span><span style="color:var(--mut)">در صورت نیاز، جداگانه و با محدوده و برآورد مشخص</span></li>
            <li style="display:flex;justify-content:space-between;gap:12px"><span><b>پشتیبانی و توسعه</b></span><span style="color:var(--mut)">پس از پایان مدت پشتیبانی رایگان، با توافق جداگانه</span></li>
          </ul>
          <p style="margin:0;color:var(--mut);font-size:.9rem">هزینه‌های دوره‌ای و خدمات خارج از پکیج پیش از انجام، به شما اعلام می‌شوند تا برای نگهداری و توسعه وب‌سایت برنامه‌ریزی روشنی داشته باشید.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- خدمات مکمل و پس از راه‌اندازی -->
  <section class="section bg-soft">
    <div class="container">
      <SectionHead tag="خدمات مکمل و پشتیبانی" title="خدمات مکمل برای رشد و نگهداری وب‌سایت" sub="تخصص اصلی کافه دانش طراحی و توسعه وب‌سایت است. پس از راه‌اندازی نیز می‌توانید برای بهبود عملکرد، تولید محتوای هدفمند و نگهداری فنی سایت از خدمات مکمل ما استفاده کنید." center />
      <div class="compl-price-grid">
        {complementary.map((c, i) => (
          <article class="card" style="padding:clamp(22px,3vw,30px);display:flex;flex-direction:column;gap:10px" data-reveal="up" data-delay={String(i * 90)}>
            <h3 style="font-size:1.15rem;margin:0">{c.t}</h3>
            <p style="color:var(--mut);font-size:.92rem;margin:0;flex:1">{c.d}</p>
            <p style="margin:0"><b style="color:var(--navy)">برآورد هزینه پس از نیازسنجی</b></p>
            <a href={c.href} class="btn btn--outline" style="justify-content:center">{c.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ سؤالات متداول تعرفه‌ها ═══ -->
  <section class="section" aria-labelledby="pricing-faq-title">
    <div class="container">
      <SectionHead tag="سؤالات متداول" title="سؤالات متداول درباره قیمت و شرایط طراحی سایت" sub="پیش از انتخاب پکیج، پاسخ پرسش‌های متداول درباره هزینه، امکانات، زمان اجرا و شرایط همکاری را بررسی کنید." center />
      <div class="faq-wrap">
        {pricingFaq.map((f, i) => (
          <div class:list={['faq-item', { 'is-open': i === 0 }]} data-accordion-item data-reveal="up" data-delay={String(i * 60)}>
            <button class="faq-item__btn" type="button" data-accordion-btn aria-expanded={i === 0 ? 'true' : 'false'}>
              {f.q}
              <span class="faq-item__sign" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="faq-item__panel" data-accordion-panel aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="faq-item__panel-inner">{f.a}</div>
            </div>
          </div>
        ))}
