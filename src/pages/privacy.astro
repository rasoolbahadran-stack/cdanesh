---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { q } from '../lib/db';

const page = await q(`SELECT * FROM pages WHERE system_key='privacy' AND status='published'`).then((r) => r[0] ?? null);
if (!page) return Astro.redirect('/404', 302);
---
<BaseLayout
  title={String(page.seo_title) || String(page.title)}
  description={String(page.seo_description) || String(page.excerpt)}
  activePath="/privacy"
>
  <PageHero title={String(page.title)} sub={String(page.excerpt)} crumbs={[{ label: 'حریم خصوصی', href: '' }]} />
  <section class="sec">
    <div class="wrap-narrow">
      <div class="prose-fa" data-reveal set:html={String(page.content)} />
    </div>
  </section>
</BaseLayout>
