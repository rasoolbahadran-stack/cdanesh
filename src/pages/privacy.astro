---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "سیاست حفظ حریم خصوصی | کافه‌دانش";
const description = "نحوه جمع‌آوری، استفاده و حفاظت از اطلاعات کاربران در وب‌سایت کافه‌دانش.";
const canonical = "https://cdanesh.ir/privacy";
---

<SiteLayout title={title} description={description} canonical={canonical}>
<!-- ═══ هیرو ═══ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="./">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>حریم خصوصی</span>
    </nav>
    <span class="eyebrow">سیاست حفظ حریم خصوصی</span>
    <h1 class="h1">اطلاعات شما، <span class="gold">مسئولیت ما</span></h1>
    <p class="lead">این سند توضیح می‌دهد چه اطلاعاتی در وب‌سایت کافه‌دانش جمع‌آوری می‌شود، چرا و چگونه محافظت می‌شود. آخرین به‌روزرسانی: آبان ۱۴۰۵.</p>
  </div>
</section>

<section class="section-tight">
  <div class="wrap" style="max-width:880px">
    <div class="prose">
      <h2 id="p1">چه اطلاعاتی جمع‌آوری می‌شود؟</h2>
      <p>فقط اطلاعاتی که شما خودتان وارد می‌کنید: نام، شماره تماس، ایمیل و متن درخواست یا پیام شما در فرم‌های سایت. علاوه بر آن، داده‌های فنی معمول بازدید (مانند نوع مرورگر و صفحات بازدیدشده) به‌صورت تجمیعی و بدون شناسایی هویت شما ثبت می‌شود.</p>
      <h2 id="p2">چرا جمع‌آوری می‌شود؟</h2>
      <ul class="check-list">
        <li>پاسخ‌دادن به درخواست و پیام شما</li>
        <li>هماهنگی جلسه مشاوره و پیگیری پروژه</li>
        <li>بهبود عملکرد و محتوای سایت بر اساس رفتار تجمیعی بازدیدکنندگان</li>
      </ul>
      <p>اطلاعات شما برای ارسال پیام تبلیغاتی بدون اجازه استفاده نمی‌شود و به اشخاص ثالث فروخته نمی‌شود.</p>
      <h2 id="p3">ابزارهای هوش مصنوعی و محرمانگی</h2>
      <p>وقتی از ابزارهای هوشمند سایت استفاده می‌کنید، متن ورودی شما به‌صورت امن از سمت سرور به سرویس مدل زبانی ارسال می‌شود؛ کلیدهای دسترسی هرگز در مرورگر قرار نمی‌گیرند. ورودی‌ها فقط برای تولید پاسخ همان درخواست استفاده می‌شوند و برای این ابزارها داده حساس (رمز، شماره کارت، اطلاعات محرمانه کسب‌وکار) وارد نکنید.</p>
      <h2 id="p4">کوکی‌ها</h2>
      <p>سایت از کوکی‌های ضروری برای عملکرد (مانند حفظ نشست ورود مدیر) استفاده می‌کند. کوکی‌های تحلیلی فقط در صورت فعال‌بودن و با هدف گزارش تجمیعی به کار می‌روند. می‌توانید کوکی‌ها را از تنظیمات مرورگر حذف یا مسدود کنید؛ بخشی از قابلیت‌ها (مثل ورود به پنل) بدون آن‌ها کار نخواهد کرد.</p>
      <h2 id="p5">امنیت داده‌ها</h2>
      <p>رمزهای عبور به‌صورت هش‌شده ذخیره می‌شوند و هرگز متن خام آن‌ها نگه‌داری نمی‌شود. ارتباط صفحات از طریق HTTPS انجام می‌شود و دسترسی به بخش مدیریت با نقش‌بندی و ثبت گزارش فعالیت محافظت می‌شود.</p>
      <h2 id="p6">حقوق شما</h2>
      <p>می‌توانید درخواست کنید اطلاعات‌تان اصلاح یا حذف شود؛ کافی است از طریق <a href="contact.html" style="color:var(--gold)">صفحه تماس</a> پیام بدهید. درخواست‌ها حداکثر در یک بازه کاری معقول بررسی می‌شود.</p>
      <h2 id="p7">تغییرات این سند</h2>
      <p>اگر این سیاست به‌روزرسانی شود، نسخه جدید همین‌جا منتشر و تاریخ به‌روزرسانی تغییر می‌کند. تغییرات مهم (مانند افزودن سرویس تحلیلی جدید) در همین صفحه شفاف اعلام می‌شود.</p>
    </div>
  </div>
</section>
</SiteLayout>
