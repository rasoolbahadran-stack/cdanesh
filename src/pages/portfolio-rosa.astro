---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "فروشگاه اینترنتی رُزا | نمونه‌کار کافه‌دانش";
const description = "نمونه مفهومی فروشگاه اینترنتی رُزا با طراحی اختصاصی، فیلتر دسته‌بندی و صفحه محصول بهینه برای تبدیل.";
---

<SiteLayout title={title} description={description} schemas={false}>
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <a href="/portfolio">نمونه‌کارها</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>فروشگاه رُزا</span>
    </nav>
    <span class="eyebrow">نمونه‌کار فروشگاهی</span>
    <h1 class="h1">فروشگاهی که خرید را <span class="gold">ساده و مطمئن</span> می‌کند</h1>
    <p class="lead">نمونه‌ای از فروشگاه محصولات تازه با تجربه خرید روان: از صفحه دسته‌بندی و فیلتر هوشمند تا صفحه محصول بهینه‌شده برای تبدیل.</p>
    <div class="page-hero-pills">
      <span class="chip chip-gold">فروشگاهی</span>
      <span class="badge-demo">نمونه مفهومی — پروژه نمایشی</span>
      <span class="chip">طراحی اختصاصی</span>
      <span class="chip">درگاه پرداخت</span>
      <span class="chip">سبد خرید روان</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="pf-card">
      <div class="pf-head">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pf-url">cdanesh.ir/demo/portfolio-rosa</span>
        <span class="pf-url" style="flex:0">با ماوس بکشید یا اسکرول کنید</span>
      </div>
      <div class="pf-window custom-scrollbar" role="region" aria-label="پیش‌نمایش کامل فروشگاه رُزا — اسکرول داخل قاب">
        <img src="/assets/img/pf-shop.webp" alt="نمای کامل صفحه فروشگاه رُزا — نمونه مفهومی" width="1280" height="3051" loading="lazy">
      </div>
    </div>
    <p class="muted small" style="text-align:center; margin-top:18px">این تصویر، نمای کاملِ صفحه‌ی اصلی نمونه است. داخل قاب اسکرول کنید تا همه بخش‌ها را ببینید.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">درباره پروژه</span>
      <h2 class="h2">هدف و روند <span class="gold">اجرای پروژه</span></h2>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">هدف این نمونه، نمایش تجربه خریدی است که مشتری را با کمترین کلیک به محصول می‌رساند. صفحه اصلی مستقیماً به دسته‌بندی‌های پرطرفدار و پرفروش‌های هفته می‌رسد و مسیر «انتخاب تا پرداخت» حداکثر در سه گام طی می‌شود.</p>
      <p style="color:var(--mut); line-height:2.1; margin-top:16px">در این ساختار، صفحه محصول طوری چیده شده که تصویر، قیمت، اطلاعات ارسال و دکمه خرید همه در دید اول باشند. بخش «چرا ما» به جای شعار، به تضمین‌های واقعی مثل سیاست بازگشت کالا و پرداخت امن اختصاص دارد تا اعتماد مشتری ساخته شود.</p>
      <div class="duo-points" style="margin-top:24px">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>ساختار دسته‌بندی سه‌سطحیه برای ده‌ها محصول</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>صفحه محصول با تمرکز بر تبدیل</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>جریان پرداخت کوتاه و شفاف</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg><span>آماده اتصال به انبار و ارسال</span></li>
      </div>
    </div>
    <aside class="aside-card reveal" data-delay="1">
      <b style="font-size:16px">مشخصات پروژه</b>
      <ul style="margin-top:16px; display:grid; gap:12px; font-size:13.5px; color:var(--mut)">
        <li style="display:flex; justify-content:space-between; gap:12px"><span>نوع پروژه</span><b style="color:var(--txt)">فروشگاهی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>وضعیت</span><b style="color:var(--warn)">نمونه مفهومی</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>خدمات اجراشده</span><b style="color:var(--txt)">طراحی سایت + UI/UX</b></li>
        <li style="display:flex; justify-content:space-between; gap:12px"><span>زمان اجرای مشابه</span><b style="color:var(--txt)">طبق برآورد پروژه</b></li>
      </ul>
      <p class="pkg-note">این نمونه برای نمایش سبک کار و کیفیت اجرای ما ساخته شده است؛ هیچ کسب‌وکار واقعی به آن اشاره ندارد.</p>
      <a class="btn btn-gold btn-block" href="/request" style="margin-top:18px">پروژه مشابه می‌خواهم</a>
    </aside>
  </div>
</section>

<section class="section-tight" style="padding-bottom:20px">
  <div class="wrap">
    <span class="eyebrow">امکانات کلیدی</span>
    <h2 class="h2" style="margin-top:10px">چه چیزهایی در این نمونه <span class="gold">پیاده شده است</span>؟</h2>
    <div class="feat-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px">
      <div class="feat-card"><b>فیلتر و دسته‌بندی هوشمند</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">دسته‌بندی موضوعی با امکان ترکیب فیلترها برای رسیدن سریع به محصول موردنظر.</p></div>
      <div class="feat-card"><b>صفحه محصول تبدیل‌محور</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">چیدمان تک‌ستونیِ اطلاعات کلیدی با نمایش قیمت، موجودی و زمان ارسال در دید اول.</p></div>
      <div class="feat-card"><b>سبد و پرداخت روان</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">جریان خرید سه‌گامی با نمایش شفاف هزینه ارسال پیش از پرداخت.</p></div>
      <div class="feat-card"><b>طراحی ریسپانسیو</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">نمایش درست در موبایل و تبلت؛ تجربه خرید یکسان روی همه دستگاه‌ها.</p></div>
      <div class="feat-card"><b>زیرساخت سئو</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">آدرس‌های تمیز، تگ‌گذاری محصول و ساختار مناسب برای دیده‌شدن در جست‌وجو.</p></div>
      <div class="feat-card"><b>پنل مدیریت ساده</b><p style="font-size:13px; color:var(--mut); margin-top:8px; line-height:1.9">افزودن محصول، تغییر قیمت و مدیریت سفارش‌ها بدون نیاز به دانش فنی.</p></div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div>
        <h2>پروژه‌ای شبیه این نمونه در سر دارید؟</h2>
        <p>در جلسه مشاوره، دقیقاً می‌گوییم چه ساختار و چه امکاناتی برای هدف شما لازم است.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark btn-lg" href="/request">شروع پروژه</a>
        <a class="btn btn-ghost btn-lg" href="/portfolio">نمونه‌کارهای دیگر</a>
      </div>
    </div>
  </div>
</section>
</SiteLayout>
