---
/* فوتر کافه دانش — سرمه‌ای تیره با هاله‌های گرادیانی + امضای طراح */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { SiteSettings } from '../lib/seed/settings-data';

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const f = settings.footer;
const c = settings.contact;
const phoneHref = 'tel:+98' + String(c.phone).replace(/\D/g, '').slice(1);
const github = c.github || 'https://github.com/rasoolbahadran-stack';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <!-- معرفی برند -->
      <div class="footer__about">
        <Logo variant="light" class="footer__logo" />
        <p class="footer__desc">{f.aboutText}</p>
        <ul class="footer__social" aria-label="راه‌های ارتباطی سریع">
          <li>
            <a href={`mailto:${c.email}`} aria-label="ایمیل کافه دانش">
              <Icon name="mail" size={17} stroke={1.9} />
            </a>
          </li>
          <li>
            <a href={phoneHref} aria-label="تماس تلفنی">
              <Icon name="phone" size={17} stroke={1.9} />
            </a>
          </li>
          <li>
            <a href={github} target="_blank" rel="noopener" aria-label="گیت‌هاب کافه دانش">
              <Icon name="github" size={17} stroke={1.7} />
            </a>
          </li>
          <li>
            <a href="/consult" aria-label="درخواست مشاوره">
              <Icon name="send" size={17} stroke={1.9} />
            </a>
          </li>
        </ul>
      </div>

      <!-- خدمات -->
      <nav class="footer__widget" aria-label="خدمات ما">
        <h4 class="footer__title">خدمات ما</h4>
        <ul class="footer__links">
          {f.colServices.map((l: { label: string; href: string }) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
          <li><a href="/services">همهٔ خدمات</a></li>
        </ul>
      </nav>

      <!-- دسترسی سریع -->
      <nav class="footer__widget" aria-label="لینک‌های مفید">
        <h4 class="footer__title">دسترسی سریع</h4>
        <ul class="footer__links">
          {f.colQuick.map((l: { label: string; href: string }) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- راه‌های ارتباطی -->
      <div class="footer__widget">
        <h4 class="footer__title">راه‌های ارتباطی</h4>
        <ul class="footer__contact">
          <li>
            <Icon name="phone" size={17} stroke={1.9} />
            <a href={phoneHref} dir="ltr">{c.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={17} stroke={1.9} />
            <a href={`mailto:${c.email}`} dir="ltr">{c.email}</a>
          </li>
          <li>
            <Icon name="pin" size={17} stroke={1.9} />
            <span>{c.address}</span>
          </li>
        </ul>
        <div class="footer__hours">
          <Icon name="clock" size={15} stroke={1.9} />
          <span>{c.hours}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- کپی‌رایت + امضای طراح -->
  <div class="footer__copy">
    <div class="container footer__copy-row">
      <p class="footer__copyright">{f.copyright}</p>
      <p class="footer__designer">
        طراحی و توسعه وب‌سایت توسط
        <a href="https://www.cdanesh.ir/" target="_blank" rel="noopener">رسول بهادران | طراح سایت</a>
        <span class="footer__sep" aria-hidden="true">|</span>
        <a href="https://www.cdanesh.ir/" target="_blank" rel="noopener">کافه دانش</a>
      </p>
    </div>
  </div>
</footer>
