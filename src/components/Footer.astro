---
// پاورقی کافه دانش — چهار ستون منظم در دسکتاپ؛ فشرده و مینیمال در موبایل
import Logo from './Logo.astro';
import { FOOTER_LINKS, SITE } from '../lib/content';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__about">
        <a href="/" class="logo" style="color:#fff" aria-label="کافه دانش — صفحه اصلی">
          <Logo variant="full" />
        </a>
        <p>استودیو تخصصی طراحی و توسعه وب‌سایت؛ سایت شرکتی، فروشگاه اینترنتی و وب‌سایت اختصاصی.</p>
        <div class="footer__reach">
          <a href={`tel:${SITE.phoneIntl}`} class="footer__reach-link">{SITE.phoneFa}</a>
          <a href={`mailto:${SITE.email}`} class="footer__reach-link">{SITE.email}</a>
        </div>
      </div>

      <nav aria-label="خدمات کافه دانش">
        <h4>خدمات</h4>
        <ul class="footer__list">
          {FOOTER_LINKS.services.map((l) => (
            <li><a href={l.href}>{l.t}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="دسترسی سریع">
        <h4>دسترسی سریع</h4>
        <ul class="footer__list">
          {FOOTER_LINKS.quick.map((l) => (
            <li><a href={l.href}>{l.t}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__contact">
        <h4>شروع همکاری</h4>
        <p>جلسهٔ اول مشاوره رایگان است؛ اهداف و نیازهای پروژه‌تان را با هم مرور می‌کنیم.</p>
        <a href="/consult" class="btn btn--sm">درخواست مشاوره و سفارش پروژه</a>
        <a href="/contact" class="footer__contact-alt">فرم تماس — پاسخ‌گویی حداکثر یک روز کاری</a>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {SITE.year} کافه‌دانش — تمامی حقوق محفوظ است. طراحی: <a href={SITE.github} target="_blank" rel="noopener">{SITE.designer}</a></span>
      <span class="footer__legal">
        <a href="/privacy">حریم خصوصی</a>
        <a href="/terms">شرایط استفاده</a>
      </span>
    </div>
  </div>
</footer>
<button type="button" class="to-top" aria-label="بازگشت به بالای صفحه">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m0 0-6 6m6-6 6 6" /></svg>
</button>
