---
// پاورقی مینیمال کافه دانش
import Logo from './Logo.astro';
import { FOOTER_LINKS, SITE } from '../lib/content';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__about">
        <a href="/" class="logo" style="color:#fff" aria-label="کافه دانش — صفحه اصلی">
          <Logo variant="full" />
        </a>
        <p>استودیو تخصصی طراحی و توسعه وب‌سایت؛ سایت شرکتی، فروشگاه اینترنتی و وب‌سایت اختصاصی.</p>
      </div>

      <nav aria-label="دسترسی سریع و خدمات">
        <h4>دسترسی سریع</h4>
        <ul class="footer__list">
          {[...FOOTER_LINKS.services, ...FOOTER_LINKS.quick].map((l) => (
            <li><a href={l.href}>{l.t}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__contact">
        <h4>ارتباط با ما</h4>
        <ul class="footer__list">
          <li><a href="/contact">فرم تماس</a></li>
          <li><a href="/consult">درخواست مشاوره</a></li>
          <li><a href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phoneIntl}`} dir="ltr">{SITE.phoneFa}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {SITE.year} کافه‌دانش — تمامی حقوق محفوظ است. طراحی: <a href="https://github.com/rasoolbahadran-stack" target="_blank" rel="noopener">{SITE.designer}</a></span>
      <span class="footer__legal">
        <a href="/privacy">حریم خصوصی</a>
        <a href="/terms">شرایط استفاده</a>
      </span>
    </div>
  </div>
</footer>
<button type="button" class="to-top" aria-label="بازگشت به بالای صفحه">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m0 0-6 6m6-6 6 6" /></svg>
</button>
