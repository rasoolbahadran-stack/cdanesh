---
// لوگوی کافه دانش — نسخه کامل (نشان فنجان + واژه‌نگار)
interface Props { variant?: 'full' | 'mark'; class?: string }
const { variant = 'full', class: cls } = Astro.props;
---
{
  variant === 'full' ? (
    <svg width="184" height="46" viewBox="0 0 196 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="کافه دانش — Cafe Danesh" class={cls}>
      <defs>
        <linearGradient id={`cd-g-${variant}`} x1="152" y1="44" x2="194" y2="4" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F4257B" />
          <stop offset="1" stop-color="#A35EEC" />
        </linearGradient>
      </defs>
      <g>
        <rect x="152" y="2" width="44" height="44" rx="12.5" fill={`url(#cd-g-${variant})`} />
        <g stroke="#ffffff" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path d="M160 20.5h17.5v9.5a6.5 6.5 0 0 1-6.5 6.5h-4.5a6.5 6.5 0 0 1-6.5-6.5v-9.5Z" />
          <path d="M177.5 23h2.8a4 4 0 0 1 0 8h-2.8" />
          <path d="M164 16c0-2 1.7-2 1.7-4M170.5 16c0-2 1.7-2 1.7-4" />
        </g>
        <path d="M186 7.4c.3 2 1.3 3 3.3 3.3-2 .3-3 1.3-3.3 3.3-.3-2-1.3-3-3.3-3.3 2-.3 3-1.3 3.3-3.3Z" fill="#FFD7E8" />
      </g>
      <text x="70" y="25" font-size="24" font-weight="800" fill="currentColor" font-family="Vazirmatn, Tahoma, sans-serif" text-anchor="middle">کافه دانش</text>
      <text x="70" y="45" font-size="10" font-weight="700" letter-spacing="2.6" fill="#F4257B" font-family="Vazirmatn, Tahoma, sans-serif" text-anchor="middle">CAFE DANESH</text>
    </svg>
  ) : (
    <svg width="42" height="42" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="کافه دانش" class={cls}>
      <defs>
        <linearGradient id={`cd-g-${variant}`} x1="8" y1="56" x2="56" y2="8" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F4257B" />
          <stop offset="1" stop-color="#A35EEC" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="17" fill={`url(#cd-g-${variant})`} />
      <g stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M18 30h24v13a9 9 0 0 1-9 9h-6a9 9 0 0 1-9-9V30Z" />
        <path d="M42 34h4a5.5 5.5 0 0 1 0 11h-4" />
        <path d="M24 24c0-2.7 2.3-2.7 2.3-5.4M33 24c0-2.7 2.3-2.7 2.3-5.4" />
      </g>
      <path d="M52 10.5c.5 2.7 1.8 4 4.5 4.5-2.7.5-4 1.8-4.5 4.5-.5-2.7-1.8-4-4.5-4.5 2.7-.5 4-1.8 4.5-4.5Z" fill="#FFD7E8" />
    </svg>
  )
}
