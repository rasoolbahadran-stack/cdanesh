---
/* لوگوی وردمارک کافه دانش — سبک Porto: تایپ درشت سرمه‌ای + زیرنویس انگلیسی صورتی */
interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
---
<a href="/" class="logo" aria-label="کافه دانش (Cafe Danesh) — صفحه اصلی">
  <span>
    <b style={size === 'sm' ? 'font-size:19px' : ''}>کافه دانش</b>
    <small>Cafe Danesh</small>
  </span>
</a>
