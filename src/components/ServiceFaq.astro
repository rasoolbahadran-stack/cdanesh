---
/* ═══ بلوک سؤالات متداول صفحات خدمات — رندر در HTML اولیه (قابل خزش) ═══
   داده از src/data/faq-pages.json؛ اگر مدیر در پنل ویرایشی ذخیره کرده باشد،
   site.js همان‌جا بازنویسی می‌کند (سازگار با رفتار قبلی). */
import faqPages from '../data/faq-pages.json';

interface Props {
  pageKey: string;
  class?: string;
}
const { pageKey, class: className } = Astro.props;
const items = (faqPages[pageKey] || []).filter(x => x.on !== false);
---
{items.length > 0 && (
  <div class={className} data-page-faq={pageKey}>
    {items.map(it => (
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">{it.q}
          <span class="fx" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-a"><div>{it.a}</div></div>
      </div>
    ))}
  </div>
)}
