---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  og?: boolean;
  schemas?: boolean;
  robots?: string;
}
const {
  title,
  description = '',
  canonical = '',
  og,
  schemas = true,
  robots = '',
} = Astro.props;
/* اگر og مشخص نشده باشد: هر صفحه‌ای که canonical دارد، تگ‌های Open Graph هم می‌گیرد (مطابق نسخهٔ تأییدشده) */
const showOg = og ?? Boolean(canonical);
const ORG = JSON.stringify({"@context": "https://schema.org", "@type": "Organization", "name": "کافه‌دانش", "alternateName": "Cdanesh Studio", "url": "https://cdanesh.ir/", "logo": "https://cdanesh.ir/assets/img/logo.svg", "email": "info@cdanesh.ir", "telephone": "+98-916-580-6207", "address": {"@type": "PostalAddress", "streetAddress": "خیابان شهید رجایی", "addressLocality": "بوشهر", "addressCountry": "IR"}, "sameAs": ["https://github.com/rasoolbahadran-stack"], "founder": {"@type": "Person", "name": "رسول بهادران", "jobTitle": "طراح و توسعه‌دهنده وب‌سایت", "telephone": "+98-916-580-6207", "address": {"@type": "PostalAddress", "addressLocality": "بوشهر", "addressCountry": "IR"}, "url": "https://www.cdanesh.ir", "sameAs": ["https://github.com/rasoolbahadran-stack"]}});
const SITE = JSON.stringify({"@context": "https://schema.org", "@type": "WebSite", "name": "کافه‌دانش", "url": "https://cdanesh.ir/", "inLanguage": "fa-IR"});
---
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description ? <meta name="description" content={description} /> : null}
  {robots ? <meta name="robots" content={robots} /> : null}
  <link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg" />
  <link rel="apple-touch-icon" href="/assets/img/logo-180.png" />
  <link rel="stylesheet" href="/assets/css/main.css" />
  <link rel="stylesheet" href="/assets/css/components.css" />
  {canonical ? <link rel="canonical" href={canonical} /> : null}
  {showOg && (
    <>
      <meta property="og:site_name" content="کافه‌دانش" />
      <meta property="og:type" content="website" />
      <meta property="og:locale" content="fa_IR" />
      <meta property="og:title" content={title} />
      {description ? <meta property="og:description" content={description} /> : null}
      {canonical ? <meta property="og:url" content={canonical} /> : null}
      <meta property="og:image" content="https://cdanesh.ir/assets/img/og-default.webp" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      {description ? <meta name="twitter:description" content={description} /> : null}
    </>
  )}
  {schemas && (
    <>
      <script is:inline type="application/ld+json" data-cd-org set:html={ORG} />
      <script is:inline type="application/ld+json" data-cd-site set:html={SITE} />
    </>
  )}
  <slot />
</head>
