---
/* هدر دقیقاً سبک Porto SEO 2: تاپ‌بار (تلفن سرمه‌ای + شبکه‌ها | ساعات + ایمیل)
   + ناوبری سفید با لوگوی وردمارک + مگامنو تراز داخل کانتینر + جستجو */
import Logo from './Logo.astro';
import type { SiteSettings } from '../lib/seed/settings-data';

interface Props {
  settings: SiteSettings;
  activePath?: string;
}
const { settings, activePath = '' } = Astro.props;
const c = settings.contact;
const m = settings.menu;

const isActive = (href: string) => (href === '/' ? activePath === '/' : activePath.startsWith(href));
---
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <a class="tb-phone" href={`tel:+98${c.phone.slice(1)}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        <span dir="ltr">{c.phoneDisplay}</span>
      </a>
      <span class="tb-icons" aria-label="شبکه‌های اجتماعی">
        <a href="#" aria-label="فیس‌بوک"><svg viewBox="0 0 24 24"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.4H7.8V13h2.7v8h3z"/></svg></a>
        <a href="#" aria-label="توییتر"><svg viewBox="0 0 24 24"><path d="M22 5.9c-.7.3-1.5.6-2.3.7.8-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.6 1a4.1 4.1 0 0 0-7 3.7A11.6 11.6 0 0 1 3.4 4.7a4.1 4.1 0 0 0 1.3 5.5c-.7 0-1.3-.2-1.9-.5v.1c0 2 1.4 3.6 3.3 4a4.2 4.2 0 0 1-1.9.1 4.1 4.1 0 0 0 3.8 2.9A8.2 8.2 0 0 1 2 18.4a11.6 11.6 0 0 0 6.3 1.8c7.5 0 11.7-6.3 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2.1z"/></svg></a>
        <a href="#" aria-label="لینکدین"><svg viewBox="0 0 24 24"><path d="M6.9 8.9H3.5V21h3.4V8.9zM5.2 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM20.5 13.9c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.1 1.7V8.9H10V21h3.4v-6.7c0-1.5.7-2.4 1.9-2.4 1.2 0 1.8.8 1.8 2.4V21h3.4v-7.1z"/></svg></a>
      </span>
    </div>
    <div class="topbar-right">
      <span class="tb-item hide-sm">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4l4.2 2.5-.8 1.3L11 13V6h2v6.4z"/></svg>
        <span>{c.hours}</span>
      </span>
      <a class="tb-item" href={`mailto:${c.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        <span dir="ltr">{c.email}</span>
      </a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="main-nav" aria-label="منوی اصلی">
      <a href="/" class={`nav-link ${isActive('/') ? 'active' : ''}`}>خانه</a>
      <div class="nav-item">
        <a href="/services" class={`nav-link ${isActive('/services') ? 'active' : ''}`}>
          خدمات <span class="caret">▾</span>
        </a>
        <div class="mega" role="menu">
          {m.megaGroups.map((g) => (
            <div class="mega-col">
              <h4>{g.title}</h4>
              {g.items.map((it) => (
                <a class="mega-item" href={it.href}>
                  <b>{it.label}</b>
                  <span>{it.desc}</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
      {m.main.filter((item) => item.href !== '/').map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? 'active' : ''}`}>{item.label}</a>
      ))}
    </nav>
    <div class="header-search">
      <button class="search-toggle" type="button" aria-label="جستجو در سایت" aria-expanded="false" data-search-toggle>
        <span class="st-sep" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"/></svg>
      </button>
      <div class="search-box" data-search-box>
        <form action="/blog" method="get" role="search">
          <input type="search" name="q" placeholder="جستجوی مقاله…" aria-label="عبارت جستجو" />
          <button type="submit">جستجو</button>
        </form>
      </div>
    </div>
    <a href={m.ctaHref} class="btn btn-gold btn-sm header-cta-mobile">مشاوره رایگان</a>
    <button class="burger" aria-label="باز کردن منو">☰</button>
  </div>
</header>

<div class="mobile-nav" aria-hidden="true">
  <div class="mn-scrim"></div>
  <div class="mn-panel">
    <button class="mn-close" aria-label="بستن منو">✕</button>
    <a href="/">خانه</a>
    <div class="mn-group-label">خدمات</div>
    {m.megaGroups.map((g) => g.items.map((it) => <a href={it.href}>{it.label}</a>))}
    <div class="mn-group-label">دسترسی سریع</div>
    {m.main.map((item) => <a href={item.href}>{item.label}</a>)}
    <div style="margin-top:16px">
      <a href={m.ctaHref} class="btn btn-gold btn-block">{m.ctaLabel} رایگان</a>
    </div>
  </div>
</div>
