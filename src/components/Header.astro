---
/* هدر کافه دانش — تاپ‌بار شیشه‌ای + ناوبری شناور روی گرادیان + زیرمنو + منوی موبایل */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { SiteSettings } from '../lib/seed/settings-data';

interface Props {
  settings: SiteSettings;
  activePath?: string;
}
const { settings, activePath = '' } = Astro.props;
const c = settings.contact;
const m = settings.menu;
const phoneHref = 'tel:+98' + String(c.phone).replace(/\D/g, '').slice(1);

const isActive = (href: string) => {
  const clean = href.split('#')[0];
  if (clean === '/' ) return activePath === '/';
  return clean !== '' && activePath.startsWith(clean);
};

type MenuItem = { label: string; href: string };
type MenuGroup = { title: string; items: { label: string; href: string; desc: string }[] };

/* آیتم‌های اصلی: خانه + خدمات (زیرمنو) + لینک‌های تنظیمات */
const serviceGroups: MenuGroup[] = m.megaGroups || [];
const mainItems: { label: string; href: string; groups?: MenuGroup[] }[] = [
  { label: 'خانه', href: '/' },
  { label: 'خدمات', href: '/services', groups: serviceGroups },
  ...m.main.map((it: MenuItem) => ({ label: it.label, href: it.href })),
];
---

<div class="topbar">
  <div class="container topbar__row">
    <div class="topbar__group">
      <a href={phoneHref}>
        <Icon name="phone" size={14} stroke={2} />
        <span dir="ltr">{c.phoneDisplay}</span>
      </a>
      <span class="topbar__sep" aria-hidden="true"></span>
      <span class="topbar__note">{c.hours}</span>
    </div>
    <div class="topbar__group">
      <a href={`mailto:${c.email}`}>
        <Icon name="mail" size={14} stroke={2} />
        <span dir="ltr">{c.email}</span>
      </a>
    </div>
  </div>
</div>

<header id="header" class="header" data-sticky>
  <div class="container header__wrap">
    <Logo variant="light" class="header__logo" />

    <nav class="header__nav" aria-label="ناوبری اصلی">
      <ul class="header__menu">
        {
          mainItems.map((item) => {
            const hasDrop = !!item.groups && item.groups.length > 0;
            const active = isActive(item.href) || (item.groups || []).some((g: MenuGroup) => g.items.some((s: { href: string }) => isActive(s.href)));
            return (
              <li class:list={['header__item', { 'has-drop': hasDrop, 'is-active': active }]}>
                <a href={item.href} class="header__link" aria-haspopup={hasDrop ? 'true' : undefined}>
                  {item.label}
                  {hasDrop && <Icon name="chevron-down" size={13} stroke={2.4} class="header__caret" />}
                </a>
                {hasDrop && (
                  <ul class="header__drop">
                    {item.groups!.map((g: MenuGroup) => (
                      <>
                        <li class="drop-title" role="presentation">{g.title}</li>
                        {g.items.map((sub: { label: string; href: string }) => (
                          <li>
                            <a href={sub.href}>{sub.label}</a>
                          </li>
                        ))}
                      </>
                    ))}
                    <li class="drop-title" role="presentation">دسترسی سریع</li>
                    <li><a href="/portfolio">نمونه‌کارها</a></li>
                    <li><a href="/pricing">تعرفه‌ها</a></li>
                    <li><a href="/faq">سؤالات متداول</a></li>
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={m.ctaHref} class="btn btn--sm">{m.ctaLabel}</a>
      <button
        class="header__burger"
        type="button"
        aria-label="باز کردن منو"
        aria-expanded="false"
        aria-controls="mobileMenu"
        data-menu-open
      >
        <Icon name="menu" size={26} stroke={2.2} />
      </button>
    </div>
  </div>
</header>

<!-- منوی موبایل -->
<div class="sidebar" id="mobileMenu" data-sidebar hidden>
  <div class="sidebar__backdrop" data-menu-close></div>
  <aside class="sidebar__panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
    <div class="sidebar__head">
      <Logo variant="dark" />
      <button class="sidebar__close" type="button" aria-label="بستن منو" data-menu-close>
        <Icon name="close" size={22} stroke={2.2} />
      </button>
    </div>
    <div class="sidebar__body">
      <nav aria-label="منوی موبایل">
        <ul class="sidebar__menu">
        {
          mainItems.map((item) => {
            const hasDrop = !!item.groups && item.groups.length > 0;
            return (
              <li class="sidebar__item">
                <a href={item.href} data-menu-nav>
                  {item.label}
                </a>
                {hasDrop && (
                  <>
                    <button
                      class="sidebar__toggle"
                      type="button"
                      aria-label={`باز کردن زیرمنوی ${item.label}`}
                      data-sub-toggle
                      aria-expanded="false"
                    >
                      <Icon name="plus" size={15} stroke={2.6} />
                    </button>
                    <ul class="sidebar__sub">
                      {item.groups!.map((g: MenuGroup) =>
                        g.items.map((sub: { label: string; href: string }) => (
                          <li>
                            <a href={sub.href} data-menu-nav>
                              {sub.label}
                            </a>
                          </li>
                        ))
                      )}
                      <li><a href="/services" data-menu-nav>همهٔ خدمات</a></li>
                    </ul>
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
    </div>
    <div class="sidebar__foot">
      <a href={m.ctaHref} class="btn btn--full" data-menu-nav>{m.ctaLabel}</a>
      <div class="sidebar__meta">
        <a href={phoneHref} dir="ltr">{c.phoneDisplay}</a>
        <span> | </span>
        <a href={`mailto:${c.email}`} dir="ltr">{c.email}</a>
      </div>
    </div>
  </aside>
</div>

<style>
  /* فاصلهٔ هدر از تاپ‌بار */
  .header {
    top: 42px;
  }

  .header.is-sticky,
  .header:global(.is-sticky) {
    top: 0;
  }

  @media (max-width: 1023px) {
    .header {
      top: 0;
    }
  }
</style>
