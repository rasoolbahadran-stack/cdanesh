---
// هدر کافه دانش — به سبک ساسمیکس: نوار قرصی شناور روی Hero + چسبیدن هنگام اسکرول
import Logo from './Logo.astro';
import { NAV, MEGA_GROUPS } from '../lib/content';

interface Props { current?: string }
const { current = '' } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---
<header id="header" class="header">
  <div class="container header__wrap">
    <a href="/" class="logo" aria-label="کافه دانش (Cafe Danesh) — صفحه اصلی" style="color:var(--navy)">
      <Logo variant="full" />
    </a>

    <nav class="header__nav" aria-label="ناوبری اصلی">
      {NAV.map((item) =>
        item.mega ? (
          <div class="mega-wrap">
            <button type="button" class="header__link" aria-expanded="false" aria-haspopup="true" data-mega-btn>
              {item.label}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="mega" role="menu" aria-label="خدمات کافه دانش">
              {MEGA_GROUPS.map((g) => (
                <div>
                  <p class="mega__col-title">{g.title}</p>
                  <ul class="mega__list">
                    {g.items.map((it) => (
                      <li><a href={it.href}>{it.t}<small>{it.d}</small></a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="mega__aside">
                <div>
                  <h4>مشاوره اولیه رایگان</h4>
                  <p>در یک جلسه کوتاه، مسیر رشد دیجیتال کسب‌وکارتان را بررسی می‌کنیم.</p>
                </div>
                <a href="/consult" class="btn btn--sm" style="justify-content:center">شروع پروژه</a>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['header__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="header__cta">
      <a href="/consult" class="btn btn--sm">درخواست مشاوره</a>
      <button type="button" class="burger" aria-label="بازکردن منو" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <a href="/" class="logo" style="color:var(--navy)"><Logo variant="full" /></a>
      <button type="button" class="burger" aria-label="بستن منو" data-menu-close style="display:block">
        <span></span>
      </button>
    </div>
    <ul class="mobile-menu__list">
      {NAV.map((item) =>
        item.mega ? (
          <li>
            <button type="button" class="mobile-menu__group-btn" aria-expanded="false" data-mobile-group>
              {item.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="mobile-menu__group-panel">
              {MEGA_GROUPS.flatMap((g) => g.items).map((it) => (
                <a href={it.href}>{it.t}</a>
              ))}
            </div>
          </li>
        ) : (
          <li><a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]} style={isActive(item.href) ? 'color:var(--pink)' : ''}>{item.label}</a></li>
        )
      )}
    </ul>
    <div class="mobile-menu__cta">
      <a href="/consult" class="btn">درخواست مشاوره رایگان</a>
      <a href="tel:+989165806207" class="btn btn--outline">۰۹۱۶ ۵۸۰ ۶۲۰۷</a>
    </div>
  </div>
</div>

<script>
  // ── رفتار هدر: قرصی شناور → چسبیدن پس از اسکرول ──
  const header = document.getElementById('header');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    if (!header) return;
    if (y > 60 && y > lastY + 4) {
      header.classList.add('header--sticky');
    } else if (y <= 60 || y < lastY - 4) {
      header.classList.remove('header--sticky');
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // ── منوی مگا: دسترس‌پذیری با کلیک/کیبورد ──
  document.querySelectorAll('[data-mega-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.closest('.mega-wrap')?.querySelector('.mega')?.classList.toggle('is-open', !open);
    });
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    document.querySelectorAll('.mega.is-open').forEach((m) => {
      if (!m.parentElement?.contains(t)) {
        m.classList.remove('is-open');
        m.parentElement?.querySelector('[data-mega-btn]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ── منوی موبایل ──
  const menu = document.querySelector('[data-mobile-menu]');
  const burger = document.querySelector('[data-burger]');
  const closeButton = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const openMenu = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', String(!open));
    burger?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) window.setTimeout(() => closeButton?.focus(), 30);
    else burger?.focus();
  };
  burger?.addEventListener('click', () => openMenu(true));
  closeButton?.addEventListener('click', () => openMenu(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('is-open')) openMenu(false);
  });
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) openMenu(false);
  });
  document.querySelectorAll('[data-mobile-group]').forEach((b) => {
    b.addEventListener('click', () => {
      b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));
    });
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => openMenu(false)));

  // ── دکمه بازگشت بالا ──
  const toTop = document.querySelector('.to-top');
  window.addEventListener('scroll', () => {
    toTop?.classList.toggle('is-show', window.scrollY > 600);
  }, { passive: true });
  toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
