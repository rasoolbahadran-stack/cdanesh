---
/* هدر حرفه‌ای کافه‌دانش: نوار بالا + نویگیشن چسبنده + مگامنو خدمات + دراور موبایل */
import Logo from './Logo.astro';
import type { SiteSettings } from '../lib/seed/settings-data';

interface Props {
  settings: SiteSettings;
  activePath?: string;
}
const { settings, activePath = '' } = Astro.props;
const c = settings.contact;
const m = settings.menu;

const isActive = (href: string) => (href === '/' ? activePath === '/' : activePath.startsWith(href));
---
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <a href={`mailto:${c.email}`}>✉️ {c.email}</a>
      <span class="hide-sm">🕘 {c.hours}</span>
    </div>
    <div class="topbar-right">
      <a class="tb-phone" href={`tel:+98${c.phone.slice(1)}`}>📞 {c.phoneDisplay}</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="main-nav" aria-label="منوی اصلی">
      <div class="nav-item">
        <a href="/services" class={`nav-link ${isActive('/services') ? 'active' : ''}`}>
          خدمات <span class="caret">▾</span>
        </a>
        <div class="mega" role="menu">
          {m.megaGroups.map((g) => (
            <div class="mega-col">
              <h4>{g.title}</h4>
              {g.items.map((it) => (
                <a class="mega-item" href={it.href}>
                  <b>{it.label}</b>
                  <span>{it.desc}</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
      {m.main.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? 'active' : ''}`}>{item.label}</a>
      ))}
    </nav>
    <div class="header-cta">
      <a href={m.ctaHref} class="btn btn-gold btn-sm">مشاوره رایگان</a>
      <button class="burger" aria-label="باز کردن منو">☰</button>
    </div>
  </div>
</header>

<div class="mobile-nav" aria-hidden="true">
  <div class="mn-scrim"></div>
  <div class="mn-panel">
    <button class="mn-close" aria-label="بستن منو">✕</button>
    <a href="/">خانه</a>
    <div class="mn-group-label">خدمات</div>
    {m.megaGroups.map((g) => g.items.map((it) => <a href={it.href}>{it.label}</a>))}
    <div class="mn-group-label">دسترسی سریع</div>
    {m.main.map((item) => <a href={item.href}>{item.label}</a>)}
    <div style="margin-top:16px">
      <a href={m.ctaHref} class="btn btn-gold btn-block">{m.ctaLabel} رایگان</a>
    </div>
  </div>
</div>
