---
/* ═══ چیدمان مشترک صفحات متنی ابری (پروژه‌ای /terms ، /privacy و /p/<slug>) ═══ */
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import { renderBlocks, tocFrom } from '../lib/ssr-articles.mjs';

interface Props {
  page: any;        // رکورد صفحه: {slug, eyebrow, title, lead, seoTitle, seoDesc, blocks, updated}
  canonical: string;
  robots?: string;
  draftPreview?: boolean; // true → پیش‌نمایش پیش‌نویس توسط مدیر (noindex + نوار اطلاع)
}
const { page, canonical, robots = '', draftPreview = false } = Astro.props;
const title = page.seoTitle || (page.title + ' | کافه دانش');
const description = page.seoDesc || page.lead || '';
const toc = tocFrom(page.blocks);
---

<SiteLayout title={title} description={description} robots={draftPreview ? 'noindex, nofollow' : robots} activePath="/">
  {draftPreview && (
    <div class="container" style="padding-top:130px">
      <div class="static-note" style="margin-bottom:10px">
        <Icon name="info" size={18} stroke={2} />
        پیش‌نمایش پیش‌نویس — این صفحه هنوز منتشر نشده و فقط برای شما (مدیر) نمایش داده می‌شود. برای انتشار: پنل → صفحات → انتشار.
      </div>
    </div>
  )}
  <section class="page-hero">
    <span class="page-hero__glow page-hero__glow--1" aria-hidden="true"></span>
    <span class="page-hero__glow page-hero__glow--2" aria-hidden="true"></span>
    <div class="container">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        <Icon name="chevron-left" size={13} stroke={2.2} />
        <span aria-current="page">{page.eyebrow || page.title}</span>
      </nav>
      <h1 data-reveal="up">{page.title}</h1>
      {page.lead && <p class="page-hero__sub" data-reveal="up" data-delay="110">{page.lead}</p>}
    </div>
  </section>

  <section class="section pad-half">
    <div class="container">
      <div class="article-body">
        {toc.length > 2 && (
          <div class="toc" data-reveal="up">
            <b>در این صفحه</b>
            <ol>
              {toc.map((sh: { id: string; t: string; level: number }) => (
                <li style={sh.level === 3 ? 'padding-inline-start:14px' : ''}>
                  <a href={'#' + sh.id}>{sh.t}</a>
                </li>
              ))}
            </ol>
          </div>
        )}
        <div class="prose" data-reveal="up">
          <Fragment set:html={renderBlocks(page.blocks)} />
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
