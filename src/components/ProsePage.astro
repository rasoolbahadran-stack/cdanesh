---
/* ═══ چیدمان مشترک صفحات متنی ابری (پروژه‌ای /terms ، /privacy و /p/<slug>) ═══ */
import SiteLayout from '../layouts/SiteLayout.astro';
import { renderBlocks, tocFrom } from '../lib/ssr-articles.mjs';

interface Props {
  page: any;        // رکورد صفحه: {slug, eyebrow, title, lead, seoTitle, seoDesc, blocks, updated}
  canonical: string;
  robots?: string;
  draftPreview?: boolean; // true → پیش‌نمایش پیش‌نویس توسط مدیر (noindex + نوار اطلاع)
}
const { page, canonical, robots = '', draftPreview = false } = Astro.props;
const title = page.seoTitle || (page.title + ' | کافه‌دانش');
const description = page.seoDesc || page.lead || '';
const toc = tocFrom(page.blocks);
---

<SiteLayout title={title} description={description} canonical={canonical} robots={draftPreview ? 'noindex, nofollow' : robots}>
  {draftPreview && (
    <div class="wrap" style="padding-top:120px">
      <div style="background:rgba(227,185,83,.12); border:1px solid rgba(227,185,83,.4); border-radius:14px; padding:12px 18px; font-size:13.5px; margin-bottom:8px">
        پیش‌نمایش پیش‌نویس — این صفحه هنوز منتشر نشده و فقط برای شما (مدیر) نمایش داده می‌شود. برای انتشار: پنل → صفحات → انتشار.
      </div>
    </div>
  )}
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span>{page.eyebrow || page.title}</span>
      </nav>
      <span class="eyebrow">{page.eyebrow || 'صفحه'}</span>
      <h1 class="h1">{page.title}</h1>
      {page.lead && <p class="lead">{page.lead}</p>}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap" style="max-width:880px">
      <div class="prose" style="padding-top:10px">
        <Fragment set:html={renderBlocks(page.blocks)} />
      </div>
      {toc.length > 2 && (
        <div class="aside-card" style="margin-top:44px">
          <b>در این صفحه</b>
          <nav class="toc" aria-label="فهرست مطالب">
            {toc.map(sh => <a href={'#' + sh.id} class={sh.level === 3 ? 'toc-l3' : ''}>{sh.t}</a>)}
          </nav>
        </div>
      )}
    </div>
  </section>
</SiteLayout>
