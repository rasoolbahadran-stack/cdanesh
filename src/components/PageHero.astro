---
// هدر صفحه داخلی — بنر گرادیان با خطوط منحنی، هماهنگ با زبان Hero
// مسیر صفحه (breadcrumb) عمداً نمایش داده نمی‌شود؛ فقط اسکیمای BreadcrumbList برای سئو نگه داشته می‌شود.
interface Props {
  title: string;
  sub?: string;
  /** نوار اطلاعاتی کوچک زیر توضیح (مثلاً وضعیت انتشار در پیش‌نمایش مدیریتی) */
  meta?: string[];
}
const { title, sub, meta = [] } = Astro.props;
---
<section class="page-hero">
  <svg class="hero__ribbon" viewBox="0 0 1440 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M-40 120 C 260 320, 620 60, 900 200 S 1380 330, 1520 210" stroke="rgba(11,18,51,0.16)" stroke-width="130" fill="none" stroke-linecap="round" />
    <path d="M-60 330 C 300 130, 700 380, 1080 240 S 1420 120, 1540 260" stroke="rgba(255,255,255,0.10)" stroke-width="72" fill="none" stroke-linecap="round" />
  </svg>
  <span class="hero__glow hero__glow--1" aria-hidden="true"></span>
  <div class="container">
    <h1 data-reveal="up">{title}</h1>
    {sub && <p data-reveal="up" data-delay="120">{sub}</p>}
    {meta.length > 0 && <div class="page-hero__meta">{meta.map((m) => <span>{m}</span>)}</div>}
    <slot />
  </div>
</section>

<style>
  .page-hero__meta{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:14px}
  .page-hero__meta span{background:rgba(255,255,255,.16);color:#fff;border-radius:99px;padding:4px 13px;font-size:.8rem;font-weight:700}
</style>
