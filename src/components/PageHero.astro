---
// هدر صفحه داخلی — بنر گرادیان با خطوط منحنی، هماهنگ با زبان Hero
interface Props {
  title: string;
  sub?: string;
  crumbs?: Array<{ label: string; href?: string }>;
}
const { title, sub, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <svg class="hero__ribbon" viewBox="0 0 1440 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M-40 120 C 260 320, 620 60, 900 200 S 1380 330, 1520 210" stroke="rgba(11,18,51,0.16)" stroke-width="130" fill="none" stroke-linecap="round" />
    <path d="M-60 330 C 300 130, 700 380, 1080 240 S 1420 120, 1540 260" stroke="rgba(255,255,255,0.10)" stroke-width="72" fill="none" stroke-linecap="round" />
  </svg>
  <span class="hero__glow hero__glow--1" aria-hidden="true"></span>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="page-hero__crumbs" aria-label="مسیر صفحه">
        {crumbs.map((c) => (c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>))}
      </nav>
    )}
    <h1 data-reveal="up">{title}</h1>
    {sub && <p data-reveal="up" data-delay="120">{sub}</p>}
    <slot />
  </div>
</section>
