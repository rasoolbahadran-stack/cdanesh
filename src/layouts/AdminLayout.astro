---
import '../styles/global.css'; import '../styles/admin.css';
interface Props {title:string;crumb?:string;newMessages?:number}
const {title,crumb,newMessages=0}=Astro.props;const p=Astro.url.pathname;
const menu=[['/admin','داشبورد','⌂','dashboard'],['/admin/posts','مقاله‌ها','✎','posts'],['/admin/pages','صفحات','▤','pages'],['/admin/categories','دسته‌بندی‌ها','▦','categories'],['/admin/media','رسانه‌ها','▧','media'],['/admin/portfolio','نمونه‌کارها','◇','portfolio'],['/admin/messages','درخواست‌ها و پیام‌ها','✉','messages'],['/admin/assistant','دستیار هوشمند','✧','assistant'],['/admin/errors','گزارش خطاها','⚒','errors'],['/admin/settings','تنظیمات','⚙','settings']];
const active=p==='/admin'?'dashboard':p.startsWith('/admin/posts')||p.startsWith('/admin/history')?'posts':p.startsWith('/admin/pages')?'pages':p.startsWith('/admin/categories')?'categories':p.startsWith('/admin/media')?'media':p.startsWith('/admin/portfolio')?'portfolio':p.startsWith('/admin/messages')?'messages':p.startsWith('/admin/assistant')?'assistant':p.startsWith('/admin/errors')?'errors':p.startsWith('/admin/settings')?'settings':'';
---
<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>{title} | کافه دانش</title><meta name="robots" content="noindex,nofollow"/><link rel="icon" type="image/svg+xml" href="/img/logo.svg"/><link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Regular.woff2" crossorigin/><link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Bold.woff2" crossorigin/></head>
<body class="admin-body"><div class="admin-layout"><aside class="admin-side" aria-label="منوی اصلی پنل">
<a class="side-brand" href="/admin"><img src="/img/logo.svg" alt="" width="38" height="38"/><span><b>کافه دانش</b><small>پنل مدیریت</small></span></a><div class="side-label">مدیریت محتوا</div>
<nav class="admin-side__nav">{menu.map(([href,label,icon,key])=><a href={href} class:list={['side-link',active===key&&'active']} aria-current={active===key?'page':undefined}><i class="ico" aria-hidden="true">{icon}</i><span class="txt">{label}</span>{key==='messages'&&newMessages>0&&<span class="side-badge">{newMessages}</span>}</a>)}</nav>
<div class="side-foot"><a class="side-link" href="/" target="_blank" rel="noopener"><i class="ico">↗</i><span class="txt">مشاهده سایت</span></a><form id="logout-form"><button class="side-link side-logout" type="submit"><i class="ico">⇥</i><span class="txt">خروج از پنل</span></button></form><button type="button" class="side-collapse" aria-label="جمع‌کردن منو"><i class="sc-ico">‹</i><span class="txt">جمع‌کردن منو</span></button></div>
</aside><div class="side-scrim"></div><main class="admin-main"><header class="admin-topbar"><button type="button" class="side-open-m" aria-label="بازکردن منو">☰ <span>منو</span></button><div class="admin-topbar__heading"><h1>{title}</h1>{crumb&&<div class="crumb">{crumb}</div>}</div><div class="actions"><a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener">مشاهده سایت ↗</a></div></header><div class="admin-content"><slot/></div></main></div>
<script>import '../scripts/admin.ts';document.getElementById('logout-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const b=(event.currentTarget as HTMLFormElement).querySelector('button');if(b)b.setAttribute('disabled','true');try{await fetch('/api/auth/logout',{method:'POST'});}finally{window.location.href='/admin/login';}});</script></body></html>