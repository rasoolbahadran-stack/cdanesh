---
// چیدمان پنل مدیریت — بدون هدر/فوتر عمومی سایت
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Bold.woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const send = (message) => { try { fetch('/api/errors', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({source:'browser',path:location.pathname,message:String(message || 'خطای پنل').slice(0,700)}), keepalive:true }); } catch {} };
        window.addEventListener('error', e => send(e.message || 'خطای اجرای اسکریپت'));
        window.addEventListener('unhandledrejection', e => send(e.reason?.message || e.reason || 'خطای promise'));
      })();
    </script>
  </body>
</html>
