---
/* چیدمان سایت — لایهٔ سازگاری
   صفحات قدیمی‌تر (پیش‌نمایش مقاله، صفحات ابری و نمونه‌کارهای مفهومی)
   همچنان از همین نام استفاده می‌کنند؛ حالا همه روی BaseLayout جدید سوار می‌شوند. */
import BaseLayout from './BaseLayout.astro';
import type { PageMeta } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schemas?: boolean;
  robots?: string;
  mainId?: string;
  activePath?: string;
}
const { title, description = '', canonical = '', schemas = true, robots = '', mainId = '', activePath = '' } = Astro.props;
const noIndex = robots.includes('noindex');

/* BaseLayout به meta از نوع PageMeta نیاز دارد. نسخهٔ قبلی title/description را
   مستقیم به BaseLayout می‌فرستاد؛ meta همیشه undefined بود و صفحاتی مثل
   /article و پیش‌نمایش نمونه‌کارهای مفهومی روی Vercel با «Internal server
   error» کرش می‌کردند. */
void schemas;
const rawPath = activePath || (canonical.startsWith('http') ? new URL(canonical).pathname : canonical) || '/';
const meta: PageMeta = {
  title,
  description,
  path: rawPath.startsWith('/') ? rawPath : `/${rawPath}`,
  noindex: noIndex,
};
---
<BaseLayout meta={meta} current={activePath || '/'}>
  <div id={mainId || undefined}>
    <slot />
  </div>
  <slot name="tail" />
</BaseLayout>
