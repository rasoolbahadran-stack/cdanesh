---
/* چیدمان سایت — لایهٔ سازگاری
   صفحات قدیمی‌تر (پیش‌نمایش مقاله، صفحات ابری و نمونه‌کارهای مفهومی)
   همچنان از همین نام استفاده می‌کنند؛ حالا همه روی BaseLayout جدید سوار می‌شوند. */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schemas?: boolean;
  robots?: string;
  mainId?: string;
  activePath?: string;
}
const { title, description = '', robots = '', mainId = '', activePath = '' } = Astro.props;
const noIndex = robots.includes('noindex');
---
<BaseLayout title={title} description={description} noIndex={noIndex} activePath={activePath}>
  <div id={mainId || undefined}>
    <slot />
  </div>
  <slot name="tail" />
</BaseLayout>
