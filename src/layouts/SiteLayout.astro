---
import PageHead from '../components/PageHead.astro';
import Header from '../components/Header.astro';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schemas?: boolean;
  robots?: string;
  mainId?: string;
}
const { title, description = '', canonical = '', schemas = true, robots = '', mainId = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <PageHead title={title} description={description} canonical={canonical} schemas={schemas} robots={robots}>
    <slot name="head" />
  </PageHead>
  <body>
<header class="site-header">
  <div class="nav-pill">
    <a class="brand" href="/" aria-label="کافه‌دانش — صفحه اصلی">
      <span class="brand-mark" aria-hidden="true"><img src="/assets/img/logo.svg" alt="" loading="eager"></span>
      <span class="brand-name">کافه‌دانش<small>CDANESH STUDIO</small></span>
    </a>
    <nav aria-label="ناوبری اصلی">
      <ul class="main-nav">
        <li class="has-mega">
          <a href="/#services" aria-haspopup="true">خدمات
            <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="mega" role="menu" aria-label="فهرست خدمات">
            <div class="mega-col">
              <b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M8 21V9"/></svg>طراحی و توسعه وب</b>
              <a class="mega-item" href="/web-design"><b>طراحی سایت اختصاصی</b><span>سایت سفارشی متناسب با برند و اهداف شما</span></a>
              <a class="mega-item" href="/e-commerce"><b>فروشگاه اینترنتی</b><span>تجربه خرید روان با درگاه پرداخت امن</span></a>
              <a class="mega-item" href="/uiux"><b>طراحی UI/UX</b><span>تجربه کاربری مهندسی‌شده و تمیز</span></a>
            </div>
            <div class="mega-col">
              <b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>سئو و تولید محتوا</b>
              <a class="mega-item" href="/seo"><b>سئو تکنیکال و محتوایی</b><span>زیرساخت فنی استاندارد و رشد ارگانیک</span></a>
              <a class="mega-item" href="/content-production"><b>مقالات تخصصی و سئوشده</b><span>محتوای ساختاریافته با تحقیق واقعی</span></a>
              <a class="mega-item" href="/speed-optimization"><b>بهینه‌سازی سرعت</b><span>Core Web Vitals و تجربه سریع کاربر</span></a>
            </div>
            <div class="mega-col">
              <b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v4m0 12v4M2 12h4m12 0h4M5 5l2.5 2.5m9 9L19 19M19 5l-2.5 2.5m-9 9L5 19"/></svg>هوش مصنوعی و پشتیبانی</b>
              <a class="mega-item" href="/ai-solutions"><b>دستیارهای هوشمند</b><span>چت‌بات و دستیار اختصاصی کسب‌وکار شما</span></a>
              <a class="mega-item" href="/support"><b>پشتیبانی و نگهداری سایت</b><span>امنیت، به‌روزرسانی و همراهی مداوم</span></a>
              <a class="mega-item" href="/services"><b>همه خدمات</b><span>مرور کامل سرویس‌های کافه‌دانش</span></a>
            </div>
            <div class="mega-rail">
              <b>دسترسی سریع</b>
              <a href="/portfolio">نمونه‌کارها <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></a>
              <a href="/blog">مجله مقالات <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></a>
              <a href="/about">درباره ما <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></a>
              <a href="/contact">تماس با ما <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></a>
              <div class="mega-card">
                <b>مشاوره اولیه رایگان</b>
                <p>در یک جلسه کوتاه، مسیر رشد دیجیتال کسب‌وکارتان را بررسی می‌کنیم.</p>
                <a class="btn btn-gold btn-sm" href="/request">شروع پروژه</a>
              </div>
            </div>
          </div>
        </li>
        <li><a href="/portfolio">نمونه‌کارها</a></li>
        <li><a href="/blog">مجله</a></li>
        <li><a href="/#pricing">تعرفه‌ها</a></li>
        <li><a href="/about">درباره ما</a></li>
        <li><a href="/contact">تماس</a></li>
      </ul>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-gold btn-sm" href="/request">درخواست مشاوره</a>
      <button class="menu-toggle" aria-label="باز کردن منو" aria-expanded="false" aria-controls="drawer"><span></span></button>
    </div>
  </div>
</header>
<div class="drawer-veil" aria-hidden="true"></div>
<aside class="drawer" id="drawer" aria-label="منوی موبایل">
  <div class="drawer-head">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><img src="/assets/img/logo.svg" alt="" loading="eager"></span><span class="brand-name">کافه‌دانش</span></a>
    <button class="drawer-close" aria-label="بستن منو"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  </div>
  <div class="drawer-group">
    <b>خدمات</b>
    <a href="/services">همه خدمات</a>
    <a href="/web-design">طراحی سایت</a>
    <a href="/e-commerce">فروشگاه اینترنتی</a>
    <a href="/seo">سئو و بهینه‌سازی</a>
    <a href="/content-production">تولید محتوا</a>
    <a href="/ai-solutions">هوش مصنوعی و اتوماسیون</a>
  </div>
  <div class="drawer-group">
    <b>سایت</b>
    <a href="/portfolio">نمونه‌کارها</a>
    <a href="/blog">مجله مقالات</a>
    <a href="/#pricing">تعرفه‌ها</a>
    <a href="/faq">سؤالات متداول</a>
    <a href="/about">درباره ما</a>
    <a href="/contact">تماس با ما</a>
  </div>
  <a class="btn btn-gold btn-block" href="/request">درخواست مشاوره رایگان</a>
</aside>
    <main id={mainId || undefined}><slot /></main>
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><img src="/assets/img/logo.svg" alt="" loading="eager"></span><span class="brand-name">کافه‌دانش<small>CDANESH STUDIO</small></span></a>
        <p>استودیو دیجیتال کافه‌دانش؛ طراحی سایت، سئو و راهکارهای هوشمند برای رشد واقعی کسب‌وکار شما.</p>
        <a class="btn btn-gold" href="/request">درخواست مشاوره رایگان</a>
      </div>
      <div class="footer-col">
        <b>خدمات</b>
        <ul>
          <li><a href="/web-design">طراحی سایت</a></li>
          <li><a href="/seo">سئو و بهینه‌سازی</a></li>
          <li><a href="/content-production">تولید محتوا</a></li>
          <li><a href="/ai-solutions">هوش مصنوعی و اتوماسیون</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <b>دسترسی سریع</b>
        <ul>
          <li><a href="/portfolio">نمونه‌کارها</a></li>
          <li><a href="/blog">مجله مقالات</a></li>
          <li><a href="/#pricing">تعرفه‌ها</a></li>
          <li><a href="/faq">سؤالات متداول</a></li>
          <li><a href="/about">درباره ما</a></li>
          <li><a href="/contact">تماس با ما</a></li>
          <li><a href="/request">ثبت درخواست خدمات</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <b>راه‌های ارتباطی</b>
        <ul>
          <li><a href="/contact">فرم تماس و اطلاعات تماس</a></li>
          <li><a href="/request">درخواست مشاوره رایگان</a></li>
          <li><a href="mailto:info@cdanesh.ir" dir="ltr">info@cdanesh.ir</a></li>
          <li><a href="tel:+989165806207" dir="ltr">۰۹۱۶ ۵۸۰ ۶۲۰۷</a></li>
          <li><a href="https://github.com/rasoolbahadran-stack" target="_blank" rel="noopener" dir="ltr">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-contact">
      <div class="fc-links">
        <a href="/privacy">حریم خصوصی</a>
        <a href="/terms">شرایط استفاده</a>
      </div>
      <a href="mailto:info@cdanesh.ir" dir="ltr">info@cdanesh.ir</a>
      <a href="tel:+989165806207" dir="ltr">۰۹۱۶ ۵۸۰ ۶۲۰۷</a>
      <span>بوشهر، خیابان شهید رجایی</span>
    </div>
    <div class="footer-copy">© <span class="js-year">۱۴۰۵</span> کافه‌دانش — تمامی حقوق محفوظ است.<span class="fc-credit">طراحی و اجرا: <a href="https://github.com/rasoolbahadran-stack" target="_blank" rel="noopener" dir="ltr">Rasool Bahadoran</a></span></div>
  </div>
  <div class="footer-mark" aria-hidden="true">کافه‌دانش</div>
</footer>
<button class="to-top" aria-label="بازگشت به بالا"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-7 7 7-7 7 7"/></svg></button>

    <script is:inline src="/assets/js/store.js"></script>
    <script is:inline src="/assets/js/data/articles-a.js"></script>
    <script is:inline src="/assets/js/data/articles-b.js"></script>
    <script is:inline src="/assets/js/data/articles.js"></script>
    <script is:inline src="/assets/js/data/faq.js"></script>
    <script is:inline src="/assets/js/data/portfolio.js"></script>
    <script is:inline src="/assets/js/site.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
    <script is:inline src="/assets/js/forms.js"></script>
    <slot name="tail" />
  </body>
</html>
