---
/* چیدمان پایهٔ عمومی — سئوی کامل: متا، OG، Twitter، Canonical، Schema.org */
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/seed';

export interface SeoProps {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  ogPublishedTime?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown>[];
}

interface Props extends SeoProps {
  activePath?: string;
}

const { title, description, ogImage, ogType = 'website', ogPublishedTime, noIndex, schema = [], activePath = '' } = Astro.props;
const settings = await getSiteSettings();
const seo = settings.seo;
const finalOg = (ogImage || seo.ogImage).startsWith('http') ? (ogImage || seo.ogImage) : Astro.site?.origin + (ogImage || seo.ogImage);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const preferredSiteName = settings.identity.brandEn?.trim() || 'CDANESH STUDIO';
const localizedSiteName = settings.identity.brandFa?.trim() || 'کافه‌دانش';
const displayTitle = title
  .replace(/کافه[\u200c\s-]*دانش/giu, preferredSiteName)
  .replace(/CDANESH\s+STUDIO/giu, preferredSiteName);

/* Schema سازمان — روی همهٔ صفحات */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://cdanesh.ir/#organization',
  name: preferredSiteName,
  alternateName: localizedSiteName,
  url: Astro.site?.href || '/',
  logo: (Astro.site?.origin || '') + '/img/logo.svg',
  description: seo.defaultDescription,
  email: settings.contact.email,
  telephone: '+98' + settings.contact.phone.slice(1),
  address: { '@type': 'PostalAddress', addressLocality: 'بوشهر', streetAddress: settings.contact.address, addressCountry: 'IR' },
};

const siteSchema = Astro.url.pathname === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://cdanesh.ir/#website',
  name: preferredSiteName,
  alternateName: [localizedSiteName, 'cdanesh.ir'],
  url: 'https://cdanesh.ir/',
} : null;

const allSchema = [orgSchema, ...(siteSchema ? [siteSchema] : []), ...schema];
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="apple-touch-icon" href="/img/logo-180.png" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/iran-yekan-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/iran-yekan-700.woff2" crossorigin />

    <meta property="og:site_name" content={preferredSiteName} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && ogPublishedTime ? <meta property="article:published_time" content={ogPublishedTime} /> : null}
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={finalOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOg} />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only">پرش به محتوای اصلی</a>
    <Header settings={settings} activePath={activePath} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
    <button class="to-top" aria-label="بازگشت به بالا">↑</button>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
