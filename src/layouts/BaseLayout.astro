---
// چیدمان پایه — SEO کامل، فونت محلی، انیمیشن‌های Reveal، هدر و فوتر
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/content';
import { ogImage, jsonLdOrganization, jsonLdWebSite, type PageMeta } from '../lib/seo';

interface Props {
  meta: PageMeta;
  current?: string;
  extraJsonLd?: object[];
}
const { meta, current = '/', extraJsonLd = [] } = Astro.props;

const canonical = `${SITE.url}${meta.path === '/' ? '' : meta.path}`;
const ogImg = ogImage(meta);
const org = jsonLdOrganization();
const website = jsonLdWebSite();

const orgLd = JSON.stringify(org);
const siteLd = JSON.stringify(website);
const extraLd = extraJsonLd.map((j) => JSON.stringify(j));
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={meta.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    {!meta.noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/img/logo-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/logo-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Vazirmatn-Bold.woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={meta.type ?? 'website'} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content={meta.title} />
    {meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}

    <script type="application/ld+json" set:html={orgLd} />
    <script type="application/ld+json" set:html={siteLd} />
    {extraLd.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>
    <Header current={current} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // ── انیمیشن ورود عناصر هنگام اسکرول (IntersectionObserver سبک) ──
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduced) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                const el = en.target as HTMLElement;
                const delay = Number(el.dataset.delay || 0);
                window.setTimeout(() => el.classList.add('is-in'), delay);
                io.unobserve(el);
              }
            });
          },
          { threshold: 0.14, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // ── شمارنده آمار ──
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const fmt = (n: number) => new Intl.NumberFormat('fa-IR').format(n);
      const runCounter = (el: HTMLElement) => {
        const target = Number(el.dataset.count || 0);
        if (reduced) { el.textContent = fmt(target); return; }
        const dur = 1400;
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (counters.length) {
        const cio = new IntersectionObserver(
          (entries) => entries.forEach((en) => {
            if (en.isIntersecting) { runCounter(en.target as HTMLElement); cio.unobserve(en.target); }
          }),
          { threshold: 0.5 }
        );
        counters.forEach((c) => cio.observe(c));
      }

      // ── تنظیم ارتفاع اسکرول کارت‌های نمونه‌کار (برای افکت مرور صفحه) ──
      document.querySelectorAll<HTMLElement>('.pf-card__shot').forEach((img) => {
        const set = () => {
          const thumb = img.closest('.pf-card__thumb');
          if (!thumb) return;
          const overflow = (img.naturalHeight ? (img.clientHeight / thumb.clientHeight - 1) : 1) * 100;
          img.style.setProperty('--scroll-h', `${Math.min(88, Math.max(30, overflow))}%`);
        };
        if (img.complete) set();
        else img.addEventListener('load', set, { once: true });
      });

      // ── آکاردئون FAQ ──
      document.querySelectorAll<HTMLElement>('[data-accordion-item]').forEach((item) => {
        const btn = item.querySelector<HTMLButtonElement>('[data-accordion-btn]');
        const panel = item.querySelector<HTMLElement>('[data-accordion-panel]');
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          const open = item.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(open));
          panel.setAttribute('aria-hidden', String(!open));
        });
      });

      // ── فیلتر نمونه‌کارها ──
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-pf-filter]');
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
          const cat = btn.dataset.pfFilter;
          document.querySelectorAll<HTMLElement>('[data-pf-item]').forEach((card) => {
            const show = cat === 'همه' || card.dataset.cat === cat;
            card.style.display = show ? '' : 'none';
          });
        });
      });

      // ── ارسال فرم‌ها (تماس/مشاوره) ──
      document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const status = form.parentElement?.querySelector<HTMLElement>('.form-status');
          const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const set = (cls: string, msg: string) => {
            if (!status) return;
            status.className = `form-status ${cls}`;
            status.textContent = msg;
          };
          btn?.setAttribute('disabled', 'true');
          const data = Object.fromEntries(new FormData(form).entries());
          if (typeof data.service === 'string' && !data.plan_title) data.plan_title = data.service;
          try {
            const res = await fetch(form.dataset.action || '/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            const payload = await res.json().catch(() => ({}));
            if (!res.ok || payload.ok === false) {
              set('is-err', payload.message || payload.error || 'ثبت درخواست انجام نشد. لطفاً اطلاعات را بررسی کنید.');
              return;
            }
            set('is-ok', payload.message || 'درخواست شما با موفقیت ثبت شد. ✅');
            form.reset();
          } catch {
            set('is-err', 'ارتباط با سرور برقرار نشد. لطفاً چند لحظه بعد دوباره تلاش کنید.');
          } finally {
            btn?.removeAttribute('disabled');
          }
        });
      });
    </script>
  </body>
</html>
