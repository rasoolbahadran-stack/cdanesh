---
import PageHead from '../components/PageHead.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schemas?: boolean;
  robots?: string;
  bodyStyle?: string;
  bodyClass?: string;
}
const { title, description = '', canonical = '', schemas = true, robots = '', bodyStyle = '', bodyClass = '' } = Astro.props;
/* لایوت بدون کروم سایت: ۴۰۴ و پنل مدیریت */
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <PageHead title={title} description={description} canonical={canonical} schemas={schemas} robots={robots}>
    <slot name="head" />
  </PageHead>
  <body class={bodyClass || undefined} style={bodyStyle || undefined}>
    <slot />
  </body>
</html>
