---
// ═══ صفحهٔ ابری — /p/<slug> ═══
// صفحات ساخته‌شده و ویرایش‌شده از بخش «صفحات» پنل مدیریت؛
// prerender=false → در هر درخواست سمت سرور از دادهٔ ابری رندر می‌شود
// (متن کامل در HTML واقعی — قابل خزش برای گوگل).
export const prerender = false;

import ProsePage from '../../components/ProsePage.astro';
import { getPublicPages, pageBySlug, RESERVED_SLUGS } from '../../lib/ssr-pages.mjs';

const { slug } = Astro.params;
const key = (slug || '').toLowerCase();

if (!key || RESERVED_SLUGS.has(key)) {
  return Astro.redirect('/404');
}

const pages = await getPublicPages();
const page = pageBySlug(pages, key);

if (!page) {
  // صفحهٔ عمومی نیست (پیش‌نویس) یا وجود ندارد → صفحهٔ ۴۰۴
  return Astro.redirect('/404');
}
---

<ProsePage page={page} canonical={'https://cdanesh.ir/p/' + page.slug} />
