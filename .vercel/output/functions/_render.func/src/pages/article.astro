---
// ═══ مسیر /article — پیش‌نمایش پنل مدیریت و ریدایرکت آدرس‌های قدیمی ═══
// مقالهٔ منتشرشده → ریدایرکت ۳۰۱ به آدرس تمیز /blog/<slug>
// مقالهٔ پیش‌نویس/زمان‌بندی‌شده (فقط با نشست مدیر) → پیش‌نمایش از دادهٔ ابری
// noindex: این صفحه نباید در گوگل ثبت شود؛ آدرس اصلی مقاله /blog/<slug> است.
export const prerender = false;

import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublicArticles, bySlugFrom } from '../lib/ssr-articles.mjs';

const params = Astro.url.searchParams;
const slug = params.get('slug') || '';

if (slug) {
  const posts = await getPublicArticles();
  const pub = bySlugFrom(posts, slug);
  // منتشرشده → آدرس تمیز (canonical) — پیش‌نمایش مقالهٔ منتشرشده همان صفحهٔ عمومی است
  if (pub) {
    return Astro.redirect('/blog/' + slug, 301);
  }
}
// پیش‌نویس/زمان‌بندی‌شده: رندر سمت کلاینت از دادهٔ ابری پنل (site.js) — noindex
const title = 'پیش‌نمایش مقاله | کافه‌دانش';
const description = '';
---

<SiteLayout title={title} description={description} robots="noindex, nofollow" mainId="article-root">
  <noscript>
    <div class="wrap" style="padding:160px 20px 60px; text-align:center">
      <p>برای مشاهده پیش‌نمایش مقاله، لطفاً جاوااسکریپت مرورگر را فعال کنید.</p>
      <a class="btn btn-gold" href="/blog">مشاهده فهرست مقالات</a>
    </div>
  </noscript>
</SiteLayout>
