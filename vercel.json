{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/portfolio/bazarino", "destination": "/portfolio/bazarino-astro", "permanent": true },
    { "source": "/portfolio/maison-mehr", "destination": "/portfolio/maison-mehr-astro", "permanent": true },
    { "source": "/portfolio/smarto", "destination": "/portfolio/smarto-astro", "permanent": true },
    { "source": "/portfolio/karino-job-portal", "destination": "/portfolio/karino-job-portal-astro", "permanent": true }
  ],
  "_readme_subdomains": "معماری زیردامنه نمونه‌کارها — پس از فعال‌سازی Wildcard DNS (*.cdanesh.ir) در پنل دامنه و افزودن دامنه Wildcard در پروژه Vercel، این ریدایرکت‌ها نسخه زنده هر پروژه را روی زیردامنه اختصاصی ارائه می‌کنند. برای فعال‌سازی، بخش «اتصال زیردامنه‌های نمونه‌کار» در README را ببینید."
}
